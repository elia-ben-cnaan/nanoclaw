"pc-ready\" id=\"pcReady\">${t(pc.ready)}</div></div>`;\n    if(s.precheckCollapsed) h+=`</details>`;\n  }\n  if(s.action){\n    h+=`<div class=\"action-card\">\n      <div class=\"ac-txt\"><b>${t(s.action.label)}</b><span><a href=\"${s.action.url}\" target=\"_blank\" rel=\"noopener\">${t(s.action.sub)}</a></span></div>\n      <a class=\"btn btn-teal\" href=\"${s.action.url}\" target=\"_blank\" rel=\"noopener\">${t(s.action.label)} <span class=\"arr\">↗</span></a>\n    </div>`;\n  }\n  if(s.note){\n    h+=`<div class=\"note\"><span class=\"ic\">⚑</span><span>${t(s.note)}</span></div>`;\n  }\n  document.getElementById('stepView').innerHTML=h;\n  linkifyTerms();\n\n  // nav buttons\n  document.getElementById('btnBack').toggleAttribute('disabled',cur===0);\n  const nextLabel=document.querySelector('#btnNext [data-i18n=\"next\"]');\n  if(nextLabel) nextLabel.textContent = cur===STEPS.length-1 ? t(UI.finish) : t(UI.next);\n}\n\nfunction togglePc(i){\n  const el=document.getElementById('pc'+i);\n  if(!el) return;\n  el.classList.toggle('on');\n  const total=document.querySelectorAll('.pc-item').length;\n  const done=document.querySelectorAll('.pc-item.on').length;\n  const ready=document.getElementById('pcReady');\n  if(ready) ready.classList.toggle('show', total>0 && done===total);\n}\n\n/* ---- glossary ---- */\nfunction gTerm(id){return GLOSSARY.find(g=>g.id===id);}\nfunction gLayers(g){\n  return `<div class=\"g-layer an\"><span class=\"g-lab\">${t(UI.gAnalogy)}</span><p>${t(g.analogy)}</p></div>\n    <div class=\"g-layer\"><span class=\"g-lab\">${t(UI.gWhat)}</span><p>${t(g.what)}</p></div>\n    <div class=\"g-layer ag\"><span class=\"g-lab\">${t(UI.gAgent)}</span><p>${t(g.agent)}</p></div>`;\n}\nfunction openGlossary(){\n  let h=`<div class=\"g-head\"><h3>${t(UI.glossaryTitle)}</h3><button class=\"g-x\" onclick=\"closeGlossary()\" aria-label=\"${t(UI.gClose)}\">×</button></div>`;\n  h+=`<p class=\"g-sub\">${t(UI.glossarySub)}</p>`;\n  GLOSSARY.forEach(g=>{h+=`<div class=\"g-card\" id=\"g-${g.id}\"><h4>${t(g.term)}</h4>${gLayers(g)}</div>`;});\n  document.getElementById('gPanel').innerHTML=h;\n  const o=document.getElementById('gOverlay');o.classList.add('open');o.scrollTop=0;\n}\nfunction openTerm(id){\n  const g=gTerm(id); if(!g){openGlossary();return;}\n  let h=`<div class=\"g-head\"><h3>${t(g.term)}</h3><button class=\"g-x\" onclick=\"closeGlossary()\" aria-label=\"${t(UI.gClose)}\">×</button></div>`;\n  h+=`<div class=\"g-card\" style=\"margin-top:14px\">${gLayers(g)}</div>`;\n  h+=`<button class=\"g-back\" onclick=\"openGlossary()\">${t(UI.gAll)} →</button>`;\n  document.getElementById('gPanel').innerHTML=h;\n  const o=document.getElementById('gOverlay');o.classList.add('open');o.scrollTop=0;\n}\nfunction closeGlossary(){document.getElementById('gOverlay').classList.remove('open');}\ndocument.addEventListener('keydown',e=>{if(e.key==='Escape')closeGlossary();});\n\nfunction linkifyTerms(rootId){\n  const root=document.getElementById(rootId||'stepView');\n  if(!root) return;\n  const targets=GLOSSARY.filter(g=>g.inline).map(g=>({id:g.id,strs:[...(g.match[lang]||[])].sort((a,b)=>b.length-a.length)}));\n  const usedIds=new Set();\n  const walker=document.createTreeWalker(root,NodeFilter.SHOW_TEXT,null);\n  const nodes=[];let n;while(n=walker.nextNode())nodes.push(n);\n  nodes.forEach(node=>{\n    if(!node.parentElement||node.parentElement.closest('.term,a,button,code')) return;\n    let cur=node;\n    for(const tg of targets){\n      if(usedIds.has(tg.id)) continue;\n      const text=cur.nodeValue;\n      for(const s of tg.strs){\n        const idx=text.indexOf(s);\n        if(idx<0) continue;\n        const span=document.createElement('span');\n        span.className='term';\n        span.setAttribute('onclick',`openTerm('${tg.id}')`);\n        span.textContent=s;\n        const frag=document.createDocumentFragment();\n        if(idx>0) frag.appendChild(document.createTextNode(text.slice(0,idx)));\n        frag.appendChild(span);\n        const after=document.createTextNode(text.slice(idx+s.length));\n        frag.appendChild(after);\n        cur.parentNode.replaceChild(frag,cur);\n        usedIds.add(tg.id);\n        cur=after;\n        break;\n      }\n    }\n  });\n}\n\nfunction renderGuide(id){\n  var g=CONNECTION_GUIDES.find(function(x){return x.id===id;});\n  if(!g) return;\n  curGuide=g;\n  var h='<div class=\"guide-back-nav\"><button onclick=\"setView(&apos;wizard&apos;);render();window.scrollTo({top:0,behavior:&apos;smooth&apos;})\">&#8592; '+(lang==='he'?'חזרה':' Back')+'</button></div>';","numLines":200,"startLine":1310,"totalLines":1546}},"sourceToolAssistantUUID":"73016e33-44d2-403a-9809-b9b320b969fb","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b522cebd-0184-435d-9a0b-60eb7d0a73fa","version":"2.1.154","gitBranch":"HEAD","slug":"breezy-launching-scott"}
