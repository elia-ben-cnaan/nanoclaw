 */\nbody[data-view=\"landing\"] .shell,body[data-view=\"landing\"] #finish,body[data-view=\"landing\"] #register{display:none}\nbody[data-view=\"register\"] #landing,body[data-view=\"register\"] .shell,body[data-view=\"register\"] #finish{display:none}\nbody[data-view=\"wizard\"] #landing,body[data-view=\"wizard\"] #register,body[data-view=\"wizard\"] #finish{display:none}\nbody[data-view=\"done\"] #landing,body[data-view=\"done\"] #register,body[data-view=\"done\"] .shell{display:none}\n\n/* ---- landing screen ---- */\n#landing{position:relative;max-width:none;margin:0;padding:0;background:#000000}\n.landing-inner{\n  position:relative;z-index:1;max-width:540px;margin:0 auto;\n  padding:60px 24px 90px;text-align:center;\n}\n.landing-mascot{width:clamp(100px,22vw,130px);height:auto;margin:0 auto 22px;display:block}\n.landing-wordmark{\n  font-family:'Baloo 2',cursive;font-size:clamp(36px,8vw,48px);font-weight:700;\n  line-height:1.1;margin-bottom:6px;letter-spacing:-.01em;\n}\n.landing-wordmark .nano{color:#FFFFFF}\n.landing-wordmark .shellano{color:#56EDD6}\n.landing-subtitle{font-size:13px;color:#56EDD6;letter-spacing:.03em;margin-bottom:28px;font-weight:500}\n.landing-headline{font-size:clamp(32px,7vw,40px);font-weight:800;line-height:1.15;margin-bottom:12px}\n.landing-headline .line1{color:#FFFFFF;display:block}\n.landing-headline .line2{color:#56EDD6;display:block}\n.landing-sub{font-size:15px;color:#B0B0B0;line-height:1.7;margin-bottom:8px;max-width:38ch;margin-inline:auto}\n.landing-meta{font-size:13px;color:#6F6F6F;margin-bottom:32px}\n.landing-cta{\n  display:inline-flex;align-items:center;gap:8px;\n  background:#56EDD6;color:#04211D;font-weight:700;font-size:17px;\n  padding:14px 32px;border-radius:100px;border:none;cursor:pointer;\n  box-shadow:0 8px 28px rgba(86,237,214,.32);transition:.18s;font-family:inherit;\n}\n.landing-cta:hover{background:#7AF4E0;box-shadow:0 12px 36px rgba(86,237,214,.44)}\n.landing-cta-sub{font-size:13px;color:#6F6F6F;margin-to