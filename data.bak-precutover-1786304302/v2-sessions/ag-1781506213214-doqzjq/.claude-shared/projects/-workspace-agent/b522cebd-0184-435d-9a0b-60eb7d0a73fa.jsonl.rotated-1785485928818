h1>'+t(g.title)+'</h1><p class=\"guide-oneliner\">'+t(g.oneLiner)+'</p></div></div>';\n  h+='<div class=\"guide-meta\"><span class=\"tag\">&#9201; '+t(g.estTime)+'</span></div>';\n  h+='<div class=\"prereqs-box\"><span class=\"pr-ic\">&#9745;</span><div class=\"pr-body\"><span class=\"pr-label\">'+t(UI.prereqsLabel)+'</span><span class=\"pr-txt\"> '+t(g.prereqs)+'</span></div></div>';\n  h+='<details class=\"what\" open><summary><h5>'+t(UI.whatLabel)+'</h5></summary><p>'+t(g.what)+'</p></details>';\n  h+='<div class=\"micro\"><h5 style=\"margin:28px 0 14px;font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-muted)\">'+t(UI.todoLabel)+'</h5>';\n  g.micro.forEach(function(m,i){\n    var shot='';\n    if(m.shot && m.shot!=='pending'){\n      shot='<div class=\"m-shot\"><img src=\"'+m.shot+'\" alt=\"\" loading=\"lazy\" onerror=\"this.parentNode.style.display=\\'none\\'\"></div>';\n    } else if(m.shot==='pending'){\n      shot='<div class=\"m-shot m-shot-pending\"><span class=\"m-cam\">📷</span><span>'+t(UI.shotPending)+'</span></div>';\n    }\n    h+='<div class=\"m-step\"><div class=\"m-num\">'+(i+1)+'</div><div class=\"m-body\"><p class=\"m-do\">'+t(m.do)+'</p>';\n    var _cmd=m.cmd&&(typeof m.cmd==='object'?m.cmd[lang]:m.cmd);\n    if(_cmd) h+='<div class=\"m-cmd\"><code>'+_cmd+'</code><button class=\"copy-btn\" onclick=\"copyCmd(this,'+JSON.stringify(_cmd)+')\">📋 '+(lang==='he'?'העתק':'Copy')+'</button><span class=\"copy-done\">'+(lang==='he'?'הועתק ✓':'Copied ✓')+'</span></div>';\n    h+=shot;\n    if(m.ok) h+='<div class=\"m-ok\"><span class=\"m-ic\">&#10003;</span><span><b>'+t(UI.okLabel)+':</b> '+t(m.ok)+'</span></div>';\n    if(m.stuck) h+='<details class=\"m-stuck\"><summary><b>'+t(UI.stuckLabel)+'</b></summary><div class=\"m-stuck-body\">'+t(m.stuck)+'</div></details>';\n    h+='</div></div>';\n  });\n  h+='</div><div class=\"guide-done\">&#10003; '+t(g.done)+'</div>';\n  if(g.note) h+='<div class=\"note\" style=\"margin-top:16px\"><span class=\"ic\">&#8505;</span> '+t(g.note)+'</div>';\n  document.getElementById('guide-view').innerHTML=h;\n  linkifyTerms('guide-view');\n}\n\n// DANIELA WIRES BACKEND\nwindow.submitLead=async function(){};\n\nif(_startWizard) setView('wizard');\nsetLang(lang);\nif(_guideId){setView('guide');renderGuide(_guideId);}\n</script>\n</body>","numLines":80,"startLine":1465,"totalLines":1546}},"sourceToolAssistantUUID":"05c38466-c7ff-49ff-8cfd-e5461981d9e6","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b522cebd-0184-435d-9a0b-60eb7d0a73fa","version":"2.1.154","gitBranch":"HEAD","slug":"breezy-launching-scott"}
