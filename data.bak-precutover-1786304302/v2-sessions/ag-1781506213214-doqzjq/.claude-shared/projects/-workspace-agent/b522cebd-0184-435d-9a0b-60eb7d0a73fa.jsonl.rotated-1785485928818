placeholder=\"'+pName+'\" autocomplete=\"name\"><p class=\"reg-error\">'+errName+'</p></div>';\n1238\t  h+='<div class=\"reg-field\" id=\"fieldPhone\"><label>'+lPhone+'</label><input type=\"tel\" id=\"regPhone\" placeholder=\"050-0000000\" autocomplete=\"tel\"><p class=\"reg-error\">'+errPhone+'</p></div>';\n1239\t  h+='<div class=\"reg-field\" id=\"fieldEmail\"><label>'+lEmail+'</label><input type=\"email\" id=\"regEmail\" placeholder=\"you@example.com\" autocomplete=\"email\"><p class=\"reg-error\">'+errEmail+'</p></div>';\n1240\t  h+='<button class=\"register-cta\" id=\"regSubmitBtn\" onclick=\"submitRegistration()\">'+ctaLabel+'</button>';\n1241\t  h+='<p class=\"reg-submit-err\" id=\"regSubmitErr\">'+errSubmit+'</p>';\n1242\t  h+='<p class=\"register-privacy\">'+priv+'</p>';\n1243\t  h+='</div>';\n1244\t  document.getElementById('register').innerHTML=h;\n1245\t  document.getElementById('regName').value=sN;\n1246\t  document.getElementById('regPhone').value=sP;\n1247\t  document.getElementById('regEmail').value=sE;\n1248\t}\n1249\t"}]},"uuid":"b7ad4ac1-e537-4841-bd89-1be513b046df","timestamp":"2026-06-16T16:18:28.271Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/agent/index.html","content":"  {\"id\":\"gcal\",\"icon\":null,\"title\":{\"en\":\"Connect Google Calendar\",\"he\":\"חיבור Google Calendar\"},\"oneLiner\":{\"en\":\"Once connected, the agent can schedule meetings, add events, set reminders and find free slots in your calendar.\",\"he\":\"אחרי החיבור הסוכן יכול לקבוע לך פגישות, להוסיף אירועים, להזכיר ולמצוא חלונות פנויים ביומן.\"},\"estTime\":{\"en\":\"about 3 minutes\",\"he\":\"כ-3 דקות\"},\"prereqs\":{\"en\":\"A Google account with an active calendar, your agent already running, and a browser open on the same device or your phone.\",\"he\":\"חשבון Google עם יומן פעיל, הסוכן שלך כבר רץ, ודפדפן פתוח באותו מכשיר או בטלפון.\"},\"what\":{\"en\":\"Your calendar is your time, and that's exactly what's hardest to manage alone. After this connection the agent steps in: you tell it \\\"schedule a meeting with Dana on Tuesday at four\\\" and it adds it, \\\"what's on tomorrow\\\" and it gives you the day, \\\"find me a free hour this week\\\" and it finds one. You never hand it your password. You just approve on Google's own page which permissions to grant, and you can revoke them any time.\",\"he\":\"היומן הוא הזמן שלך, וזה בדיוק מה שהכי קשה לנהל לבד. אחרי החיבור הזה הסוכן נכנס לתמונה: אתה אומר לו \\\"קבע לי פגישה עם דנה ביום שלישי בארבע\\\" והוא מוסיף אותה ליומן, \\\"מה יש לי מחר\\\" והוא מסכם לך את היום, \\\"מצא לי שעה פנויה השבוע\\\" והוא מוצא. אתה לא נותן לו את הסיסמה שלך אף פעם. אתה רק מאשר בעמוד של גוגל אילו הרשאות לתת, ואפשר לבטל אותן בכל רגע.\"},\"micro\":[{\"do\":{\"en\":\"In your agent chat write: <code>connect Google Calendar</code>. It will send you back a link (a web address) for a secure sign-in with Google.\",\"he\":\"בצ'אט של הסוכן כתוב לו: \\\"חבר אותי ליומן גוגל\\\". הוא יחזיר לך קישור (כתובת אינטרנט) להתחברות מאובטחת מול גוגל.\"},\"shot\":\"shots/gcal-1-ask.png\",\"ok\":{\"en\":\"The agent sent you a connect link. It opens your OneCLI vault first (the first time, see the OneCLI guide), and then Google's own approve screen.\",\"he\":\"הסוכן שלח לך קישור חיבור. הקישור פותח את כספת OneCLI שלך. בפעם הראשונה, ראה מדריך OneCLI. ואז מסך האישור של גוגל.\"},\"stuck\":{\"en\":\"No link? Write to the agent \\\"send me the Google Calendar link again\\\".\",\"he\":\"לא קיבלת קישור? כתוב לסוכן \\\"שלח לי שוב את הקישור ליומן גוגל\\\".\"}},{\"do\":{\"en\":\"Tap the link. It opens your OneCLI vault, and from there continues to Google. If you're signed in to several accounts, choose the account you want to connect (make sure it's the right one, with the calendar you actually use).\",\"he\":\"לחץ על הקישור. הוא פותח את כספת OneCLI שלך, ומשם ממשיך לגוגל. אם אתה מחובר לכמה חשבונות, בחר את החשבון שאתה רוצה לחבר (שים לב שזה החשבון הנכון, עם היומן שאתה מנהל).\"},\"shot\":\"shots/google-accountchooser.jpg\",\"ok\":{\"en\":\"You picked an account, and the page moves on.\",\"he\":\"בחרת חשבון, והעמוד ממשיך הלאה.\"},\"stuck\":{\"en\":\"Picked the wrong account by mistake? Close the window, go back to the chat and open the link again, then choose the right account.\",\"he\":\"בחרת בטעות חשבון לא נכון? סגור את החלון, חזור לצ'אט ופתח את הקישור שוב, ובחר את החשבון הנכון.\"}},{\"do\":{\"en\":\"If a <b>Google hasn't verified this app</b> screen appears, don't worry, it's an expected screen for this kind of connection. Tap <b>Advanced</b> at the bottom, then <b>Go to...</b>.\",\"he\":\"אם יופיע מסך <b>Google לא אימת את האפליקציה</b> (This app isn't verified), אל תיבהל, זה מסך צפוי בחיבור מהסוג הזה. לחץ על <b>מתקדם</b> (Advanced) למטה, ואז על <b>המשך אל...</b> (Go to...).\"},\"shot\":\"shots/gcal-3-notverified.png\",\"ok\":{\"en\":\"You tapped <b>Advanced</b> then <b>Continue</b>, and Google moves on to the permissions screen.\",\"he\":\"לחצת <b>מתקדם</b> ואז <b>המשך</b>, וגוגל ממשיכה למסך ההרשאות.\"},\"stuck\":{\"en\":\"Can't see <b>Go to</b>? Scroll down a bit after tapping <b>Advanced</b>, the link shows there in small text. This is a safe step, you continue to Google's official page.\",\"he\":\"לא רואה את <b>המשך אל</b>? גלול קצת למטה אחרי שלחצת <b>מתקדם</b>, הקישור מופיע שם בקטן. זה שלב בטוח, אתה ממשיך לעמוד הרשמי של גוגל.\"}},{\"do\":{\"en\":\"A permissions screen appears listing what the agent can do with your calendar. If there are checkboxes, tick all of them (or <b>Select all</b>), otherwise the connection won't complete. Then tap <b>Continue</b>.\",\"he\":\"יופיע מסך הרשאות שמפרט מה הסוכן יוכל לעשות ביומן. אם יש תיבות סימון, סמן את כולן (או <b>בחר הכול</b>), אחרת החיבור לא יושלם. ואז לחץ <b>המשך</b>.\"},\"shot\":\"shots/google-consent.jpg\",\"ok\":{\"en\":\"You ticked all the boxes and tapped <b>Continue</b>.\",\"he\":\"סימנת את כל התיבות ולחצת <b>המשך</b>.\"},\"stuck\":{\"en\":\"⚠️ The wording sounds broad (\\\"see and edit all your calendars\\\")? It's secure access through Google, your password isn't exposed, and you can revoke it any time. Most important: don't leave a box unchecked, or the connection fails silently.\",\"he\":\"⚠️ הניסוח נשמע רחב (\\\"צפייה ועריכה של כל היומנים\\\")? זו גישה מאובטחת דרך גוגל, הסיסמה שלך לא נחשפת, ותוכל לבטל בכל רגע. הכי חשוב: אל תשאיר תיבה לא מסומנת, אחרת החיבור נכשל בשקט.\"}},{\"do\":{\"en\":\"You land on a page saying the connection succeeded. You can close it and go back to the agent chat.\",\"he\":\"תגיע לעמוד שאומר שהחיבור הצליח. אפשר לסגור אותו ולחזור לצ'אט של הסוכן.\"},\"shot\":\"shots/onecli-gcal-real.jpg\",\"ok\":{\"en\":\"The agent chat confirms that Google Calendar is connected.\",\"he\":\"הצ'אט של הסוכן מאשר ש-Google Calendar מחובר.\"},\"stuck\":{\"en\":\"Have a work Google account (an organizational Workspace account)? Sometimes the admin blocks third-party apps, and the connection fails. Fix: either ask the admin to approve it, or connect a personal Google account to test.\",\"he\":\"יש לך חשבון גוגל ארגוני (Workspace של מקום העבודה)? לפעמים מנהל המערכת חוסם אפליקציות צד-שלישי, ואז החיבור ייכשל. פתרון: או שתבקש מהאדמין לאשר, או שתחבר חשבון גוגל אישי לבדיקה.\"}},{\"do\":{\"en\":\"Check it works, and this is the fun part: write to the agent <code>add a test meeting to my calendar tomorrow at 10am</code>. Open your calendar, and the event is already there.\",\"he\":\"בדוק שזה עובד, וזה החלק הכיפי: כתוב לסוכן <code>תוסיף לי ליומן פגישת בדיקה מחר ב-10 בבוקר</code>. פתח את היומן, והאירוע כבר שם.\"},\"shot\":\"shots/gcal-6-event.png\",\"ok\":{\"en\":\"The event shows in your calendar at the right time, without you touching it yourself. From here the agent works with your calendar.\",\"he\":\"האירוע מופיע ביומן שלך בזמן הנכון, בלי שנגעת בו בעצמך. מכאן הסוכן עובד עם היומן שלך.\"},\"stuck\":{\"en\":\"The agent says it has no access? Most likely a permission box was left unchecked in step 4. Ask <code>connect Google Calendar</code> again, and this time tick all the boxes.\",\"he\":\"הסוכן אומר שאין לו גישה? כנראה נשארה תיבת הרשאה לא מסומנת בצעד 4. בקש \\\"חבר אותי ליומן גוגל\\\" שוב, והפעם סמן את כל התיבות.\"}}],\"done\":{\"en\":\"Google Calendar is connected. Now you can ask the agent to schedule meetings, add events, remind you and find free slots, all without ever giving it your password. Together with Gmail it becomes a full personal assistant. To revoke access later: <a href='https://myaccount.google.com/' target='_blank' rel='noopener'>myaccount.google.com</a>, then Security, then third-party apps.\",\"he\":\"Google Calendar מחובר. עכשיו תוכל לבקש מהסוכן לקבוע פגישות, להוסיף אירועים, להזכיר לך ולמצוא חלונות פנויים, והכול בלי שנתת לו אי פעם את הסיסמה שלך. ביחד עם Gmail זה הופך אותו לעוזר אישי שלם. לביטול הגישה בעתיד: <a href='https://myaccount.google.com/' target='_blank' rel='noopener'>myaccount.google.com</a>, אבטחה, אפליקציות צד-שלישי.\"},\"note\":{\"en\":\"Already connected Gmail? Calendar uses the same Google account and the same flow. Gmail and Calendar together make the agent a full personal assistant.\",\"he\":\"כבר חיברת Gmail? חיבור היומן עובד עם אותו חשבון גוגל ואותה זרימה. Gmail ויומן ביחד הופכים את הסוכן לעוזר אישי שלם.\"}}\n];\n\n\nlet lang='he', cur=0, curGuide=null;\nconst done=new Set();\n// optional deep-link: ?lang=en&step=2&start=1\nconst _q=new URLSearchParams(location.search);\nif(_q.get('lang')==='en') lang='en';\nlet _startWizard=false;\nif(_q.get('step')){cur=Math.max(0,Math.min(STEPS.length-1,parseInt(_q.get('step'))-1));_startWizard=true;}\nif(_q.get('start')==='1') _startWizard=true;\nconst _guideId=_q.get('guide')||null;\nif(_guideId) _startWizard=false;\n\nfunction t(o){return o[lang]}\nfunction setView(v){document.body.dataset.view=v;}\n\nfunction setLang(l){\n  lang=l;\n  document.body.dir = l==='he'?'rtl':'ltr';\n  document.documentElement.lang=l;\n  document.getElementById('lang-en').classList.toggle('on',l==='en');\n  document.getElementById('lang-he').classList.toggle('on',l==='he');\n  document.querySelectorAll('