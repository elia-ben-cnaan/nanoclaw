ellano · מבית היוצרים של NanoClaw</span></footer>\n\n<!-- nc-analytics -->\n<script>\n(function(){\n  var LEADS_ENDPOINT='/api/t';\n  var p=new URLSearchParams(location.search);\n  var src=p.get('utm_source'), med=p.get('utm_medium'), cmp=p.get('utm_campaign'), cnt=p.get('utm_content');\n  if(src||med||cmp||cnt){\n    try{fetch(LEADS_ENDPOINT,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({type:'pageview',page:'sales',utm_source:src,utm_medium:med,utm_campaign:cmp,utm_content:cnt})});}catch(e){}\n    document.querySelectorAll('a.cta-primary').forEach(function(a){\n      var u=new URL(a.href,location.href);\n      if(src) u.searchParams.set('utm_source',src);\n      if(med) u.searchParams.set('utm_medium',med);\n      if(cmp) u.searchParams.set('utm_campaign',cmp);\n      if(cnt) u.searchParams.set('utm_content',cnt);\n      a.href=u.toString();\n    });\n  }\n})();\n</script>\n</body>\n</html>\n","structuredPatch":[{"oldStart":3,"oldLines":13,"newStart":3,"newLines":13,"lines":[" <head>"," <meta charset=\"utf-8\" />"," <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />","-<title>NanoShellano למכירות — סוכן AI שמכפיל אותך</title>","+<title>NanoShellano למכירות | סוכן AI שמכפיל אותך</title>"," <meta property=\"og:type\" content=\"website\" />","-<meta property=\"og:title\" content=\"NanoShellano למכירות — סוכן AI שמכפיל אותך\" />","+<meta property=\"og:title\" content=\"NanoShellano למכירות | סוכן AI שמכפיל אותך\" />"," <meta property=\"og:description\" content=\"לא עוד כלי. זרוע מבצעת שעושה פולואפים, סיכומים והכנה לפגישות. 20 דקות להתקנה.\" />"," <meta property=\"og:image\" content=\"https://nanoshellano.vercel.app/shots/nanoshellano-lockup-trim.png\" />"," <meta name=\"twitter:card\" content=\"summary_large_image\" />","-<meta name=\"twitter:title\" content=\"NanoShellano למכירות — סוכן AI שמכפיל אותך\" />","+<meta name=\"twitter:title\" content=\"NanoShellano למכירות | סוכן AI שמכפיל אותך\" />"," <meta name=\"