{"parentUuid":"8828b604-6582-4e69-8680-7a4c5fc003dd","isSidechain":false,"message":{"model":"claude-sonnet-4-6","id":"msg_01UgLGefjLUDEDoYdmgCm5YS","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012ZbqNWnh41DgdkAikngaZN","name":"Read","input":{"file_path":"/workspace/agent/index.html","offset":522,"limit":340},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":8049,"cache_read_input_tokens":43501,"output_tokens":162,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":8049,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":1,"output_tokens":162,"cache_read_input_tokens":43501,"cache_creation_input_tokens":8049,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8049},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Cc6QJ8PP6hqCDQycp1MBN","type":"assistant","uuid":"57930695-c566-41c0-b9c8-a97cd3c2dc34","timestamp":"2026-06-16T05:40:34.273Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b522cebd-0184-435d-9a0b-60eb7d0a73fa","version":"2.1.154","gitBranch":"HEAD","slug":"breezy-launching-scott"}
{"parentUuid":"57930695-c566-41c0-b9c8-a97cd3c2dc34","isSidechain":false,"promptId":"8c70bf4d-ae46-4a1a-b54a-a67b26a69c94","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012ZbqNWnh41DgdkAikngaZN","type":"tool_result","content":"522\tconst STEPS = [\n523\t  {\n524\t    phase:'prepare', status:'ready', owner:'you',\n525\t    openWhat:true,\n526\t    precheckCollapsed:true,\n527\t    opener:{en:'In about 30 minutes you will have your own AI agent. It talks with you, remembers you, and works for you in the background. No technical background needed, you are not alone. I am with you step by step.', he:'בעוד כחצי שעה יהיה לך סוכן AI משלך. מדבר איתך, זוכר אותך, עובד בשבילך ברקע. בלי רקע טכני, בלי לבד. אני איתך צעד-צעד.'},\n528\t    title:{en:'What’s waiting for you here', he:'מה מחכה לך כאן'},\n529\t    what:{\n530\t      en:'In about 30–45 minutes you will have your own AI agent in your messaging app. Here is how this guide works: every word in blue is a glossary term, tap it to learn more. Each step opens with a “What happens here” box explaining the goal. Stuck? Tap “Stuck here? The fix is inside” to see what can happen. Every command comes with a copy button so you never type anything by hand.',\n531\t      he:'כך המדריך הזה עובד: כל מילה בכחול היא מונח שאפשר ללחוץ עליו ולהבין. כל שלב נפתח בתיבת מה קורה כאן שמסבירה את המטרה. נתקעת? לחץ על נתקעת כאן? הפתרון בפנים. כל פקודה מגיעה עם כפתור העתק, כך שלא צריך להקליד שום דבר ביד.'\n532\t    },\n533\t    todo:{\n534\t      en:['A small <b>cloud server</b> for your agent to live on, always on.','An <b>Anthropic</b> account with a small credit balance, the AI brain.','A messaging app to talk to it (Telegram, free).','About 30–45 minutes and a coffee ☕'],\n535\t      he:['שרת בענן קטן שיחיה הסוכן תמיד דלוק.','חשבון <b>Anthropic</b> עם יתרת קרדיט קטנה, זה המוח של הסוכן.','אפליקציית הודעות לדבר אתו (טלגרם, חינם).','בערך 30–45 דקות וכוס קפה ☕']\n536\t    },\n537\t    callout:{en:\"NanoClaw itself is free, open source, for everyone. You only pay for the external providers: the cloud server (hosting) and Anthropic (the AI brain).\", he:\"NanoClaw עצמו חינמי לגמרי, קוד פתוח, לכולם. אתה משלם רק לספקי המשנה: שרת הענן (אחסון) ו-Anthropic (מוח ה-AI).\"},\n538\t    precheck:{\n539\t      title:{en:'Quick check before you start', he:'בדיקה מהירה לפני שמתחילים'},\n540\t      sub:{en:\"Tick each one. Two minutes now and the install goes smooth all the way through.\", he:\"סמן כל אחד, שתי דקות עכשיו, וההתקנה תעבור חלק עד הסוף.\"},\n541\t      glossaryHint:{en:\"Don’t worry about the words, each one is explained with a tap.\", he:\"אל תיבהל מהמילים, כל אחת מוסברת בלחיצה.\"},\n542\t      items:[\n543\t        {en:\"I can use a cloud server with enough RAM for the agent (not the cheapest basic plan).\", he:\"אני יכול להשתמש בשרת ענן עם מספיק זיכרון (לא התוכנית הכי זולה).\"},\n544\t        {en:'I will <b>not</b> use Google Cloud (it blocks the installer). DigitalOcean / Hetzner / exe.dev are fine.', he:'אני <b>לא</b> אשתמש ב-Google Cloud (הוא חוסם את המתקין). DigitalOcean / Hetzner / exe.dev, בסדר גמור.'},\n545\t        {en:'I have a <b>credit card</b> ready for the cloud server (about the cloud server is billed to my own account, not to NanoClaw).', he:'יש לי <b>כרטיס אשראי</b> מוכן לשרת הענן (החיוב ישירות לחשבון שלי, לא ל-NanoClaw).'},\n546\t        {en:\"I'll add a <b>small credit balance</b> to my Anthropic account, without it the agent simply won’t start, so best to top it up a minute ahead and that’s it.\", he:\"אני אטען <b>יתרת קרדיט קטנה</b> לחשבון Anthropic שלי, בלי הקרדיט הסוכן פשוט לא יתחיל, אז כדאי לטעון מראש דקה וזהו.\"},\n547\t        {en:'I have <b>Telegram</b> on my phone (or will install it, it’s free).', he:'יש לי <b>טלגרם</b> בטלפון (או שאתקין, זה חינם).'},\n548\t        {en:'I have <b>30–45 minutes</b> free for this first session.', he:'יש לי <b>30–45 דקות</b> פנויות לישיבה הראשונה הזו.'}\n549\t      ],\n550\t      ready:{en:'You’re ready, let’s go. 🚀', he:'אתה מוכן, קדימה. 🚀'}\n551\t    },\n552\t    bridge:{en:\"From here it gets practical, but I’m with you every step. Every word is explained, and if something gets stuck, write to me.\", he:\"מכאן זה נהיה מעשי, אבל אני אתך בכל צעד. כל מילה מוסברת, ואם משהו נתקע, כתוב לי.\"},\n553\t    note:{en:'Nothing here is locked in: no passwords are kept, every key is yours, and everything is in your name.', he:'אין כאן שום דבר שאי אפשר לבטל: לא נשמרות סיסמאות, כל מפתח שלך, והכל רשום על שמך.'}\n554\t  },\n555\t  {\n556\t    phase:'prepare', status:'ready', owner:'you',\n557\t    openWhat:true,\n558\t    title:{en:'Where will your agent live?', he:'איפה הסוכן יחיה?'},\n559\t    what:{\n560\t      en:\"Your agent can live on a cloud server or on your own computer. Cloud means it stays on 24/7 and runs in a secured, isolated environment, so you can reach it from your phone anywhere, even when your computer is off. This guide covers the cloud path. A local guide may come later if there is enough demand.\",\n561\t      he:\"הסוכן שלך יכול לחיות על שרת ענן או על המחשב שלך. ענן אומר שהוא דולק 24/7, רץ בסביבה מאובטחת ומבודלת, ואפשר לפנות אליו מהנייד בכל מקום, גם כשהמחשב שלך כבוי. המדריך הזה מכסה את מסלול הענן. מדריך מקומי יכול לבוא בהמשך אם יהיה מספיק ביקוש.\"\n562\t    },\n563\t    note:{en:'Tip: in the next step you will pick the cloud server. A standard plan works, and you are billed directly by the provider.', he:'טיפ: בשלב הבא תבחר את שרת הענן. חבילה סטנדרטית עובדת, והחיוב ישירות אליך מספק הענן.'}\n564\t  },\n565\t  {\n566\t    phase:'install', status:'ready', owner:'you',\n567\t    openWhat:true,\n568\t    title:{en:'Set up your cloud server', he:'הקמת שרת הענן'},\n569\t    what:{\n570\t      en:\"Don't let the word server throw you. It's just a small computer you rent, always on, and that's where the agent lives. Only two decisions actually matter here, everything else stays at its default.\",\n571\t      he:\"אל תיבהל מהמילה שרת. זה פשוט מחשב קטן שאתה שוכר, שתמיד דולק, וזה הבית של הסוכן. שתי החלטות בלבד באמת חשובות פה, השאר ברירת מחדל.\"\n572\t    },\n573\t    action:{label:{en:'Open DigitalOcean', he:'פתח את DigitalOcean'}, sub:{en:'digitalocean.com', he:'digitalocean.com'}, url:'https://www.digitalocean.com/'},\n574\t    micro:[\n575\t      {\n576\t        do:{en:'Go to <a href=\"https://www.digitalocean.com/\" target=\"_blank\" rel=\"noopener\">digitalocean.com</a> and click <b>“Sign up”</b> (top right). Register with your email or your Google account, and add a payment card, a 4 GB machine runs roughly $5–12 a month.', he:'נכנסים ל-<a href=\"https://www.digitalocean.com/\" target=\"_blank\" rel=\"noopener\">digitalocean.com</a> ולוחצים <b>“Sign up”</b> (למעלה מימין). נרשמים עם אימייל או חשבון Google, ומוסיפים כרטיס תשלום, מכונה של 4GB עולה בערך 5–12$ לחודש.'},\n577\t        shot:null,\n578\t        ok:{en:'After confirming your email, you land on the DigitalOcean dashboard.', he:'אחרי אישור האימייל, אתה מגיע ללוח הבקרה של DigitalOcean.'},\n579\t        stuck:{en:'Asked to verify your email? Open the message they sent and click the confirmation link.', he:'מבקשים לאמת אימייל? פתח את ההודעה ששלחו ולחץ על קישור האישור.'}\n580\t      },\n581\t      {\n582\t        do:{en:'Click <b>Create → Droplets</b>. Pick <b>Ubuntu</b>, a plan with <b>at least 4 GB RAM</b>, and a region close to you. Then click <b>Create Droplet</b>.', he:'לוחצים <b>Create → Droplets</b>. בוחרים <b>Ubuntu</b>, חבילה עם <b>לפחות 4GB RAM</b>, ואזור קרוב אליך. ואז <b>Create Droplet</b>.'},\n583\t        shot:'shots/do-size.png',\n584\t        ok:{en:'After about a minute your new server appears with its own IP address (like 164.92.20.10).', he:'אחרי כדקה השרת החדש מופיע עם כתובת IP משלו (כמו 164.92.20.10).'},\n585\t        stuck:{en:'Don’t grab the very cheapest 1–2 GB plan, the agent needs ~4 GB and won’t start on less. And skip Google Cloud: it blocks the install (DigitalOcean, Hetzner and exe.dev all work).', he:'אל תיקח את החבילה הכי זולה של 1–2GB, הסוכן צריך בערך 4GB ולא יעלה על פחות. ודלג על Google Cloud: הוא חוסם את ההתקנה (DigitalOcean, Hetzner ו-exe.dev עובדים).'}\n586\t      },\n587\t      {\n588\t        do:{en:'When it asks how to log in, choose a <b>password</b> (the simple path), set one, and write it down somewhere safe.', he:'כשהוא שואל איך להתחבר, בוחרים <b>סיסמה</b> (הדרך הפשוטה), קובעים אותה, ורושמים במקום בטוח.'},\n589\t        shot:null,\n590\t        ok:{en:'The password is set, you’ll use it to log in next.', he:'הסיסמה נקבעה, תשתמש בה כדי להתחבר עכשיו.'},\n591\t        stuck:{en:'Offered SSH keys instead? A password is fine here, it’s simpler and works perfectly.', he:'מציעים לך מפתחות SSH במקום? סיסמא מצוינת כאן, פשוטה יותר ועובדת מצוין.'}\n592\t      },\n593\t      {\n594\t        do:{en:'In the DigitalOcean sidebar on the left click <b>Droplets</b>. Find your server in the list. The status should show <b>active</b>.', he:'בסרגל הצד של DigitalOcean משמאל לוחצים על <b>Droplets</b>. מוצאים את השרת שלך ברשימה. הסטאטוס צריך להיות <b>active</b>.'},\n595\t        shot:'shots/do-droplets.png',\n596\t        ok:{en:'Your server row appears in the Droplets list.', he:'שורת השרת שלך מופיעה ברשימת ה-Droplets.'},\n597\t        stuck:{en:'No Droplet visible? Make sure you are in the right project, or look under All Droplets.', he:'לא רואה את ה-Droplet? ודא שאתה בפרויקט הנכון, או חפש תחת All Droplets.'}\n598\t      },\n599\t      {\n600\t        do:{en:'Click your server name to open its page. Click the <b>Access</b> tab, then click <b>Launch Droplet Console</b>. A black terminal window opens in the browser.', he:'לוחצים על שם השרת שלך כדי לפתוח את העמוד שלו. לוחצים על הכרטיסייה <b>Access</b>, ואז על <b>Launch Droplet Console</b>. נפתח חלון טרמינל שחור בדפדפן.'},\n601\t        shot:'shots/do-access.png',\n602\t        ok:{en:'A black window with a <code>root@...:~#</code> prompt opens right in your browser, no extra software needed.', he:'נפתח חלון שחור עם שורת פקודה <code>root@...:~#</code> ישר בדפדפן, בלי תוכנה נוספת.'},\n603\t        stuck:{en:'Console will not open? Make sure pop-ups are allowed for the site, or click Console again.', he:'ה-Console לא נפתח? ודא שחלונות קופצים מותרים לאתר, או נסה ללחוץ שוב על Console.'}\n604\t      },\n605\t      {\n606\t        do:{en:'On your server’s page click <b>“Console”</b>, a black terminal opens right in your browser, no extra software. Log in as <code>root</code> with the password you set.', he:'בדף של השרת לוחצים <b>“Console”</b>, נפתח טרמינל שחור ישר בדפדפן, בלי תוכנה נוספת. מתחברים בתור <code>root</code> עם הסיסמה שקבעת.'},\n607\t        shot:'shots/do-console.png',\n608\t        ok:{en:'You see a black window with a <code>root@...:~#</code> prompt. This is where the installer will run in the next step.', he:'אתה רואה חלון שחור עם שורת פקודה <code>root@...:~#</code>. כאן ירוץ המתקין בשלב הבא.'},\n609\t        stuck:{en:'Console won’t open? Allow pop-ups for the site, or click Console again, it can take a few seconds.', he:'ה-Console לא נפתח? אפשר חלונות קופצים לאתר, או לחץ Console שוב, זה יכול לקחת כמה שניות.'}\n610\t      }\n611\t    ],\n612\t    note:{en:'This guide uses DigitalOcean specifically, but the same steps work on Hetzner, exe.dev, or any standard VPS. Two things matter: at least a 4 GB machine (the agent will not run on less), and not Google Cloud (it blocks the install). The browser Console means you never have to install or understand SSH.', he:'המדריך הזה עובד עם DigitalOcean ספציפית, אבל אותם שלבים עובדים גם על Hetzner, exe.dev, ועל כל VPS סטנדרטי אחר. שני דברים חשובים: לפחות 4GB זיכרון (הסוכן לא ירוץ על פחות), ולא Google Cloud (הוא חוסם את ההתקנה). ה-Console בדפדפן אומר שאתה אף פעם לא צריך להתקין או להבין SSH.'}\n613\t  },\n614\t  {\n615\t    phase:'install', status:'ready', owner:'you',\n616\t    title:{en:'Your AI key', he:'מפתח ה-AI שלך'},\n617\t    what:{\n618\t      en:'Your agent thinks using Claude by Anthropic. You need one key, like a password that gives your agent access to its “brain”. The installer will ask you for it shortly, so let’s get it ready now.',\n619\t      he:'הסוכן חושב באמצעות Claude של Anthropic. צריך מפתח אחד, כמו סיסמה שנותנת לסוכן גישה ל\"מוח\". המתקין יבקש אותו ממך עוד מעט, אז נכין אותו עכשיו.'\n620\t    },\n621\t    callout:{en:\"Sounds technical, but it's just copy, paste, and click.\", he:\"זה נשמע טכני אבל זה רק העתק-הדבק וללחוץ.\"},\n622\t    todo:{\n623\t      en:['Open an Anthropic account, free to create.','<b>Load a small credit balance</b>, the AI itself costs a little per use.','Go to <b>API Keys</b> and create a new key.','Copy it somewhere safe, the installer asks for it in the next step.'],\n624\t      he:['פותחים חשבון Anthropic, הפתיחה חינם.','<b>טוענים יתרת קרדיט קטנה</b>, ה-AI עצמו עולה מעט לפי שימוש.','נכנסים ל-<b>API Keys</b> ויוצרים מפתח חדש.','מעתיקים למקום בטוח, המתקין יבקש אותו בשלב הבא.']\n625\t    },\n626\t    action:{label:{en:'Open Anthropic Console', he:'פתח את קונסולת Anthropic'}, sub:{en:'console.anthropic.com', he:'console.anthropic.com'}, url:'https://console.anthropic.com/'},\n627\t    micro:[\n628\t      {\n629\t        do:{en:'In your browser’s address bar, open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> and press Enter. The Claude Console login page opens.', he:'בשורת הכתובת של הדפדפן פותחים <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ולוחצים Enter. נפתח דף הכניסה של Claude Console.'},\n630\t        shot:null,\n631\t        ok:{en:'You see the heading “Build with the Claude API” and two ways to sign in, Google or email.', he:'רואים את הכותרת “Build with the Claude API” ושתי דרכים להיכנס, Google או אימייל.'},\n632\t        stuck:{en:'Landed somewhere else? Make sure you open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> directly, with no “www” and no spaces.', he:'הגעת למקום אחר? ודא שאתה פותח <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ישירות, בלי “www” ובלי רווחים.'}\n633\t      },\n634\t      {\n635\t        do:{en:'Easiest path: click <b>“Continue with Google”</b> and pick your Google account. No Google? Type your email, click <b>Continue</b>, and paste the code that arrives in your inbox.', he:'הדרך הקלה: לוחצים <b>“Continue with Google”</b> ובוחרים את חשבון הגוגל שלך. אין גוגל? מקלידים אימייל, לוחצים <b>Continue</b>, ומדביקים את הקוד שמגיע למייל.'},\n636\t        shot:null,\n637\t        ok:{en:'You land on the Console dashboard, with a menu down the left side.', he:'אתה מגיע ללוח הבקרה (Dashboard), עם תפריט בצד.'},\n638\t        stuck:{en:'No email arrived? Check your spam folder, or just use the Google button instead.', he:'לא הגיע מייל? בדוק בתיקיית הספאם, או פשוט השתמש בכפתור של Google.'}\n639\t      },\n640\t      {\n641\t        do:{en:'In the left menu click <b>Billing</b>, then <b>“Add to credit balance”</b>. Choose a small amount (even $5) and enter a card.', he:'בתפריט הצד לוחצים <b>Billing</b>, ואז <b>“Add to credit balance”</b>. בוחרים סכום קטן (אפילו 5$) ומזינים כרטיס.'},\n642\t        shot:null,\n643\t        ok:{en:'At the top you see a Balance with the amount you loaded, for example $5.00.', he:'למעלה מופיע Balance עם הסכום שטענת, למשל $5.00.'},\n644\t        stuck:{en:'Card declined? Try another card. Remember: with no balance the agent simply won’t answer.', he:'הכרטיס נדחה? נסה כרטיס אחר. זכור: בלי יתרה הסוכן פשוט לא יענה.'}\n645\t      },\n646\t      {\n647\t        do:{en:'In the left menu click <b>API Keys</b>, then the <b>“Create Key”</b> button. Give it a name (like “my-agent”) and click <b>Add</b>.', he:'בתפריט הצד לוחצים <b>API Keys</b>, ואז על הכפתור <b>“Create Key”</b>. נותנים שם (למשל “my-agent”) ולוחצים <b>Add</b>.'},\n648\t        shot:null,\n649\t        ok:{en:'A window opens showing a long key that starts with <code>sk-ant-</code>.', he:'נפתח חלון עם מפתח ארוך שמתחיל ב-<code>sk-ant-</code>.'},\n650\t        stuck:{en:'Don’t see “API Keys”? Click the gear / Settings icon next to your account name, it’s in there.', he:'לא רואה “API Keys”? לחץ על גלגל השיניים / Settings ליד שם החשבון, זה שם.'}\n651\t      },\n652\t      {\n653\t        do:{en:'Click <b>Copy</b> and paste the key somewhere safe (a note or document). You only see it once.', he:'לוחצים <b>Copy</b> ומדביקים את המפתח במקום בטוח (פתק או מסמך). רואים אותו פעם אחת בלבד.'},\n654\t        shot:null,\n655\t        ok:{en:'Your key is saved, starting with <code>sk-ant-</code>. The installer will ask for it in the next step.', he:'המפתח שמור אצלך, מתחיל ב-<code>sk-ant-</code>. המתקין יבקש אותו בשלב הבא.'},\n656\t        stuck:{en:'Closed it before copying? No problem, just create a new key. You can always make another.', he:'סגרת לפני שהעתקת? אין בעיה, פשוט צור מפתח חדש. אפשר תמיד.'}\n657\t      }\n658\t    ],\n659\t    note:{en:'Note: the account is free, but the AI is pay-as-you-go. With no balance the agent simply won’t answer, so load a small amount first (even $5 is enough to start).', he:'שימו לב: החשבון חינם, אבל ה-AI בתשלום לפי שימוש. בלי יתרה הסוכן פשוט לא יענה, לכן טוענים סכום קטן מראש (אפילו 5$ מספיקים להתחלה).'}\n660\t  },\n661\t  {\n662\t    phase:'install', status:'ready', owner:'auto',\n663\t    opener:{en:'In this step the agent gets installed on your server. One command downloads NanoClaw and runs an installer that sets up Node, Docker, and the agent container entirely on its own. You paste once and press Enter, it handles everything.', he:'בשלב הזה הסוכן מותקן על השרת שלך. פקודה אחת מורידה את NanoClaw ומפעילה מתקין שמגדיר את Node, Docker וקונטיינר הסוכן לגמרי לבד. מדביקים פעם אחת ולוחצים Enter, הוא מטפל בכל השאר.'},\n664\t    title:{en:'Install the agent on your server', he:'מתקינים את הסוכן על השרת'},\n665\t    what:{\n666\t      en:'This is the magic of NanoClaw: one command that installs everything for you. You paste one line into the server terminal and the smart installer handles the rest. Before you paste: the terminal is the black window from the previous step. You interact in three ways here: (a) some things I write for you to copy and paste, (b) some I show as a screenshot, (c) some you answer by selecting with the ↑/↓ arrow keys, then Enter to confirm.',\n667\t      he:'זה הקסם של נאנו-קלו: פקודה אחת שמתקינה את הכל בשבילך. מדביקים שורה אחת בטרמינל והמתקין דואג לכל השאר. לפני שמדביקים: הטרמינל הוא החלון השחור מהשלב הקודם. יש כאן שלוש דרכי אינטראקציה: (א) חלק אני כותב לך להעתיק-להדביק, (ב) חלק מראה בצילום מסך, (ג) חלק עונים על ידי בחירה במקשי החצים ↑/↓ ואז Enter.'\n668\t    },\n669\t    callout:{en:\"No need to understand the command, just copy, paste, and hit Enter.\", he:\"אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter.\"},\n670\t    todo:{\n671\t      en:['Paste into the terminal: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','The installer runs on its own, it installs every component (a few minutes).','When it asks, paste the Anthropic key from the previous step.','That’s it, it builds your agent and gets it ready to launch.'],\n672\t      he:['מדביקים בטרמינל: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','המתקין רץ לבד, מתקין כל רכיב שצריך (כמה דקות).','כשהוא מבקש, מדביקים את מפתח ה-Anthropic מהשלב הקודם.','זהו, הוא בונה את הסוכן ומכין אותו להפעלה.']\n673\t    },\n674\t    micro:[\n675\t      {\n676\t        do:{en:'Make sure you’re in the black terminal window from the previous step, the one showing a <code>root@...:~#</code> prompt.', he:'מוודאים שאתה בחלון הטרמינל השחור מהשלב הקודם, זה שמראה שורת פקודה <code>root@...:~#</code>.'},\n677\t        shot:null,\n678\t        ok:{en:'The cursor is blinking next to the <code>#</code> prompt, ready for you to type.', he:'הסמן מהבהב ליד הסימן <code>#</code>, מוכן שתקליד.'},\n679\t        stuck:{en:'Closed the Console? Go back to your server in DigitalOcean and click “Console” again.', he:'סגרת את ה-Console? חזור לשרת ב-DigitalOcean ולחץ שוב על “Console”.'}\n680\t      },\n681\t      {\n682\t        cmd:\"git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh\",\n683\t        do:{en:'Copy this exact line, paste it into the terminal (right-click → Paste, or Ctrl+Shift+V), and press <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>', he:'מעתיקים את השורה הזו בדיוק, מדביקים בטרמינל (קליק ימני → Paste, או Ctrl+Shift+V), ולוחצים <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>'},\n684\t        shot:null,\n685\t        ok:{en:'Text starts scrolling by, it’s installing. Don’t close the window.', he:'טקסט מתחיל לזרום על המסך, זה מתקין. אל תסגור את החלון.'},\n686\t        stuck:{en:'You don’t need to understand the text flying by, that’s normal. If it ever stops with an error, the installer tries to fix itself; just give it a moment.', he:'אתה לא צריך להבין את הטקסט שרץ, זה נורמלי. אם זה נעצר עם שגיאה, המתקין מנסה לתקן את עצמו; פשוט תן לו רגע.'}\n687\t      },\n688\t      {\n689\t        do:{en:'⚠️ Right at the start it <b>will</b> stop and warn <i>“you are running as root”</i>, then ask <code>Choose [1/2]</code>. <b>Type <code>2</code> and press Enter</b> to continue. Important: don’t just press Enter on its own, the default is option 1, which stops the install and dumps a wall of commands. Type the <b>2</b> first.', he:'⚠️ ממש בהתחלה הוא <b>יעצור</b> ויזהיר <i>“you are running as root”</i>, ואז ישאל <code>Choose [1/2]</code>. <b>מקלידים <code>2</code> ולוחצים Enter</b> כדי להמשיך. חשוב: אל תלחץ Enter לבד, ברירת המחדל היא אפשרות 1, שעוצרת את ההתקנה ושופכת קיר של פקודות. הקלד קודם <b>2</b>.'},\n690\t        shot:'shots/term-5-root.png',\n691\t        ok:{en:'It accepts your choice and the installation keeps going.', he:'הוא מקבל את הבחירה וההתקנה ממשיכה.'},\n692\t        stuck:{en:'See a different warning asking “Try anyway? [y/N]” about memory or Google Cloud? That means the server is too small or on Google Cloud, stop, and use a 4 GB DigitalOcean machine instead (see the server step).', he:'רואה אזהרה אחרת “Try anyway? [y/N]” על זיכרון או Google Cloud? סימן שהשרת קטן מדי או על Google Cloud, עצור, והשתמש במכונה של 4GB ב-DigitalOcean (ראה שלב השרת).'}\n693\t      },\n694\t      {\n695\t        do:{en:'Next it asks <i>“How would you like to begin?”</i> with two options. Pick <b>Standard setup</b> (use the arrow keys if needed, then Enter). It’s the guided path that does everything for you, Advanced is for developers and you don’t want it.', he:'אחר כך הוא שואל <i>“How would you like to begin?”</i> עם שתי אפשרויות. בוחרים <b>Standard setup</b> (במקשי החצים אם צריך, ואז Enter). זה המסלול המודרך שעושה הכל בשבילך, Advanced מיועד למפתחים ואתה לא רוצה אותו.'},\n696\t        shot:'shots/term-5-begin.png',\n697\t        ok:{en:'It runs a quick system check and says something like <code>Your system looks good</code>.', he:'הוא מריץ בדיקת מערכת קצרה ואומר משהו כמו <code>Your system looks good</code>.'},\n698\t        stuck:{en:'Picked Advanced by mistake? No drama, press <b>Ctrl+C</b> to stop, then run the same line again (<code>cd nanoclaw && bash nanoclaw.sh</code>) and choose Standard this time.', he:'בחרת Advanced בטעות? לא נורא, לוחצים <b>Ctrl+C</b> כדי לעצור, ואז מריצים שוב את אותה שורה (<code>cd nanoclaw && bash nanoclaw.sh</code>) ובוחרים Standard הפעם.'}\n699\t      },\n700\t      {\n701\t        do:{en:'It says it’s <b>preparing your assistant’s sandbox</b>, this is the longest part, about <b>3–10 minutes</b> on a fresh machine. Just wait; let it run.', he:'הוא אומר שהוא <b>מכין את ה-sandbox של הסוכן</b>, זה החלק הארוך ביותר, בערך <b>3–10 דקות</b> במכונה חדשה. פשוט מחכים ונותנים לו לרוץ.'},\n702\t        shot:'shots/term-5-sandbox.png',\n703\t        ok:{en:'It prints <code>Sandbox ready.</code> and moves on by itself.', he:'הוא מדפיס <code>Sandbox ready.</code> וממשיך לבד.'},\n704\t        stuck:{en:'As long as the spinner keeps ticking the seconds, it’s working, don’t touch it. A first build really can take up to 10 minutes.', he:'כל עוד הספינר ממשיך לספור שניות, זה עובד, אל תיגע. בנייה ראשונה באמת יכולה לקחת עד 10 דקות.'}\n705\t      },\n706\t      {\n707\t        do:{en:'It may ask <i>“Which agent runtime?”</i> and offer <b>Claude</b> (the default) or Codex. Pick <b>Claude</b> and press <b>Enter</b>. That’s the brain you set up the key for.', he:'ייתכן שהוא ישאל <i>“Which agent runtime?”</i> ויציע <b>Claude</b> (ברירת המחדל) או Codex. בוחרים <b>Claude</b> ולוחצים <b>Enter</b>. זה ה\"מוח\" שבשבילו הכנת את המפתח.'},\n708\t        shot:null,\n709\t        ok:{en:'It accepts Claude and moves to connecting your key.', he:'הוא מקבל את Claude ועובר לחיבור המפתח שלך.'},\n710\t        stuck:{en:'Didn’t see this question at all? That’s fine, on some versions Claude is chosen automatically and it skips straight to the key.', he:'לא ראית את השאלה הזו בכלל? בסדר גמור, בחלק מהגרסאות Claude נבחר אוטומטית והוא מדלג ישר למפתח.'}\n711\t      },\n712\t      {\n713\t        do:{en:'It asks <i>“How would you like to connect to Claude?”</i> with a short menu. Use the arrow keys to highlight <b>“Paste an Anthropic API key”</b> (not “Sign in with subscription”, not “Paste OAuth token”), press <b>Enter</b>, then paste the <code>sk-ant-</code> key you saved earlier and press <b>Enter</b> again.', he:'הוא שואל <i>“How would you like to connect to Claude?”</i> עם תפריט קצר. בעזרת מקשי החצים מסמנים <b>“Paste an Anthropic API key”</b> (לא “Sign in with subscription”, לא “Paste OAuth token”), לוחצים <b>Enter</b>, ואז מדביקים את המפתח <code>sk-ant-</code> ששמרת קודם ולוחצים <b>Enter</b> שוב.'},\n714\t        shot:'shots/term-5-connect.png',\n715\t        ok:{en:'It prints <code>Claude account connected.</code> and continues.', he:'הוא מדפיס <code>Claude account connected.</code> וממשיך.'},\n716\t        stuck:{en:'Pasting doesn’t show the key? That’s a security feature, it’s there. If it says the token “looks truncated”, make the terminal window wider and paste again so the key fits on one line.', he:'ההדבקה לא מציגה את המפתח? זו תכונת אבטחה, הוא שם. אם כתוב שהטוקן “looks truncated”, הרחב את חלון הטרמינל והדבק שוב כדי שהמפתח ייכנס בשורה אחת.'}\n717\t      },\n718\t      {\n719\t        do:{en:'It asks <i>“What should your assistant call you?”</i>. Type your <b>name</b> and press <b>Enter</b>.', he:'הוא שואל <i>“What should your assistant call you?”</i>. מקלידים את <b>השם</b> שלך ולוחצים <b>Enter</b>.'},\n720\t        shot:null,\n721\t        ok:{en:'It then runs a quick self-test (“ping/pong”) while the agent wakes up for the first time.', he:'אז הוא מריץ בדיקה עצמית קצרה (“ping/pong”) בזמן שהסוכן מתעורר בפעם הראשונה.'},\n722\t        stuck:{en:'If it asks “What next?”, choose <b>Continue with setup</b>.', he:'אם הוא שואל “What next?”, בחר <b>Continue with setup</b>.'}\n723\t      },\n724\t      {\n725\t        edge:true, do:{en:'⏳ On a brand-new machine the self-test can take 30–60 seconds, or even time out the first time. <b>That’s normal, not a failure.</b> If the installer offers to install a helper (Claude) to check things, choose <b>Yes</b>. If it then needs you to sign in, it shows a <b>link</b> (with “press c to copy”). Open that link in your browser, sign in, click <b>Authorize</b>, copy the code it gives you, return to the Console, <b>right-click → Paste</b>, and press <b>Enter</b>.', he:'⏳ במכונה חדשה לגמרי הבדיקה יכולה לקחת 30–60 שניות, ולפעמים אפילו נגמר לה הזמן בפעם הראשונה. <b>זה נורמלי, לא תקלה.</b> אם המתקין מציע להתקין עוזר (Claude) כדי לבדוק, בוחרים <b>Yes</b>. אם הוא צריך שתתחבר, הוא מציג <b>קישור</b> (עם “press c to copy”). פותחים את הקישור בדפדפן, מתחברים, לוחצים <b>Authorize</b>, מעתיקים את הקוד שהוא נותן, חוזרים ל-Console, <b>קליק ימני → Paste</b>, ולוחצים <b>Enter</b>.'},\n726\t        shot:null,\n727\t        ok:{en:'It finishes signing in and continues on its own. It may ask you to sign in a <b>second time</b> with broader permissions, just do the exact same thing.', he:'הוא מסיים להתחבר וממשיך לבד. ייתכן שהוא יבקש להתחבר <b>פעם שנייה</b> עם הרשאות רחבות יותר, פשוט עושים בדיוק אותו דבר.'},\n728\t        stuck:{en:'When it finishes and says something like “type /exit to resume”, type <code>/exit</code> (<b>with the slash</b>, not just “exit”) and press Enter to continue setup.', he:'כשהוא מסיים ואומר משהו כמו “type /exit to resume”, מקלידים <code>/exit</code> (<b>עם הלוכסן</b>, לא רק “exit”) ולוחצים Enter כדי להמשיך בהתקנה.'}\n729\t      },\n730\t      {\n731\t        cmd:\"Asia/Jerusalem\",\n732\t        do:{en:'It asks about your <b>timezone</b> (“Your system reports UTC, is that right, or are you somewhere else?”). Choose <b>“I’m somewhere else”</b>, then when it asks <i>“Where are you?”</i>, type your timezone and press Enter. In Israel, copy exactly:<br><code>Asia/Jerusalem</code>', he:'הוא שואל על <b>אזור הזמן</b> (“Your system reports UTC, is that right, or are you somewhere else?”). בוחרים <b>“I’m somewhere else”</b>, ואז כשהוא שואל <i>“Where are you?”</i> מקלידים את אזור הזמן ולוחצים Enter. בישראל, מעתיקים בדיוק:<br><code>Asia/Jerusalem</code>'},\n733\t        shot:null,\n734\t        ok:{en:'It prints <code>Timezone set to Asia/Jerusalem</code> and moves on.', he:'הוא מדפיס <code>Timezone set to Asia/Jerusalem</code> וממשיך.'},\n735\t        stuck:{en:'Not in Israel? Type yours in the same <b>Region/City</b> format, e.g. <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.', he:'לא בישראל? הקלד את שלך באותו פורמט <b>Region/City</b>, למשל <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.'}\n736\t      },\n737\t      {\n738\t        do:{en:'Next it will ask to connect a chat app, that’s the following step. When you finish that, the installer shows a final <b>“You’re set”</b> message.', he:'אחר כך הוא יבקש לחבר אפליקציית צ\\'אט, זה השלב הבא. כשתסיים אותו, המתקין יציג הודעת סיום <b>“You’re set”</b>.'},\n739\t        shot:'shots/term-5-set.png',\n740\t        ok:{en:'You see the success message, the hard part is over. Now you’ll go say hello (the last step). One thing worth knowing up front: on a brand-new server the very first message sometimes needs a small nudge before the agent answers, that’s normal, and the last step walks you through the quick 2-minute self-fix if it happens.', he:'אתה רואה את הודעת ההצלחה, החלק הקשה מאחורינו. עכשיו הולכים להגיד שלום (השלב האחרון). דבר אחד ששווה לדעת מראש: בשרת חדש לגמרי, לפעמים ההודעה הראשונה צריכה דחיפה קטנה לפני שהסוכן עונה, זה נורמלי, והשלב האחרון מלווה אותך בתיקון העצמי המהיר של 2 דקות אם זה קורה.'},\n741\t        stuck:{en:'If it ends with “a few things still need your attention”, the installer can launch Claude to diagnose and fix it for you, let it.', he:'אם זה מסתיים ב-“a few things still need your attention”, המתקין יכול להפעיל את Claude כדי לאבחן ולתקן בשבילך, תן לו.'}\n742\t      }\n743\t    ],\n744\t    note:{en:'No need to understand the command, just copy, paste, and hit Enter. The installer explains each step as it goes, and if it gets stuck it tries to solve it on its own.', he:'אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter. המתקין מסביר כל שלב תוך כדי, ואם הוא נתקע הוא מנסה לפתור לבד.'}\n745\t  },\n746\t  {\n747\t    phase:'connect', status:'ready', owner:'you',\n748\t    title:{en:'Connect your chat app', he:'חיבור אפליקציית הצ\\'אט'},\n749\t    what:{\n750\t      en:'This is how you will actually talk to your agent. NanoClaw can connect to Telegram, Slack, WhatsApp, and more. Our recommendation: start with Telegram first, because with Telegram you do NOT need a phone number. In this guide I show the Telegram setup. If you do not have Telegram Desktop yet, install it now: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.',\n751\t      he:'כך תדבר עם הסוכן בפועל. NanoClaw יכול להתחבר לטלגרם, Slack, וואטסאפ ועוד. ההמלצה שלנו: להתחיל עם טלגרם קודם, כי עם טלגרם לא צריך מספר טלפון. במדריך זה מראים את החיבור לטלגרם. אם עדיין אין לך Telegram Desktop, התקן עכשיו: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.'\n752\t    },\n753\t    callout:{en:\"Sounds technical, but it's just copy, paste, and click.\", he:\"זה נשמע טכני אבל זה רק העתק-הדבק וללחוץ.\"},\n754\t    todo:{\n755\t      en:['In Telegram, open a chat with <code>@BotFather</code> and create a new bot.','It gives you a token (a line of code), copy it.','Paste it into the installer when it asks, and your bot is connected.'],\n756\t      he:['בטלגרם, פותחים צ\\'אט עם <code>@BotFather</code> ויוצרים בוט חדש.','הוא נותן לך טוקן (שורת קוד), מעתיקים אותו.','מדביקים אותו למתקין כשהוא מבקש, והבוט מחובר.']\n757\t    },\n758\t    micro:[\n759\t      {\n760\t        do:{en:'Do this in the <b>Telegram app on your phone or desktop</b>, not in a new browser tab. ⚠️ Important: leave the server Console tab open and don’t switch away from it for too long, the browser Console disconnects if you leave it in the background. In Telegram’s <b>search bar at the very top</b>, type <code>@BotFather</code> and tap the result with a <b>blue verified checkmark</b>.', he:'עושים את זה ב<b>אפליקציית טלגרם בטלפון או במחשב</b>, לא בטאב חדש בדפדפן. ⚠️ חשוב: השאר את טאב ה-Console של השרת פתוח ואל תעבור ממנו לזמן רב, ה-Console בדפדפן מתנתק אם משאירים אותו ברקע. בשורת החיפוש של טלגרם למעלה מקלידים <code>@BotFather</code> ולוחצים על התוצאה עם <b>הסימן הכחול המאומת</b>.'},\n761\t        cmd:'@BotFather',\n762\t        shot:null,\n763\t        ok:{en:'A chat opens with \"BotFather\", with a blue checkmark next to the name.', he:'נפתח צ\\'אט עם “BotFather”, עם וי כחול ליד השם.'},\n764\t        stuck:{en:'Console says “Disconnected” when you come back? No harm done, just click <b>Reload</b> and, if needed, re-run <code>cd nanoclaw && bash nanoclaw.sh</code>, it picks up where it left off (fast, since the heavy parts are already built). Several BotFather results? Pick the one with the blue verified badge, that’s the only official one.', he:'ה-Console כתוב בו “Disconnected” כשחזרת? לא נורא, פשוט לוחצים <b>Reload</b> ואם צריך מריצים שוב <code>cd nanoclaw && bash nanoclaw.sh</code>, הוא ממשיך מאיפה שעצר (מהר, כי החלקים הכבדים כבר בנויים). כמה תוצאות BotFather? בחר את זו עם הוי הכחול המאומת, זו היחידה הרשמית.'}\n765\t      },\n766\t      {\n767\t        do:{en:'At the bottom message box, type <code>/newbot</code> and send it.', he:'בתיבת ההודעה למטה מקלידים <code>/newbot</code> ושולחים.'},\n768\t        cmd:'/newbot',\n769\t        shot:null,\n770\t        ok:{en:'BotFather replies and asks for a name for your bot.', he:'BotFather עונה ומבקש שם לבוט שלך.'}\n771\t      },\n772\t      {\n773\t        do:{en:'Send a <b>name</b> (anything, e.g. “My Agent”). Then send a <b>username</b> that must end in <code>bot</code> (e.g. <code>myagent_bot</code>).', he:'שולחים <b>שם</b> (כל דבר, למשל “הסוכן שלי”). אחר כך שולחים <b>שם משתמש</b> שחייב להסתיים ב-<code>bot</code> (למשל <code>myagent_bot</code>).'},\n774\t        shot:null,\n775\t        ok:{en:'BotFather confirms and sends a message containing your token.', he:'BotFather מאשר ושולח הודעה שמכילה את הטוקן שלך.'},\n776\t        stuck:{en:'“Username is already taken”? Just try another one, add a number or word before “bot”.', he:'“שם המשתמש כבר תפוס”? פשוט נסה אחר, הוסף מספר או מילה לפני “bot”.'}\n777\t      },\n778\t      {\n779\t        do:{en:'In that message, <b>copy the WHOLE token</b>, a long line that looks like <code>123456789:AAH...</code>. It has two parts: the <b>numbers</b>, a <b>colon</b> <code>:</code>, then letters. You need <b>all of it</b>, including the numbers before the colon. On a phone, long-press the line and tap Copy.', he:'בהודעה הזו <b>מעתיקים את כל הטוקן</b>, שורה ארוכה שנראית כמו <code>123456789:AAH...</code>. יש לו שני חלקים: <b>מספרים</b>, <b>נקודתיים</b> <code>:</code>, ואז אותיות. צריך את <b>הכל</b>, כולל המספרים שלפני הנקודתיים. בנייד, לחיצה ארוכה על השורה ואז Copy.'},\n780\t        shot:'shots/tg-botfather.png',\n781\t        ok:{en:'The token is copied to your clipboard.', he:'הטוקן הועתק.'},\n782\t        stuck:{en:'Easy mistake: copying only the part <i>after</i> the colon. The token must include the numbers and the <code>:</code> at the start, or the installer rejects it. The token is the line right after “Use this token to access the HTTP API”.', he:'טעות נפוצה: להעתיק רק את החלק <i>אחרי</i> הנקודתיים. הטוקן חייב לכלול את המספרים ואת ה-<code>:</code> בהתחלה, אחרת המתקין דוחה אותו. הטוקן הוא השורה מיד אחרי “Use this token to access the HTTP API”.'}\n783\t      },\n784\t      {\n785\t        do:{en:'Go back to the installer in your server terminal. When it asks for your Telegram token, <b>paste it and press Enter</b>.', he:'חוזרים למתקין בטרמינל של השרת. כשהוא מבקש את טוקן הטלגרם, <b>מדביקים ולוחצים Enter</b>.'},\n786\t        shot:'shots/tg-code.png',\n787\t        ok:{en:'It finds your bot (“Found your bot: @yourbot”) and shows a short <b>secret code</b> on screen.', he:'הוא מוצא את הבוט שלך (“Found your bot: @yourbot”) ומציג <b>קוד סודי</b> קצר על המסך.'},\n788\t        stuck:{en:'“Telegram didn’t accept that token”? Copy it again from BotFather, it’s easy to miss a character, and paste once more.', he:'“Telegram didn’t accept that token”? העתק אותו שוב מ-BotFather, קל לפספס תו, והדבק עוד פעם.'}\n789\t      },\n790\t      {\n791\t        do:{en:'Open the chat with <b>your own bot</b> in Telegram (search its <code>@username</code>) and <b>send it that secret code</b> as a message.', he:'פותחים בטלגרם את הצ\\'אט עם <b>הבוט שלך</b> (מחפשים את ה-<code>@username</code> שלו) ו<b>שולחים לו את הקוד הסודי</b> כהודעה.'},\n792\t        shot:'shots/tg-pair.png',\n793\t        ok:{en:'The installer prints <code>Telegram paired.</code>, then asks what to name your assistant (default <b>Nano</b>), type a name or just press Enter.', he:'המתקין מדפיס <code>Telegram paired.</code>, ואז שואל איך לקרוא לסוכן (ברירת מחדל <b>Nano</b>), מקלידים שם או פשוט לוחצים Enter.'},\n794\t        stuck:{en:'Sent it and nothing happened? Make sure you sent the code to <i>your</i> bot (not to BotFather), exactly as shown. A wrong code just lets you try again; an expired one is replaced automatically.', he:'שלחת וכלום לא קרה? ודא ששלחת את הקוד ל<i>בוט שלך</i> (לא ל-BotFather), בדיוק כמו שמופיע. קוד שגוי פשוט מאפשר לנסות שוב; קוד שפג תוקפו מוחלף אוטומטית.'}\n795\t      }\n796\t    ],\n797\t    note:{en:'Prefer WhatsApp? Possible, but it needs a separate phone number. Tip: turn on WhatsApp Business as a second line on the same phone. Telegram is simpler to start with.', he:'מעדיף וואטסאפ? אפשר, אבל הוא דורש מספר טלפון נפרד. טיפ: הפעל WhatsApp Business כקו שני על אותו טלפון. טלגרם פשוט יותר להתחלה.'}\n798\t  },\n799\t  {\n800\t    phase:'launch', status:'ready', owner:'you',\n801\t    openWhat:true,\n802\t    title:{en:'Say hello 👋', he:'תגיד שלום 👋'},\n803\t    what:{\n804\t      en:'Your agent is alive. Open Telegram, send it a message, and watch it reply. You don’t need to know anything else, the moment you say hi, it greets you and gives you a short guided tour of what it can do. Tip: if it ever explains something too technically, just tell it “I have no technical background, explain simply”, and it will. No commands to memorize, just talk to it like a person. From here it’s yours, and it learns and grows together with you.',\n805\t      he:'הסוכן חי. פותחים את טלגרם, שולחים לו הודעה, ורואים אותו עונה. אתה לא צריך לדעת שום דבר נוסף, ברגע שתגיד היי, הוא יקבל אותך ויעשה לך סיור קצר ומודרך על מה שהוא יכול לעשות. טיפ: אם הוא מסביר משהו טכני מדי, פשוט תגיד לו “אין לי רקע טכני, תסביר בפשטות”, והוא יעשה את זה. אין פקודות לזכור, פשוט מדברים אתו כמו עם בנאדם. מכאן זה שלך, והוא לומד וייבנה יחד אתך.'\n806\t    },\n807\t    todo:{\n808\t      en:['Open Telegram and find your new bot.','Send <b>“Hi”</b>.','It replies, and greets you with a short tour. 🎉','No reply within a minute? A normal first-boot hiccup, the built-in 2-minute self-fix below handles it.'],\n809\t      he:['פותחים טלגרם ומוצאים את הבוט החדש שלך.','שולחים <b>\"היי\"</b>.','הוא עונה, ומקבל אותך עם סיור קצר. 🎉','אין תשובה תוך דקה? תקלת אתחול ראשונה רגילה, התיקון העצמי של 2 דקות למטה פותר אותה.']\n810\t    },\n811\t    micro:[\n812\t      {\n813\t        do:{en:'Open Telegram and search for your bot’s <b>username</b>, the one ending in <code>bot</code> that you created.', he:'פותחים טלגרם ומחפשים את <b>שם המשתמש</b> של הבוט, זה שמסתיים ב-<code>bot</code> שיצרת.'},\n814\t        shot:null,\n815\t        ok:{en:'Your bot’s chat opens, with a “Start” button or an empty message box. Tap <b>Start</b> if it’s there.', he:'נפתח הצ\\'אט של הבוט, עם כפתור “Start” או תיבת הודעה ריקה. אם יש כפתור <b>Start</b>, לוחצים עליו.'}\n816\t      },\n817\t      {\n818\t        do:{en:'At the bottom, type <b>“Hi”</b> (or anything you like) and send. Then wait up to a minute, the very first message wakes the agent up.', he:'למטה מקלידים <b>“היי”</b> (או כל דבר) ושולחים. ואז ממתינים עד דקה, ההודעה הראשונה מעירה את הסוכן.'},\n819\t        shot:'shots/tg-hello.png',\n820\t        ok:{en:'Your agent replies and greets you, often with a short guided tour of what it can do. <b>If it replied, you’re done, skip the next step. 🎉</b>', he:'הסוכן עונה ומקבל אותך, לרוב עם סיור קצר על מה שהוא יכול. <b>אם הוא ענה, סיימת, דלג על השלב הבא. 🎉</b>'}\n821\t      },\n822\t      {\n823\t        do:{en:'😌 <b>Didn’t reply within a minute? This is expected on a brand-new server</b>, and your agent is built to fix itself. It’s a 2-minute, one-time fix. Go to your server’s <b>Console</b> and type <code>claude</code>, then Enter. If it asks to trust the folder, choose <b>Yes</b>. Then paste this exactly and press Enter:<br><code>My NanoClaw agent receives Telegram messages but never replies. Containers spawn but the per-session database directory is owned by root while the container runs as a non-root user, so it can’t write. Fix it durably in the code, rebuild, and restart.</code>', he:'😌 <b>לא ענה תוך דקה? זה צפוי בשרת חדש לגמרי</b>, והסוכן בנוי כדי לתקן את עצמו. זה תיקון חד-פעמי של 2 דקות. נכנסים ל-<b>Console</b> של השרת ומקלידים <code>claude</code>, ואז Enter. אם הוא מבקש לאשר את התיקייה (trust), בוחרים <b>Yes</b>. ואז מדביקים בדיוק את זה ולוחצים Enter:<br><code>My NanoClaw agent receives Telegram messages but never replies. Containers spawn but the per-session database directory is owned by root while the container runs as a non-root user, so it can’t write. Fix it durably in the code, rebuild, and restart.</code>'},\n824\t        shot:'shots/sh-selfheal.png',\n825\t        cmd:\"My NanoClaw agent receives Telegram messages but never replies. Containers spawn but the per-session database directory is owned by root while the container runs as a non-root user, so it can't write. Fix it durably in the code, rebuild, and restart.\",\n826\t        ok:{en:'It investigates, applies the fix, rebuilds, and restarts on its own, takes a couple of minutes. Approve each step it suggests (type <code>1</code> / Yes), or press <b>Shift+Tab</b> once to let it run on its own. When it says it’s done, type <code>/exit</code> (<b>with the slash</b>) and press Enter.', he:'הוא בודק, מחיל את התיקון, בונה מחדש ומפעיל מחדש לבד, לוקח כמה דקות. מאשרים כל שלב שהוא מציע (מקלידים <code>1</code> / Yes), או לוחצים <b>Shift+Tab</b> פעם אחת כדי שירוץ לבד. כשהוא אומר שסיים, מקלידים <code>/exit</code> (<b>עם הלוכסן</b>) ולוחצים Enter.'},\n827\t        stuck:{en:'Now go back to Telegram and send <b>“Hi”</b> again, this time it replies. If it still doesn’t after the fix finished, give it one more minute (the service is restarting), then try once more.', he:'עכשיו חוזרים לטלגרם ושולחים <b>“היי”</b> שוב, הפעם הוא עונה. אם עדיין לא אחרי שהתיקון הסתיים, תן לו עוד דקה (השירות עולה מחדש), ונסה שוב.'}\n828\t      }\n829\t    ],\n830\t    note:{en:'What it costs: roughly $5–12/month for the cloud server, plus your Anthropic usage (pay-as-you-go). From here the agent is fully yours. Stuck on something? Write to me, but you’re not dependent on anyone to keep it running.', he:'כמה זה עולה: בערך 5–12$ לחודש על שרת הענן, ובנוסף השימוש ב-Anthropic (לפי שימוש). מכאן הסוכן שלך לגמרי. נתקעת במשהו? כתוב לי, אבל אתה לא תלוי באף אחד כדי שהוא ימשיך לרוץ.'}\n831\t  },\n832\t  {\n833\t    phase:'launch', status:'ready', owner:'auto',\n834\t    openWhat:true,\n835\t    title:{en:'Onboarding: your first chat', he:'היכרות ראשונה'},\n836\t    what:{\n837\t      en:'The moment you say hi, your agent introduces itself and takes you on a tour. No commands to memorize: it guides you. This section shows what to expect in that first conversation.',\n838\t      he:'ברגע שאמרת היי, הסוכן מציג את עצמו ולוקח אותך לסיור. אין פקודות לזכור: הוא מוביל. חלק זה מראה מה לצפות בשיחה הראשונה.'\n839\t    },\n840\t    micro:[\n841\t      {\n842\t        do:{en:'After your agent replies to your first message it will greet you and offer a choice: <b>\"Want a quick tour of what I can do, or do you already have something to jump into?\"</b> You can choose the tour, or just start with a task.', he:'אחרי שהסוכן עונה להודעה הראשונה שלך, הוא יקבל אותך ויציע בחירה: <b>\"רוצה סיור קצר על מה שאני יכול לעשות, או שכבר יש לך משהו לקפוץ אליו?\"</b> אפשר לבחור את הסיור, או פשוט להתחיל עם משימה.'},\n843\t        shot:'shots/tg-onboard.png',\n844\t        ok:{en:'Your agent replied and is waiting for your choice or first request.', he:'הסוכן ענה ומחכה לבחירתך או לבקשה הראשונה שלך.'},\n845\t        stuck:{en:'Agent did not reply? Jump back to the previous step for the two-minute self-fix.', he:'הסוכן לא ענה? חזור לשלב הקודם לתיקון העצמי של שתי דקות.'}\n846\t      },\n847\t      {\n848\t        do:{en:'If you choose the tour, the agent sends a series of short capability cards one at a time, each ending with <b>\"Continue?\"</b> so you set the pace. Memory, scheduled tasks, web search, building things, sending files, and more.', he:'אם תבחר את הסיור, הסוכן שולח סדרה של כרטיסי יכולות קצרים, אחד אחד, כל אחד מסתיים ב-<b>\"ממשיכים?\"</b> כדי שאתה תקבע את הקצב. זיכרון, משימות מתוזמנות, חיפוש ברשת, בניית דברים, שליחת קבצים ועוד.'},\n849\t        shot:null,\n850\t        ok:{en:'You read the capability cards. At the end the agent invites you to share what you do or hand it a small task.', he:'קראת את כרטיסי היכולות. בסוף הסוכן מזמין אותך לספר לו מה אתה עושה או לתת לו משימה קטנה.'}\n851\t      },\n852\t      {\n853\t        do:{en:'One tip worth knowing: if the agent ever explains something too technically, just write <b>\"I have no technical background, explain simply\"</b> and it will recalibrate its whole style for you, for the rest of the session.', he:'טיפ ששווה לדעת: אם הסוכן אי פעם מסביר משהו טכני מדי, פשוט כתוב <b>\"אין לי רקע טכני, תסביר בפשטות\"</b> והוא יכוון מחדש את כל הסגנון שלו בשבילך, לשאר השיחה.'},\n854\t        shot:null,\n855\t        ok:{en:'The agent acknowledged and adapted its tone. From here it speaks your language.', he:'הסוכן הבין והתאים את הטון שלו. מכאן הוא מדבר בשפה שלך.'}\n856\t      }\n857\t    ],\n858\t    note:{en:'No commands to memorize. The agent onboards you itself, and you can always redirect it: \"give me a task to try\" or \"show me what you can do with my calendar.\" It adapts.', he:'אין פקודות לזכור. הסוכן עצמו מכניס אותך לעניינים, ותמיד אפשר להפנות אותו: \"תן לי משימה לנסות\" או \"הראה לי מה אתה יכול לעשות עם היומן שלי.\" הוא מתאים את עצמו.'}\n859\t  },\n860\t];\n861\t"}]},"uuid":"1975b2b0-6e6d-4bb6-9fd4-c6ce1f36dfc7","timestamp":"2026-06-16T05:40:34.674Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/agent/index.html","content":"const STEPS = [\n  {\n    phase:'prepare', status:'ready', owner:'you',\n    openWhat:true,\n    precheckCollapsed:true,\n    opener:{en:'In about 30 minutes you will have your own AI agent. It talks with you, remembers you, and works for you in the background. No technical background needed, you are not alone. I am with you step by step.', he:'בעוד כחצי שעה יהיה לך סוכן AI משלך. מדבר איתך, זוכר אותך, עובד בשבילך ברקע. בלי רקע טכני, בלי לבד. אני איתך צעד-צעד.'},\n    title:{en:'What’s waiting for you here', he:'מה מחכה לך כאן'},\n    what:{\n      en:'In about 30–45 minutes you will have your own AI agent in your messaging app. Here is how this guide works: every word in blue is a glossary term, tap it to learn more. Each step opens with a “What happens here” box explaining the goal. Stuck? Tap “Stuck here? The fix is inside” to see what can happen. Every command comes with a copy button so you never type anything by hand.',\n      he:'כך המדריך הזה עובד: כל מילה בכחול היא מונח שאפשר ללחוץ עליו ולהבין. כל שלב נפתח בתיבת מה קורה כאן שמסבירה את המטרה. נתקעת? לחץ על נתקעת כאן? הפתרון בפנים. כל פקודה מגיעה עם כפתור העתק, כך שלא צריך להקליד שום דבר ביד.'\n    },\n    todo:{\n      en:['A small <b>cloud server</b> for your agent to live on, always on.','An <b>Anthropic</b> account with a small credit balance, the AI brain.','A messaging app to talk to it (Telegram, free).','About 30–45 minutes and a coffee ☕'],\n      he:['שרת בענן קטן שיחיה הסוכן תמיד דלוק.','חשבון <b>Anthropic</b> עם יתרת קרדיט קטנה, זה המוח של הסוכן.','אפליקציית הודעות לדבר אתו (טלגרם, חינם).','בערך 30–45 דקות וכוס קפה ☕']\n    },\n    callout:{en:\"NanoClaw itself is free, open source, for everyone. You only pay for the external providers: the cloud server (hosting) and Anthropic (the AI brain).\", he:\"NanoClaw עצמו חינמי לגמרי, קוד פתוח, לכולם. אתה משלם רק לספקי המשנה: שרת הענן (אחסון) ו-Anthropic (מוח ה-AI).\"},\n    precheck:{\n      title:{en:'Quick check before you start', he:'בדיקה מהירה לפני שמתחילים'},\n      sub:{en:\"Tick each one. Two minutes now and the install goes smooth all the way through.\", he:\"סמן כל אחד, שתי דקות עכשיו, וההתקנה תעבור חלק עד הסוף.\"},\n      glossaryHint:{en:\"Don’t worry about the words, each one is explained with a tap.\", he:\"אל תיבהל מהמילים, כל אחת מוסברת בלחיצה.\"},\n      items:[\n        {en:\"I can use a cloud server with enough RAM for the agent (not the cheapest basic plan).\", he:\"אני יכול להשתמש בשרת ענן עם מספיק זיכרון (לא התוכנית הכי זולה).\"},\n        {en:'I will <b>not</b> use Google Cloud (it blocks the installer). DigitalOcean / Hetzner / exe.dev are fine.', he:'אני <b>לא</b> אשתמש ב-Google Cloud (הוא חוסם את המתקין). DigitalOcean / Hetzner / exe.dev, בסדר גמור.'},\n        {en:'I have a <b>credit card</b> ready for the cloud server (about the cloud server is billed to my own account, not to NanoClaw).', he:'יש לי <b>כרטיס אשראי</b> מוכן לשרת הענן (החיוב ישירות לחשבון שלי, לא ל-NanoClaw).'},\n        {en:\"I'll add a <b>small credit balance</b> to my Anthropic account, without it the agent simply won’t start, so best to top it up a minute ahead and that’s it.\", he:\"אני אטען <b>יתרת קרדיט קטנה</b> לחשבון Anthropic שלי, בלי הקרדיט הסוכן פשוט לא יתחיל, אז כדאי לטעון מראש דקה וזהו.\"},\n        {en:'I have <b>Telegram</b> on my phone (or will install it, it’s free).', he:'יש לי <b>טלגרם</b> בטלפון (או שאתקין, זה חינם).'},\n        {en:'I have <b>30–45 minutes</b> free for this first session.', he:'יש לי <b>30–45 דקות</b> פנויות לישיבה הראשונה הזו.'}\n      ],\n      ready:{en:'You’re ready, let’s go. 🚀', he:'אתה מוכן, קדימה. 🚀'}\n    },\n    bridge:{en:\"From here it gets practical, but I’m with you every step. Every word is explained, and if something gets stuck, write to me.\", he:\"מכאן זה נהיה מעשי, אבל אני אתך בכל צעד. כל מילה מוסברת, ואם משהו נתקע, כתוב לי.\"},\n    note:{en:'Nothing here is locked in: no passwords are kept, every key is yours, and everything is in your name.', he:'אין כאן שום דבר שאי אפשר לבטל: לא נשמרות סיסמאות, כל מפתח שלך, והכל רשום על שמך.'}\n  },\n  {\n    phase:'prepare', status:'ready', owner:'you',\n    openWhat:true,\n    title:{en:'Where will your agent live?', he:'איפה הסוכן יחיה?'},\n    what:{\n      en:\"Your agent can live on a cloud server or on your own computer. Cloud means it stays on 24/7 and runs in a secured, isolated environment, so you can reach it from your phone anywhere, even when your computer is off. This guide covers the cloud path. A local guide may come later if there is enough demand.\",\n      he:\"הסוכן שלך יכול לחיות על שרת ענן או על המחשב שלך. ענן אומר שהוא דולק 24/7, רץ בסביבה מאובטחת ומבודלת, ואפשר לפנות אליו מהנייד בכל מקום, גם כשהמחשב שלך כבוי. המדריך הזה מכסה את מסלול הענן. מדריך מקומי יכול לבוא בהמשך אם יהיה מספיק ביקוש.\"\n    },\n    note:{en:'Tip: in the next step you will pick the cloud server. A standard plan works, and you are billed directly by the provider.', he:'טיפ: בשלב הבא תבחר את שרת הענן. חבילה סטנדרטית עובדת, והחיוב ישירות אליך מספק הענן.'}\n  },\n  {\n    phase:'install', status:'ready', owner:'you',\n    openWhat:true,\n    title:{en:'Set up your cloud server', he:'הקמת שרת הענן'},\n    what:{\n      en:\"Don't let the word server throw you. It's just a small computer you rent, always on, and that's where the agent lives. Only two decisions actually matter here, everything else stays at its default.\",\n      he:\"אל תיבהל מהמילה שרת. זה פשוט מחשב קטן שאתה שוכר, שתמיד דולק, וזה הבית של הסוכן. שתי החלטות בלבד באמת חשובות פה, השאר ברירת מחדל.\"\n    },\n    action:{label:{en:'Open DigitalOcean', he:'פתח את DigitalOcean'}, sub:{en:'digitalocean.com', he:'digitalocean.com'}, url:'https://www.digitalocean.com/'},\n    micro:[\n      {\n        do:{en:'Go to <a href=\"https://www.digitalocean.com/\" target=\"_blank\" rel=\"noopener\">digitalocean.com</a> and click <b>“Sign up”</b> (top right). Register with your email or your Google account, and add a payment card, a 4 GB machine runs roughly $5–12 a month.', he:'נכנסים ל-<a href=\"https://www.digitalocean.com/\" target=\"_blank\" rel=\"noopener\">digitalocean.com</a> ולוחצים <b>“Sign up”</b> (למעלה מימין). נרשמים עם אימייל או חשבון Google, ומוסיפים כרטיס תשלום, מכונה של 4GB עולה בערך 5–12$ לחודש.'},\n        shot:null,\n        ok:{en:'After confirming your email, you land on the DigitalOcean dashboard.', he:'אחרי אישור האימייל, אתה מגיע ללוח הבקרה של DigitalOcean.'},\n        stuck:{en:'Asked to verify your email? Open the message they sent and click the confirmation link.', he:'מבקשים לאמת אימייל? פתח את ההודעה ששלחו ולחץ על קישור האישור.'}\n      },\n      {\n        do:{en:'Click <b>Create → Droplets</b>. Pick <b>Ubuntu</b>, a plan with <b>at least 4 GB RAM</b>, and a region close to you. Then click <b>Create Droplet</b>.', he:'לוחצים <b>Create → Droplets</b>. בוחרים <b>Ubuntu</b>, חבילה עם <b>לפחות 4GB RAM</b>, ואזור קרוב אליך. ואז <b>Create Droplet</b>.'},\n        shot:'shots/do-size.png',\n        ok:{en:'After about a minute your new server appears with its own IP address (like 164.92.20.10).', he:'אחרי כדקה השרת החדש מופיע עם כתובת IP משלו (כמו 164.92.20.10).'},\n        stuck:{en:'Don’t grab the very cheapest 1–2 GB plan, the agent needs ~4 GB and won’t start on less. And skip Google Cloud: it blocks the install (DigitalOcean, Hetzner and exe.dev all work).', he:'אל תיקח את החבילה הכי זולה של 1–2GB, הסוכן צריך בערך 4GB ולא יעלה על פחות. ודלג על Google Cloud: הוא חוסם את ההתקנה (DigitalOcean, Hetzner ו-exe.dev עובדים).'}\n      },\n      {\n        do:{en:'When it asks how to log in, choose a <b>password</b> (the simple path), set one, and write it down somewhere safe.', he:'כשהוא שואל איך להתחבר, בוחרים <b>סיסמה</b> (הדרך הפשוטה), קובעים אותה, ורושמים במקום בטוח.'},\n        shot:null,\n        ok:{en:'The password is set, you’ll use it to log in next.', he:'הסיסמה נקבעה, תשתמש בה כדי להתחבר עכשיו.'},\n        stuck:{en:'Offered SSH keys instead? A password is fine here, it’s simpler and works perfectly.', he:'מציעים לך מפתחות SSH במקום? סיסמא מצוינת כאן, פשוטה יותר ועובדת מצוין.'}\n      },\n      {\n        do:{en:'In the DigitalOcean sidebar on the left click <b>Droplets</b>. Find your server in the list. The status should show <b>active</b>.', he:'בסרגל הצד של DigitalOcean משמאל לוחצים על <b>Droplets</b>. מוצאים את השרת שלך ברשימה. הסטאטוס צריך להיות <b>active</b>.'},\n        shot:'shots/do-droplets.png',\n        ok:{en:'Your server row appears in the Droplets list.', he:'שורת השרת שלך מופיעה ברשימת ה-Droplets.'},\n        stuck:{en:'No Droplet visible? Make sure you are in the right project, or look under All Droplets.', he:'לא רואה את ה-Droplet? ודא שאתה בפרויקט הנכון, או חפש תחת All Droplets.'}\n      },\n      {\n        do:{en:'Click your server name to open its page. Click the <b>Access</b> tab, then click <b>Launch Droplet Console</b>. A black terminal window opens in the browser.', he:'לוחצים על שם השרת שלך כדי לפתוח את העמוד שלו. לוחצים על הכרטיסייה <b>Access</b>, ואז על <b>Launch Droplet Console</b>. נפתח חלון טרמינל שחור בדפדפן.'},\n        shot:'shots/do-access.png',\n        ok:{en:'A black window with a <code>root@...:~#</code> prompt opens right in your browser, no extra software needed.', he:'נפתח חלון שחור עם שורת פקודה <code>root@...:~#</code> ישר בדפדפן, בלי תוכנה נוספת.'},\n        stuck:{en:'Console will not open? Make sure pop-ups are allowed for the site, or click Console again.', he:'ה-Console לא נפתח? ודא שחלונות קופצים מותרים לאתר, או נסה ללחוץ שוב על Console.'}\n      },\n      {\n        do:{en:'On your server’s page click <b>“Console”</b>, a black terminal opens right in your browser, no extra software. Log in as <code>root</code> with the password you set.', he:'בדף של השרת לוחצים <b>“Console”</b>, נפתח טרמינל שחור ישר בדפדפן, בלי תוכנה נוספת. מתחברים בתור <code>root</code> עם הסיסמה שקבעת.'},\n        shot:'shots/do-console.png',\n        ok:{en:'You see a black window with a <code>root@...:~#</code> prompt. This is where the installer will run in the next step.', he:'אתה רואה חלון שחור עם שורת פקודה <code>root@...:~#</code>. כאן ירוץ המתקין בשלב הבא.'},\n        stuck:{en:'Console won’t open? Allow pop-ups for the site, or click Console again, it can take a few seconds.', he:'ה-Console לא נפתח? אפשר חלונות קופצים לאתר, או לחץ Console שוב, זה יכול לקחת כמה שניות.'}\n      }\n    ],\n    note:{en:'This guide uses DigitalOcean specifically, but the same steps work on Hetzner, exe.dev, or any standard VPS. Two things matter: at least a 4 GB machine (the agent will not run on less), and not Google Cloud (it blocks the install). The browser Console means you never have to install or understand SSH.', he:'המדריך הזה עובד עם DigitalOcean ספציפית, אבל אותם שלבים עובדים גם על Hetzner, exe.dev, ועל כל VPS סטנדרטי אחר. שני דברים חשובים: לפחות 4GB זיכרון (הסוכן לא ירוץ על פחות), ולא Google Cloud (הוא חוסם את ההתקנה). ה-Console בדפדפן אומר שאתה אף פעם לא צריך להתקין או להבין SSH.'}\n  },\n  {\n    phase:'install', status:'ready', owner:'you',\n    title:{en:'Your AI key', he:'מפתח ה-AI שלך'},\n    what:{\n      en:'Your agent thinks using Claude by Anthropic. You need one key, like a password that gives your agent access to its “brain”. The installer will ask you for it shortly, so let’s get it ready now.',\n      he:'הסוכן חושב באמצעות Claude של Anthropic. צריך מפתח אחד, כמו סיסמה שנותנת לסוכן גישה ל\"מוח\". המתקין יבקש אותו ממך עוד מעט, אז נכין אותו עכשיו.'\n    },\n    callout:{en:\"Sounds technical, but it's just copy, paste, and click.\", he:\"זה נשמע טכני אבל זה רק העתק-הדבק וללחוץ.\"},\n    todo:{\n      en:['Open an Anthropic account, free to create.','<b>Load a small credit balance</b>, the AI itself costs a little per use.','Go to <b>API Keys</b> and create a new key.','Copy it somewhere safe, the installer asks for it in the next step.'],\n      he:['פותחים חשבון Anthropic, הפתיחה חינם.','<b>טוענים יתרת קרדיט קטנה</b>, ה-AI עצמו עולה מעט לפי שימוש.','נכנסים ל-<b>API Keys</b> ויוצרים מפתח חדש.','מעתיקים למקום בטוח, המתקין יבקש אותו בשלב הבא.']\n    },\n    action:{label:{en:'Open Anthropic Console', he:'פתח את קונסולת Anthropic'}, sub:{en:'console.anthropic.com', he:'console.anthropic.com'}, url:'https://console.anthropic.com/'},\n    micro:[\n      {\n        do:{en:'In your browser’s address bar, open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> and press Enter. The Claude Console login page opens.', he:'בשורת הכתובת של הדפדפן פותחים <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ולוחצים Enter. נפתח דף הכניסה של Claude Console.'},\n        shot:null,\n        ok:{en:'You see the heading “Build with the Claude API” and two ways to sign in, Google or email.', he:'רואים את הכותרת “Build with the Claude API” ושתי דרכים להיכנס, Google או אימייל.'},\n        stuck:{en:'Landed somewhere else? Make sure you open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> directly, with no “www” and no spaces.', he:'הגעת למקום אחר? ודא שאתה פותח <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ישירות, בלי “www” ובלי רווחים.'}\n      },\n      {\n        do:{en:'Easiest path: click <b>“Continue with Google”</b> and pick your Google account. No Google? Type your email, click <b>Continue</b>, and paste the code that arrives in your inbox.', he:'הדרך הקלה: לוחצים <b>“Continue with Google”</b> ובוחרים את חשבון הגוגל שלך. אין גוגל? מקלידים אימייל, לוחצים <b>Continue</b>, ומדביקים את הקוד שמגיע למייל.'},\n        shot:null,\n        ok:{en:'You land on the Console dashboard, with a menu down the left side.', he:'אתה מגיע ללוח הבקרה (Dashboard), עם תפריט בצד.'},\n        stuck:{en:'No email arrived? Check your spam folder, or just use the Google button instead.', he:'לא הגיע מייל? בדוק בתיקיית הספאם, או פשוט השתמש בכפתור של Google.'}\n      },\n      {\n        do:{en:'In the left menu click <b>Billing</b>, then <b>“Add to credit balance”</b>. Choose a small amount (even $5) and enter a card.', he:'בתפריט הצד לוחצים <b>Billing</b>, ואז <b>“Add to credit balance”</b>. בוחרים סכום קטן (אפילו 5$) ומזינים כרטיס.'},\n        shot:null,\n        ok:{en:'At the top you see a Balance with the amount you loaded, for example $5.00.', he:'למעלה מופיע Balance עם הסכום שטענת, למשל $5.00.'},\n        stuck:{en:'Card declined? Try another card. Remember: with no balance the agent simply won’t answer.', he:'הכרטיס נדחה? נסה כרטיס אחר. זכור: בלי יתרה הסוכן פשוט לא יענה.'}\n      },\n      {\n        do:{en:'In the left menu click <b>API Keys</b>, then the <b>“Create Key”</b> button. Give it a name (like “my-agent”) and click <b>Add</b>.', he:'בתפריט הצד לוחצים <b>API Keys</b>, ואז על הכפתור <b>“Create Key”</b>. נותנים שם (למשל “my-agent”) ולוחצים <b>Add</b>.'},\n        shot:null,\n        ok:{en:'A window opens showing a long key that starts with <code>sk-ant-</code>.', he:'נפתח חלון עם מפתח ארוך שמתחיל ב-<code>sk-ant-</code>.'},\n        stuck:{en:'Don’t see “API Keys”? Click the gear / Settings icon next to your account name, it’s in there.', he:'לא רואה “API Keys”? לחץ על גלגל השיניים / Settings ליד שם החשבון, זה שם.'}\n      },\n      {\n        do:{en:'Click <b>Copy</b> and paste the key somewhere safe (a note or document). You only see it once.', he:'לוחצים <b>Copy</b> ומדביקים את המפתח במקום בטוח (פתק או מסמך). רואים אותו פעם אחת בלבד.'},\n        shot:null,\n        ok:{en:'Your key is saved, starting with <code>sk-ant-</code>. The installer will ask for it in the next step.', he:'המפתח שמור אצלך, מתחיל ב-<code>sk-ant-</code>. המתקין יבקש אותו בשלב הבא.'},\n        stuck:{en:'Closed it before copying? No problem, just create a new key. You can always make another.', he:'סגרת לפני שהעתקת? אין בעיה, פשוט צור מפתח חדש. אפשר תמיד.'}\n      }\n    ],\n    note:{en:'Note: the account is free, but the AI is pay-as-you-go. With no balance the agent simply won’t answer, so load a small amount first (even $5 is enough to start).', he:'שימו לב: החשבון חינם, אבל ה-AI בתשלום לפי שימוש. בלי יתרה הסוכן פשוט לא יענה, לכן טוענים סכום קטן מראש (אפילו 5$ מספיקים להתחלה).'}\n  },\n  {\n    phase:'install', status:'ready', owner:'auto',\n    opener:{en:'In this step the agent gets installed on your server. One command downloads NanoClaw and runs an installer that sets up Node, Docker, and the agent container entirely on its own. You paste once and press Enter, it handles everything.', he:'בשלב הזה הסוכן מותקן על השרת שלך. פקודה אחת מורידה את NanoClaw ומפעילה מתקין שמגדיר את Node, Docker וקונטיינר הסוכן לגמרי לבד. מדביקים פעם אחת ולוחצים Enter, הוא מטפל בכל השאר.'},\n    title:{en:'Install the agent on your server', he:'מתקינים את הסוכן על השרת'},\n    what:{\n      en:'This is the magic of NanoClaw: one command that installs everything for you. You paste one line into the server terminal and the smart installer handles the rest. Before you paste: the terminal is the black window from the previous step. You interact in three ways here: (a) some things I write for you to copy and paste, (b) some I show as a screenshot, (c) some you answer by selecting with the ↑/↓ arrow keys, then Enter to confirm.',\n      he:'זה הקסם של נאנו-קלו: פקודה אחת שמתקינה את הכל בשבילך. מדביקים שורה אחת בטרמינל והמתקין דואג לכל השאר. לפני שמדביקים: הטרמינל הוא החלון השחור מהשלב הקודם. יש כאן שלוש דרכי אינטראקציה: (א) חלק אני כותב לך להעתיק-להדביק, (ב) חלק מראה בצילום מסך, (ג) חלק עונים על ידי בחירה במקשי החצים ↑/↓ ואז Enter.'\n    },\n    callout:{en:\"No need to understand the command, just copy, paste, and hit Enter.\", he:\"אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter.\"},\n    todo:{\n      en:['Paste into the terminal: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','The installer runs on its own, it installs every component (a few minutes).','When it asks, paste the Anthropic key from the previous step.','That’s it, it builds your agent and gets it ready to launch.'],\n      he:['מדביקים בטרמינל: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','המתקין רץ לבד, מתקין כל רכיב שצריך (כמה דקות).','כשהוא מבקש, מדביקים את מפתח ה-Anthropic מהשלב הקודם.','זהו, הוא בונה את הסוכן ומכין אותו להפעלה.']\n    },\n    micro:[\n      {\n        do:{en:'Make sure you’re in the black terminal window from the previous step, the one showing a <code>root@...:~#</code> prompt.', he:'מוודאים שאתה בחלון הטרמינל השחור מהשלב הקודם, זה שמראה שורת פקודה <code>root@...:~#</code>.'},\n        shot:null,\n        ok:{en:'The cursor is blinking next to the <code>#</code> prompt, ready for you to type.', he:'הסמן מהבהב ליד הסימן <code>#</code>, מוכן שתקליד.'},\n        stuck:{en:'Closed the Console? Go back to your server in DigitalOcean and click “Console” again.', he:'סגרת את ה-Console? חזור לשרת ב-DigitalOcean ולחץ שוב על “Console”.'}\n      },\n      {\n        cmd:\"git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh\",\n        do:{en:'Copy this exact line, paste it into the terminal (right-click → Paste, or Ctrl+Shift+V), and press <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>', he:'מעתיקים את השורה הזו בדיוק, מדביקים בטרמינל (קליק ימני → Paste, או Ctrl+Shift+V), ולוחצים <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>'},\n        shot:null,\n        ok:{en:'Text starts scrolling by, it’s installing. Don’t close the window.', he:'טקסט מתחיל לזרום על המסך, זה מתקין. אל תסגור את החלון.'},\n        stuck:{en:'You don’t need to understand the text flying by, that’s normal. If it ever stops with an error, the installer tries to fix itself; just give it a moment.', he:'אתה לא צריך להבין את הטקסט שרץ, זה נורמלי. אם זה נעצר עם שגיאה, המתקין מנסה לתקן את עצמו; פשוט תן לו רגע.'}\n      },\n      {\n        do:{en:'⚠️ Right at the start it <b>will</b> stop and warn <i>“you are running as root”</i>, then ask <code>Choose [1/2]</code>. <b>Type <code>2</code> and press Enter</b> to continue. Important: don’t just press Enter on its own, the default is option 1, which stops the install and dumps a wall of commands. Type the <b>2</b> first.', he:'⚠️ ממש בהתחלה הוא <b>יעצור</b> ויזהיר <i>“you are running as root”</i>, ואז ישאל <code>Choose [1/2]</code>. <b>מקלידים <code>2</code> ולוחצים Enter</b> כדי להמשיך. חשוב: אל תלחץ Enter לבד, ברירת המחדל היא אפשרות 1, שעוצרת את ההתקנה ושופכת קיר של פקודות. הקלד קודם <b>2</b>.'},\n        shot:'shots/term-5-root.png',\n        ok:{en:'It accepts your choice and the installation keeps going.', he:'הוא מקבל את הבחירה וההתקנה ממשיכה.'},\n        stuck:{en:'See a different warning asking “Try anyway? [y/N]” about memory or Google Cloud? That means the server is too small or on Google Cloud, stop, and use a 4 GB DigitalOcean machine instead (see the server step).', he:'רואה אזהרה אחרת “Try anyway? [y/N]” על זיכרון או Google Cloud? סימן שהשרת קטן מדי או על Google Cloud, עצור, והשתמש במכונה של 4GB ב-DigitalOcean (ראה שלב השרת).'}\n      },\n      {\n        do:{en:'Next it asks <i>“How would you like to begin?”</i> with two options. Pick <b>Standard setup</b> (use the arrow keys if needed, then Enter). It’s the guided path that does everything for you, Advanced is for developers and you don’t want it.', he:'אחר כך הוא שואל <i>“How would you like to begin?”</i> עם שתי אפשרויות. בוחרים <b>Standard setup</b> (במקשי החצים אם צריך, ואז Enter). זה המסלול המודרך שעושה הכל בשבילך, Advanced מיועד למפתחים ואתה לא רוצה אותו.'},\n        shot:'shots/term-5-begin.png',\n        ok:{en:'It runs a quick system check and says something like <code>Your system looks good</code>.', he:'הוא מריץ בדיקת מערכת קצרה ואומר משהו כמו <code>Your system looks good</code>.'},\n        stuck:{en:'Picked Advanced by mistake? No drama, press <b>Ctrl+C</b> to stop, then run the same line again (<code>cd nanoclaw && bash nanoclaw.sh</code>) and choose Standard this time.', he:'בחרת Advanced בטעות? לא נורא, לוחצים <b>Ctrl+C</b> כדי לעצור, ואז מריצים שוב את אותה שורה (<code>cd nanoclaw && bash nanoclaw.sh</code>) ובוחרים Standard הפעם.'}\n      },\n      {\n        do:{en:'It says it’s <b>preparing your assistant’s sandbox</b>, this is the longest part, about <b>3–10 minutes</b> on a fresh machine. Just wait; let it run.', he:'הוא אומר שהוא <b>מכין את ה-sandbox של הסוכן</b>, זה החלק הארוך ביותר, בערך <b>3–10 דקות</b> במכונה חדשה. פשוט מחכים ונותנים לו לרוץ.'},\n        shot:'shots/term-5-sandbox.png',\n        ok:{en:'It prints <code>Sandbox ready.</code> and moves on by itself.', he:'הוא מדפיס <code>Sandbox ready.</code> וממשיך לבד.'},\n        stuck:{en:'As long as the spinner keeps ticking the seconds, it’s working, don’t touch it. A first build really can take up to 10 minutes.', he:'כל עוד הספינר ממשיך לספור שניות, זה עובד, אל תיגע. בנייה ראשונה באמת יכולה לקחת עד 10 דקות.'}\n      },\n      {\n        do:{en:'It may ask <i>“Which agent runtime?”</i> and offer <b>Claude</b> (the default) or Codex. Pick <b>Claude</b> and press <b>Enter</b>. That’s the brain you set up the key for.', he:'ייתכן שהוא ישאל <i>“Which agent runtime?”</i> ויציע <b>Claude</b> (ברירת המחדל) או Codex. בוחרים <b>Claude</b> ולוחצים <b>Enter</b>. זה ה\"מוח\" שבשבילו הכנת את המפתח.'},\n        shot:null,\n        ok:{en:'It accepts Claude and moves to connecting your key.', he:'הוא מקבל את Claude ועובר לחיבור המפתח שלך.'},\n        stuck:{en:'Didn’t see this question at all? That’s fine, on some versions Claude is chosen automatically and it skips straight to the key.', he:'לא ראית את השאלה הזו בכלל? בסדר גמור, בחלק מהגרסאות Claude נבחר אוטומטית והוא מדלג ישר למפתח.'}\n      },\n      {\n        do:{en:'It asks <i>“How would you like to connect to Claude?”</i> with a short menu. Use the arrow keys to highlight <b>“Paste an Anthropic API key”</b> (not “Sign in with subscription”, not “Paste OAuth token”), press <b>Enter</b>, then paste the <code>sk-ant-</code> key you saved earlier and press <b>Enter</b> again.', he:'הוא שואל <i>“How would you like to connect to Claude?”</i> עם תפריט קצר. בעזרת מקשי החצים מסמנים <b>“Paste an Anthropic API key”</b> (לא “Sign in with subscription”, לא “Paste OAuth token”), לוחצים <b>Enter</b>, ואז מדביקים את המפתח <code>sk-ant-</code> ששמרת קודם ולוחצים <b>Enter</b> שוב.'},\n        shot:'shots/term-5-connect.png',\n        ok:{en:'It prints <code>Claude account connected.</code> and continues.', he:'הוא מדפיס <code>Claude account connected.</code> וממשיך.'},\n        stuck:{en:'Pasting doesn’t show the key? That’s a security feature, it’s there. If it says the token “looks truncated”, make the terminal window wider and paste again so the key fits on one line.', he:'ההדבקה לא מציגה את המפתח? זו תכונת אבטחה, הוא שם. אם כתוב שהטוקן “looks truncated”, הרחב את חלון הטרמינל והדבק שוב כדי שהמפתח ייכנס בשורה אחת.'}\n      },\n      {\n        do:{en:'It asks <i>“What should your assistant call you?”</i>. Type your <b>name</b> and press <b>Enter</b>.', he:'הוא שואל <i>“What should your assistant call you?”</i>. מקלידים את <b>השם</b> שלך ולוחצים <b>Enter</b>.'},\n        shot:null,\n        ok:{en:'It then runs a quick self-test (“ping/pong”) while the agent wakes up for the first time.', he:'אז הוא מריץ בדיקה עצמית קצרה (“ping/pong”) בזמן שהסוכן מתעורר בפעם הראשונה.'},\n        stuck:{en:'If it asks “What next?”, choose <b>Continue with setup</b>.', he:'אם הוא שואל “What next?”, בחר <b>Continue with setup</b>.'}\n      },\n      {\n        edge:true, do:{en:'⏳ On a brand-new machine the self-test can take 30–60 seconds, or even time out the first time. <b>That’s normal, not a failure.</b> If the installer offers to install a helper (Claude) to check things, choose <b>Yes</b>. If it then needs you to sign in, it shows a <b>link</b> (with “press c to copy”). Open that link in your browser, sign in, click <b>Authorize</b>, copy the code it gives you, return to the Console, <b>right-click → Paste</b>, and press <b>Enter</b>.', he:'⏳ במכונה חדשה לגמרי הבדיקה יכולה לקחת 30–60 שניות, ולפעמים אפילו נגמר לה הזמן בפעם הראשונה. <b>זה נורמלי, לא תקלה.</b> אם המתקין מציע להתקין עוזר (Claude) כדי לבדוק, בוחרים <b>Yes</b>. אם הוא צריך שתתחבר, הוא מציג <b>קישור</b> (עם “press c to copy”). פותחים את הקישור בדפדפן, מתחברים, לוחצים <b>Authorize</b>, מעתיקים את הקוד שהוא נותן, חוזרים ל-Console, <b>קליק ימני → Paste</b>, ולוחצים <b>Enter</b>.'},\n        shot:null,\n        ok:{en:'It finishes signing in and continues on its own. It may ask you to sign in a <b>second time</b> with broader permissions, just do the exact same thing.', he:'הוא מסיים להתחבר וממשיך לבד. ייתכן שהוא יבקש להתחבר <b>פעם שנייה</b> עם הרשאות רחבות יותר, פשוט עושים בדיוק אותו דבר.'},\n        stuck:{en:'When it finishes and says something like “type /exit to resume”, type <code>/exit</code> (<b>with the slash</b>, not just “exit”) and press Enter to continue setup.', he:'כשהוא מסיים ואומר משהו כמו “type /exit to resume”, מקלידים <code>/exit</code> (<b>עם הלוכסן</b>, לא רק “exit”) ולוחצים Enter כדי להמשיך בהתקנה.'}\n      },\n      {\n        cmd:\"Asia/Jerusalem\",\n        do:{en:'It asks about your <b>timezone</b> (“Your system reports UTC, is that right, or are you somewhere else?”). Choose <b>“I’m somewhere else”</b>, then when it asks <i>“Where are you?”</i>, type your timezone and press Enter. In Israel, copy exactly:<br><code>Asia/Jerusalem</code>', he:'הוא שואל על <b>אזור הזמן</b> (“Your system reports UTC, is that right, or are you somewhere else?”). בוחרים <b>“I’m somewhere else”</b>, ואז כשהוא שואל <i>“Where are you?”</i> מקלידים את אזור הזמן ולוחצים Enter. בישראל, מעתיקים בדיוק:<br><code>Asia/Jerusalem</code>'},\n        shot:null,\n        ok:{en:'It prints <code>Timezone set to Asia/Jerusalem</code> and moves on.', he:'הוא מדפיס <code>Timezone set to Asia/Jerusalem</code> וממשיך.'},\n        stuck:{en:'Not in Israel? Type yours in the same <b>Region/City</b> format, e.g. <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.', he:'לא בישראל? הקלד את שלך באותו פורמט <b>Region/City</b>, למשל <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.'}\n      },\n      {\n        do:{en:'Next it will ask to connect a chat app, that’s the following step. When you finish that, the installer shows a final <b>“You’re set”</b> message.', he:'אחר כך הוא יבקש לחבר אפליקציית צ\\'אט, זה השלב הבא. כשתסיים אותו, המתקין יציג הודעת סיום <b>“You’re set”</b>.'},\n        shot:'shots/term-5-set.png',\n        ok:{en:'You see the success message, the hard part is over. Now you’ll go say hello (the last step). One thing worth knowing up front: on a brand-new server the very first message sometimes needs a small nudge before the agent answers, that’s normal, and the last step walks you through the quick 2-minute self-fix if it happens.', he:'אתה רואה את הודעת ההצלחה, החלק הקשה מאחורינו. עכשיו הולכים להגיד שלום (השלב האחרון). דבר אחד ששווה לדעת מראש: בשרת חדש לגמרי, לפעמים ההודעה הראשונה צריכה דחיפה קטנה לפני שהסוכן עונה, זה נורמלי, והשלב האחרון מלווה אותך בתיקון העצמי המהיר של 2 דקות אם זה קורה.'},\n        stuck:{en:'If it ends with “a few things still need your attention”, the installer can launch Claude to diagnose and fix it for you, let it.', he:'אם זה מסתיים ב-“a few things still need your attention”, המתקין יכול להפעיל את Claude כדי לאבחן ולתקן בשבילך, תן לו.'}\n      }\n    ],\n    note:{en:'No need to understand the command, just copy, paste, and hit Enter. The installer explains each step as it goes, and if it gets stuck it tries to solve it on its own.', he:'אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter. המתקין מסביר כל שלב תוך כדי, ואם הוא נתקע הוא מנסה לפתור לבד.'}\n  },\n  {\n    phase:'connect', status:'ready', owner:'you',\n    title:{en:'Connect your chat app', he:'חיבור אפליקציית הצ\\'אט'},\n    what:{\n      en:'This is how you will actually talk to your agent. NanoClaw can connect to Telegram, Slack, WhatsApp, and more. Our recommendation: start with Telegram first, because with Telegram you do NOT need a phone number. In this guide I show the Telegram setup. If you do not have Telegram Desktop yet, install it now: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.',\n      he:'כך תדבר עם הסוכן בפועל. NanoClaw יכול להתחבר לטלגרם, Slack, וואטסאפ ועוד. ההמלצה שלנו: להתחיל עם טלגרם קודם, כי עם טלגרם לא צריך מספר טלפון. במדריך זה מראים את החיבור לטלגרם. אם עדיין אין לך Telegram Desktop, התקן עכשיו: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.'\n    },\n    callout:{en:\"Sounds technical, but it's just copy, paste, and click.\", he:\"זה נשמע טכני אבל זה רק העתק-הדבק וללחוץ.\"},\n    todo:{\n      en:['In Telegram, open a chat with <code>@BotFather</code> and create a new bot.','It gives you a token (a line of code), copy it.','Paste it into the installer when it asks, and your bot is connected.'],\n      he:['בטלגרם, פותחים צ\\'אט עם <code>@BotFather</code> ויוצרים בוט חדש.','הוא נותן לך טוקן (שורת קוד), מעתיקים אותו.','מדביקים אותו למתקין כשהוא מבקש, והבוט מחובר.']\n    },\n    micro:[\n      {\n        do:{en:'Do this in the <b>Telegram app on your phone or desktop</b>, not in a new browser tab. ⚠️ Important: leave the server Console tab open and don’t switch away from it for too long, the browser Console disconnects if you leave it in the background. In Telegram’s <b>search bar at the very top</b>, type <code>@BotFather</code> and tap the result with a <b>blue verified checkmark</b>.', he:'עושים את זה ב<b>אפליקציית טלגרם בטלפון או במחשב</b>, לא בטאב חדש בדפדפן. ⚠️ חשוב: השאר את טאב ה-Console של השרת פתוח ואל תעבור ממנו לזמן רב, ה-Console בדפדפן מתנתק אם משאירים אותו ברקע. בשורת החיפוש של טלגרם למעלה מקלידים <code>@BotFather</code> ולוחצים על התוצאה עם <b>הסימן הכחול המאומת</b>.'},\n        cmd:'@BotFather',\n        shot:null,\n        ok:{en:'A chat opens with \"BotFather\", with a blue checkmark next to the name.', he:'נפתח צ\\'אט עם “BotFather”, עם וי כחול ליד השם.'},\n        stuck:{en:'Console says “Disconnected” when you come back? No harm done, just click <b>Reload</b> and, if needed, re-run <code>cd nanoclaw && bash nanoclaw.sh</code>, it picks up where it left off (fast, since the heavy parts are already built). Several BotFather results? Pick the one with the blue verified badge, that’s the only official one.', he:'ה-Console כתוב בו “Disconnected” כשחזרת? לא נורא, פשוט לוחצים <b>Reload</b> ואם צריך מריצים שוב <code>cd nanoclaw && bash nanoclaw.sh</code>, הוא ממשיך מאיפה שעצר (מהר, כי החלקים הכבדים כבר בנויים). כמה תוצאות BotFather? בחר את זו עם הוי הכחול המאומת, זו היחידה הרשמית.'}\n      },\n      {\n        do:{en:'At the bottom message box, type <code>/newbot</code> and send it.', he:'בתיבת ההודעה למטה מקלידים <code>/newbot</code> ושולחים.'},\n        cmd:'/newbot',\n        shot:null,\n        ok:{en:'BotFather replies and asks for a name for your bot.', he:'BotFather עונה ומבקש שם לבוט שלך.'}\n      },\n      {\n        do:{en:'Send a <b>name</b> (anything, e.g. “My Agent”). Then send a <b>username</b> that must end in <code>bot</code> (e.g. <code>myagent_bot</code>).', he:'שולחים <b>שם</b> (כל דבר, למשל “הסוכן שלי”). אחר כך שולחים <b>שם משתמש</b> שחייב להסתיים ב-<code>bot</code> (למשל <code>myagent_bot</code>).'},\n        shot:null,\n        ok:{en:'BotFather confirms and sends a message containing your token.', he:'BotFather מאשר ושולח הודעה שמכילה את הטוקן שלך.'},\n        stuck:{en:'“Username is already taken”? Just try another one, add a number or word before “bot”.', he:'“שם המשתמש כבר תפוס”? פשוט נסה אחר, הוסף מספר או מילה לפני “bot”.'}\n      },\n      {\n        do:{en:'In that message, <b>copy the WHOLE token</b>, a long line that looks like <code>123456789:AAH...</code>. It has two parts: the <b>numbers</b>, a <b>colon</b> <code>:</code>, then letters. You need <b>all of it</b>, including the numbers before the colon. On a phone, long-press the line and tap Copy.', he:'בהודעה הזו <b>מעתיקים את כל הטוקן</b>, שורה ארוכה שנראית כמו <code>123456789:AAH...</code>. יש לו שני חלקים: <b>מספרים</b>, <b>נקודתיים</b> <code>:</code>, ואז אותיות. צריך את <b>הכל</b>, כולל המספרים שלפני הנקודתיים. בנייד, לחיצה ארוכה על השורה ואז Copy.'},\n        shot:'shots/tg-botfather.png',\n        ok:{en:'The token is copied to your clipboard.', he:'הטוקן הועתק.'},\n        stuck:{en:'Easy mistake: copying only the part <i>after</i> the colon. The token must include the numbers and the <code>:</code> at the start, or the installer rejects it. The token is the line right after “Use this token to access the HTTP API”.', he:'טעות נפוצה: להעתיק רק את החלק <i>אחרי</i> הנקודתיים. הטוקן חייב לכלול את המספרים ואת ה-<code>:</code> בהתחלה, אחרת המתקין דוחה אותו. הטוקן הוא השורה מיד אחרי “Use this token to access the HTTP API”.'}\n      },\n      {\n        do:{en:'Go back to the installer in your server terminal. When it asks for your Telegram token, <b>paste it and press Enter</b>.', he:'חוזרים למתקין בטרמינל של השרת. כשהוא מבקש את טוקן הטלגרם, <b>מדביקים ולוחצים Enter</b>.'},\n        shot:'shots/tg-code.png',\n        ok:{en:'It finds your bot (“Found your bot: @yourbot”) and shows a short <b>secret code</b> on screen.', he:'הוא מוצא את הבוט שלך (“Found your bot: @yourbot”) ומציג <b>קוד סודי</b> קצר על המסך.'},\n        stuck:{en:'“Telegram didn’t accept that token”? Copy it again from BotFather, it’s easy to miss a character, and paste once more.', he:'“Telegram didn’t accept that token”? העתק אותו שוב מ-BotFather, קל לפספס תו, והדבק עוד פעם.'}\n      },\n      {\n        do:{en:'Open the chat with <b>your own bot</b> in Telegram (search its <code>@username</code>) and <b>send it that secret code</b> as a message.', he:'פותחים בטלגרם את הצ\\'אט עם <b>הבוט שלך</b> (מחפשים את ה-<code>@username</code> שלו) ו<b>שולחים לו את הקוד הסודי</b> כהודעה.'},\n        shot:'shots/tg-pair.png',\n        ok:{en:'The installer prints <code>Telegram paired.</code>, then asks what to name your assistant (default <b>Nano</b>), type a name or just press Enter.', he:'המתקין מדפיס <code>Telegram paired.</code>, ואז שואל איך לקרוא לסוכן (ברירת מחדל <b>Nano</b>), מקלידים שם או פשוט לוחצים Enter.'},\n        stuck:{en:'Sent it and nothing happened? Make sure you sent the code to <i>your</i> bot (not to BotFather), exactly as shown. A wrong code just lets you try again; an expired one is replaced automatically.', he:'שלחת וכלום לא קרה? ודא ששלחת את הקוד ל<i>בוט שלך</i> (לא ל-BotFather), בדיוק כמו שמופיע. קוד שגוי פשוט מאפשר לנסות שוב; קוד שפג תוקפו מוחלף אוטומטית.'}\n      }\n    ],\n    note:{en:'Prefer WhatsApp? Possible, but it needs a separate phone number. Tip: turn on WhatsApp Business as a second line on the same phone. Telegram is simpler to start with.', he:'מעדיף וואטסאפ? אפשר, אבל הוא דורש מספר טלפון נפרד. טיפ: הפעל WhatsApp Business כקו שני על אותו טלפון. טלגרם פשוט יותר להתחלה.'}\n  },\n  {\n    phase:'launch', status:'ready', owner:'you',\n    openWhat:true,\n    title:{en:'Say hello 👋', he:'תגיד שלום 👋'},\n    what:{\n      en:'Your agent is alive. Open Telegram, send it a message, and watch it reply. You don’t need to know anything else, the moment you say hi, it greets you and gives you a short guided tour of what it can do. Tip: if it ever explains something too technically, just tell it “I have no technical background, explain simply”, and it will. No commands to memorize, just talk to it like a person. From here it’s yours, and it learns and grows together with you.',\n      he:'הסוכן חי. פותחים את טלגרם, שולחים לו הודעה, ורואים אותו עונה. אתה לא צריך לדעת שום דבר נוסף, ברגע שתגיד היי, הוא יקבל אותך ויעשה לך סיור קצר ומודרך על מה שהוא יכול לעשות. טיפ: אם הוא מסביר משהו טכני מדי, פשוט תגיד לו “אין לי רקע טכני, תסביר בפשטות”, והוא יעשה את זה. אין פקודות לזכור, פשוט מדברים אתו כמו עם בנאדם. מכאן זה שלך, והוא לומד וייבנה יחד אתך.'\n    },\n    todo:{\n      en:['Open Telegram and find your new bot.','Send <b>“Hi”</b>.','It replies, and greets you with a short tour. 🎉','No reply within a minute? A normal first-boot hiccup, the built-in 2-minute self-fix below handles it.'],\n      he:['פותחים טלגרם ומוצאים את הבוט החדש שלך.','שולחים <b>\"היי\"</b>.','הוא עונה, ומקבל אותך עם סיור קצר. 🎉','אין תשובה תוך דקה? תקלת אתחול ראשונה רגילה, התיקון העצמי של 2 דקות למטה פותר אותה.']\n    },\n    micro:[\n      {\n        do:{en:'Open Telegram and search for your bot’s <b>username</b>, the one ending in <code>bot</code> that you created.', he:'פותחים טלגרם ומחפשים את <b>שם המשתמש</b> של הבוט, זה שמסתיים ב-<code>bot</code> שיצרת.'},\n        shot:null,\n        ok:{en:'Your bot’s chat opens, with a “Start” button or an empty message box. Tap <b>Start</b> if it’s there.', he:'נפתח הצ\\'אט של הבוט, עם כפתור “Start” או תיבת הודעה ריקה. אם יש כפתור <b>Start</b>, לוחצים עליו.'}\n      },\n      {\n        do:{en:'At the bottom, type <b>“Hi”</b> (or anything you like) and send. Then wait up to a minute, the very first message wakes the agent up.', he:'למטה מקלידים <b>“היי”</b> (או כל דבר) ושולחים. ואז ממתינים עד דקה, ההודעה הראשונה מעירה את הסוכן.'},\n        shot:'shots/tg-hello.png',\n        ok:{en:'Your agent replies and greets you, often with a short guided tour of what it can do. <b>If it replied, you’re done, skip the next step. 🎉</b>', he:'הסוכן עונה ומקבל אותך, לרוב עם סיור קצר על מה שהוא יכול. <b>אם הוא ענה, סיימת, דלג על השלב הבא. 🎉</b>'}\n      },\n      {\n        do:{en:'😌 <b>Didn’t reply within a minute? This is expected on a brand-new server</b>, and your agent is built to fix itself. It’s a 2-minute, one-time fix. Go to your server’s <b>Console</b> and typ