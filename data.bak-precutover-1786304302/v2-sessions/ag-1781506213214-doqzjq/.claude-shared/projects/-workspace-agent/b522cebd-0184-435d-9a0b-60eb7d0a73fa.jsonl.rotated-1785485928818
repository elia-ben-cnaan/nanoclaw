erm,a,button,code')) return;\n    let cur=node;\n    for(const tg of targets){\n      if(usedIds.has(tg.id)) continue;\n      const text=cur.nodeValue;\n      for(const s of tg.strs){\n        const idx=text.indexOf(s);\n        if(idx<0) continue;\n        const span=document.createElement('span');\n        span.className='term';\n        span.setAttribute('onclick',`openTerm('${tg.id}')`);\n        span.textContent=s;\n        const frag=document.createDocumentFragment();\n        if(idx>0) frag.appendChild(document.createTextNode(text.slice(0,idx)));\n        frag.appendChild(span);\n        const after=document.createTextNode(text.slice(idx+s.length));\n        frag.appendChild(after);\n        cur.parentNode.replaceChild(frag,cur);\n        usedIds.add(tg.id);\n        cur=after;\n        break;\n      }\n    }\n  });\n}\n\nfunction renderGuide(id){\n  var g=CONNECTION_GUIDES.find(function(x){return x.id===id;});\n  if(!g) return;\n  curGuide=g;\n  var h='<div class=\"guide-back-nav\"><button onclick=\"setView(&apos;wizard&apos;);render();window.scrollTo({top:0,behavior:&apos;smooth&apos;})\">&#8592; '+(lang==='he'?'חזרה':' Back')+'</button></div>';\n  if(g.hero) h+='<div class=\"guide-hero\"><img src=\"'+g.hero+'\" alt=\"\" loading=\"lazy\" onerror=\"this.parentNode.style.display=&apos;none&apos;\" style=\"width:100%;border-radius:16px;margin-bottom:28px;display:block\"></div>';\n  h+='<div class=\"step-head\"><div class=\"step-num\" style=\"font-size:18px;background:var(--teal-deep);color:#fff\">&#9654;</div><div style=\"flex:1\"><h1>'+t(g.title)+'</h1><p class=\"guide-oneliner\">'+t(g.oneLiner)+'</p></div></div>';\n  h+='<div class=\"guide-meta\"><span class=\"tag\">&#9201; '+t(g.estTime)+'</span></div>';\n  h+='<div class=\"prereqs-box\"><span class=\"pr-ic\">&#9745;</span><div class=\"pr-body\"><span class=\"pr-label\">'+t(UI.prereqsLabel)+'</span><span class=\"pr-txt\"> '+t(g.prereqs)+'</span></div></div>';\n  h+='<details class=\"what\" open><summary><h5