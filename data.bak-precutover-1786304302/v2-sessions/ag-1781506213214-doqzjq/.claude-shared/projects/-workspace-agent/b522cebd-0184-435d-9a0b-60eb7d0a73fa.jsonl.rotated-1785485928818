il is the first column → in dir=rtl that places it on the RIGHT */\n.shell{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:332px 1fr;gap:54px;padding:40px 40px 90px}\n\n/* faint content placeholder (left) so the rail reads in context */\n.stage{opacity:.30;pointer-events:none;grid-column:2}\n.stage .num{width:46px;height:46px;border-radius:13px;background:var(--teal);display:inline-block;margin-bottom:18px}\n.stage h1{font-family:var(--round);font-size:46px;font-weight:800;margin-bottom:14px}\n.stage .l{height:18px;border-radius:6px;background:var(--surface-3);margin-bottom:14px}\n.stage .l.w1{width:74%}.stage .l.w2{width:90%}.stage .l.w3{width:60%}\n.stage .box{height:120px;border-radius:14px;background:var(--surface-2);border-inline-start:4px solid var(--teal);margin-top:26px}\n\n/* ===== RAIL ===== */\n.rail{grid-column:1;position:relative;z-index:1;border-inline-start:1px solid var(--line);padding-inline-start:30px}\n\n.rail-phase{margin-bottom:10px}\n.rail-phase>h4{font-size:15px;font-weight:800;letter-spacing:.01em;color:var(--teal);margin-bottom:3px}\n.rail-step{display:flex;align-items:center;gap:9px;padding:5px 9px;border-radius:9px;color:var(--ink-muted);font-size:15px;line-height:1.25;cursor:pointer;transition:.15s}\n.rail-step:hover{background:var(--surface-2);color:var(--ink)}\n.rail-step.active{background:var(--surface-3);color:var(--ink);font-weight:600}\n.rail-step .dot{flex:none;width:21px;height:21px;border-radius:50%;border:1.5px solid var(--line);display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-size:11.5px;color:var(--ink-muted)}\n.rail-step.active .dot{border-color:var(--teal);color:var(--teal)}\n.rail-step.done .dot{background:var(--teal);border-color:var(--teal);color:var(--on-teal)}\n\n/* section: connections */\n.rail-sec{margin-top:14px;padding-top:13px;border-top:1px solid var(--line)}\n.rail-sec-head{font-size:15px;font-weight:800;letter-spacing:.01em;color:var(--ink);margin-bottom:2px}\n.rail-sec-sub{font-size:12.5px;color:var(--ink-dim);margin-bottom:8px;line-height:1.45}\n.rail-guide{display:flex;align-items:center;gap:9px;padding:5px 9px;border-radius:9px;color:var(--ink-muted);font-size:14.5px;cursor:pointer;transition:.15s}\n.rail-guide:hover{background:var(--surface-2);color:var(--ink)}\n.rail-guide .lg{flex:none;width:21px;height:21px;border-radius:6px;background:var(--surface-3);display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--teal);font-weight:700;font-family:var(--mono)}\n\n/* glossary entry — clean glyph, no emoji */\n.rail-gloss{display:flex;align-items:center;gap:9px;padding:5px 9px;margin-top:2px;border-radius:9px;color:var(--ink-muted);font-size:14.5px;cursor:pointer}\n.rail-gloss:hover{background:var(--surface-2);color:var(--ink)}\n.rail-gloss svg{flex:none}\n\n/* ===== request-more-guides — a CONSTANT card in the rail: the invite (title + paragraph) and the שם/מייל/שלח register are ALWAYS visible throughout the guide; only the connection PICKER is a secondary click-to-open dropdown ===== */\n.rail-drop{margin-top:14px;border:1px solid var(--line);background:var(--surface);border-radius:13px;padding:13px}\n.rd-title{font-size:15px;font-weight:800;color:var(--ink);line-height:1.3;margin-bottom:6px}\n.rd-intro{font-size:12.5px;color:var(--ink-muted);line-height:1.55;margin-bottom:11px}\n/* secondary toggle — choose specific connections (the dropdown) */\n.rd-pick-toggle{display:flex;align-items:center;justify-content:space-between;gap:10px;width:100%;background:var(--surface-2);border:1px solid var(--line);color:var(--ink);font-family:var(--sans);font-size:13.5px;font-weight:700;padding:9px 12px;border-radius:10px;cursor:pointer;text-align:start}\n.rd-pick-toggle .rd-caret{flex:none;color:var(--teal);font-size:10px;transition:transform .2s}\n.rail-drop.open .rd-caret{transform:rotate(180deg)}\n.rd-pick{display:none;margin-top:9px}\n.rail-drop.open .rd-pick{display:block}\n/* the list scrolls INSIDE a fixed inner box — does NOT extend the page; the register below stays always visible */\n.rd-list{max-height:196px;overflow-y:auto;margin:0 -4px;padding:0 4px;display:flex;flex-direction:column;gap:0}\n.rd-list::-webkit-scrollbar{width:6px}\n.rd-list::-webkit-scrollbar-thumb{background:var(--surface-3);border-radius:100px}\n.rd-list::-webkit-scrollbar-track{background:transparent}\n/* category header — sticky inside the inner scroll so the section title follows the journey */\n.rd-cat{font-size:11px;font-weight:800;letter-spacing:.05em;color:var(--teal);padding:9px 8px 3px;position:sticky;top:0;background:var(--surface);z-index:1}\n.rd-cat:first-child{padding-top:2px}\n.rd-opt{display:flex;align-items:center;gap:9px;padding:4px 8px;border-radius:8px;font-size:14px;color:var(--ink-muted);cursor:pointer;user-select:none;transition:.1s}\n.rd-opt:hover{background:var(--surface-2);color:var(--ink)}\n.rd-opt .bx{flex:none;width:16px;height:16px;border-radius:5px;border:1.5px solid var(--line);display:flex;align-items:center;justify-content:center}\n.rd-opt.on{color:var(--ink)}\n.rd-opt.on .bx{background:var(--teal);border-color:var(--teal)}\n.rd-opt.on .bx::after{content:'';width:4px;height:8px;border:solid var(--on-teal);border-width:0 2px 2px 0;transform:rotate(45deg);margin-bottom:2px}\n.rd-other{width:100%;margin-top:10px;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:9px 12px;color:var(--ink);font-family:var(--sans);font-size:13.5px}\n.rd-other::placeholder{color:var(--ink-dim)}\n.rd-other:focus{outline:none;border-color:rgba(86,237,214,.5)}\n/* fill-details — only when NOT registered */\n.rd-reg{margin-top:11px;padding-top:11px;border-top:1px solid var(--line)}\n.rd-reg .rg-hint{font-size:12.5px;color:var(--ink-muted);line-height:1.5;margin-bottom:8px}\n.rd-reg input{display:block;width:100%;margin-bottom:7px;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:9px 12px;color:var(--ink);font-family:var(--sans);font-size:13.5px}\n.rd-reg input::placeholder{color:var(--ink-dim)}\n.rd-reg input:focus{outline:none;border-color:rgba(86,237,214,.5)}\n/* known-user variant */\n.rd-known{margin-top:11px;padding-top:11px;border-top:1px solid var(--line);font-size:12.5px;color:var(--ink-muted);line-height:1.5}\n.rd-known b{color:var(--teal)}\n.rd-send{margin-top:11px;width:100%;background:var(--teal);color:var(--on-teal);border:none;border-radius:100px;padding:11px;font-family:var(--sans);font-size:14.5px;font-weight:700;cursor:pointer}\n.rd-note{margin-top:8px;text-align:center;font-size:11.5px;color:var(--ink-dim);line-height:1.5}\n</style>\n</head>\n<body>\n<div class=\"shell\">\n\n  <!-- faint stage (context only) -->\n  <div class=\"stage\">\n    <span class=\"num\"></span>\n    <h1>איפה הסוכן יחיה?</h1>\n    <div class=\"l w1\"></div><div class=\"l w2\"></div><div class=\"l w3\"></div>\n    <div class=\"box\"></div>\n  </div>\n\n  <!-- THE RAIL -->\n  <aside class=\"rail\">\n\n    <div class=\"rail-phase\">\n      <h4>הכנה</h4>\n      <div class=\"rail-step done\"><span class=\"dot\">1</span>מה מחכה לך כאן</div>\n      <div class=\"rail-step active\"><span class=\"dot\">2</span>איפה הסוכן יחיה?</div>\n    </div>\n\n    <div class=\"rail-phase\">\n      <h4>התקנה</h4>\n      <div class=\"rail-step\"><span class=\"dot\">3</span>הקמת שרת הענן</div>\n      <div class=\"rail-step\"><span class=\"dot\">4</span>מפתח ה-AI שלך</div>\n      <div class=\"rail-step\"><span class=\"dot\">5</span>מתקינים את הסוכן</div>\n    </div>\n\n    <div class=\"rail-phase\">\n      <h4>חיבור</h4>\n      <div class=\"rail-step\"><span class=\"dot\">6</span>חיבור אפליקציית הצ'אט</div>\n    </div>\n\n    <div class=\"rail-phase\">\n      <h4>הפעלה</h4>\n      <div class=\"rail-step\"><span class=\"dot\">7</span>תגיד שלום ל-NanoClaw</div>\n      <div class=\"rail-step\"><span class=\"dot\">8</span>היכרות עם הסוכן שלך</div>\n    </div>\n\n    <!-- additional connections -->\n    <div class=\"r