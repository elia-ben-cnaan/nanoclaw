{"parentUuid":"f47b5794-e7c8-44db-bc03-80dd8bf627ab","isSidechain":false,"message":{"model":"claude-sonnet-4-6","id":"msg_01End7KSDcaM7vAeGFY2ThGU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013tt4DDbQ53x3oxn6FFLt83","name":"Read","input":{"file_path":"/workspace/inbox/a2a-1781640103772-8ap4sr/guide.html","offset":679,"limit":250},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":10123,"cache_read_input_tokens":77887,"output_tokens":109,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":10123,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":1,"output_tokens":109,"cache_read_input_tokens":77887,"cache_creation_input_tokens":10123,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10123},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011Cc7Y1d6jvVkfL8QzsGzhX","attributionMcpServer":"nanoclaw","attributionMcpTool":"send_message","type":"assistant","uuid":"dd939a17-764b-4aa0-93c0-5953ec9edeae","timestamp":"2026-06-16T20:02:19.267Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b522cebd-0184-435d-9a0b-60eb7d0a73fa","version":"2.1.154","gitBranch":"HEAD","slug":"breezy-launching-scott"}
{"parentUuid":"dd939a17-764b-4aa0-93c0-5953ec9edeae","isSidechain":false,"promptId":"b213ee7c-171f-49df-96e1-7199d02ca51b","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013tt4DDbQ53x3oxn6FFLt83","type":"tool_result","content":"679\t    },\n680\t    action:{label:{en:'Open Anthropic Console', he:'פתח את קונסולת Anthropic'}, sub:{en:'console.anthropic.com', he:'console.anthropic.com'}, url:'https://console.anthropic.com/'},\n681\t    micro:[\n682\t      {\n683\t        do:{en:'In your browser’s address bar, open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> and press Enter. The Claude Console login page opens.', he:'בשורת הכתובת של הדפדפן פותחים <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ולוחצים Enter. נפתח דף הכניסה של Claude Console.'},\n684\t        shot:null,\n685\t        ok:{en:'You see the heading “Build with the Claude API” and two ways to sign in, Google or email.', he:'רואים את הכותרת “Build with the Claude API” ושתי דרכים להיכנס, Google או אימייל.'},\n686\t        stuck:{en:'Landed somewhere else? Make sure you open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> directly, with no “www” and no spaces.', he:'הגעת למקום אחר? ודא שאתה פותח <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ישירות, בלי “www” ובלי רווחים.'}\n687\t      },\n688\t      {\n689\t        do:{en:'Easiest path: click <b>“Continue with Google”</b> and pick your Google account. No Google? Type your email, click <b>Continue</b>, and paste the code that arrives in your inbox.', he:'הדרך הקלה: לוחצים <b>“Continue with Google”</b> ובוחרים את חשבון הגוגל שלך. אין גוגל? מקלידים אימייל, לוחצים <b>Continue</b>, ומדביקים את הקוד שמגיע למייל.'},\n690\t        shot:null,\n691\t        ok:{en:'You land on the Console dashboard, with a menu down the left side.', he:'אתה מגיע ללוח הבקרה (Dashboard), עם תפריט בצד.'},\n692\t        stuck:{en:'No email arrived? Check your spam folder, or just use the Google button instead.', he:'לא הגיע מייל? בדוק בתיקיית הספאם, או פשוט השתמש בכפתור של Google.'}\n693\t      },\n694\t      {\n695\t        do:{en:'In the left menu click <b>Billing</b>, then <b>“Add to credit balance”</b>. Choose a small amount (even $5) and enter a card.', he:'בתפריט הצד לוחצים <b>Billing</b>, ואז <b>“Add to credit balance”</b>. בוחרים סכום קטן (אפילו 5$) ומזינים כרטיס.'},\n696\t        shot:'shots/anthropic-dashboard.jpg',\n697\t        ok:{en:'At the top you see a Balance with the amount you loaded, for example $5.00.', he:'למעלה מופיע Balance עם הסכום שטענת, למשל $5.00.'},\n698\t        stuck:{en:'Card declined? Try another card. Remember: with no balance the agent simply won’t answer.', he:'הכרטיס נדחה? נסה כרטיס אחר. זכור: בלי יתרה הסוכן פשוט לא יענה.'}\n699\t      },\n700\t      {\n701\t        do:{en:'In the left menu click <b>API Keys</b>, then the <b>“Create Key”</b> button. Give it a name (like “my-agent”) and click <b>Add</b>.', he:'בתפריט הצד לוחצים <b>API Keys</b>, ואז על הכפתור <b>“Create Key”</b>. נותנים שם (למשל “my-agent”) ולוחצים <b>Add</b>.'},\n702\t        shot:'shots/anthropic-keys.jpg',\n703\t        ok:{en:'A window opens showing a long key that starts with <code>sk-ant-</code>.', he:'נפתח חלון עם מפתח ארוך שמתחיל ב-<code>sk-ant-</code>.'},\n704\t        stuck:{en:'Don’t see “API Keys”? Click the gear / Settings icon next to your account name, it’s in there.', he:'לא רואה “API Keys”? לחץ על גלגל השיניים / Settings ליד שם החשבון, זה שם.'}\n705\t      },\n706\t      {\n707\t        do:{en:'Click <b>Copy</b> and paste the key somewhere safe (a note or document). You only see it once.', he:'לוחצים <b>Copy</b> ומדביקים את המפתח במקום בטוח (פתק או מסמך). רואים אותו פעם אחת בלבד.'},\n708\t        shot:'shots/anthropic-createkey.jpg',\n709\t        ok:{en:'Your key is saved, starting with <code>sk-ant-</code>. The installer will ask for it in the next step.', he:'המפתח שמור אצלך, מתחיל ב-<code>sk-ant-</code>. המתקין יבקש אותו בשלב הבא.'},\n710\t        stuck:{en:'Closed it before copying? No problem, just create a new key. You can always make another.', he:'סגרת לפני שהעתקת? אין בעיה, פשוט צור מפתח חדש. אפשר תמיד.'}\n711\t      }\n712\t    ],\n713\t    note:{en:'Note: the account is free, but the AI is pay-as-you-go. With no balance the agent simply won’t answer, so load a small amount first (even $5 is enough to start).', he:'שימו לב: החשבון חינם, אבל ה-AI בתשלום לפי שימוש. בלי יתרה הסוכן פשוט לא יענה, לכן טוענים סכום קטן מראש (אפילו 5$ מספיקים להתחלה).'}\n714\t  },\n715\t  {\n716\t    phase:'install', status:'ready', owner:'auto',\n717\t    opener:{en:'In this step the agent gets installed on your server. One command downloads NanoClaw and runs an installer that sets up Node, Docker, and the agent container entirely on its own. You paste once and press Enter, it handles everything.', he:'בשלב הזה הסוכן מותקן על השרת שלך. פקודה אחת מורידה את NanoClaw ומפעילה מתקין שמגדיר את Node, Docker וקונטיינר הסוכן לגמרי לבד. מדביקים פעם אחת ולוחצים Enter, הוא מטפל בכל השאר.'},\n718\t    title:{en:'Install the agent on your server', he:'מתקינים את הסוכן על השרת'},\n719\t    what:{\n720\t      en:'This is the magic of NanoClaw: one command that installs everything for you. You paste one line into the server terminal and the smart installer handles the rest. Before you paste: the terminal is the black window from the previous step. You interact in three ways here: (a) some things I write for you to copy and paste, (b) some I show as a screenshot, (c) some you answer by selecting with the ↑/↓ arrow keys, then Enter to confirm.',\n721\t      he:'זה הקסם של נאנו-קלו: פקודה אחת שמתקינה את הכל בשבילך. מדביקים שורה אחת בטרמינל והמתקין דואג לכל השאר. לפני שמדביקים: הטרמינל הוא החלון השחור מהשלב הקודם. יש כאן שלוש דרכי אינטראקציה: (א) חלק אני כותב לך להעתיק-להדביק, (ב) חלק מראה בצילום מסך, (ג) חלק עונים על ידי בחירה במקשי החצים ↑/↓ ואז Enter.'\n722\t    },\n723\t    callout:{en:\"No need to understand the command, just copy, paste, and hit Enter.\", he:\"אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter.\"},\n724\t    todo:{\n725\t      en:['Paste into the terminal: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','The installer runs on its own, it installs every component (a few minutes).','When it asks, paste the Anthropic key from the previous step.','That’s it, it builds your agent and gets it ready to launch.'],\n726\t      he:['מדביקים בטרמינל: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','המתקין רץ לבד, מתקין כל רכיב שצריך (כמה דקות).','כשהוא מבקש, מדביקים את מפתח ה-Anthropic מהשלב הקודם.','זהו, הוא בונה את הסוכן ומכין אותו להפעלה.']\n727\t    },\n728\t    micro:[\n729\t      {\n730\t        do:{en:'Make sure you’re in the black terminal window from the previous step, the one showing a <code>root@...:~#</code> prompt.', he:'מוודאים שאתה בחלון הטרמינל השחור מהשלב הקודם, זה שמראה שורת פקודה <code>root@...:~#</code>.'},\n731\t        shot:null,\n732\t        ok:{en:'The cursor is blinking next to the <code>#</code> prompt, ready for you to type.', he:'הסמן מהבהב ליד הסימן <code>#</code>, מוכן שתקליד.'},\n733\t        stuck:{en:'Closed the Console? Go back to your server in DigitalOcean and click “Console” again.', he:'סגרת את ה-Console? חזור לשרת ב-DigitalOcean ולחץ שוב על “Console”.'}\n734\t      },\n735\t      {\n736\t        cmd:\"git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh\",\n737\t        do:{en:'Copy this exact line, paste it into the terminal (right-click → Paste, or Ctrl+Shift+V), and press <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>', he:'מעתיקים את השורה הזו בדיוק, מדביקים בטרמינל (קליק ימני → Paste, או Ctrl+Shift+V), ולוחצים <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>'},\n738\t        shot:'shots/do-paste-cmd.jpg',\n739\t        ok:{en:'Text starts scrolling by, it’s installing. Don’t close the window.', he:'טקסט מתחיל לזרום על המסך, זה מתקין. אל תסגור את החלון.'},\n740\t        stuck:{en:'You don’t need to understand the text flying by, that’s normal. If it ever stops with an error, the installer tries to fix itself; just give it a moment.', he:'אתה לא צריך להבין את הטקסט שרץ, זה נורמלי. אם זה נעצר עם שגיאה, המתקין מנסה לתקן את עצמו; פשוט תן לו רגע.'}\n741\t      },\n742\t      {\n743\t        do:{en:'This is what the installer looks like as it runs: the NanoClaw banner, then a series of steps it handles almost by itself. The next micros walk you through them one by one.', he:'ככה נראה המתקין רץ: באנר NanoClaw, ואז סדרת שלבים שהוא מבצע כמעט לבד. בצעדים הבאים נעבור עליהם אחד אחד.'},\n744\t        shot:'shots/term-flow-clean.jpg',\n745\t        ok:{en:'You see text flowing, the install has started.', he:'אתה רואה טקסט זורם, ההתקנה התחילה.'}\n746\t      },\n747\t      {\n748\t        do:{en:'⚠️ Right at the start it <b>will</b> stop and warn <i>“you are running as root”</i>, then ask <code>Choose [1/2]</code>. <b>Type <code>2</code> and press Enter</b> to continue. Important: don’t just press Enter on its own, the default is option 1, which stops the install and dumps a wall of commands. Type the <b>2</b> first.', he:'⚠️ ממש בהתחלה הוא <b>יעצור</b> ויזהיר <i>“you are running as root”</i>, ואז ישאל <code>Choose [1/2]</code>. <b>מקלידים <code>2</code> ולוחצים Enter</b> כדי להמשיך. חשוב: אל תלחץ Enter לבד, ברירת המחדל היא אפשרות 1, שעוצרת את ההתקנה ושופכת קיר של פקודות. הקלד קודם <b>2</b>.'},\n749\t        shot:'shots/term-run.jpg',\n750\t        ok:{en:'It accepts your choice and the installation keeps going.', he:'הוא מקבל את הבחירה וההתקנה ממשיכה.'},\n751\t        stuck:{en:'See a different warning asking “Try anyway? [y/N]” about memory or Google Cloud? That means the server is too small or on Google Cloud, stop, and use a 4 GB DigitalOcean machine instead (see the server step).', he:'רואה אזהרה אחרת “Try anyway? [y/N]” על זיכרון או Google Cloud? סימן שהשרת קטן מדי או על Google Cloud, עצור, והשתמש במכונה של 4GB ב-DigitalOcean (ראה שלב השרת).'}\n752\t      },\n753\t      {\n754\t        do:{en:'After you type <code>2</code> and press Enter, the install continues.', he:'אחרי שהקלדת <code>2</code> ולחצת Enter, ההתקנה ממשיכה הלאה.'},\n755\t        shot:'shots/term-root-choice.jpg',\n756\t        ok:{en:'The installer accepted your choice.', he:'המתקין קיבל את הבחירה.'}\n757\t      },\n758\t      {\n759\t        do:{en:'Next it asks <i>“How would you like to begin?”</i> with two options. Pick <b>Standard setup</b> (use the arrow keys if needed, then Enter). It’s the guided path that does everything for you, Advanced is for developers and you don’t want it.', he:'אחר כך הוא שואל <i>“How would you like to begin?”</i> עם שתי אפשרויות. בוחרים <b>Standard setup</b> (במקשי החצים אם צריך, ואז Enter). זה המסלול המודרך שעושה הכל בשבילך, Advanced מיועד למפתחים ואתה לא רוצה אותו.'},\n760\t        shot:'shots/term-begin.jpg',\n761\t        ok:{en:'It runs a quick system check and says something like <code>Your system looks good</code>.', he:'הוא מריץ בדיקת מערכת קצרה ואומר משהו כמו <code>Your system looks good</code>.'},\n762\t        stuck:{en:'Picked Advanced by mistake? No drama, press <b>Ctrl+C</b> to stop, then run the same line again (<code>cd nanoclaw && bash nanoclaw.sh</code>) and choose Standard this time.', he:'בחרת Advanced בטעות? לא נורא, לוחצים <b>Ctrl+C</b> כדי לעצור, ואז מריצים שוב את אותה שורה (<code>cd nanoclaw && bash nanoclaw.sh</code>) ובוחרים Standard הפעם.'}\n763\t      },\n764\t      {\n765\t        do:{en:'It says it’s <b>preparing your assistant’s sandbox</b>, this is the longest part, about <b>3–10 minutes</b> on a fresh machine. Just wait; let it run.', he:'הוא אומר שהוא <b>מכין את ה-sandbox של הסוכן</b>, זה החלק הארוך ביותר, בערך <b>3–10 דקות</b> במכונה חדשה. פשוט מחכים ונותנים לו לרוץ.'},\n766\t        shot:'shots/term-sandbox.jpg',\n767\t        ok:{en:'It prints <code>Sandbox ready.</code> and moves on by itself.', he:'הוא מדפיס <code>Sandbox ready.</code> וממשיך לבד.'},\n768\t        stuck:{en:'As long as the spinner keeps ticking the seconds, it’s working, don’t touch it. A first build really can take up to 10 minutes.', he:'כל עוד הספינר ממשיך לספור שניות, זה עובד, אל תיגע. בנייה ראשונה באמת יכולה לקחת עד 10 דקות.'}\n769\t      },\n770\t      {\n771\t        do:{en:'If it looks stuck with no output for a few dozen seconds, <b>that\\'s normal</b>. The first build takes time, don\\'t touch it, just let it run.', he:'אם הוא נראה תקוע ואין פלט כמה עשרות שניות, <b>זה נורמלי</b>. הבנייה הראשונה לוקחת זמן, אל תיגע, פשוט תן לו.'},\n772\t        shot:'shots/term-sandbox-wait.jpg',\n773\t        ok:{en:'The spinner keeps going, that means it\\'s working.', he:'הספינר ממשיך, סימן שהוא עובד.'}\n774\t      },\n775\t      {\n776\t        do:{en:'It announces <code>Sandbox ready</code> then <code>OneCLI vault ready</code>. The vault adds your keys to approved requests so your key is never exposed directly to the agent.', he:'הוא מודיע <code>Sandbox ready</code> ואז <code>OneCLI vault ready</code>. הכספת מוסיפה את המפתחות לבקשות מאושרות, כך שהמפתח שלך לא נחשף לסוכן ישירות.'},\n777\t        shot:'shots/term-vault-ready.jpg',\n778\t        ok:{en:'The environment is ready, it continues on its own.', he:'הסביבה מוכנה, הוא ממשיך לבד.'}\n779\t      },\n780\t      {\n781\t        do:{en:'The installer detects the OneCLI vault and connects it automatically, nothing to do here.', he:'המתקין מזהה את כספת OneCLI ומחבר אותה אוטומטית, אין מה לעשות פה.'},\n782\t        shot:'shots/term-onecli-found.jpg',\n783\t        ok:{en:'The vault is connected.', he:'הכספת מחוברת.'}\n784\t      },\n785\t      {\n786\t        do:{en:'It may ask <i>“Which agent runtime?”</i> and offer <b>Claude</b> (the default) or Codex. Pick <b>Claude</b> and press <b>Enter</b>. That’s the brain you set up the key for.', he:'ייתכן שהוא ישאל <i>“Which agent runtime?”</i> ויציע <b>Claude</b> (ברירת המחדל) או Codex. בוחרים <b>Claude</b> ולוחצים <b>Enter</b>. זה ה\"מוח\" שבשבילו הכנת את המפתח.'},\n787\t        shot:null,\n788\t        ok:{en:'It accepts Claude and moves to connecting your key.', he:'הוא מקבל את Claude ועובר לחיבור המפתח שלך.'},\n789\t        stuck:{en:'Didn’t see this question at all? That’s fine, on some versions Claude is chosen automatically and it skips straight to the key.', he:'לא ראית את השאלה הזו בכלל? בסדר גמור, בחלק מהגרסאות Claude נבחר אוטומטית והוא מדלג ישר למפתח.'}\n790\t      },\n791\t      {\n792\t        do:{en:'It asks <i>“How would you like to connect to Claude?”</i> with a short menu. Use the arrow keys to highlight <b>“Paste an Anthropic API key”</b> (not “Sign in with subscription”, not “Paste OAuth token”), press <b>Enter</b>, then paste the <code>sk-ant-</code> key you saved earlier and press <b>Enter</b> again.', he:'הוא שואל <i>“How would you like to connect to Claude?”</i> עם תפריט קצר. בעזרת מקשי החצים מסמנים <b>“Paste an Anthropic API key”</b> (לא “Sign in with subscription”, לא “Paste OAuth token”), לוחצים <b>Enter</b>, ואז מדביקים את המפתח <code>sk-ant-</code> ששמרת קודם ולוחצים <b>Enter</b> שוב.'},\n793\t        shot:'shots/term-connect-menu.jpg',\n794\t        ok:{en:'It prints <code>Claude account connected.</code> and continues.', he:'הוא מדפיס <code>Claude account connected.</code> וממשיך.'},\n795\t        stuck:{en:'Pasting doesn’t show the key? That’s a security feature, it’s there. If it says the token “looks truncated”, make the terminal window wider and paste again so the key fits on one line.', he:'ההדבקה לא מציגה את המפתח? זו תכונת אבטחה, הוא שם. אם כתוב שהטוקן “looks truncated”, הרחב את חלון הטרמינל והדבק שוב כדי שהמפתח ייכנס בשורה אחת.'}\n796\t      },\n797\t      {\n798\t        do:{en:'After you choose <b>Paste an Anthropic API key</b>, it asks for the key. Paste the <code>sk-ant-</code> key you saved and press Enter.', he:'אחרי שבחרת <b>Paste an Anthropic API key</b>, הוא מבקש את המפתח. מדביקים את המפתח <code>sk-ant-</code> ששמרת ולוחצים Enter.'},\n799\t        shot:'shots/term-key-prompt.jpg',\n800\t        ok:{en:'It\\'s waiting for your key.', he:'הוא מחכה למפתח שלך.'}\n801\t      },\n802\t      {\n803\t        do:{en:'Pasting shows as dots, that\\'s a security feature, the key is there. Press Enter and it confirms <code>Claude account connected</code>.', he:'ההדבקה מופיעה כנקודות, זו תכונת אבטחה, המפתח שם. לוחצים Enter והוא מאשר <code>Claude account connected</code>.'},\n804\t        shot:'shots/term-key-entered.jpg',\n805\t        ok:{en:'The key was accepted and the connection confirmed.', he:'המפתח התקבל והחיבור אושר.'}\n806\t      },\n807\t      {\n808\t        do:{en:'It asks <i>“What should your assistant call you?”</i>. Type your <b>name</b> and press <b>Enter</b>.', he:'הוא שואל <i>“What should your assistant call you?”</i>. מקלידים את <b>השם</b> שלך ולוחצים <b>Enter</b>.'},\n809\t        shot:'shots/term-name-you.jpg',\n810\t        ok:{en:'It then runs a quick self-test (“ping/pong”) while the agent wakes up for the first time.', he:'אז הוא מריץ בדיקה עצמית קצרה (“ping/pong”) בזמן שהסוכן מתעורר בפעם הראשונה.'},\n811\t        stuck:{en:'If it asks “What next?”, choose <b>Continue with setup</b>.', he:'אם הוא שואל “What next?”, בחר <b>Continue with setup</b>.'}\n812\t      },\n813\t      {\n814\t        do:{en:'On a new machine the self-test can fail the first time, <b>that\\'s expected</b>. When it offers to install a helper (Claude) to check things, choose <b>Yes</b>.', he:'במכונה חדשה הבדיקה העצמית יכולה להיכשל בפעם הראשונה, <b>זה צפוי</b>. כשהוא מציע להתקין עוזר (Claude) כדי לבדוק, בוחרים <b>Yes</b>.'},\n815\t        shot:'shots/term-noreply.jpg',\n816\t        ok:{en:'It starts installing the helper.', he:'הוא מתחיל להתקין את העוזר.'}\n817\t      },\n818\t      {\n819\t        do:{en:'It installs the Claude tool in the background. A few moments and it\\'s done on its own.', he:'הוא מתקין את כלי ה-Claude ברקע. כמה רגעים וזה נגמר לבד.'},\n820\t        shot:'shots/term-cli-install.jpg',\n821\t        ok:{en:'The install finished and it continues.', he:'ההתקנה הסתיימה והוא ממשיך.'}\n822\t      },\n823\t      {\n824\t        edge:true, do:{en:'⏳ On a brand-new machine the self-test can take 30–60 seconds, or even time out the first time. <b>That’s normal, not a failure.</b> If the installer offers to install a helper (Claude) to check things, choose <b>Yes</b>. If it then needs you to sign in, it shows a <b>link</b> (with “press c to copy”). Open that link in your browser, sign in, click <b>Authorize</b>, copy the code it gives you, return to the Console, <b>right-click → Paste</b>, and press <b>Enter</b>.', he:'⏳ במכונה חדשה לגמרי הבדיקה יכולה לקחת 30–60 שניות, ולפעמים אפילו נגמר לה הזמן בפעם הראשונה. <b>זה נורמלי, לא תקלה.</b> אם המתקין מציע להתקין עוזר (Claude) כדי לבדוק, בוחרים <b>Yes</b>. אם הוא צריך שתתחבר, הוא מציג <b>קישור</b> (עם “press c to copy”). פותחים את הקישור בדפדפן, מתחברים, לוחצים <b>Authorize</b>, מעתיקים את הקוד שהוא נותן, חוזרים ל-Console, <b>קליק ימני → Paste</b>, ולוחצים <b>Enter</b>.'},\n825\t        shot:null,\n826\t        ok:{en:'It finishes signing in and continues on its own. It may ask you to sign in a <b>second time</b> with broader permissions, just do the exact same thing.', he:'הוא מסיים להתחבר וממשיך לבד. ייתכן שהוא יבקש להתחבר <b>פעם שנייה</b> עם הרשאות רחבות יותר, פשוט עושים בדיוק אותו דבר.'},\n827\t        stuck:{en:'When it finishes and says something like “type /exit to resume”, type <code>/exit</code> (<b>with the slash</b>, not just “exit”) and press Enter to continue setup.', he:'כשהוא מסיים ואומר משהו כמו “type /exit to resume”, מקלידים <code>/exit</code> (<b>עם הלוכסן</b>, לא רק “exit”) ולוחצים Enter כדי להמשיך בהתקנה.'}\n828\t      },\n829\t      {\n830\t        cmd:\"Asia/Jerusalem\",\n831\t        do:{en:'It asks about your <b>timezone</b> (“Your system reports UTC, is that right, or are you somewhere else?”). Choose <b>“I’m somewhere else”</b>, then when it asks <i>“Where are you?”</i>, type your timezone and press Enter. In Israel, copy exactly:<br><code>Asia/Jerusalem</code>', he:'הוא שואל על <b>אזור הזמן</b> (“Your system reports UTC, is that right, or are you somewhere else?”). בוחרים <b>“I’m somewhere else”</b>, ואז כשהוא שואל <i>“Where are you?”</i> מקלידים את אזור הזמן ולוחצים Enter. בישראל, מעתיקים בדיוק:<br><code>Asia/Jerusalem</code>'},\n832\t        shot:null,\n833\t        ok:{en:'It prints <code>Timezone set to Asia/Jerusalem</code> and moves on.', he:'הוא מדפיס <code>Timezone set to Asia/Jerusalem</code> וממשיך.'},\n834\t        stuck:{en:'Not in Israel? Type yours in the same <b>Region/City</b> format, e.g. <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.', he:'לא בישראל? הקלד את שלך באותו פורמט <b>Region/City</b>, למשל <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.'}\n835\t      },\n836\t      {\n837\t        do:{en:'Next it will ask to connect a chat app, that’s the following step. When you finish that, the installer shows a final <b>“You’re set”</b> message.', he:'אחר כך הוא יבקש לחבר אפליקציית צ\\'אט, זה השלב הבא. כשתסיים אותו, המתקין יציג הודעת סיום <b>“You’re set”</b>.'},\n838\t        shot:'shots/term-5-set.png',\n839\t        ok:{en:'You see the success message, the hard part is over. Now you’ll go say hello (the last step). One thing worth knowing up front: on a brand-new server the very first message sometimes needs a small nudge before the agent answers, that’s normal, and the last step walks you through the quick 2-minute self-fix if it happens.', he:'אתה רואה את הודעת ההצלחה, החלק הקשה מאחורינו. עכשיו הולכים להגיד שלום (השלב האחרון). דבר אחד ששווה לדעת מראש: בשרת חדש לגמרי, לפעמים ההודעה הראשונה צריכה דחיפה קטנה לפני שהסוכן עונה, זה נורמלי, והשלב האחרון מלווה אותך בתיקון העצמי המהיר של 2 דקות אם זה קורה.'},\n840\t        stuck:{en:'If it ends with “a few things still need your attention”, the installer can launch Claude to diagnose and fix it for you, let it.', he:'אם זה מסתיים ב-“a few things still need your attention”, המתקין יכול להפעיל את Claude כדי לאבחן ולתקן בשבילך, תן לו.'}\n841\t      }\n842\t    ],\n843\t    note:{en:'No need to understand the command, just copy, paste, and hit Enter. The installer explains each step as it goes, and if it gets stuck it tries to solve it on its own.', he:'אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter. המתקין מסביר כל שלב תוך כדי, ואם הוא נתקע הוא מנסה לפתור לבד.'}\n844\t  },\n845\t  {\n846\t    phase:'connect', status:'ready', owner:'you',\n847\t    title:{en:'Connect your chat app', he:'חיבור אפליקציית הצ\\'אט'},\n848\t    what:{\n849\t      en:'This is how you will actually talk to your agent. NanoClaw can connect to Telegram, Slack, WhatsApp, and more. Our recommendation: start with Telegram first, because with Telegram you do NOT need a phone number. In this guide I show the Telegram setup. If you do not have Telegram Desktop yet, install it now: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.',\n850\t      he:'כך תדבר עם הסוכן בפועל. NanoClaw יכול להתחבר לטלגרם, Slack, וואטסאפ ועוד. ההמלצה שלנו: להתחיל עם טלגרם קודם, כי עם טלגרם לא צריך מספר טלפון. במדריך זה מראים את החיבור לטלגרם. אם עדיין אין לך Telegram Desktop, התקן עכשיו: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.'\n851\t    },\n852\t    callout:{en:\"Sounds technical, but it's just copy, paste, and click.\", he:\"זה נשמע טכני אבל זה רק העתק-הדבק וללחוץ.\"},\n853\t    todo:{\n854\t      en:['In Telegram, open a chat with <code>@BotFather</code> and create a new bot.','It gives you a token (a line of code), copy it.','Paste it into the installer when it asks, and your bot is connected.'],\n855\t      he:['בטלגרם, פותחים צ\\'אט עם <code>@BotFather</code> ויוצרים בוט חדש.','הוא נותן לך טוקן (שורת קוד), מעתיקים אותו.','מדביקים אותו למתקין כשהוא מבקש, והבוט מחובר.']\n856\t    },\n857\t    micro:[\n858\t      {\n859\t        do:{en:'The installer asks which chat app to connect. Choose <b>Telegram</b> (use the arrow keys then Enter).', he:'המתקין שואל לאיזו אפליקציית צ\\'אט לחבר. בוחרים <b>Telegram</b> (במקשי החצים ואז Enter).'},\n860\t        shot:'shots/tg-channel-menu.jpg',\n861\t        ok:{en:'You chose Telegram, let\\'s continue to create the bot.', he:'בחרת Telegram, נמשיך ליצירת הבוט.'}\n862\t      },\n863\t      {\n864\t        do:{en:'Do this in the <b>Telegram app on your phone or desktop</b>, not in a new browser tab. ⚠️ Important: leave the server Console tab open and don’t switch away from it for too long, the browser Console disconnects if you leave it in the background. In Telegram’s <b>search bar at the very top</b>, type <code>@BotFather</code> and tap the result with a <b>blue verified checkmark</b>.', he:'עושים את זה ב<b>אפליקציית טלגרם בטלפון או במחשב</b>, לא בטאב חדש בדפדפן. ⚠️ חשוב: השאר את טאב ה-Console של השרת פתוח ואל תעבור ממנו לזמן רב, ה-Console בדפדפן מתנתק אם משאירים אותו ברקע. בשורת החיפוש של טלגרם למעלה מקלידים <code>@BotFather</code> ולוחצים על התוצאה עם <b>הסימן הכחול המאומת</b>.'},\n865\t        cmd:'@BotFather',\n866\t        shot:null,\n867\t        ok:{en:'A chat opens with \"BotFather\", with a blue checkmark next to the name.', he:'נפתח צ\\'אט עם “BotFather”, עם וי כחול ליד השם.'},\n868\t        stuck:{en:'Console says “Disconnected” when you come back? No harm done, just click <b>Reload</b> and, if needed, re-run <code>cd nanoclaw && bash nanoclaw.sh</code>, it picks up where it left off (fast, since the heavy parts are already built). Several BotFather results? Pick the one with the blue verified badge, that’s the only official one.', he:'ה-Console כתוב בו “Disconnected” כשחזרת? לא נורא, פשוט לוחצים <b>Reload</b> ואם צריך מריצים שוב <code>cd nanoclaw && bash nanoclaw.sh</code>, הוא ממשיך מאיפה שעצר (מהר, כי החלקים הכבדים כבר בנויים). כמה תוצאות BotFather? בחר את זו עם הוי הכחול המאומת, זו היחידה הרשמית.'}\n869\t      },\n870\t      {\n871\t        do:{en:'At the bottom message box, type <code>/newbot</code> and send it.', he:'בתיבת ההודעה למטה מקלידים <code>/newbot</code> ושולחים.'},\n872\t        cmd:'/newbot',\n873\t        shot:null,\n874\t        ok:{en:'BotFather replies and asks for a name for your bot.', he:'BotFather עונה ומבקש שם לבוט שלך.'}\n875\t      },\n876\t      {\n877\t        do:{en:'Send a <b>name</b> (anything, e.g. “My Agent”). Then send a <b>username</b> that must end in <code>bot</code> (e.g. <code>myagent_bot</code>).', he:'שולחים <b>שם</b> (כל דבר, למשל “הסוכן שלי”). אחר כך שולחים <b>שם משתמש</b> שחייב להסתיים ב-<code>bot</code> (למשל <code>myagent_bot</code>).'},\n878\t        shot:null,\n879\t        ok:{en:'BotFather confirms and sends a message containing your token.', he:'BotFather מאשר ושולח הודעה שמכילה את הטוקן שלך.'},\n880\t        stuck:{en:'“Username is already taken”? Just try another one, add a number or word before “bot”.', he:'“שם המשתמש כבר תפוס”? פשוט נסה אחר, הוסף מספר או מילה לפני “bot”.'}\n881\t      },\n882\t      {\n883\t        do:{en:'In that message, <b>copy the WHOLE token</b>, a long line that looks like <code>123456789:AAH...</code>. It has two parts: the <b>numbers</b>, a <b>colon</b> <code>:</code>, then letters. You need <b>all of it</b>, including the numbers before the colon. On a phone, long-press the line and tap Copy.', he:'בהודעה הזו <b>מעתיקים את כל הטוקן</b>, שורה ארוכה שנראית כמו <code>123456789:AAH...</code>. יש לו שני חלקים: <b>מספרים</b>, <b>נקודתיים</b> <code>:</code>, ואז אותיות. צריך את <b>הכל</b>, כולל המספרים שלפני הנקודתיים. בנייד, לחיצה ארוכה על השורה ואז Copy.'},\n884\t        shot:'shots/tg-botfather.jpg',\n885\t        ok:{en:'The token is copied to your clipboard.', he:'הטוקן הועתק.'},\n886\t        stuck:{en:'Easy mistake: copying only the part <i>after</i> the colon. The token must include the numbers and the <code>:</code> at the start, or the installer rejects it. The token is the line right after “Use this token to access the HTTP API”.', he:'טעות נפוצה: להעתיק רק את החלק <i>אחרי</i> הנקודתיים. הטוקן חייב לכלול את המספרים ואת ה-<code>:</code> בהתחלה, אחרת המתקין דוחה אותו. הטוקן הוא השורה מיד אחרי “Use this token to access the HTTP API”.'}\n887\t      },\n888\t      {\n889\t        do:{en:'Go back to the installer in your server terminal. When it asks for your Telegram token, <b>paste it and press Enter</b>.', he:'חוזרים למתקין בטרמינל של השרת. כשהוא מבקש את טוקן הטלגרם, <b>מדביקים ולוחצים Enter</b>.'},\n890\t        shot:'shots/tg-token-prompt.jpg',\n891\t        ok:{en:'It finds your bot (“Found your bot: @yourbot”) and shows a short <b>secret code</b> on screen.', he:'הוא מוצא את הבוט שלך (“Found your bot: @yourbot”) ומציג <b>קוד סודי</b> קצר על המסך.'},\n892\t        stuck:{en:'“Telegram didn’t accept that token”? Copy it again from BotFather, it’s easy to miss a character, and paste once more.', he:'“Telegram didn’t accept that token”? העתק אותו שוב מ-BotFather, קל לפספס תו, והדבק עוד פעם.'}\n893\t      },\n894\t      {\n895\t        do:{en:'Open the chat with <b>your own bot</b> in Telegram (search its <code>@username</code>) and <b>send it that secret code</b> as a message.', he:'פותחים בטלגרם את הצ\\'אט עם <b>הבוט שלך</b> (מחפשים את ה-<code>@username</code> שלו) ו<b>שולחים לו את הקוד הסודי</b> כהודעה.'},\n896\t        shot:'shots/tg-paircode.jpg',\n897\t        ok:{en:'The installer prints <code>Telegram paired.</code>, then asks what to name your assistant (default <b>Nano</b>), type a name or just press Enter.', he:'המתקין מדפיס <code>Telegram paired.</code>, ואז שואל איך לקרוא לסוכן (ברירת מחדל <b>Nano</b>), מקלידים שם או פשוט לוחצים Enter.'},\n898\t        stuck:{en:'Sent it and nothing happened? Make sure you sent the code to <i>your</i> bot (not to BotFather), exactly as shown. A wrong code just lets you try again; an expired one is replaced automatically.', he:'שלחת וכלום לא קרה? ודא ששלחת את הקוד ל<i>בוט שלך</i> (לא ל-BotFather), בדיוק כמו שמופיע. קוד שגוי פשוט מאפשר לנסות שוב; קוד שפג תוקפו מוחלף אוטומטית.'}\n899\t      },\n900\t      {\n901\t        do:{en:'The installer prints <code>Telegram paired</code> and your bot is connected.', he:'המתקין מדפיס <code>Telegram paired</code> והבוט שלך מחובר.'},\n902\t        shot:'shots/tg-ready.jpg',\n903\t        ok:{en:'The bot is connected, all that\\'s left is to say hello.', he:'הבוט מחובר, נשאר רק להגיד שלום.'}\n904\t      }\n905\t    ],\n906\t    note:{en:'Prefer WhatsApp? Possible, but it needs a separate phone number. Tip: turn on WhatsApp Business as a second line on the same phone. Telegram is simpler to start with.', he:'מעדיף וואטסאפ? אפשר, אבל הוא דורש מספר טלפון נפרד. טיפ: הפעל WhatsApp Business כקו שני על אותו טלפון. טלגרם פשוט יותר להתחלה.'}\n907\t  },\n908\t  {\n909\t    phase:'launch', status:'ready', owner:'you',\n910\t    openWhat:true,\n911\t    title:{en:'Say hello to NanoClaw', he:'תגיד שלום ל-NanoClaw שלך'},\n912\t    what:{\n913\t      en:'Your agent is alive. Open Telegram, send it a message, and watch it reply. You don’t need to know anything else, the moment you say hi, it greets you and gives you a short guided tour of what it can do. Tip: if it ever explains something too technically, just tell it “I have no technical background, explain simply”, and it will. No commands to memorize, just talk to it like a person. From here it’s yours, and it learns and grows together with you.',\n914\t      he:'הסוכן חי. פותחים את טלגרם, שולחים לו הודעה, ורואים אותו עונה. אתה לא צריך לדעת שום דבר נוסף, ברגע שתגיד היי, הוא יקבל אותך ויעשה לך סיור קצר ומודרך על מה שהוא יכול לעשות. טיפ: אם הוא מסביר משהו טכני מדי, פשוט תגיד לו “אין לי רקע טכני, תסביר בפשטות”, והוא יעשה את זה. אין פקודות לזכור, פשוט מדברים אתו כמו עם בנאדם. מכאן זה שלך, והוא לומד וייבנה יחד אתך.'\n915\t    },\n916\t    todo:{\n917\t      en:['Open Telegram and find your new bot.','Send <b>“Hi”</b>.','It replies, and greets you with a short tour.','No reply within a minute? A normal first-boot hiccup, the built-in 2-minute self-fix below handles it.'],\n918\t      he:['פותחים טלגרם ומוצאים את הבוט החדש שלך.','שולחים <b>\"היי\"</b>.','הוא עונה, ומקבל אותך עם סיור קצר.','אין תשובה תוך דקה? תקלת אתחול ראשונה רגילה, התיקון העצמי של 2 דקות למטה פותר אותה.']\n919\t    },\n920\t    micro:[\n921\t      {\n922\t        do:{en:'Open Telegram and search for your bot’s <b>username</b>, the one ending in <code>bot</code> that you created.', he:'פותחים טלגרם ומחפשים את <b>שם המשתמש</b> של הבוט, זה שמסתיים ב-<code>bot</code> שיצרת.'},\n923\t        shot:'shots/tg-empty-start.jpg',\n924\t        ok:{en:'Your bot’s chat opens, with a “Start” button or an empty message box. Tap <b>Start</b> if it’s there.', he:'נפתח הצ\\'אט של הבוט, עם כפתור “Start” או תיבת הודעה ריקה. אם יש כפתור <b>Start</b>, לוחצים עליו.'}\n925\t      },\n926\t      {\n927\t        do:{en:'At the bottom, type <b>“Hi”</b> (or anything you like) and send. Then wait up to a minute, the very first message wakes the agent up.', he:'למטה מקלידים <b>“היי”</b> (או כל דבר) ושולחים. ואז ממתינים עד דקה, ההודעה הראשונה מעירה את הסוכן.'},\n928\t        shot:'shots/tg-hello.jpg',"}]},"uuid":"fbd27d2d-e4be-48e1-a5f8-26fc8173e8fe","timestamp":"2026-06-16T20:02:19.571Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/inbox/a2a-1781640103772-8ap4sr/guide.html","content":"    },\n    action:{label:{en:'Open Anthropic Console', he:'פתח את קונסולת Anthropic'}, sub:{en:'console.anthropic.com', he:'console.anthropic.com'}, url:'https://console.anthropic.com/'},\n    micro:[\n      {\n        do:{en:'In your browser’s address bar, open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> and press Enter. The Claude Console login page opens.', he:'בשורת הכתובת של הדפדפן פותחים <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ולוחצים Enter. נפתח דף הכניסה של Claude Console.'},\n        shot:null,\n        ok:{en:'You see the heading “Build with the Claude API” and two ways to sign in, Google or email.', he:'רואים את הכותרת “Build with the Claude API” ושתי דרכים להיכנס, Google או אימייל.'},\n        stuck:{en:'Landed somewhere else? Make sure you open <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> directly, with no “www” and no spaces.', he:'הגעת למקום אחר? ודא שאתה פותח <a href=\"https://console.anthropic.com/\" target=\"_blank\" rel=\"noopener\">console.anthropic.com</a> ישירות, בלי “www” ובלי רווחים.'}\n      },\n      {\n        do:{en:'Easiest path: click <b>“Continue with Google”</b> and pick your Google account. No Google? Type your email, click <b>Continue</b>, and paste the code that arrives in your inbox.', he:'הדרך הקלה: לוחצים <b>“Continue with Google”</b> ובוחרים את חשבון הגוגל שלך. אין גוגל? מקלידים אימייל, לוחצים <b>Continue</b>, ומדביקים את הקוד שמגיע למייל.'},\n        shot:null,\n        ok:{en:'You land on the Console dashboard, with a menu down the left side.', he:'אתה מגיע ללוח הבקרה (Dashboard), עם תפריט בצד.'},\n        stuck:{en:'No email arrived? Check your spam folder, or just use the Google button instead.', he:'לא הגיע מייל? בדוק בתיקיית הספאם, או פשוט השתמש בכפתור של Google.'}\n      },\n      {\n        do:{en:'In the left menu click <b>Billing</b>, then <b>“Add to credit balance”</b>. Choose a small amount (even $5) and enter a card.', he:'בתפריט הצד לוחצים <b>Billing</b>, ואז <b>“Add to credit balance”</b>. בוחרים סכום קטן (אפילו 5$) ומזינים כרטיס.'},\n        shot:'shots/anthropic-dashboard.jpg',\n        ok:{en:'At the top you see a Balance with the amount you loaded, for example $5.00.', he:'למעלה מופיע Balance עם הסכום שטענת, למשל $5.00.'},\n        stuck:{en:'Card declined? Try another card. Remember: with no balance the agent simply won’t answer.', he:'הכרטיס נדחה? נסה כרטיס אחר. זכור: בלי יתרה הסוכן פשוט לא יענה.'}\n      },\n      {\n        do:{en:'In the left menu click <b>API Keys</b>, then the <b>“Create Key”</b> button. Give it a name (like “my-agent”) and click <b>Add</b>.', he:'בתפריט הצד לוחצים <b>API Keys</b>, ואז על הכפתור <b>“Create Key”</b>. נותנים שם (למשל “my-agent”) ולוחצים <b>Add</b>.'},\n        shot:'shots/anthropic-keys.jpg',\n        ok:{en:'A window opens showing a long key that starts with <code>sk-ant-</code>.', he:'נפתח חלון עם מפתח ארוך שמתחיל ב-<code>sk-ant-</code>.'},\n        stuck:{en:'Don’t see “API Keys”? Click the gear / Settings icon next to your account name, it’s in there.', he:'לא רואה “API Keys”? לחץ על גלגל השיניים / Settings ליד שם החשבון, זה שם.'}\n      },\n      {\n        do:{en:'Click <b>Copy</b> and paste the key somewhere safe (a note or document). You only see it once.', he:'לוחצים <b>Copy</b> ומדביקים את המפתח במקום בטוח (פתק או מסמך). רואים אותו פעם אחת בלבד.'},\n        shot:'shots/anthropic-createkey.jpg',\n        ok:{en:'Your key is saved, starting with <code>sk-ant-</code>. The installer will ask for it in the next step.', he:'המפתח שמור אצלך, מתחיל ב-<code>sk-ant-</code>. המתקין יבקש אותו בשלב הבא.'},\n        stuck:{en:'Closed it before copying? No problem, just create a new key. You can always make another.', he:'סגרת לפני שהעתקת? אין בעיה, פשוט צור מפתח חדש. אפשר תמיד.'}\n      }\n    ],\n    note:{en:'Note: the account is free, but the AI is pay-as-you-go. With no balance the agent simply won’t answer, so load a small amount first (even $5 is enough to start).', he:'שימו לב: החשבון חינם, אבל ה-AI בתשלום לפי שימוש. בלי יתרה הסוכן פשוט לא יענה, לכן טוענים סכום קטן מראש (אפילו 5$ מספיקים להתחלה).'}\n  },\n  {\n    phase:'install', status:'ready', owner:'auto',\n    opener:{en:'In this step the agent gets installed on your server. One command downloads NanoClaw and runs an installer that sets up Node, Docker, and the agent container entirely on its own. You paste once and press Enter, it handles everything.', he:'בשלב הזה הסוכן מותקן על השרת שלך. פקודה אחת מורידה את NanoClaw ומפעילה מתקין שמגדיר את Node, Docker וקונטיינר הסוכן לגמרי לבד. מדביקים פעם אחת ולוחצים Enter, הוא מטפל בכל השאר.'},\n    title:{en:'Install the agent on your server', he:'מתקינים את הסוכן על השרת'},\n    what:{\n      en:'This is the magic of NanoClaw: one command that installs everything for you. You paste one line into the server terminal and the smart installer handles the rest. Before you paste: the terminal is the black window from the previous step. You interact in three ways here: (a) some things I write for you to copy and paste, (b) some I show as a screenshot, (c) some you answer by selecting with the ↑/↓ arrow keys, then Enter to confirm.',\n      he:'זה הקסם של נאנו-קלו: פקודה אחת שמתקינה את הכל בשבילך. מדביקים שורה אחת בטרמינל והמתקין דואג לכל השאר. לפני שמדביקים: הטרמינל הוא החלון השחור מהשלב הקודם. יש כאן שלוש דרכי אינטראקציה: (א) חלק אני כותב לך להעתיק-להדביק, (ב) חלק מראה בצילום מסך, (ג) חלק עונים על ידי בחירה במקשי החצים ↑/↓ ואז Enter.'\n    },\n    callout:{en:\"No need to understand the command, just copy, paste, and hit Enter.\", he:\"אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter.\"},\n    todo:{\n      en:['Paste into the terminal: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','The installer runs on its own, it installs every component (a few minutes).','When it asks, paste the Anthropic key from the previous step.','That’s it, it builds your agent and gets it ready to launch.'],\n      he:['מדביקים בטרמינל: <code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>','המתקין רץ לבד, מתקין כל רכיב שצריך (כמה דקות).','כשהוא מבקש, מדביקים את מפתח ה-Anthropic מהשלב הקודם.','זהו, הוא בונה את הסוכן ומכין אותו להפעלה.']\n    },\n    micro:[\n      {\n        do:{en:'Make sure you’re in the black terminal window from the previous step, the one showing a <code>root@...:~#</code> prompt.', he:'מוודאים שאתה בחלון הטרמינל השחור מהשלב הקודם, זה שמראה שורת פקודה <code>root@...:~#</code>.'},\n        shot:null,\n        ok:{en:'The cursor is blinking next to the <code>#</code> prompt, ready for you to type.', he:'הסמן מהבהב ליד הסימן <code>#</code>, מוכן שתקליד.'},\n        stuck:{en:'Closed the Console? Go back to your server in DigitalOcean and click “Console” again.', he:'סגרת את ה-Console? חזור לשרת ב-DigitalOcean ולחץ שוב על “Console”.'}\n      },\n      {\n        cmd:\"git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh\",\n        do:{en:'Copy this exact line, paste it into the terminal (right-click → Paste, or Ctrl+Shift+V), and press <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>', he:'מעתיקים את השורה הזו בדיוק, מדביקים בטרמינל (קליק ימני → Paste, או Ctrl+Shift+V), ולוחצים <b>Enter</b>:<br><code>git clone https://github.com/nanocoai/nanoclaw.git && cd nanoclaw && bash nanoclaw.sh</code>'},\n        shot:'shots/do-paste-cmd.jpg',\n        ok:{en:'Text starts scrolling by, it’s installing. Don’t close the window.', he:'טקסט מתחיל לזרום על המסך, זה מתקין. אל תסגור את החלון.'},\n        stuck:{en:'You don’t need to understand the text flying by, that’s normal. If it ever stops with an error, the installer tries to fix itself; just give it a moment.', he:'אתה לא צריך להבין את הטקסט שרץ, זה נורמלי. אם זה נעצר עם שגיאה, המתקין מנסה לתקן את עצמו; פשוט תן לו רגע.'}\n      },\n      {\n        do:{en:'This is what the installer looks like as it runs: the NanoClaw banner, then a series of steps it handles almost by itself. The next micros walk you through them one by one.', he:'ככה נראה המתקין רץ: באנר NanoClaw, ואז סדרת שלבים שהוא מבצע כמעט לבד. בצעדים הבאים נעבור עליהם אחד אחד.'},\n        shot:'shots/term-flow-clean.jpg',\n        ok:{en:'You see text flowing, the install has started.', he:'אתה רואה טקסט זורם, ההתקנה התחילה.'}\n      },\n      {\n        do:{en:'⚠️ Right at the start it <b>will</b> stop and warn <i>“you are running as root”</i>, then ask <code>Choose [1/2]</code>. <b>Type <code>2</code> and press Enter</b> to continue. Important: don’t just press Enter on its own, the default is option 1, which stops the install and dumps a wall of commands. Type the <b>2</b> first.', he:'⚠️ ממש בהתחלה הוא <b>יעצור</b> ויזהיר <i>“you are running as root”</i>, ואז ישאל <code>Choose [1/2]</code>. <b>מקלידים <code>2</code> ולוחצים Enter</b> כדי להמשיך. חשוב: אל תלחץ Enter לבד, ברירת המחדל היא אפשרות 1, שעוצרת את ההתקנה ושופכת קיר של פקודות. הקלד קודם <b>2</b>.'},\n        shot:'shots/term-run.jpg',\n        ok:{en:'It accepts your choice and the installation keeps going.', he:'הוא מקבל את הבחירה וההתקנה ממשיכה.'},\n        stuck:{en:'See a different warning asking “Try anyway? [y/N]” about memory or Google Cloud? That means the server is too small or on Google Cloud, stop, and use a 4 GB DigitalOcean machine instead (see the server step).', he:'רואה אזהרה אחרת “Try anyway? [y/N]” על זיכרון או Google Cloud? סימן שהשרת קטן מדי או על Google Cloud, עצור, והשתמש במכונה של 4GB ב-DigitalOcean (ראה שלב השרת).'}\n      },\n      {\n        do:{en:'After you type <code>2</code> and press Enter, the install continues.', he:'אחרי שהקלדת <code>2</code> ולחצת Enter, ההתקנה ממשיכה הלאה.'},\n        shot:'shots/term-root-choice.jpg',\n        ok:{en:'The installer accepted your choice.', he:'המתקין קיבל את הבחירה.'}\n      },\n      {\n        do:{en:'Next it asks <i>“How would you like to begin?”</i> with two options. Pick <b>Standard setup</b> (use the arrow keys if needed, then Enter). It’s the guided path that does everything for you, Advanced is for developers and you don’t want it.', he:'אחר כך הוא שואל <i>“How would you like to begin?”</i> עם שתי אפשרויות. בוחרים <b>Standard setup</b> (במקשי החצים אם צריך, ואז Enter). זה המסלול המודרך שעושה הכל בשבילך, Advanced מיועד למפתחים ואתה לא רוצה אותו.'},\n        shot:'shots/term-begin.jpg',\n        ok:{en:'It runs a quick system check and says something like <code>Your system looks good</code>.', he:'הוא מריץ בדיקת מערכת קצרה ואומר משהו כמו <code>Your system looks good</code>.'},\n        stuck:{en:'Picked Advanced by mistake? No drama, press <b>Ctrl+C</b> to stop, then run the same line again (<code>cd nanoclaw && bash nanoclaw.sh</code>) and choose Standard this time.', he:'בחרת Advanced בטעות? לא נורא, לוחצים <b>Ctrl+C</b> כדי לעצור, ואז מריצים שוב את אותה שורה (<code>cd nanoclaw && bash nanoclaw.sh</code>) ובוחרים Standard הפעם.'}\n      },\n      {\n        do:{en:'It says it’s <b>preparing your assistant’s sandbox</b>, this is the longest part, about <b>3–10 minutes</b> on a fresh machine. Just wait; let it run.', he:'הוא אומר שהוא <b>מכין את ה-sandbox של הסוכן</b>, זה החלק הארוך ביותר, בערך <b>3–10 דקות</b> במכונה חדשה. פשוט מחכים ונותנים לו לרוץ.'},\n        shot:'shots/term-sandbox.jpg',\n        ok:{en:'It prints <code>Sandbox ready.</code> and moves on by itself.', he:'הוא מדפיס <code>Sandbox ready.</code> וממשיך לבד.'},\n        stuck:{en:'As long as the spinner keeps ticking the seconds, it’s working, don’t touch it. A first build really can take up to 10 minutes.', he:'כל עוד הספינר ממשיך לספור שניות, זה עובד, אל תיגע. בנייה ראשונה באמת יכולה לקחת עד 10 דקות.'}\n      },\n      {\n        do:{en:'If it looks stuck with no output for a few dozen seconds, <b>that\\'s normal</b>. The first build takes time, don\\'t touch it, just let it run.', he:'אם הוא נראה תקוע ואין פלט כמה עשרות שניות, <b>זה נורמלי</b>. הבנייה הראשונה לוקחת זמן, אל תיגע, פשוט תן לו.'},\n        shot:'shots/term-sandbox-wait.jpg',\n        ok:{en:'The spinner keeps going, that means it\\'s working.', he:'הספינר ממשיך, סימן שהוא עובד.'}\n      },\n      {\n        do:{en:'It announces <code>Sandbox ready</code> then <code>OneCLI vault ready</code>. The vault adds your keys to approved requests so your key is never exposed directly to the agent.', he:'הוא מודיע <code>Sandbox ready</code> ואז <code>OneCLI vault ready</code>. הכספת מוסיפה את המפתחות לבקשות מאושרות, כך שהמפתח שלך לא נחשף לסוכן ישירות.'},\n        shot:'shots/term-vault-ready.jpg',\n        ok:{en:'The environment is ready, it continues on its own.', he:'הסביבה מוכנה, הוא ממשיך לבד.'}\n      },\n      {\n        do:{en:'The installer detects the OneCLI vault and connects it automatically, nothing to do here.', he:'המתקין מזהה את כספת OneCLI ומחבר אותה אוטומטית, אין מה לעשות פה.'},\n        shot:'shots/term-onecli-found.jpg',\n        ok:{en:'The vault is connected.', he:'הכספת מחוברת.'}\n      },\n      {\n        do:{en:'It may ask <i>“Which agent runtime?”</i> and offer <b>Claude</b> (the default) or Codex. Pick <b>Claude</b> and press <b>Enter</b>. That’s the brain you set up the key for.', he:'ייתכן שהוא ישאל <i>“Which agent runtime?”</i> ויציע <b>Claude</b> (ברירת המחדל) או Codex. בוחרים <b>Claude</b> ולוחצים <b>Enter</b>. זה ה\"מוח\" שבשבילו הכנת את המפתח.'},\n        shot:null,\n        ok:{en:'It accepts Claude and moves to connecting your key.', he:'הוא מקבל את Claude ועובר לחיבור המפתח שלך.'},\n        stuck:{en:'Didn’t see this question at all? That’s fine, on some versions Claude is chosen automatically and it skips straight to the key.', he:'לא ראית את השאלה הזו בכלל? בסדר גמור, בחלק מהגרסאות Claude נבחר אוטומטית והוא מדלג ישר למפתח.'}\n      },\n      {\n        do:{en:'It asks <i>“How would you like to connect to Claude?”</i> with a short menu. Use the arrow keys to highlight <b>“Paste an Anthropic API key”</b> (not “Sign in with subscription”, not “Paste OAuth token”), press <b>Enter</b>, then paste the <code>sk-ant-</code> key you saved earlier and press <b>Enter</b> again.', he:'הוא שואל <i>“How would you like to connect to Claude?”</i> עם תפריט קצר. בעזרת מקשי החצים מסמנים <b>“Paste an Anthropic API key”</b> (לא “Sign in with subscription”, לא “Paste OAuth token”), לוחצים <b>Enter</b>, ואז מדביקים את המפתח <code>sk-ant-</code> ששמרת קודם ולוחצים <b>Enter</b> שוב.'},\n        shot:'shots/term-connect-menu.jpg',\n        ok:{en:'It prints <code>Claude account connected.</code> and continues.', he:'הוא מדפיס <code>Claude account connected.</code> וממשיך.'},\n        stuck:{en:'Pasting doesn’t show the key? That’s a security feature, it’s there. If it says the token “looks truncated”, make the terminal window wider and paste again so the key fits on one line.', he:'ההדבקה לא מציגה את המפתח? זו תכונת אבטחה, הוא שם. אם כתוב שהטוקן “looks truncated”, הרחב את חלון הטרמינל והדבק שוב כדי שהמפתח ייכנס בשורה אחת.'}\n      },\n      {\n        do:{en:'After you choose <b>Paste an Anthropic API key</b>, it asks for the key. Paste the <code>sk-ant-</code> key you saved and press Enter.', he:'אחרי שבחרת <b>Paste an Anthropic API key</b>, הוא מבקש את המפתח. מדביקים את המפתח <code>sk-ant-</code> ששמרת ולוחצים Enter.'},\n        shot:'shots/term-key-prompt.jpg',\n        ok:{en:'It\\'s waiting for your key.', he:'הוא מחכה למפתח שלך.'}\n      },\n      {\n        do:{en:'Pasting shows as dots, that\\'s a security feature, the key is there. Press Enter and it confirms <code>Claude account connected</code>.', he:'ההדבקה מופיעה כנקודות, זו תכונת אבטחה, המפתח שם. לוחצים Enter והוא מאשר <code>Claude account connected</code>.'},\n        shot:'shots/term-key-entered.jpg',\n        ok:{en:'The key was accepted and the connection confirmed.', he:'המפתח התקבל והחיבור אושר.'}\n      },\n      {\n        do:{en:'It asks <i>“What should your assistant call you?”</i>. Type your <b>name</b> and press <b>Enter</b>.', he:'הוא שואל <i>“What should your assistant call you?”</i>. מקלידים את <b>השם</b> שלך ולוחצים <b>Enter</b>.'},\n        shot:'shots/term-name-you.jpg',\n        ok:{en:'It then runs a quick self-test (“ping/pong”) while the agent wakes up for the first time.', he:'אז הוא מריץ בדיקה עצמית קצרה (“ping/pong”) בזמן שהסוכן מתעורר בפעם הראשונה.'},\n        stuck:{en:'If it asks “What next?”, choose <b>Continue with setup</b>.', he:'אם הוא שואל “What next?”, בחר <b>Continue with setup</b>.'}\n      },\n      {\n        do:{en:'On a new machine the self-test can fail the first time, <b>that\\'s expected</b>. When it offers to install a helper (Claude) to check things, choose <b>Yes</b>.', he:'במכונה חדשה הבדיקה העצמית יכולה להיכשל בפעם הראשונה, <b>זה צפוי</b>. כשהוא מציע להתקין עוזר (Claude) כדי לבדוק, בוחרים <b>Yes</b>.'},\n        shot:'shots/term-noreply.jpg',\n        ok:{en:'It starts installing the helper.', he:'הוא מתחיל להתקין את העוזר.'}\n      },\n      {\n        do:{en:'It installs the Claude tool in the background. A few moments and it\\'s done on its own.', he:'הוא מתקין את כלי ה-Claude ברקע. כמה רגעים וזה נגמר לבד.'},\n        shot:'shots/term-cli-install.jpg',\n        ok:{en:'The install finished and it continues.', he:'ההתקנה הסתיימה והוא ממשיך.'}\n      },\n      {\n        edge:true, do:{en:'⏳ On a brand-new machine the self-test can take 30–60 seconds, or even time out the first time. <b>That’s normal, not a failure.</b> If the installer offers to install a helper (Claude) to check things, choose <b>Yes</b>. If it then needs you to sign in, it shows a <b>link</b> (with “press c to copy”). Open that link in your browser, sign in, click <b>Authorize</b>, copy the code it gives you, return to the Console, <b>right-click → Paste</b>, and press <b>Enter</b>.', he:'⏳ במכונה חדשה לגמרי הבדיקה יכולה לקחת 30–60 שניות, ולפעמים אפילו נגמר לה הזמן בפעם הראשונה. <b>זה נורמלי, לא תקלה.</b> אם המתקין מציע להתקין עוזר (Claude) כדי לבדוק, בוחרים <b>Yes</b>. אם הוא צריך שתתחבר, הוא מציג <b>קישור</b> (עם “press c to copy”). פותחים את הקישור בדפדפן, מתחברים, לוחצים <b>Authorize</b>, מעתיקים את הקוד שהוא נותן, חוזרים ל-Console, <b>קליק ימני → Paste</b>, ולוחצים <b>Enter</b>.'},\n        shot:null,\n        ok:{en:'It finishes signing in and continues on its own. It may ask you to sign in a <b>second time</b> with broader permissions, just do the exact same thing.', he:'הוא מסיים להתחבר וממשיך לבד. ייתכן שהוא יבקש להתחבר <b>פעם שנייה</b> עם הרשאות רחבות יותר, פשוט עושים בדיוק אותו דבר.'},\n        stuck:{en:'When it finishes and says something like “type /exit to resume”, type <code>/exit</code> (<b>with the slash</b>, not just “exit”) and press Enter to continue setup.', he:'כשהוא מסיים ואומר משהו כמו “type /exit to resume”, מקלידים <code>/exit</code> (<b>עם הלוכסן</b>, לא רק “exit”) ולוחצים Enter כדי להמשיך בהתקנה.'}\n      },\n      {\n        cmd:\"Asia/Jerusalem\",\n        do:{en:'It asks about your <b>timezone</b> (“Your system reports UTC, is that right, or are you somewhere else?”). Choose <b>“I’m somewhere else”</b>, then when it asks <i>“Where are you?”</i>, type your timezone and press Enter. In Israel, copy exactly:<br><code>Asia/Jerusalem</code>', he:'הוא שואל על <b>אזור הזמן</b> (“Your system reports UTC, is that right, or are you somewhere else?”). בוחרים <b>“I’m somewhere else”</b>, ואז כשהוא שואל <i>“Where are you?”</i> מקלידים את אזור הזמן ולוחצים Enter. בישראל, מעתיקים בדיוק:<br><code>Asia/Jerusalem</code>'},\n        shot:null,\n        ok:{en:'It prints <code>Timezone set to Asia/Jerusalem</code> and moves on.', he:'הוא מדפיס <code>Timezone set to Asia/Jerusalem</code> וממשיך.'},\n        stuck:{en:'Not in Israel? Type yours in the same <b>Region/City</b> format, e.g. <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.', he:'לא בישראל? הקלד את שלך באותו פורמט <b>Region/City</b>, למשל <code>Europe/London</code>, <code>America/New_York</code>, <code>Asia/Dubai</code>.'}\n      },\n      {\n        do:{en:'Next it will ask to connect a chat app, that’s the following step. When you finish that, the installer shows a final <b>“You’re set”</b> message.', he:'אחר כך הוא יבקש לחבר אפליקציית צ\\'אט, זה השלב הבא. כשתסיים אותו, המתקין יציג הודעת סיום <b>“You’re set”</b>.'},\n        shot:'shots/term-5-set.png',\n        ok:{en:'You see the success message, the hard part is over. Now you’ll go say hello (the last step). One thing worth knowing up front: on a brand-new server the very first message sometimes needs a small nudge before the agent answers, that’s normal, and the last step walks you through the quick 2-minute self-fix if it happens.', he:'אתה רואה את הודעת ההצלחה, החלק הקשה מאחורינו. עכשיו הולכים להגיד שלום (השלב האחרון). דבר אחד ששווה לדעת מראש: בשרת חדש לגמרי, לפעמים ההודעה הראשונה צריכה דחיפה קטנה לפני שהסוכן עונה, זה נורמלי, והשלב האחרון מלווה אותך בתיקון העצמי המהיר של 2 דקות אם זה קורה.'},\n        stuck:{en:'If it ends with “a few things still need your attention”, the installer can launch Claude to diagnose and fix it for you, let it.', he:'אם זה מסתיים ב-“a few things still need your attention”, המתקין יכול להפעיל את Claude כדי לאבחן ולתקן בשבילך, תן לו.'}\n      }\n    ],\n    note:{en:'No need to understand the command, just copy, paste, and hit Enter. The installer explains each step as it goes, and if it gets stuck it tries to solve it on its own.', he:'אין צורך להבין את הפקודה, רק להעתיק, להדביק וללחוץ Enter. המתקין מסביר כל שלב תוך כדי, ואם הוא נתקע הוא מנסה לפתור לבד.'}\n  },\n  {\n    phase:'connect', status:'ready', owner:'you',\n    title:{en:'Connect your chat app', he:'חיבור אפליקציית הצ\\'אט'},\n    what:{\n      en:'This is how you will actually talk to your agent. NanoClaw can connect to Telegram, Slack, WhatsApp, and more. Our recommendation: start with Telegram first, because with Telegram you do NOT need a phone number. In this guide I show the Telegram setup. If you do not have Telegram Desktop yet, install it now: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.',\n      he:'כך תדבר עם הסוכן בפועל. NanoClaw יכול להתחבר לטלגרם, Slack, וואטסאפ ועוד. ההמלצה שלנו: להתחיל עם טלגרם קודם, כי עם טלגרם לא צריך מספר טלפון. במדריך זה מראים את החיבור לטלגרם. אם עדיין אין לך Telegram Desktop, התקן עכשיו: <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">telegram.org/dl</a>. Desktop: <a href=\"https://desktop.telegram.org\" target=\"_blank\" rel=\"noopener\">desktop.telegram.org</a>.'\n    },\n    callout:{en:\"Sounds technical, but it's just copy, paste, and click.\", he:\"זה נשמע טכני אבל זה רק העתק-הדבק וללחוץ.\"},\n    todo:{\n      en:['In Telegram, open a chat with <code>@BotFather</code> and create a new bot.','It gives you a token (a line of code), copy it.','Paste it into the installer when it asks, and your bot is connected.'],\n      he:['בטלגרם, פותחים צ\\'אט עם <code>@BotFather</code> ויוצרים בוט חדש.','הוא נותן לך טוקן (שורת קוד), מעתיקים אותו.','מדביקים אותו למתקין כשהוא מבקש, והבוט מחובר.']\n    },\n    micro:[\n      {\n        do:{en:'The installer asks which chat app to connect. Choose <b>Telegram</b> (use the arrow keys then Enter).', he:'המתקין שואל לאיזו אפליקציית צ\\'אט לחבר. בוחרים <b>Telegram</b> (במקשי החצים ואז Enter).'},\n        shot:'shots/tg-channel-menu.jpg',\n        ok:{en:'You chose Telegram, let\\'s continue to create the bot.', he:'בחרת Telegram, נמשיך ליצירת הבוט.'}\n      },\n      {\n        do:{en:'Do this in the <b>Telegram app on your phone or desktop</b>, not in a new browser tab. ⚠️ Important: leave the server Console tab open and don’t switch away from it for too long, the browser Console disconnects if you leave it in the background. In Telegram’s <b>search bar at the very top</b>, type <code>@BotFather</code> and tap the result with a <b>blue verified checkmark</b>.', he:'עושים את זה ב<b>אפליקציית טלגרם בטלפון או במחשב</b>, לא בטאב חדש בדפדפן. ⚠️ חשוב: השאר את טאב ה-Console של השרת פתוח ואל תעבור ממנו לזמן רב, ה-Console בדפדפן מתנתק אם משאירים אותו ברקע. בשורת החיפוש של טלגרם למעלה מקלידים <code>@BotFather</code> ולוחצים על התוצאה עם <b>הסימן הכחול המאומת</b>.'},\n        cmd:'@BotFather',\n        shot:null,\n        ok:{en:'A chat opens with \"BotFather\", with a blue checkmark next to the name.', he:'נפתח צ\\'אט עם “BotFather”, עם וי כחול ליד השם.'},\n        stuck:{en:'Console says “Disconnected” when you come back? No harm done, just click <b>Reload</b> and, if needed, re-run <code>cd nanoclaw && bash nanoclaw.sh</code>, it picks up where it left off (fast, since the heavy parts are already built). Several BotFather results? Pick the one with the blue verified badge, that’s the only official one.', he:'ה-Console כתוב בו “Disconnected” כשחזרת? לא נורא, פשוט לוחצים <b>Reload</b> ואם צריך מריצים שוב <code>cd nanoclaw && bash nanoclaw.sh</code>, הוא ממשיך מאיפה שעצר (מהר, כי החלקים הכבדים כבר בנויים). כמה תוצאות BotFather? בחר את זו עם הוי הכחול המאומת, זו היחידה הרשמית.'}\n      },\n      {\n        do:{en:'At the bottom message box, type <code>/newbot</code> and send it.', he:'בתיבת ההודעה למטה מקלידים <code>/newbot</code> ושולחים.'},\n        cmd:'/newbot',\n        shot:null,\n        ok:{en:'BotFather replies and asks for a name for your bot.', he:'BotFather עונה ומבקש שם לבוט שלך.'}\n      },\n      {\n        do:{en:'Send a <b>name</b> (anything, e.g. “My Agent”). Then send a <b>username</b> that must end in <code>bot</code> (e.g. <code>myagent_bot</code>).', he:'שולחים <b>שם</b> (כל דבר, למשל “הסוכן שלי”). אחר כך שולחים <b>שם משתמש</b> שחייב להסתיים ב-<code>bot</code> (למשל <code>myagent_bot</code>).'},\n        shot:null,\n        ok:{en:'BotFather confirms and sends a message containing your token.', he:'BotFather מאשר ושולח הודעה שמכילה את הטוקן שלך.'},\n        stuck:{en:'“Username is already taken”? Just try another one, add a number or word before “bot”.', he:'“שם המשתמש כבר תפוס”? פשוט נסה אחר, הוסף מספר או מילה לפני “bot”.'}\n      },\n      {\n        do:{en:'In that message, <b>copy the WHOLE token</b>, a long line that looks like <code>123456789:AAH...</code>. It has two parts: the <b>numbers</b>, a <b>colon</b> <code>:</code>, then letters. You need <b>all of it</b>, including the numbers before the colon. On a phone, long-press the line and tap Copy.', he:'בהודעה הזו <b>מעתיקים את כל הטוקן</b>, שורה ארוכה שנראית כמו <code>123456789:AAH...</code>. יש לו שני חלקים: <b>מספרים</b>, <b>נקודתיים</b> <code>:</code>, ואז אותיות. צריך את <b>הכל</b>, כולל המספרים שלפני הנקודתיים. בנייד, לחיצה ארוכה על השורה ואז Copy.'},\n        shot:'shots/tg-botfather.jpg',\n        ok:{en:'The token is copied to your clipboard.', he:'הטוקן הועתק.'},\n        stuck:{en:'Easy mistake: copying only the part <i>after</i> the colon. The token must include the numbers and the <code>:</code> at the start, or the installer rejects it. The token is the line right after “Use this token to access the HTTP API”.', he:'טעות נפוצה: להעתיק רק את החלק <i>אחרי</i> הנקודתיים. הטוקן חייב לכלול את המספרים ואת ה-<code>:</code> בהתחלה, אחרת המתקין דוחה אותו. הטוקן הוא השורה מיד אחרי “Use this token to access the HTTP API”.'}\n      },\n      {\n        do:{en:'Go back to the installer in your server terminal. When it asks for your Telegram token, <b>paste it and press Enter</b>.', he:'חוזרים למתקין בטרמינל של השרת. כשהוא מבקש את טוקן הטלגרם, <b>מדביקים ולוחצים Enter</b>.'},\n        shot:'shots/tg-token-prompt.jpg',\n        ok:{en:'It finds your bot (“Found your bot: @yourbot”) and shows a short <b>secret code</b> on screen.', he:'הוא מוצא את הבוט שלך (“Found your bot: @yourbot”) ומציג <b>קוד סודי</b> קצר על המסך.'},\n        stuck:{en:'“Telegram didn’t accept that token”? Copy it again from BotFather, it’s easy to miss a character, and paste once more.', he:'“Telegram didn’t accept that token”? העתק אותו שוב מ-BotFather, קל לפספס תו, והדבק עוד פעם.'}\n      },\n      {\n        do:{en:'Open the chat with <b>your own bot</b> in Telegram (search its <code>@username</code>) and <b>send it that secret code</b> as a message.', he:'פותחים בטלגרם את הצ\\'אט עם <b>הבוט שלך</b> (מחפשים את ה-<code>@username</code> שלו) ו<b>שולחים לו את הקוד הסודי</b> כהודעה.'},\n        shot:'shots/tg-paircode.jpg',\n        ok:{en:'The installer prints <code>Telegram paired.</code>, then asks what to name your assistant (default <b>Nano</b>), type a name or just press Enter.', he:'המתקין מדפיס <code>Telegram paired.</code>, ואז שואל איך לקרוא לסוכן (ברירת מחדל <b>Nano</b>), מקלידים שם או פשוט לוחצים Enter.'},\n        stuck:{en:'Sent it and nothing happened? Make sure you sent the code to <i>your</i> bot (not to BotFather), exactly as shown. A wrong code just lets you try again; an expired one is replaced automatically.', he:'שלחת וכלום לא קרה? ודא ששלחת את הקוד ל<i>בוט שלך</i> (לא ל-BotFather), בדיוק כמו שמופיע. קוד שגוי פשוט מאפשר לנסות שוב; קוד שפג תוקפו מוחלף אוטומטית.'}\n      },\n      {\n        do:{en:'The installer prints <code>Telegram paired</code> and your bot is connected.', he:'המתקין מדפיס <code>Telegram paired</code> והבוט שלך מחובר.'},\n        shot:'shots/tg-ready.jpg',\n        ok:{en:'The bot is connected, all that\\'s left is to say hello.', he:'הבוט מחובר, נשאר רק להגיד שלום.'}\n      }\n    ],\n    note:{en:'Prefer WhatsApp? Possible, but it needs a separate phone number. Tip: turn on WhatsApp Business as a second line on the same phone. Telegram is simpler to start with.', he:'מעדיף וואטסאפ? אפשר, אבל הוא דורש מספר טלפון נפרד. טיפ: הפעל WhatsApp Business כקו שני על אותו טלפון. טלגרם פשוט יותר להתחלה.'}\n  },\n  {\n    phase:'launch', status:'ready', owner:'you',\n    openWhat:true,\n    title:{en:'Say hello to NanoClaw', he:'תגיד שלום ל-NanoClaw שלך'},\n    what:{\n      en:'Your agent is alive. Open Telegram, send it a message, and watch it reply. You don’t need to know anything else, the moment you say hi, it greets you and gives you a short guided tour of what it can do. Tip: if it ever explains something too technically, just tell it “I have no technical background, explain simply”, and it will. No commands to memorize, just talk to it like a person. From here it’s yours, and it learns and grows together with you.',\n      he:'הסוכן חי. פותחים את טלגרם, שולחים לו הודעה, ורואים אותו עונה. אתה לא צריך לדעת שום דבר נוסף, ברגע שתגיד היי, הוא יקבל אותך ויעשה לך סיור קצר ומודרך על מה שהוא יכול לעשות. טיפ: אם הוא מסביר משהו טכני מדי, פשוט תגיד לו “אין לי רקע טכני, תסביר בפשטות”, והוא יעשה את זה. אין פקודות לזכור, פשוט מדברים אתו כמו עם בנאדם. מכאן זה שלך, והוא לומד וייבנה יחד אתך.'\n    },\n    todo:{\n      en:['Open Telegram and find your new bot.','Send <b>“Hi”</b>.','It replies, and greets you with a short tour.','No reply within a minute? A normal first-boot hiccup, the built-in 2-minute self-fix below handles it.'],\n      he:['פותחים טלגרם ומוצאים את הבוט החדש שלך.','שולחים <b>\"היי\"</b>.','הוא עונה, ומקבל אותך עם סיור קצר.','אין תשובה תוך דקה? תקלת אתחול ראשונה רגילה, התיקון העצמי של 2 דקות למטה פותר אותה.']\n    },\n    micro:[\n      {\n        do:{en:'Open Telegram and search for your bot’s <b>username</b>, the one ending in <code>bot</code> that you created.', he:'פותחים טלגרם ומחפשים את <b>שם המשתמש</b> של הבוט, זה שמסתיים ב-<code>bot</code> שיצרת.'},\n        shot:'shots/tg-empty-start.jpg',\n        ok:{en:'Your bot’s chat opens, with a “Start” button or an empty message box. Tap <b>Start</b> if it’s there.', he:'נפתח הצ\\'אט של הבוט, עם כפתור “Start” או תיבת הודעה ריקה. אם יש כפתור <b>Start</b>, לוחצים עליו.'}\n      },\n      {\n        do:{en:'At the bottom, type <b>“Hi”</b> (or anything you like) and send. Then wait up to a minute, the very first message wakes the agent up.', he:'למטה מקלידים <b>“היי”</b> (או כל דבר) ושולחים. ואז ממתינים עד דקה, ההודעה הראשונה מעירה את הסוכן.'},\n        shot:'shots/tg-hello.jpg',","numLines":250,"startLine":679,"totalLines":1684}},"sourceToolAssistantUUID":"dd939a17-764b-4aa0-93c0-5953ec9edeae","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b522cebd-0184-435d-9a0b-60eb7d0a73fa","version":"2.1.154","gitBranch":"HEAD","slug":"breezy-launching-scott"}
