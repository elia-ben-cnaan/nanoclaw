\n  if(errEl)errEl.style.display='none';\n  try{\n    await window.submitLead({name:nameEl.value.trim(),email:emailEl.value.trim()});\n    startWizard();\n  }catch(e){\n    btn.disabled=false;\n    if(errEl)errEl.style.display='block';\n  }\n}\nfunction showDone(){done.add(cur);setView('done');window.scrollTo({top:0,behavior:'smooth'});}\n\nfunction go(d){\n  if(d>0 && cur===STEPS.length-1){showDone();return;}\n  if(d>0) done.add(cur);\n  cur=Math.max(0,Math.min(STEPS.length-1,cur+d));\n  render();\n  window.scrollTo({top:0,behavior:'smooth'});\n}\nfunction jump(i){cur=i;setView('wizard');render();window.scrollTo({top:0,behavior:'smooth'})}\nfunction showGuide(id){setView('guide');renderGuide(id);window.scrollTo({top:0,behavior:'smooth'});}\nfunction copyCmd(btn,text){\n  var d=btn.nextElementSibling;\n  if(navigator.clipboard){navigator.clipboard.writeText(text).then(function(){d.classList.add('show');setTimeout(function(){d.classList.remove('show')},2200);});}\n  else{var ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);d.classList.add('show');setTimeout(function(){d.classList.remove('show')},2200);}\n}\n\nfunction render(){\n  const s=STEPS[cur];\n  // progress\n  const pct=Math.round(((cur+ (done.has(cur)?1:0))/STEPS.length)*100);","numLines":80,"startLine":1287,"totalLines":1673}},"sourceToolAssistantUUID":"44d4b067-541a-489b-bd30-c8a516db36c2","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b522cebd-0184-435d-9a0b-60eb7d0a73fa","version":"2.1.154","gitBranch":"HEAD","slug":"breezy-launching-scott"}
