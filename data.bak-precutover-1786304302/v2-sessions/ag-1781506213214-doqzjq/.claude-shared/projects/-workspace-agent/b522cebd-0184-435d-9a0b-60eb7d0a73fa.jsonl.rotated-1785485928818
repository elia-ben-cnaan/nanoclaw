e guides constantly and add new connections. Leave your name and email, and I\\'ll let you know when a new guide is ready.')+'</p>'\n      +'<button class=\"rd-pick-toggle\" onclick=\"document.getElementById(\\'railDrop\\').classList.toggle(\\'open\\')\">'\n      +(_isHe?'רוצה לבחור חיבורים מסוימים?':'Want to pick specific connections?')\n      +'<span class=\"rd-caret\">▼</span></button>'\n      +'<div class=\"rd-pick\"><div class=\"rd-list\">'+_catHtml\n      +'<input class=\"rd-other\" placeholder=\"'+(_isHe?'לא מצאת? כתוב לי כאן':'Not found? Write it here')+'\"></div></div>'\n      +'<div class=\"rd-reg\">'\n      +'<input type=\"text\" id=\"rdName\" placeholder=\"'+(_isHe?'שם':'Name')+'\">'\n      +'<input type=\"email\" id=\"rdEmail\" placeholder=\"'+(_isHe?'אימייל':'Email')+'\">'\n      +'</div>'\n      +'<button class=\"rd-send\" onclick=\"submitGuideRequest(this)\">'+(_isHe?'שלח לי ←':'Send me →')+'</button>'\n      +'<p class=\"rd-note\">'+(_isHe?'הפרטים נשמרים רק כדי שאעדכן אותך. נשארים שלך.':'Your details are saved only to update you. They stay yours.')+'</p>'\n      +'</div>'\n      +'</div>';\n  document.getElementById('rail').innerHTML=rail;\n\n  // step body\n  let h=`<div class=\"step-head\"><div class=\"step-num\">${String(cur+1).padStart(2,'0')}</div><h1>${t(s.title)}</h1></div>`;\n  if(s.opener) h+='<div class=\"step-opener\">'+t(s.opener)+'</div>';\n  h+='<div class=\"what\"><h5>'+t(UI.whatLabel)+'</h5><p>'+t(s.what)+'</p></div>';\n  if(s.legend){\n    const _he=lang==='he';\n    h+='<div class=\"legend\"><h5>'+(_he?'איך עובדים עם המדריך':'How this guide works')+'</h5>'\n     +'<div class=\"lg-row\"><span class=\"lg-mk lg-gloss\">'+(_he?'מונח':'Term')+'</span><p>'+(_he?'מילים עם קו מקווקו בטורקיז הן <b>מונחים</b>, לחיצה פותחת הסבר קצר.':'Words with a teal dotted underline are <b>glossary terms</b>, tap one for a short explanation.')+'</p></div>'\n     +'<div class=\"lg-row\"><span class=\"lg-mk lg-code\">'+(_he?'קוד':'Code')+'</span><p>'+(_he?'פ