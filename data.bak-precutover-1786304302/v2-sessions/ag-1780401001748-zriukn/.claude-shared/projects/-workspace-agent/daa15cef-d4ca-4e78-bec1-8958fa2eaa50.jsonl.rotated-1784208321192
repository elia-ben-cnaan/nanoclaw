ont-size: 13px; line-height: 1.72; color: var(--gray); }\n\n/* CLOSING BANNER */\n.banner {\n  font-size: clamp(34px, 5vw, 78px);\n  font-weight: 900; letter-spacing: -0.03em; line-height: 1.05;\n  color: var(--text); text-align: center; margin-bottom: 40px;\n}\n.banner em { font-style: normal; color: var(--brass); }\n.next-grid {\n  display: grid; grid-template-columns: repeat(3, 1fr);\n  gap: 14px; width: 100%; max-width: 880px; margin-top: 8px;\n}\n.next-cell {\n  background: var(--card); border: 1px solid var(--border);\n  border-radius: 12px; padding: 22px 20px; text-align: right;\n  transition: border-color 0.3s;\n}\n.next-cell:hover { border-color: var(--border-brass); }\n.next-num { font-family: 'Sora', sans-serif; font-size: 13px; font-weight: 800; color: var(--brass); margin-bottom: 8px; }\n.next-cell h4 { font-size: 15px; font-weight: 700; color: var(--text); margin-bottom: 5px; }\n.next-cell p { font-size: 12px; line-height: 1.6; color: var(--gray); }\n\n/* NAVBAR */\n#navbar {\n  position: fixed; top: 0; left: 0; right: 0; z-index: 200;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 26px 48px; pointer-events: all;\n}\n[dir=\"rtl\"] #navbar { flex-direction: row-reverse; }\n.nav-logo {\n  display: flex; align-items: center; gap: 10px;\n  font-family: 'Sora', sans-serif;\n  font-size: 18px; font-weight: 800; letter-spacing: -0.02em; color: var(--text);\n}\n.nav-logo svg { width: 18px; height: 21px; display: block; }\n.nav-r { display: flex; gap: 20px; align-items: center; }\n.nav-count { font-size: 11px; color: var(--dim); letter-spacing: 0.07em; font-variant-numeric: tabular-nums; }\n.nav-count b { color: rgba(255,255,255,0.65); font-weight: 500; }\n\n/* BOTTOMBAR */\n#bottombar {\n  position: fixed; bottom: 0; left: 0; right: 0; z-index: 200;\n  display: flex; align-items: center; justify-content: space-between;\n  padding: 22px 48px; pointer-events: all;\n}\n[dir=\"rtl\"] #bottombar { flex-direction: row-reverse; }\n#slide-lbl { font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); min-width: 110px; }\n#progress { display: flex; gap: 5px; align-items: center; direction: ltr; }\n.pdot { width: 3px; height: 3px; border-radius: 50%; background: rgba(255,255,255,0.18); cursor: pointer; transition: all 0.22s; }\n.pdot.on { background: var(--brass); width: 18px; border-radius: 2px; }\n.pdot:hover:not(.on) { background: rgba(255,255,255,0.42); }\n#arrows { display: flex; gap: 6px; direction: ltr; }\n.arr-btn {\n  width: 40px; height: 40px; border: 1px solid rgba(255,255,255,0.22);\n  background: rgba(255,255,255,0.05); color: rgba(255,255,255,0.65); cursor: pointer; font-size: 16px;\n  display: flex; align-items: center; justify-content: center; transition: all 0.15s;\n  border-radius: 7px;\n}\n.arr-btn:hover { border-color: var(--brass); color: var(--brass); background: rgba(232,178,58,0.08); }\n\n/* MOBILE */\n@media (max-width: 768px) {\n  /* slides scroll vertically so tall content is never clipped */\n  .slide { display: block; overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; }\n  .s-wrap, .insight-wrap {\n    min-height: 100%;\n    justify-content: center;\n    padding: 86px 22px 94px;\n  }\n  #navbar { padding: 16px 18px; background: linear-gradient(to bottom, var(--bg) 62%, rgba(11,15,23,0)); }\n  #bottombar { padding: 14px 18px 16px; background: linear-gradient(to top, var(--bg) 62%, rgba(11,15,23,0)); }\n  .nav-logo { font-size: 16px; }\n  #slide-lbl { min-width: 0; }\n  .h-xl { font-size: clamp(40px, 11vw, 72px); }\n  .h-lg { font-size: clamp(30px, 9vw, 52px); }\n  .h-insight { font-size: clamp(30px, 8.4vw, 60px); }\n  .cover-word { font-size: clamp(56px, 18vw, 120px); }\n  .body-t { font-size: 14px; }\n  .split { flex-direction: column !important; gap: 20px; }\n  .split-l { flex: none; }\n  .split-r { gap: 12px; }\n  /* command center flows in the scroll container instead of absolute fill */\n  .cmd-center {\n    position: static; height: auto; min-height: 100%;\n    justify-content: center;\n    padding: 86px 20px 94px; gap: 18px;\n  }\n  .cmd-bg-num { font-size: 100px; left: 6px; top: auto; bottom: 14%; }\n  .cmd-main { max-width: 100%; }\n  .cmd-stage-title { font-size: clamp(30px, 9vw, 50px); margin-bottom: 22px; }\n  .cmd-selector { grid-template-columns: repeat(2, 1fr); }\n  .cmd-bullet-item { font-size: 15px; }\n  .infra-cards { grid-template-columns: 1fr; margin-top: 26px; }\n  .next-grid { grid-template-columns: 1fr; }\n  .banner { font-size: clamp(32px, 9vw, 58px); }\n  .stat-row { gap: 26px; }\n}\n</style>\n</head>\n<body>\n\n<nav id=\"navbar\">\n  <div class=\"nav-logo\" dir=\"ltr\">\n    <svg viewBox=\"0 0 120 140\">\n      <path fill-rule=\"evenodd\" fill=\"#e8b23a\" d=\"M74 16 L26 116 L74 116 Z  M74 56 L52 102 L74 102 Z\"/>\n      <rect x=\"74\" y=\"14\" width=\"26\" height=\"8\" rx=\"2\" fill=\"#eef2f8\"/>\n      <rect x=\"83\" y=\"14\" width=\"8\" height=\"100\" rx=\"2\" fill=\"#eef2f8\"/>\n      <rect x=\"74\" y=\"106\" width=\"26\" height=\"8\" rx=\"2\" fill=\"#eef2f8\"/>\n      <rect x=\"20\" y=\"124\" width=\"80\" height=\"7\" rx=\"3.5\" fill=\"#9aa6ba\"/>\n    </svg>\n    <span>M<span style=\"color:var(--brass)\">A</span>ST</span>\n  </div>\n  <div class=\"nav-r\">\n    <span class=\"nav-count\" dir=\"ltr\"><b id=\"cur\">01</b>&thinsp;/&thinsp;10</span>\n  </div>\n</nav>\n\n<div id=\"deck\"></div>\n\n<div id=\"bottombar\">\n  <div id=\"slide-lbl\"></div>\n  <div id=\"progress\"></div>\n  <div id=\"arrows\">\n    <button class=\"arr-btn\" id=\"arr-back\">&#8592;</button>\n    <button class=\"arr-btn\" id=\"arr-fwd\">&#8594;</button>\n  </div>\n</div>\n\n<script>\n// background animation removed — clean dark backdrop\nwindow.resetRain = function() {};\n\n// MAST mark (reused on cover)\nconst MARK_SVG = `<svg viewBox=\"0 0 120 140\">\n  <path fill-rule=\"evenodd\" fill=\"#e8b23a\" d=\"M74 16 L26 116 L74 116 Z  M74 56 L52 102 L74 102 Z\"/>\n  <rect x=\"74\" y=