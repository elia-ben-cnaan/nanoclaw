card-dot { opacity: 1; }\n@keyframes dpulse { 0%, 100% { transform: scale(0.8); } 50% { transform: scale(1.2); } }\n\n/* COMMAND CENTER */\n.cmd-scan {\n  position: absolute; inset: 0; z-index: 3; pointer-events: none;\n  background: linear-gradient(180deg,\n    transparent 0%, rgba(232,178,58,0.02) 35%,\n    rgba(232,178,58,0.06) 50%,\n    rgba(232,178,58,0.02) 65%, transparent 100%);\n  opacity: 0;\n}\n@keyframes scan {\n  0%   { transform: translateY(-100%); opacity: 0; }\n  8%   { opacity: 1; }\n  92%  { opacity: 1; }\n  100% { transform: translateY(110%); opacity: 0; }\n}\n\n.cmd-center {\n  position: absolute;\n  top: 76px; bottom: 68px;\n  left: 0; right: 0;\n  padding: 18px 72px 14px;\n  display: flex; flex-direction: column; gap: 14px;\n  z-index: 2;\n}\n\n.cmd-bg-num {\n  position: absolute;\n  right: 56px; top: 20%;\n  font-family: 'Sora', sans-serif;\n  font-size: clamp(160px, 26vw, 360px);\n  font-weight: 800; letter-spacing: -0.07em;\n  color: rgba(232,178,58,0.06);\n  line-height: 1; pointer-events: none; user-select: none;\n  transition: opacity 0.3s ease;\n}\n[dir=\"rtl\"] .cmd-bg-num { right: auto; left: 56px; }\n\n.cmd-header {\n  display: flex; align-items: center; justify-content: space-between;\n  flex-shrink: 0;\n}\n.cmd-meta {\n  font-size: 9px; font-weight: 700;\n  letter-spacing: 0.22em; text-transform: uppercase; color: var(--brass);\n}\n\n/* Stage selector */\n.cmd-selector {\n  display: grid; grid-template-columns: repeat(4, 1fr);\n  gap: 1px; background: rgba(255,255,255,0.045);\n  border-radius: 10px; overflow: hidden;\n  border: 1px solid rgba(255,255,255,0.06);\n  flex-shrink: 0;\n}\n.cmd-node {\n  background: #090c12;\n  padding: 18px 16px 15px;\n  cursor: pointer; position: relative; overflow: hidden;\n  transition: background 0.35s;\n}\n.cmd-node.active { background: var(--card-hi); }\n.cmd-node:hover:not(.active) { background: rgba(255,255,255,0.025); }\n.cmd-node-num {\n  font-family: 'Sora', sans-serif;\n  font-size: 9px; font-weight: 700;\n  letter-spacing: 0.16em; text-transform: uppercase;\n  color: var(--dim); margin-bottom: 6px; transition: color 0.35s;\n}\n.cmd-node.active .cmd-node-num { color: var(--brass); }\n.cmd-node-name {\n  font-size: 13px; font-weight: 700;\n  letter-spacing: 0; color: rgba(255,255,255,0.32); line-height: 1.35; transition: color 0.35s;\n}\n.cmd-node.active .cmd-node-name { color: rgba(255,255,255,0.9); }\n.cmd-node::before {\n  content: ''; position: absolute;\n  right: 0; top: 0; bottom: 0;\n  width: 2px; background: var(--brass);\n  opacity: 0; transition: opacity 0.35s;\n}\n.cmd-node.active::before { opacity: 1; }\n.cmd-prog {\n  position: absolute; bottom: 0; right: 0;\n  height: 2px; width: 0%;\n  background: var(--brass);\n  box-shadow: 0 0 6px rgba(232,178,58,0.7);\n  opacity: 0;\n}\n.cmd-node.active .cmd-prog { opacity: 1; }\n\n/* Main content */\n.cmd-main {\n  flex: 1; min-height: 0;\n  display: flex; flex-direction: column;\n  justify-content: center;\n  max-width: 62%;\n  transition: opacity 0.28s ease, transform 0.28s ease;\n}\n[dir=\"rtl\"] .cmd-main { align-self: flex-end; text-align: right; }\n\n.cmd-stage-label {\n  font-size: 10px; font-weight: 700;\n  letter-spacing: 0.2em; text-transform: uppercase;\n  color: var(--brass); margin-bottom: 16px;\n}\n.cmd-stage-title {\n  font-size: clamp(36px, 5vw, 76px);\n  font-weight: 900; letter-spacing: -0.03em;\n  line-height: 1.02; color: var(--text);\n  margin-bottom: 32px;\n}\n\n.cmd-bullets {\n  display: flex; flex-direction: column; gap: 15px;\n}\n.cmd-bullet-item {\n  font-size: clamp(14px, 1.6vw, 20px);\n  font-weight: 400; line-height: 1.38; letter-spacing: -0.005em;\n  padding-left: 18px;\n  border-left: 2px solid rgba(232,178,58,0.08);\n  color: rgba(255,255,255,0.2);\n  transition: color 0.55s ease, border-color 0.55s ease, text-shadow 0.55s ease, padding 0.3s ease;\n}\n.cmd-bullet-item.lit {\n  color: rgba(255,255,255,0.94);\n  border-left-color: rgba(232,178,58,0.85);\n  text-shadow: 0 0