s = document.querySelectorAll(selector);\n845\t  if (!cards.length) return;\n846\t  if (cycleState[slideIdx] === undefined) cycleState[slideIdx] = 0;\n847\t  cards.forEach((c, i) => c.classList.toggle('on', i === cycleState[slideIdx]));\n848\t  cycleIntervals[slideIdx] = setInterval(() => {\n849\t    cards[cycleState[slideIdx]].classList.remove('on');\n850\t    cycleState[slideIdx] = (cycleState[slideIdx] + 1) % cards.length;\n851\t    cards[cycleState[slideIdx]].classList.add('on');\n852\t  }, 2400);\n853\t}\n854\tfunction stopCycle(slideIdx) {\n855\t  if (cycleIntervals[slideIdx]) { clearInterval(cycleIntervals[slideIdx]); delete cycleIntervals[slideIdx]; }\n856\t  if (SLIDES[slideIdx] && SLIDES[slideIdx].type === 'infra') {\n857\t    document.querySelectorAll(`#slide-${slideIdx} .infra-card`).forEach(c => c.classList.remove('on'));\n858\t  }\n859\t}\n860\t\n861\t// COMMAND CENTER\n862\tfunction startCmdCenter() { cmdSelectStage(0); }\n863\t\n864\tfunction stopCmdCenter() {\n865\t  stopBulletCycle();\n866\t  cmdActiveIdx = -1;\n867\t  for (let i = 0; i < STAGES.length; i++) {\n868\t    const node = document.getElementById(`cmd-node-${i}`);\n869\t    if (node) node.classList.remove('active');\n870\t    const bar = document.getElementById(`cmd-prog-${i}`);\n871\t    if (bar) { bar.style.transition = 'none'; bar.style.width = '0%'; }\n872\t  }\n873\t}\n874\t\n875\tfunction cmdSelectStage(idx) {\n876\t  stopBulletCycle();\n877\t  cmdActiveIdx = idx;\n878\t\n879\t  for (let i = 0; i < STAGES.length; i++) {\n880\t    const node = document.getElementById(`cmd-node-${i}`);\n881\t    if (node) node.classList.toggle('active', i === idx);\n882\t  }\n883\t\n884\t  const bgNum = document.getElementById('cmd-bg-num');\n885\t  if (bgNum) {\n886\t    bgNum.style.opacity = '0';\n887\t    setTimeout(() => { bgNum.textContent = STAGES[idx].n; bgNum.style.opacity = '1'; }, 220);\n888\t  }\n889\t\n890\t  triggerScanLine();\n891\t  updateCmdContent();\n892\t\n893\t  const content = doc