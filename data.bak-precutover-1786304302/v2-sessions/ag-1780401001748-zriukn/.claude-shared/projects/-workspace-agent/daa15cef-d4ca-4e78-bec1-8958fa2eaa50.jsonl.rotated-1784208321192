ss=\"cover-word sora\">M<span>A</span>ST</div>\n656\t      <div class=\"cover-tag-he\">טרנספורמציית AI לארגונים.</div>\n657\t      <div class=\"cover-sub\">\n658\t        <span>דק רציונל</span>\n659\t        <span class=\"cover-dot\"></span>\n660\t        <span>למה העסק, ולמה עכשיו</span>\n661\t        <span class=\"cover-dot\"></span>\n662\t        <b>יוני 2026</b>\n663\t      </div>\n664\t    </div>`;\n665\t  }\n666\t\n667\t  if (s.type === 'statement') {\n668\t    return ov + `<div class=\"s-wrap centered\">\n669\t      <div class=\"label-sm\" id=\"meta-${i}\"></div>\n670\t      <div class=\"rule c\"></div>\n671\t      <h1 class=\"h-xl\" id=\"hl-${i}\"></h1>\n672\t      <p class=\"body-t\" id=\"bd-${i}\"></p>\n673\t    </div>`;\n674\t  }\n675\t\n676\t  if (s.type === 'split') {\n677\t    const cards = s.cards.map((c, ci) => `\n678\t      <div class=\"fcard\">\n679\t        <div class=\"fcard-step\" id=\"cstep-${i}-${ci}\"></div>\n680\t        <h3 id=\"ctitle-${i}-${ci}\"></h3>\n681\t        <p id=\"cdesc-${i}-${ci}\"></p>\n682\t        <div class=\"fcard-dot\"></div>\n683\t        <div class=\"fcard-glow\"></div>\n684\t      </div>`).join('');\n685\t    return ov + `<div class=\"s-wrap\">\n686\t      <div class=\"split\">\n687\t        <div class=\"split-l\">\n688\t          <div class=\"rule\"></div>\n689\t          <h1 class=\"h-lg\" id=\"hl-${i}\"></h1>\n690\t          <p class=\"body-t\" id=\"bd-${i}\"></p>\n691\t        </div>\n692\t        <div class=\"split-r\">${cards}</div>\n693\t      </div>\n694\t    </div>`;\n695\t  }\n696\t\n697\t  if (s.type === 'insight') {\n698\t    const stats = s.stats ? `<div class=\"stat-row\">${s.stats.map((st, si) =>\n699\t      `<div class=\"stat-box\"><div class=\"stat-num ${st.muted ? 'muted' : ''}\">${st.num}</div><div class=\"stat-lbl\" id=\"stat-lbl-${i}-${si}\"></div></div>`\n700\t    ).join('')}</div>` : '';\n701\t    return ov + `<div class=\"insight-wrap\">\n702\t      <h1 class=\"h-insight\" id=\"hl-${i}\"></h1>\n