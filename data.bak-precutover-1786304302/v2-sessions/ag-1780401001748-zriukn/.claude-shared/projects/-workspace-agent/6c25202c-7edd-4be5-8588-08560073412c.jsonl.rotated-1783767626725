{"parentUuid":"4c7b553d-ce22-43ba-9eab-cdb00478b346","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/build_mock.mjs","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/build_mock.mjs","content":"import sharp from 'sharp';\nimport fs from 'fs';\n\nconst W = 410;\nconst RIGHT = 390, LEFTPAD = 20;\nconst teal = '#56EDD6', white = '#FFFFFF', muted = '#B0B0B0', bg = '#000000';\nconst tealLine = '#2A6B5F', icoBg = '#0d1614', border = '#3A3A3A';\nconst FONT = \"Assistant, sans-serif\";\n\n// crude RTL-aware wrap by estimated advance\nfunction wrap(text, size, maxW, factor = 0.52) {\n  const words = text.split(' ');\n  const sp = size * 0.30;\n  const cw = c => c === ' ' ? sp : size * factor;\n  const wWidth = w => [...w].reduce((a, c) => a + cw(c), 0);\n  const lines = []; let cur = ''; let curW = 0;\n  for (const w of words) {\n    const add = (cur ? sp : 0) + wWidth(w);\n    if (curW + add > maxW && cur) { lines.push(cur); cur = w; curW = wWidth(w); }\n    else { cur = cur ? cur + ' ' + w : w; curW += add; }\n  }\n  if (cur) lines.push(cur);\n  return lines;\n}\nconst esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\nlet svg = '';\nlet y = 0;\n\n// ---- header ----\nconst headerH = 60;\nsvg += `<text x=\"${RIGHT}\" y=\"40\" text-anchor=\"end\" font-family=\"${FONT}\" font-size=\"18\" font-weight=\"800\" fill=\"${teal}\">click2agent</text>`;\nsvg += `<text x=\"${LEFTPAD}\" y=\"38\" text-anchor=\"start\" font-family=\"${FONT}\" font-size=\"12.5\" font-weight=\"700\" fill=\"${teal}\">HE</text>`;\nsvg += `<text x=\"${LEFTPAD + 24}\" y=\"38\" text-anchor=\"start\" font-family=\"${FONT}\" font-size=\"11\" fill=\"#444\">/</text>`;\nsvg += `<text x=\"${LEFTPAD + 34}\" y=\"38\" text-anchor=\"start\" font-family=\"${FONT}\" font-size=\"12.5\" font-weight=\"500\" fill=\"${muted}\">EN</text>`;\ny = headerH + 26;\n\n// ---- title (centered, accent teal on second part) ----\nsvg += `<text x=\"${W/2}\" y=\"${y}\" text-anchor=\"middle\" direction=\"rtl\" font-family=\"${FONT}\" font-size=\"25\" font-weight=\"700\" letter-spacing=\"-.2\" xml:space=\"preserve\"><tspan fill=\"${white}\">עשרה ימים </tspan><tspan fill=\"${teal}\">בעולם החדש</tspan></text>`;\ny += 30;\n\n// ---- lead (centered muted) ----\nconst lead = 'סוכני AI נכנסים לכל תפקיד, והעבודה שהכרנו משתנה. אני רוצה שתרגישו את זה בעצמכם. עשרה ימים על העבודה האמיתית שלכם.';\nconst leadLines = wrap(lead, 14.5, 340, 0.56);\nfor (const ln of leadLines) { svg += `<text x=\"${W/2}\" y=\"${y}\" text-anchor=\"middle\" direction=\"rtl\" font-family=\"${FONT}\" font-size=\"14.5\" fill=\"${muted}\">${esc(ln)}</text>`; y += 23; }\ny += 12;\n\n// ---- bullets ----\nconst icons = [\n  // gift/box\n  `<polyline points=\"20 12 20 22 4 22 4 12\"/><rect x=\"2\" y=\"7\" width=\"20\" height=\"5\"/><line x1=\"12\" y1=\"22\" x2=\"12\" y2=\"7\"/><path d=\"M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z\"/><path d=\"M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z\"/>`,\n  // clock\n  `<circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/>`,\n  // wallet/download (shared account)\n  `<path d=\"M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2v-6\"/><path d=\"M12 2v10m0 0l3-3m-3 3l-3-3\"/><path d=\"M4 8V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v2\"/>`,\n  // rocket (build your own)\n  `<path d=\"M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z\"/><path d=\"M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z\"/><path d=\"M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5\"/>`,\n];\nconst bullets = [\n  ['בחינם לגמרי', 'בלי כרטיס אשראי, בלי לבטל כלום, בלי אותיות קטנות. פשוט מתחילים.', false],\n  ['לומד אתכם', 'לא הדגמה. סוכן שעובד על המשימות האמיתיות שלכם, ולומד את הקצב והסגנון שלכם ככל שתשתמשו.', false],\n  ['חשבון משותף', 'הפיילוט רץ על חשבון משותף לכולם, במימוני. יש תקרת שימוש יומית, ואם מותחים אותה יותר מדי הסוכן עשוי להאט או לעצור לזמן מה. שימוש הוגן שומר שזה יישאר פתוח לכולם.', true],\n  ['מסיימים ומפתחים', 'בתום עשרה ימים אתם מפתחים ננוקלאו משלכם, והסוכן שלי מלווה אתכם בכל צעד עד שהוא באוויר.', true],\n];\nconst icoR = 390; // icon right edge\nconst icoSize = 29;\nconst textRight = icoR - icoSize - 14; // text right edge\nconst textMaxW = textRight - LEFTPAD;\n\nbullets.forEach((b, i) => {\n  const [title, body, isNew] = b;\n  const bodyLines = wrap(body, 13, textMaxW, 0.6);\n  const rowTop = y;\n  const padTop = 16;\n  let ty = y + padTop + 14;\n  // divider above (except first)\n  if (i > 0) svg += `<line x1=\"${LEFTPAD}\" y1=\"${rowTop}\" x2=\"${RIGHT}\" y2=\"${rowTop}\" stroke=\"${border}\" stroke-width=\"1\"/>`;\n  // new-bullet subtle highlight tint\n  // icon box\n  const iy = rowTop + padTop;\n  svg += `<rect x=\"${icoR - icoSize}\" y=\"${iy}\" width=\"${icoSize}\" height=\"${icoSize}\" rx=\"9\" fill=\"${icoBg}\" stroke=\"${tealLine}\"/>`;\n  svg += `<svg x=\"${icoR - icoSize + 7}\" y=\"${iy + 7}\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"${teal}\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${icons[i]}</svg>`;\n  // title\n  svg += `<text x=\"${textRight}\" y=\"${ty}\" text-anchor=\"start\" direction=\"rtl\" font-family=\"${FONT}\" font-size=\"15\" font-weight=\"600\" fill=\"${white}\">${esc(title)}</text>`;\n  ty += 21;\n  for (const ln of bodyLines) { svg += `<text x=\"${textRight}\" y=\"${ty}\" text-anchor=\"start\" direction=\"rtl\" font-family=\"${FONT}\" font-size=\"13\" fill=\"${muted}\">${esc(ln)}</text>`; ty += 20; }\n  y = ty + 14;\n});\n\n// ---- soul line ----\ny += 8;\nsvg += `<text x=\"${W/2}\" y=\"${y}\" text-anchor=\"middle\" direction=\"rtl\" font-family=\"${FONT}\" font-size=\"12\" fill=\"#7d7d7d\" xml:space=\"preserve\"><tspan>שלכם, </tspan><tspan fill=\"${teal}\">אליה בן כנען</tspan><tspan>.</tspan></text>`;\ny += 24;\n\n// ---- dots ----\nconst dotY = y + 6, dotN = 5, dotGap = 7, dotW = 7;\nconst totalDots = dotN * dotW + (dotN - 1) * dotGap + 12; // active is wider\nlet dx = W/2 - totalDots/2;\nfor (let i = 0; i < dotN; i++) {\n  const active = i === 3;\n  const w = active ? 18 : dotW;\n  svg += `<rect x=\"${dx}\" y=\"${dotY}\" width=\"${w}\" height=\"7\" rx=\"3.5\" fill=\"${active ? teal : '#333'}\"/>`;\n  dx += w + dotGap;\n}\ny = dotY + 24;\n\n// ---- CTA ----\nconst ctaH = 48;\nsvg += `<rect x=\"${LEFTPAD}\" y=\"${y}\" width=\"${W - 2*LEFTPAD}\" height=\"${ctaH}\" rx=\"12\" fill=\"${teal}\"/>`;\nsvg += `<text x=\"${W/2}\" y=\"${y + ctaH/2 + 5.5}\" text-anchor=\"middle\" direction=\"rtl\" font-family=\"${FONT}\" font-size=\"15.5\" font-weight=\"700\" fill=\"#04211C\">עשרה ימים? אני בפנים</text>`;\ny += ctaH + 22;\n\nconst H = Math.ceil(y);\nconst full = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${W}\" height=\"${H}\" viewBox=\"0 0 ${W} ${H}\">`\n  + `<rect width=\"${W}\" height=\"${H}\" fill=\"${bg}\"/>`\n  + `<rect x=\"0.5\" y=\"0.5\" width=\"${W-1}\" height=\"${H-1}\" rx=\"0\" fill=\"none\" stroke=\"#141414\"/>`\n  + svg + `</svg>`;\n\nfs.writeFileSync('mock-page4.svg', full);\nawait sharp(Buffer.from(full), { density: 220 }).png().toFile('mock-page4.png');\nconsole.log('done', W, H);\n","numLines":122,"startLine":1,"totalLines":122}},"displayPath":"../nanohub_demo/build_mock.mjs"},"type":"attachment","uuid":"d9e80bc5-677b-40e9-a925-34e712a53efa","timestamp":"2026-07-11T08:53:28.030Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent/tmp_shellano_hotfix","sessionId":"6c25202c-7edd-4be5-8588-08560073412c","version":"2.1.197","gitBranch":"HEAD","slug":"squishy-juggling-hummingbird"}
