{"parentUuid":"1fe4b560-8b14-4bc3-8d47-b7ba1be46a10","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/qa_shot.mjs","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/qa_shot.mjs","content":"import { chromium } from 'playwright';\nconst URL = 'https://click2agent.com/';\nconst b = await chromium.launch({ executablePath: '/usr/bin/chromium', args: ['--no-sandbox','--disable-dev-shm-usage','--disable-gpu','--single-process','--no-zygote','--disable-crash-reporter','--disable-breakpad','--disable-crashpad','--disable-software-rasterizer','--disable-features=VizDisplayCompositor,DBus'] });\nconst p = await b.newPage({ viewport: { width: 412, height: 915 }, deviceScaleFactor: 2 });\nawait p.goto(URL, { waitUntil: 'networkidle' });\nawait p.waitForTimeout(700);\nasync function run(lang){\n  if (lang==='en'){ await p.click('button[data-lang=\"en\"]'); await p.waitForTimeout(500); }\n  for (let i=0;i<5;i++){\n    await p.waitForTimeout(1400); // let reveal animations settle\n    await p.screenshot({ path: `qa-${lang}-${i}.png`, fullPage: true });\n    const fwd = await p.$('#arrFwd');\n    const dis = fwd ? await fwd.getAttribute('disabled') : '1';\n    if (i<4 && fwd && dis===null) await fwd.click();\n  }\n}\nawait run('he');\n// back to slide 0 then switch lang\nfor (let k=0;k<5;k++){ const back=await p.$('#arrBack'); const d=back?await back.getAttribute('disabled'):'1'; if(d===null) await back.click(); await p.waitForTimeout(200); }\nawait run('en');\nawait b.close();\nconsole.log('shots done');\n","numLines":23,"startLine":1,"totalLines":23}},"displayPath":"../nanohub_demo/qa_shot.mjs"},"type":"attachment","uuid":"a9a063e6-a38b-4dae-8184-f7756cdd924c","timestamp":"2026-07-11T09:17:19.942Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent/tmp_shellano_hotfix","sessionId":"6c25202c-7edd-4be5-8588-08560073412c","version":"2.1.197","gitBranch":"HEAD","slug":"squishy-juggling-hummingbird"}
