l(W/2-70, 116, 'Mobile', plane);\npill(W/2+70, 116, 'Desktop', plane);\ny+=54;\n\n// ===== B: two pills with \"Download\" word =====\nlabel('B');\nprompt('Need Telegram?'); y+=14;\npill(W/2-82, 140, 'Download · Mobile', null);\npill(W/2+82, 140, 'Desktop', null);\ny+=54;\n\n// ===== C: single subtle pill combining both =====\nlabel('C');\nprompt('Need Telegram?'); y+=14;\n{ const w=250,h=34,x=W/2-w/2,cy=y+h/2+4.5;\n  svg += `<rect x=\"${x}\" y=\"${y}\" width=\"${w}\" height=\"${h}\" rx=\"10\" fill=\"${icoBg}\" stroke=\"${tealLine}\"/>`;\n  svg += `<svg x=\"${x+14}\" y=\"${y+h/2-7}\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"${teal}\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">${dl}</svg>`;\n  svg += `<text x=\"${x+40}\" y=\"${cy}\" text-anchor=\"start\" font-family=\"${FONT}\" font-size=\"12.5\" font-weight=\"600\" fill=\"${teal}\">Mobile</text>`;\n  svg += `<text x=\"${x+w/2+12}\" y=\"${cy}\" text-anchor=\"middle\" font-family=\"${FONT}\" font-size=\"12.5\" fill=\"#3a3a3a\">|</text>`;\n  svg += `<text x=\"${x+w-18}\" y=\"${cy}\" text-anchor=\"end\" font-family=\"${FONT}\" font-size=\"12.5\" font-weight=\"600\" fill=\"${teal}\">Desktop</text>`;\n}\ny+=52;\n\n// current (for reference)\nlabel('CURRENT (thin links)');\nprompt('Need Telegram? Grab it in a minute:'); y+=20;\nsvg += `<text x=\"${W/2-30}\" y=\"${y}\" text-anchor=\"middle\" font-family=\"${FONT}\" font-size=\"12.5\" font-weight=\"600\" fill=\"${teal}\">Mobile →</text>`;\nsvg += `<text x=\"${W/2}\" y=\"${y}\" text-anchor=\"middle\" font-family=\"${FONT}\" font-size=\"12\" fill=\"#3a3a3a\">·</text>`;\nsvg += `<text x=\"${W/2+35}\" y=\"${y}\" text-anchor=\"middle\" font-family=\"${FONT}\" font-size=\"12.5\" font-weight=\"600\" fill=\"${teal}\">Desktop →</text>`;\ny+=34;\n\nconst H=Math.ceil(y);\nconst full = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${W}\" height=\"${H}\" viewBox=\"0 0 ${W} ${H}\"><rect width=\"${W}\" height=\"${H}\" fill=\"${bg}\"/>`+svg+`</svg>`;\nawait sharp(Buffer.from(full),{density:220}).png().toFile('mock-dl.png');\nconsole.log('done',W,H);\n","numLines":67,"startLine":1,"totalLines":67}},"displayPath":"nanohub_demo/build_dlmock.mjs"},"type":"attachment","uuid":"6d04b8bf-9508-4eae-a494-c054be57e5dc","timestamp":"2026-07-11T08:14:45.197Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"6c25202c-7edd-4be5-8588-08560073412c","version":"2.1.197","gitBranch":"HEAD","slug":"squishy-juggling-hummingbird"}
