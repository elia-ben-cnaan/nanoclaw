l function logs) and forward if a sink is set.\n  console.log(\"[pilot-register]\", JSON.stringify(lead));\n  if (process.env.LEAD_SINK_URL) {\n    try {\n      await fetch(process.env.LEAD_SINK_URL, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(lead),\n      });\n    } catch (e) { console.log(\"[pilot-register] sink failed\", String(e)); }\n  }\n\n  // The real chain: ask the host provisioner to create the agent + mint a Telegram pairing code.\n  if (process.env.HOST_PROVISION_URL) {\n    try {\n      const r = await fetch(process.env.HOST_PROVISION_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...(process.env.HOST_PROVISION_TOKEN\n            ? { Authorization: `Bearer ${process.env.HOST_PROVISION_TOKEN}` }\n            : {}),\n        },\n        body: JSON.stringify(lead),\n      });\n      if (r.ok) {\n        const data = await r.json();\n        if (data && data.deepLink) {\n          return res.status(200).json({ ok: true, status: \"live\", deepLink: data.deepLink });\n        }\n      }\n      console.log(\"[pilot-register] provision non-ok\", r.status);\n    } catch (e) {\n      console.log(\"[pilot-register] provision failed\", String(e));\n    }\n  }\n\n  // Host piece not wired yet: keep the flow alive, send them to the shared bot.\n  return res.status(200).json({\n    ok: true,\n    status: \"pending\",\n    deepLink: `https://t.me/${BOT}`,\n  });\n};","is_error":false}]},"uuid":"82fefd42-639e-4e40-96c2-1cb68500db32","timestamp":"2026-07-11T09:45:36.487Z","toolUseResult":{"stdout":"// Pilot registration endpoint.\n// Validates the new user, then tries to provision a real agent + Telegram deep link\n// via the host provisioner (HOST_PROVISION_URL). If the host piece is not wired yet,\n// it returns status:\"pending\" with the shared-bot fallback link, so the flow never breaks\n// and no registration is lost.\n\