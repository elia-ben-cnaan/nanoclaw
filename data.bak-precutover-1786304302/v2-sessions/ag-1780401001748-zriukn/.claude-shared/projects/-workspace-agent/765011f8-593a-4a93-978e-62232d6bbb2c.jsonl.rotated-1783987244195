{"parentUuid":"e66c0b38-0c81-4d17-b5be-f3866156800c","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/api/app-summary.js","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/api/app-summary.js","content":"// App journey funnel — proxies the VM tracking endpoint (provision.shellano.com/app/summary),\n// which owns the anonymous event store on SQLite. Moved off Vercel Blob (suspended quota).\n// The authenticated summary URL (with its ADMIN_KEY) lives in APP_SUMMARY_URL server-side and\n// never reaches the browser. The VM already folds events per visitor and computes the funnel;\n// we only humanize the source labels here so the board renders consistent Hebrew names.\nconst KNOWN = {\n  shellano: \"שלנו · וואטסאפ\",\n  click2agent: \"קליק טו אייג'נט · וואטסאפ\",\n  c2a: \"קליק טו אייג'נט · וואטסאפ\",\n  linkedin: \"לינקדאין\",\n  facebook: \"פייסבוק\",\n  instagram: \"אינסטגרם\",\n};\nfunction labelFor(raw) {\n  const s = String(raw || \"\").trim();\n  if (!s || s === \"לא ידוע\" || s === \"null\") return \"לא מסומן\";\n  const low = s.toLowerCase();\n  if (KNOWN[low]) return KNOWN[low];\n  return low.split(/[-_]/).map((p) => KNOWN[p] || p).join(\" · \");\n}\n\nmodule.exports = async function handler(req, res) {\n  res.setHeader('Cache-Control', 'no-store');\n  const url = process.env.APP_SUMMARY_URL;\n  if (!url) {\n    return res.status(200).json({ ok: false, error: \"summary not configured\" });\n  }\n  try {\n    const r = await fetch(url, { headers: { Accept: \"application/json\" } });\n    if (!r.ok) return res.status(200).json({ ok: false, error: \"upstream \" + r.status });\n    const data = await r.json();\n    if (!data || data.ok === false) {\n      return res.status(200).json({ ok: false, error: (data && data.error) || \"no data\" });\n    }\n\n    // Humanize source labels, keeping the VM's computed counts intact.\n    const bySource = Array.isArray(data.bySource)\n      ? data.bySource\n          .map((o) => ({\n            label: labelFor(o.label),\n            entered: +o.entered || 0,\n            reachedForm: +o.reachedForm || 0,\n            submitted: +o.submitted || 0,\n          }))\n          .sort((a, b) => b.entered - a.entered)\n      : [];\n\n    return res.status(200).json({\n      ok: true,\n      funnel: data.funnel || { entered: 0, clicked: 0, reachedForm: 0, submitted: 0, droppedNoForm: 0, abandonedForm: 0 },\n      depth: Array.isArray(data.depth) ? data.depth : [0, 0, 0, 0, 0],\n      medDwellMs: +data.medDwellMs || 0,\n      bySource,\n      generated_at: data.generated_at || new Date().toISOString(),\n    });\n  } catch (e) {\n    return res.status(200).json({ ok: false, error: String((e && e.message) || e) });\n  }\n};\n","numLines":60,"startLine":1,"totalLines":60}},"displayPath":"nanohub_demo/api/app-summary.js"},"type":"attachment","uuid":"0fafbbde-2678-42f7-bf7e-9f3b0fa0a0ec","timestamp":"2026-07-13T21:57:58.566Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"765011f8-593a-4a93-978e-62232d6bbb2c","version":"2.1.197","gitBranch":"HEAD","slug":"calm-watching-seal"}
