 === \"null\") return \"לא מסומן\";\n  const low = s.toLowerCase();\n  if (KNOWN[low]) return KNOWN[low];\n  return low.split(/[-_]/).map((p) => KNOWN[p] || p).join(\" · \");\n}\n\nasync function loadAll(list) {\n  const out = [];\n  let cursor;\n  do {\n    const page = await list({ prefix: 'evapp/', cursor, limit: 1000 });\n    const batch = page.blobs || [];\n    for (let i = 0; i < batch.length; i += 30) {\n      const slice = batch.slice(i, i + 30);\n      const recs = await Promise.all(slice.map(async (b) => {\n        try { const r = await fetch(b.url); return await r.json(); } catch { return null; }\n      }));\n      for (const r of recs) if (r) out.push(r);\n    }\n    cursor = page.cursor;\n  } while (cursor);\n  return out;\n}\n\nmodule.exports = async function handler(req, res) {\n  res.setHeader('Cache-Control', 'no-store');\n  try {\n    const { list } = await import('@vercel/blob');\n    const recs = await loadAll(list);\n\n    // Fold every event for a visitor into a single journey (sessions are richer than visits).\n    const V = new Map(); // vid -> journey\n    for (const r of recs) {\n      const vid = r.vid || 'anon';\n      let j = V.get(vid);\n      if (!j) { j = { vid, src: '', maxStep: 0, dwell: 0, clicked: false, reachedForm: false, submitted: false, lastTs: '' }; V.set(vid, j); }\n      if (r.src && !j.src) j.src = r.src;\n      const step = +r.max_step || 0;\n      if (step > j.maxStep) j.maxStep = step;\n      if ((+r.dwell_ms || 0) > j.dwell) j.dwell = +r.dwell_ms || 0;\n      if (r.submitted) j.submitted = true;\n      const evs = Array.isArray(r.events) ? r.events : [];\n      for (const e of evs) {\n        const name = e && (e.e || e.name || '');\n        if (name === 'cta_click') j.clicked = true;\n        if (name === 'reached_form') j.reachedForm = true;\n        if (name === 'register_submit') j.submitted = true;\n      }\n      // screen 4 = the form screen in the N=5 app (0..4)\n      if (j.maxStep >= 4) j.reachedForm = true;\n      const t = r.received_at || r.ts || '';\n      if (t > j.lastTs) j.lastTs = t;\n    }\n\n    const journeys = [...V.values()];\n    const entered = journeys.length;\n    const clicked = journeys.filter((j) => j.clicked || j.maxStep >= 1).length;\n    const reachedForm = journeys.filter((j) => j.reachedForm).length;\n    const submitted = journeys.filter((j) => j.submitted).length;\n    const droppedNoForm = entered - reachedForm;\n    const abandonedForm = reachedForm - submitted; // saw the form, left no details\n    const dwells = journeys.map((j) => j.dwell).filter((x) => x > 0).sort((a, b) => a - b);\n    const medDwell = dwells.length ? dwells[Math.floor(dwells.length / 2)] : 0;\n\n    // screen-depth distribution (how far people got): screens 0..4\n    const depth = [0, 0, 0, 0, 0];\n    for (const j of journeys) { const s = Math.min(4, Math.max(0, j.maxStep)); for (let k = 0; k <= s; k++) depth[k]++; }\n\n    // by source: entered / reached form / submitted\n    const bySrcMap = new Map();\n    for (const j of journeys) {\n      const label = labelFor(j.src);\n      let o = bySrcMap.get(label);\n      if (!o) { o = { label, entered: 0, reachedForm: 0, submitted: 0 }; bySrcMap.set(label, o); }\n      o.entered++; if (j.reachedForm) o.reachedForm++; if (j.submitted) o.submitted++;\n    }\n    const bySource = [...bySrcMap.values()].sort((a, b) => b.entered - a.entered);\n\n    return res.status(200).json({\n      ok: true,\n      funnel: { entered, clicked, reachedForm, submitted, droppedNoForm, abandonedForm },\n      depth,       // index = screen number, value = visitors who reached at least that screen\n      medDwellMs: medDwell,\n      bySource,\n      generated_at: new Date().toISOString(),\n    });\n  } catch (e) {\n    return res.status(200).json({ ok: false, error: String((e && e.message) || e) });\n  }\n};\n","userModified":false},"sourceToolAssistantUUID":"5ec442a2-3da2-4184-85f7-525eead6f761","userType":"external","entrypoint":"sdk-ts","cwd"