orm:translateY(0); opacity:1}}\n203\t  .sheet-card h3{font-size:18px; font-weight:800; margin-bottom:12px}\n204\t  .sheet-card p{font-size:13.5px; color:var(--mut); line-height:1.8; margin-bottom:10px; text-align:start}\n205\t  .sheet-card p b{color:var(--ink)}\n206\t  .cta.ghost{background:transparent; color:var(--teal); border:1px solid var(--teal-deep); margin-top:6px}\n207\t\n208\t  /* magic / handoff overlay */\n209\t  .switch{position:absolute; inset:0; z-index:50; background:rgba(0,0,0,.93); backdrop-filter:blur(5px);\n210\t    display:none; flex-direction:column; align-items:center; justify-content:center; gap:18px; text-align:center; padding:30px}\n211\t  .switch.on{display:flex; animation:fade .25s ease both}\n212\t  .switch .ho-ico{animation:bob 1.4s ease-in-out infinite}\n213\t  @keyframes bob{0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)}}\n214\t  .switch h2{margin:0}\n215\t  .switch p{color:var(--mut); font-size:14px; line-height:1.6}\n216\t  .switch b{color:var(--ink)}\n217\t</style>\n218\t</head>\n219\t<body>\n220\t  <div class=\"device\">\n221\t    <div class=\"topbar\">\n222\t      <img class=\"logotxt\" src=\"c2a_logo_transparent.png\" alt=\"Click2Agent\">\n223\t\n224\t      <button class=\"back\" id=\"back\" onclick=\"go(-1)\" aria-label=\"back\">→</button>\n225\t      <div class=\"prog\" id=\"prog\"></div>\n226\t      <div class=\"stepn\" id=\"stepn\"></div>\n227\t      <div class=\"lang\" id=\"lang\" onclick=\"toggleLang()\">EN</div>\n228\t    </div>\n229\t    <div class=\"stage\" id=\"stage\"></div>\n230\t    <div class=\"foot\" id=\"foot\"></div>\n231\t    <div class=\"sheet\" id=\"sheet\"></div>\n232\t    <div class=\"switch\" id=\"switch\"></div>\n233\t  </div>\n234\t\n235\t<script>\n236\tconst N = 6;\n237\tconst BOT_FALLBACK = 'https://telegram.me/joni_agent_bot';\n238\tlet i = 0, L = 'he', agree = false, animating = false, submitting = false;\n239\tlet deepLink = '';\n240\tconst SRC = new URLSearchParams(location.search).get('src') || '';\n241\tconst reg = { name:'', phone:'', email:'' };\n242\t\n243\tconst T = {\n244\t  he:{\n245\t    /* 1 NEED */\n246\t    s1_kick:'NanoShellano',\n247\t    s1_title:'עולם העבודה משתנה.<br>כבר עכשיו.',\n248\t    s1_p:[\n249\t      'בכל חודש שעובר, סוכני AI נכנסים לעוד מחלקה, לעוד תפקיד, לעוד שולחן עבודה. זה כבר לא עתיד, זה ההווה.',\n250\t      'מי שיודע לעבוד עם סוכן ימצא את עצמו <b>צעד אחד לפני כולם</b>. ומי שלא, ימצא את עצמו עושה ביד דברים שסוכן עושה בשניות.',\n251\t      'הצעד הכי חשוב שתעשה השנה הוא לפתוח סוכן אחד משלך, ולהתחיל לעבוד איתו. <span class=\"em\">בלי רקע טכני, בלי קוד.</span>'\n252\t    ],\n253\t    s1_cta:'אני רוצה להיכנס לעולם הזה →',\n254\t    s1_note:'פיילוט בגישה מוזמנת · גרסה ראשונה',\n255\t    s1_by:'מאת אליה בן כנען',\n256\t\n257\t    /* 2 FREE */\n258\t    s2_kick:'למה בחינם',\n259\t    s2_title:'ולמה אני נותן<br>את זה בחינם',\n260\t    s2_p:[\n261\t      'לפני שנה לא ידעתי לכתוב שורת קוד אחת. היום יש לי סוכנים שעושים בשבילי חצי מהעבודה, וזה שינה לי לגמרי את הדרך שבה אני עובד.',\n262\t      'אז במקום לשמור את זה לעצמי, בניתי דרך פשוטה שתעביר גם אותך לצד השני. <b>בלי לשלם שקל.</b>',\n263\t      'זה פיילוט שאני עושה כדי להכניס כמה שיותר אנשים לעולם הסוכנים. בלי כרטיס אשראי, בלי התחייבות, בלי קאצ\\'.'\n264\t    ],\n265\t    s2_cta:'יפה, ומה עם הפרטיות? →',\n266\t    s2_note:'בלי עלות נסתרת. הפיילוט פתוח ובחינם.',\n267\t\n268\t    /* 3 SECURE */\n269\t    s3_kick:'מאובטח',\n270\t    s3_title:'מאובטח, ורק שלך',\n271\t    s3_lead:'לפני שמכניסים סוכן לחיים שלך, מגיע לך לדעת בדיוק מה קורה עם המידע.',\n272\t    s3_sic:'🔒',\n273\t    s3_sec_t:'חשבון מבודד, רק שלך',\n274\t    s3_sec:'הסוכן חי בחשבון נפרד ומבודד שמיוחד רק לך. כל חיבור נסגר מוצפן, והמידע שלך לא מתערבב עם אף אחד.',\n275\t    s3_f:[\n276\t      ['🔑','אתה מאשר כל חיבור בעצמך','שום שירות לא מתחבר בלי שאתה לוחץ \"אשר\", בחשבון שלך. מחברים רק מה שבא לך.'],\n277\t      ['🚪','מנתקים ומוחקים בכל רגע','בלחיצה אחת מנתקים שירות, ובלחיצה אחת מוחקים את הסוכן ואת כל הנתונים איתו.'],\n278\t      ['🛡️','לא מוכרים, לא משתפים','המידע שלך לא נמכר ולא עובר לאף אחד. הוא נשאר אצלך.']\n279\t    ],\n280\t    s3_honest:'<b>בכנות:</b> זו לא הבטחה ש\"אין לנו גישה\". זו שליטה אמיתית, אתה מחליט, אתה מאשר, ואתה מבטל מתי שתרצה.',\n281\t    s3_nano_link:'מה זה NanoClaw בעצם?',\n282\t    s3_cta:'הבנתי, איך זה הולך להיות? →',\n283\t    s3_note:'אפשר לשוחח עם הסוכן בכל שפה, בעברית או באנגלית.',\n284\t\n285\t    /* 4 FLOW */\n286\t    s4_kick:'הדרך',\n287\t    s4_title:'איך זה הולך להיות',\n288\t    s4_lead:'חמישה צעדים מהרגע שתלחץ \"מתחילים\" ועד שהסוכן עובד בשבילך.',\n289\t    s4_flow:[\n290\t      ['פותחים לך משתמש','שם, טלפון, מייל. לוקח דקה.'],\n291\t      ['מוקם לך סוכן אישי','המערכת מקימה לך סוכן על שרת מנוהל, תמיד פעיל, רק שלך.'],\n292\t      ['מקבלים קוד לטלגרם','קישור אישי שמחבר את הסוכן ישירות לטלגרם שלך.'],\n293\t      ['נכנסים לשיחה','הסוכן מקבל את פניך בשמך, ומתחילים לדבר בשפה רגילה.'],\n294\t      ['מחברים כלים, כשרוצים','מייל, יומן, וואטסאפ. מחברים בקצב שלך, בלחיצה.']\n295\t    ],\n296\t    s4_cta:'ומה הוא בעצם עושה? →',\n297\t    s4_note:'הכל קורה תוך כמה דקות. אתה רק עוקב אחרי המסכים.',\n298\t\n299\t    /* 5 — ככה נעבוד יחד */\n300\t    s5_how_t:'ככה נעבוד יחד',\n301\t    s5_agent:'ג\\'וני',\n302\t    s5_typing:'זמין עכשיו',\n303\t    s5_cases:[\n304\t      {t:'משימות רוחביות', s:'בקשה אחת הופכת לשרשרת פעולות על פני כמה מערכות, וחוזרת אליך גמורה.',\n305\t       c:[['me','עדכן את הלקוח ב-CRM, תכין הצעת מחיר ותשלח לו במייל'],\n306\t          ['bot','על איזה סכום ההצעה?'],\n307\t          ['me','45 אלף, כמו שסיכמנו בפגישה'],\n308\t          ['bot','עדכנתי ב-CRM, הכנתי הצעה, וכתבתי טיוטת מייל ללקוח.'],\n309\t          ['bot','המייל ממתין לאישורך. תיכנס ותאשר שליחה.']]},\n310\t      {t:'יצירת תוצרים', s:'לא רק עונה, מייצר את התוצרים עצמם. דוחות, מצגות, מסמכים וניתוחים.',\n311\t       c:[['me','אני צריך מצגת 10 שקפים על תוצאות Q2, לישיבה ב-3'],\n312\t          ['bot','במיתוג שלנו או של הלקוח?'],\n313\t          ['me','שלנו, עם הלוגואים של הלקוחות החדשים'],\n314\t          ['bot','בונה: פתיחה, 7 שקפי גרפים וסיכום עם המלצות.'],\n315\t          ['bot','מוכנה, מצורפת.','מצגת_Q2.pptx']]},\n316\t      {t:'קולגה לאונבורדינג', s:'חדש בתפקיד? הוא הקולגה שמלווה אותך שלב שלב.',\n317\t       c:[['me','חדש בתפקיד. איך פותחים בקשת רכש?'],\n318\t          ['bot','עליי. פותח לך בקשה ב-CRM ומעדכן את הפרטים לפי הנהלים. על איזה סכום?'],\n319\t          ['me','הזמנת ציוד משרדי, תקציב 6000 שקל'],\n320\t          ['bot','מילאתי ושלחתי לאישור המנהל. תמתין לאישור במייל.']]},\n321\t      {t:'מתחדש בכלי AI', s:'כלי AI חדש כל שבוע, ואי אפשר להדביק. אז הוא מדביק במקומך.',\n322\t       c:[['me','אני צריך סרטון הדרכה לנהלים החדשים במשרד'],\n323\t          ['bot','יצא כלי חדש שמרכיב סרטונים מצילומים של המשרד והאנשים. יש לך תמונות?'],\n324\t          ['me','מצרף תמונות של הצוות והמשרד','תמונות_הצוות.zip'],\n325\t          ['bot','בוצע. העליתי את הסרטון לדרייב ושלחתי לאישור המנהלת.']]}\n326\t    ],\n327\t    s5_cta:'אז מה אנחנו מבטיחים? →',\n328\t    s5_note:'בחר תרחיש כדי לראות איך זה נראה בשיחה אמיתית.',\n329\t\n330\t    /* 6 INSTALL + REGISTER */\n331\t    s6_kick:'התקנה',\n332\t    s6_title:'ההתקנה, ומשם הקסם',\n333\t    s6_lead:'שלוש דקות. פותחים לך משתמש, מקבלים קוד לטלגרם, <b>ומשם הקסם מתחיל.</b>',\n334\t    s6_steps:[['1','ממלאים פרטים'],['2','מקבלים קוד לטלגרם'],['3','הקסם מתחיל']],\n335\t    s6_name:'שם מלא', s6_name_ph:'איך קוראים לך',\n336\t    s6_phone:'טלפון', s6_phone_ph:'050-0000000',\n337\t    s6_email:'מייל', s6_email_ph:'you@example.com',\n338\t    s6_check:'קראתי ומאשר את <a class=\"tlink\" onclick=\"event.stopPropagation();openSheet(\\'priv\\')\">תנאי השימוש והפרטיות</a>. האישור הזה פותח את הסוכן.',\n339\t    s6_cta:'פתח לי סוכן →', s6_cta_load:'פותח לך סוכן…',\n340\t    s6_note:'הפרטים נשמרים כדי שהסוכן יקבל את פניך נכון. בלי ספאם.',\n341\t\n342\t    magic_t:'הסוכן שלך מוכן ✨',\n343\t    magic_p:'פתחנו לך טלגרם. הסוכן <b>מחכה לך שם</b>, רק תגיד שלום.',\n344\t    magic_peek:'אהלן! 👋 אני הננו שלך, מוכן להתחיל. על מה נצלול ראשון?',\n345\t\n346\t    sheet_nano_t:'מה זה NanoClaw?',\n347\t    sheet_nano:[\n348\t      '<b>NanoClaw</b> היא תשתית הסוכנים שעליה הכל רץ. סוכן אישי שחי על שרת מנוהל, תמיד פעיל, ומדבר איתך דרך טלגרם בשפה רגילה.',\n349\t      'הסוכן הוא שלך, לא של חברה. הוא לומד מה אתה צריך, מבצע משימות, ויכול להתחבר למערכות שלך כשתרצה, תמיד בשליטה שלך.',\n350\t      'הפיילוט הזה הוא הדרך הכי פשוטה לפתוח סוכן כזה, בלי רקע טכני ובלי הגדרות.'\n351\t    ],\n352\t    sheet_priv_t:'תנאי שימוש ופרטיות',\n353\t    sheet_priv:[\n354\t      '<b>פיילוט.</b> השירות הוא פיילוט ניסיוני שניתן בחינם, לתקופה של כחודש בשלב זה. אנחנו רשאים לשנות, להאריך, להשהות או להפסיק אותו בכל עת, ללא הודעה מוקדמת וללא התחייבות להמשך זמינות.',\n355\t      '<b>מה אנחנו אוספים.</b> פרטים שתמסור בהרשמה (שם, טלפון, מייל), תוכן השיחות שלך עם הסוכן, ומידע משירותים שתבחר לחבר, רק אחרי שאתה מאשר כל חיבור בעצמך.',\n356\t      '<b>למה.</b> המידע משמש כדי להקים ולהפעיל את הסוכן האישי שלך, לקבל את פניך נכון, ולתפעל את השירות. לא למטרה אחרת.',\n357\t      '<b>איפה זה נשמר.</b> הסוכן חי בחשבון נפרד ומבודד שמיוחד רק לך. החיבורים מוצפנים, והמידע שלך לא מתערבב עם משתמשים אחרים.',\n358\t      '<b>שיתוף.</b> אנחנו לא מוכרים ולא משתפים את המידע שלך. כדי שהשירות יעבוד הוא רץ על תשתיות צד שלישי (שרת מנוהל, טלגרם, וספקי מודל AI) שמעבדים נתונים רק לצורך הפעלת השירות.',\n359\t      '<b>שליטה ומחיקה.</b> אתה בשליטה מלאה. כדי למחוק הכל, פשוט כותב לסוכן את פקודת המחיקה (למשל \"מחק והפסק\") והוא מוחק את כל היסטוריית השיחה שלך ומפסיק לפעול. אחר כך אפשר למחוק את איש הקשר בטלגרם, והסוכן לא יגיב יותר. תמיד אפשר גם לפנות אלינו לבקשת מחיקה.',\n360\t      '<b>שמירת מידע.</b> המידע נשמר כל עוד הסוכן שלך פעיל, או עד שתמחק אותו. אם הפיילוט יופסק, נמחק את הנתונים בהתאם.',\n361\t      '<b>בלי אחריות.</b> זה שירות ניסיוני שמסופק כמו שהוא (as is). אין הבטחה לזמינות רציפה, ואין להסתמך עליו לשימושים קריטיים או למידע רגיש.',\n362\t      '<b>גיל.</b> השימוש מיועד לבני 18 ומעלה.',\n363\t      '<b>שינויים.</b> נוכל לעדכן את התנאים מעת לעת. המשך השימוש מהווה הסכמה לגרסה המעודכנת.',\n364\t      '<b>יצירת קשר.</b> לכל שאלה: 052-8738698 · elia@bencnaan.net'\n365\t    ],\n366\t    sheet_close:'הבנתי'\n367\t  },\n368\t\n369\ten:{\n370\t  s1_kick:'NanoShellano',\n371\t  s1_title:'The world of work<br>is changing. Right now.',\n372\t  s1_p:[\n373\t    'Every month, AI agents move into another department, another role, another desk. This stopped being a prediction. It is already happening.',\n374\t    'People who learn to work with an agent will be <b>a step ahead of everyone else</b>. People who don\\'t will keep doing by hand what an agent finishes in seconds.',\n375\t    'The most important move you can make this year is to open an agent of your own and start working with it. <span class=\"em\">No technical background, no code.</span>'\n376\t  ],\n377\t  s1_cta:'I want in →',\n378\t  s1_note:'Invite-only pilot · First release',\n379\t  s1_by:'Built by Elia Ben Cnaan',\n380\t\n381\t  s2_kick:'Why free',\n382\t  s2_title:'And why I give<br>it away for free',\n383\t  s2_p:[\n384\t    'A year ago I couldn\\'t write a single line of code. Today, agents do half my work for me, and they\\'ve changed the way I work from the ground up.',\n385\t    'So rather than keep that to myself, I built a simple way to bring you across to the other side too. <b>Without spending a cent.</b>',\n386\t    'This is a pilot I\\'m running to bring as many people as I can into the world of agents. No credit card, no commitment, no catch.'\n387\t  ],\n388\t  s2_cta:'Sounds good. What about privacy? →',\n389\t  s2_note:'No hidden costs. The pilot is open and free.',\n390\t\n391\t  s3_kick:'Security',\n392\t  s3_title:'Secure, and yours alone',\n393\t  s3_lead:'Before you let an agent into your life, you deserve to know exactly what happens with your data.',\n394\t  s3_sic:'🔒',\n395\t  s3_sec_t:'An isolated account, just for you',\n396\t  s3_sec:'Your agent lives in a separate, isolated account dedicated to you alone. Every connection is encrypted, and your data never mixes with anyone else\\'s.',\n397\t  s3_f:[\n398\t    ['🔑','You approve every connection','Nothing connects until you tap \"approve\", inside your own account. You connect only what you choose to.'],\n399\t    ['🚪','Disconnect and delete anytime','One tap disconnects a service. One tap deletes the agent, along with everything it knows.'],\n400\t    ['🛡️','Never sold, never shared','Your data isn\\'t sold and doesn\\'t get passed to anyone. It stays yours.']\n401\t  ],\n402\t  s3_honest:'<b>To be honest:</b> this isn\\'t a \"we have no access\" promise. It\\'s real control. You decide, you approve, and you can revoke it all whenever you want.',\n403\t  s3_nano_link:'So what is NanoClaw, exactly?',\n404\t  s3_cta:'Got it. How does it work? →',\n405\t  s3_note:'You can chat with the agent in any language, Hebrew or English.',\n406\t\n407\t  s4_kick:'The path',\n408\t  s4_title:'Here\\'s how it goes',\n409\t  s4_lead:'Five steps between tapping \"start\" and having an agent that works for you.',\n410\t  s4_flow:[\n411\t    ['Open your account','Name, phone, email. Takes a minute.'],\n412\t    ['Your personal agent is created','It runs on a managed server, always on, and belongs only to you.'],\n413\t    ['Get your Telegram code','A personal link that drops the agent straight into your Telegram.'],\n414\t    ['Step into the chat','The agent greets you by name, and you just talk, in plain language.'],\n415\t    ['Connect tools when you\\'re ready','Email, calendar, WhatsApp. Each one is a single tap, at your own pace.']\n416\t  ],\n417\t  s4_cta:'So what can it actually do? →',\n418\t  s4_note:'The whole thing takes a few minutes. Just follow the screens.',\n419\t\n420\t  s5_how_t:'Here\\'s how we\\'ll work',\n421\t  s5_agent:'Joni',\n422\t  s5_typing:'online',\n423\t  s5_cases:[\n424\t    {t:'Tasks across your systems', s:'One request becomes a chain of actions across several systems, and comes back to you finished.',\n425\t     c:[['me','Update the client in the CRM, prep a quote and email it over'],\n426\t        ['bot','What amount should the quote be for?'],\n427\t        ['me','45K, like we agreed in the meeting'],\n428\t        ['bot','CRM updated, quote ready, and I\\'ve drafted the email to the client.'],\n429\t        ['bot','The email is waiting for your sign-off. Open it and approve to send.']]},\n430\t    {t:'Creates real deliverables', s:'It produces the actual work: reports, decks, documents, analyses.',\n431\t     c:[['me','I need a 10-slide deck on the Q2 results, for a 3pm meeting'],\n432\t        ['bot','Our branding or the client\\'s?'],\n433\t        ['me','Ours, with the new clients\\' logos'],\n434\t        ['bot','On it: an intro, 7 chart slides, and a summary with recommendations.'],\n435\t        ['bot','Done, attached.','Q2_deck.pptx']]},\n436\t    {t:'Your onboarding buddy', s:'New on the job? It\\'s the colleague who walks you through everything, step by step.',\n437\t     c:[['me','Just started the role. How do I open a purchase request?'],\n438\t        ['bot','On it. I\\'ll open a request in the CRM and fill in the details according to policy. What amount?'],\n439\t        ['me','Office equipment, budget is 6,000'],\n440\t        ['bot','Filled in and sent to your manager for approval. Keep an eye out for the confirmation email.']]},\n441\t    {t:'Keeps up with AI tools', s:'A new AI tool drops every week. Nobody can keep up, so it keeps up for you.',\n442\t     c:[['me','I need a training video for the new office procedures'],\n443\t        ['bot','A new tool just came out that builds videos from photos of the office and the team. Got any pictures?'],\n444\t        ['me','Attaching photos of the team and the office','team_photos.zip'],\n445\t        ['bot','Done. The video is up on Drive and sent to your manager for approval.']]}\n446\t  ],\n447\t  s5_cta:'So what\\'s the promise? →',\n448\t  s5_note:'Pick a scenario to see how it plays out in a real conversation.',\n449\t\n450\t  s6_kick:'Install',\n451\t  s6_title:'A short setup, then the magic',\n452\t  s6_lead:'Three minutes. We open your account, a code lands in your Telegram, <b>and from there the magic begins.</b>',\n453\t  s6_steps:[['1','Fill in your details'],['2','Get your Telegram code'],['3','The magic begins']],\n454\t  s6_name:'Full name', s6_name_ph:'Your name',\n455\t  s6_phone:'Phone', s6_phone_ph:'050-0000000',\n456\t  s6_email:'Email', s6_email_ph:'you@example.com',\n457\t  s6_check:'I\\'ve read and accept the <a class=\"tlink\" onclick=\"event.stopPropagation();openSheet(\\'priv\\')\">terms of use and privacy policy</a>. This confirmation is what opens your agent.',\n458\t  s6_cta:'Open my agent →', s6_cta_load:'Opening your agent…',\n459\t  s6_note:'We save your details so the agent can greet you properly. No spam.',\n460\t\n461\t  magic_t:'Your agent is ready ✨',\n462\t  magic_p:'We\\'ve opened Telegram for you. Your agent is <b>already waiting</b>, just say hi.',\n463\t  magic_peek:'Hey! 👋 I\\'m your Nano, ready to go. What should we dive into first?',\n464\t\n465\t  sheet_nano_t:'What is NanoClaw?',\n466\t  sheet_nano:[\n467\t    '<b>NanoClaw</b> is the infrastructure everything here runs on: a personal agent that lives on a managed server, stays on around the clock, and talks with you over Telegram in plain language.',\n468\t    'The agent belongs to you, not to some company. It learns what you need, gets things done, and can connect to your systems when you choose, always under your control.',\n469\t    'This pilot is the simplest way to get an agent of your own, with no technical background and nothing to configure.'\n470\t  ],\n471\t  sheet_priv_t:'Terms of use & privacy',\n472\t  sheet_priv:[\n473\t    '<b>Pilot.</b> This service is an experimental pilot, provided free of charge, for a period of roughly one month at this stage. We may change, extend, pause or discontinue it at any time, without prior notice and with no commitment to continued availability.',\n474\t    '<b>What we collect.</b> The details you provide at signup (name, phone, email), the content of your conversations with the agent, and data from services you choose to connect, only after you approve each connection yourself.',\n475\t    '<b>Why.</b> We use it to set up and run your personal agent, greet you by name, and operate the service. Nothing beyond that.',\n476\t    '<b>Where it is stored.</b> Your agent runs in a separate, isolated account dedicated to you alone. Connections are encrypted, and your data never mixes with other users\\'.',\n477\t    '<b>Sharing.</b> We do not sell or share your data. To function, the service relies on third-party infrastructure (a managed server, Telegram, and AI model providers) that processes data only to operate the service.',\n478\t    '<b>Control and deletion.</b> You are in full control. To delete everything, send the agent a delete command (for example \"delete and exit\") and it wipes your entire chat history and stops working. You can then delete the contact in Telegram, and the agent will not respond again. You can also contact us at any time to request deletion.',\n479\t    '<b>Retention.</b> Data is kept while your agent is active, or until you delete it. If the pilot ends, we delete the data accordingly.',\n480\t    '<b>No warranty.</b> This is an experimental service, provided as is. Continuous availability is not guaranteed, and it should not be relied on for critical uses or sensitive data.',\n481\t    '<b>Age.</b> The service is intended for users aged 18 and over.',\n482\t    '<b>Changes.</b> We may update these terms from time to time. Continued use means you accept the updated version.',\n483\t    '<b>Contact.</b> For any question: 052-8738698 · elia@bencnaan.net'\n484\t  ],\n485\t  sheet_close:'Got it'\n486\t}\n487\t};\n488\t\n489\tfunction esc(s){ return String(s).replace(/\"/g,'&quot;'); }\n490\tfunction bubbles(arr){\n491\t  return arr.map(b=>`<div class=\"bub${b[0]==='me'?' me':''}\">${b[1]}</div>`).join('');\n492\t}\n493\t\n494\tfunction screenHTML(t){\n495\t  switch(i){\n496\t    case 0: return `\n497\t      <div class=\"glow\"></div>\n498\t      <div class=\"hero-mascot\"><img src=\"nanoshellano-mascot.png\" alt=\"NanoShellano\"></div>\n499\t      <h2>${t.s1_title}</h2>\n500\t      ${t.s1_p.map(p=>`<p class=\"prose\">${p}</p>`).join('')}\n501\t      <div class=\"spacer\"></div>`;\n502\t    case 1: return `\n503\t      <div class=\"glow\"></div>\n504\t      <div class=\"kick\">${t.s2_kick}</div>\n505\t      <h2>${t.s2_title}</h2>\n506\t      ${t.s2_p.map(p=>`<p class=\"prose\">${p}</p>`).join('')}\n507\t      <div class=\"spacer\"></div>`;\n508\t    case 2: return `\n509\t      <div class=\"glow\"></div>\n510\t      <div class=\"kick\">${t.s3_kick}</div>\n511\t      <h2>${t.s3_title}</h2>\n512\t      <p class=\"lead\">${t.s3_lead}</p>\n513\t      <div class=\"secband\"><div class=\"sic\">${t.s3_sic}</div><div class=\"stx\"><b>${t.s3_sec_t}</b>${t.s3_sec}</div></div>\n514\t      <div class=\"flist\">\n515\t        ${t.s3_f.map(f=>`<div class=\"fitem\"><div class=\"fic\">${f[0]}</div><div class=\"ftx\"><b>${f[1]}</b>${f[2]}</div></div>`).join('')}\n516\t      </div>\n517\t      <div class=\"honest\">${t.s3_honest}</div>\n518\t      <div class=\"linkrow\"><a onclick=\"openSheet('nano')\">${t.s3_nano_link}</a></div>\n519\t      <div class=\"spacer\"></div>`;\n520\t    case 3: return `\n521\t      <div class=\"glow\"></div>\n522\t      <div class=\"kick\">${t.s4_kick}</div>\n523\t      <h2>${t.s4_title}</h2>\n524\t      <p class=\"lead\">${t.s4_lead}</p>\n525\t      <div class=\"flow\">\n526\t        ${t.s4_flow.map((f,n)=>`<div class=\"frow\"><div class=\"fnum\">${n+1}</div><div class=\"fbody\"><b>${f[0]}</b><span>${f[1]}</span></div></div>`).join('')}\n527\t      </div>\n528\t      <div class=\"spacer\"></div>`;\n529\t    case 4: return `\n530\t      <div class=\"glow\"></div>\n531\t      <div class=\"kick\">${t.s5_kick}</div>\n532\t      <h2>${t.s5_title}</h2>\n533\t      <p class=\"lead\">${t.s5_lead}</p>\n534\t      <div class=\"caps\">\n535\t        ${t.s5_caps.map(c=>`<div class=\"cap\"><div class=\"ci\">${c[0]}</div><div class=\"ct\"><b>${c[1]}</b><span>${c[2]}</span></div></div>`).join('')}\n536\t      </div>\n537\t      <div class=\"demo\">\n538\t        <div class=\"demo-top\"><div class=\"demo-av\">N</div><div><div class=\"demo-nm\">${t.s5_demo_nm}</div><div class=\"demo-on\">online</div></div></div>\n539\t        ${bubbles(t.s5_demo)}\n540\t      </div>\n541\t      <div class=\"spacer\"></div>`;\n542\t    case 5: return `\n543\t      <div class=\"glow\"></div>\n544\t      <div class=\"kick\">${t.s6_kick}</div>\n545\t      <h2>${t.s6_title}</h2>\n546\t      <p class=\"lead\">${t.s6_lead}</p>\n547\t      <div class=\"istrip\">\n548\t        ${t.s6_steps.map(s=>`<div class=\"istep\"><div class=\"in\">${s[0]}</div><b>${s[1]}</b></div>`).join('')}\n549\t      </div>\n550\t      <label>${t.s6_name}</label>\n551\t      <input class=\"inp\" placeholder=\"${esc(t.s6_name_ph)}\" value=\"${esc(reg.name)}\" oninput=\"reg.name=this.value;refreshCta()\">\n552\t      <label>${t.s6_phone}</label>\n553\t      <input class=\"inp\" type=\"tel\" placeholder=\"${esc(t.s6_phone_ph)}\" value=\"${esc(reg.phone)}\" oninput=\"reg.phone=this.value;refreshCta()\">\n554\t      <label>${t.s6_email}</label>\n555\t      <input class=\"inp\" type=\"email\" placeholder=\"${esc(t.s6_email_ph)}\" value=\"${esc(reg.email)}\" oninput=\"reg.email=this.value;refreshCta()\">\n556\t      <div class=\"check ${agree?'on':''}\" onclick=\"toggleAgree()\"><div class=\"box\"><span>✓</span></div><div>${t.s6_check}</div></div>\n557\t      <div class=\"spacer\"></div>`;\n558\t  }\n559\t}\n560\t\n561\t// Forward arrow is the opposite of back: Hebrew advances leftward (←), English advances rightward (→).\n562\tfunction cta(label){ return label.replace(/\\s*[→←]\\s*$/,'') + ' ' + (L==='he'?'←':'→'); }\n563\tfunction footHTML(t){\n564\t  switch(i){\n565\t    case 0: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s1_cta)}</button><p class=\"note\">${t.s1_note}</p><p class=\"byline\">${t.s1_by}</p>`;\n566\t    case 1: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s2_cta)}</button><p class=\"note\">${t.s2_note}</p>`;\n567\t    case 2: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s3_cta)}</button><p class=\"note\">${t.s3_note}</p>`;\n568\t    case 3: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s4_cta)}</button><p class=\"note\">${t.s4_note}</p>`;\n569\t    case 4: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s5_cta)}</button><p class=\"note\">${t.s5_note}</p>`;\n570\t    case 5: return `<button class=\"cta\" id=\"regCta\" ${validReg()&&!submitting?'':'disabled'} onclick=\"submitReg()\">${submitting?t.s6_cta_load:cta(t.s6_cta)}</button><p class=\"note\">${t.s6_note}</p>`;\n571\t  }\n572\t}\n573\t\n574\tfunction validReg(){\n575\t  return reg.name.trim().length>=2 &&\n576\t    /^[\\d+][\\d\\-\\s()]{6,}$/.test(reg.phone.trim()) &&\n577\t    /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(reg.email.trim()) &&\n578\t    agree;\n579\t}\n580\tfunction refreshCta(){\n581\t  const c=document.getElementById('regCta');\n582\t  if(c) c.disabled = !validReg() || submitting;\n583\t}\n584\t\n585\tfunction paintChrome(){\n586\t  const t=T[L];\n587\t  document.documentElement.lang=L;\n588\t  document.documentElement.dir = L==='he'?'rtl':'ltr';\n589\t  document.getElementById('back').textContent = L==='he'?'→':'←';\n590\t  document.getElementById('lang').textContent = L==='he'?'EN':'עב';\n591\t  let p='';\n592\t  for(let k=0;k<N;k++) p+=`<div class=\"seg ${k<i?'done':''} ${k===i?'cur':''}\"><i></i></div>`;\n593\t  document.getElementById('prog').innerHTML=p;\n594\t  document.getElementById('stepn').textContent=`${i+1}/${N}`;\n595\t  document.getElementById('back').disabled = i===0 || submitting;\n596\t  document.getElementById('foot').innerHTML=footHTML(t);\n597\t}\n598\t\n599\tfunction init(){\n600\t  const stage=document.getElementById('stage');\n601\t  const div=document.createElement('div');\n602\t  div.className='screen';\n603\t  div.innerHTML=screenHTML(T[L]);\n604\t  stage.appendChild(div);\n605\t  paintChrome();\n606\t}\n607\tfunction repaint(){\n608\t  const stage=document.getElementById('stage');\n609\t  stage.innerHTML='';\n610\t  const div=document.createElement('div');\n611\t  div.className='screen';\n612\t  div.innerHTML=screenHTML(T[L]);\n613\t  stage.appendChild(div);\n614\t  paintChrome();\n615\t}\n616\tfunction transition(dir){\n617\t  if(animating) return;\n618\t  animating=true;\n619\t  const stage=document.getElementById('stage');\n620\t  const old=stage.querySelector('.screen');\n621\t  const nw=document.createElement('div');\n622\t  nw.className='screen '+(dir>0?'in-fwd':'in-back');\n623\t  nw.innerHTML=screenHTML(T[L]);\n624\t  if(old){ old.classList.remove('in-fwd','in-back'); old.classList.add(dir>0?'out-fwd':'out-back'); }\n625\t  stage.appendChild(nw);\n626\t  paintChrome();\n627\t  setTimeout(()=>{ if(old&&old.parentNode) old.parentNode.removeChild(old); animating=false; },380);\n628\t}\n629\tfunction go(d){\n630\t  const ni=i+d;\n631\t  if(ni<0||ni>=N||animating||submitting) return;\n632\t  i=ni; transition(d);\n633\t}\n634\t\n635\tasync function submitReg(){\n636\t  if(!validReg()||submitting||animating) return;\n637\t  submitting=true; paintChrome();\n638\t  const payload={ name:reg.name.trim(), phone:reg.phone.trim(), email:reg.email.trim(), lang:L, src:SRC };\n639\t  try{\n640\t    const r=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});\n641\t    const data=await r.json().catch(()=>null);\n642\t    deepLink=(data&&data.deepLink)?data.deepLink:BOT_FALLBACK;\n643\t  }catch(e){ deepLink=BOT_FALLBACK; }\n644\t  submitting=false; paintChrome();\n645\t  handoff();\n646\t}\n647\tfunction handoff(){\n648\t  const t=T[L], sw=document.getElementById('switch');\n649\t  sw.innerHTML=`<div class=\"ho-ico\">✨</div><h2>${t.magic_t}</h2><p>${t.magic_p}</p>`+\n650\t    `<div class=\"tg-peek\"><div class=\"peek-av\">N</div><div class=\"peek-bub\">${t.magic_peek}</div></div>`+\n651\t    `<button class=\"cta ghost\" style=\"max-width:300px\" onclick=\"closeHandoff()\">${t.sheet_close}</button>`;\n652\t  sw.classList.add('on');\n653\t  window.open(deepLink||BOT_FALLBACK,'_blank','noopener');\n654\t}\n655\tfunction closeHandoff(){ document.getElementById('switch').classList.remove('on'); }\n656\t\n657\tfunction openSheet(which){\n658\t  which = which||'nano';\n659\t  const t=T[L], s=document.getElementById('sheet');\n660\t  const title=t['sheet_'+which+'_t']||t.sheet_nano_t;\n661\t  const body=t['sheet_'+which]||t.sheet_nano;\n662\t  s.innerHTML=`<div class=\"sheet-card\"><h3>${title}</h3>${body.map(p=>`<p>${p}</p>`).join('')}<button class=\"cta ghost\" onclick=\"closeSheet()\">${t.sheet_close}</button></div>`;\n663\t  s.classList.add('on');\n664\t}\n665\tfunction closeSheet(){ document.getElementById('sheet').classList.remove('on'); }\n666\t\n667\tfunction toggleAgree(){ agree=!agree; repaint(); }\n668\tfunction setLang(l){ L=l; repaint(); }\n669\tfunction toggleLang(){ L=(L==='he'?'en':'he'); repaint(); }\n670\t\n671\tinit();\n672\t</script>\n673\t</body>\n674\t</html>\n675\t"}]},"uuid":"af9d04ce-3882-4168-a92c-f79fda6c7782","timestamp":"2026-07-29T19:35:48.183Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/nano.html","content":"<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n<title>NanoShellano · הסוכן האישי שלך</title>\n<link rel=\"icon\" type=\"image/png\" sizes=\"32x32\" href=\"/favicon-32.png\">\n<link rel=\"apple-touch-icon\" href=\"/apple-touch-icon.png\">\n<meta name=\"description\" content=\"פותחים סוכן AI אישי בטלגרם בקליק אחד, בלי רקע טכני.\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"NanoShellano · הסוכן האישי שלך\">\n<meta property=\"og:description\" content=\"פותחים סוכן AI אישי בטלגרם בקליק אחד, בלי רקע טכני.\">\n<meta property=\"og:url\" content=\"https://nanohubdemo.vercel.app/nano.html\">\n<meta property=\"og:site_name\" content=\"NanoShellano\">\n<meta property=\"og:image\" content=\"https://nanohubdemo.vercel.app/shellano_og_share.png\">\n<meta property=\"og:image:width\" content=\"2400\">\n<meta property=\"og:image:height\" content=\"1260\">\n<meta property=\"og:image:alt\" content=\"NanoShellano, your next hire is an AI agent\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"NanoShellano · הסוכן האישי שלך\">\n<meta name=\"twitter:image\" content=\"https://nanohubdemo.vercel.app/shellano_og_share.png\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;700;800&family=Baloo+2:wght@600;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --bg:#000; --panel:#0E0E0E; --panel2:#161616; --line:#242424;\n    --ink:#FFF; --mut:#B0B0B0; --dim:#6F6F6F;\n    --teal:#56EDD6; --teal-deep:#0F756D; --on-teal:#04211D;\n    --red:#FF4D4D; --orange:#E85D3A;\n  }\n  *{box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent}\n  html,body{height:100%}\n  body{background:#050505; font-family:Heebo,system-ui,sans-serif; color:var(--ink);\n    display:flex; align-items:center; justify-content:center; padding:0}\n\n  .device{position:relative; width:100%; max-width:412px; height:100vh; max-height:880px;\n    background:var(--bg); overflow:hidden; display:flex; flex-direction:column;\n    border:1px solid var(--line); border-radius:34px; box-shadow:0 30px 80px rgba(0,0,0,.7)}\n  @media (max-width:480px){ .device{max-width:none; height:100vh; max-height:none; border:0; border-radius:0} }\n\n  .topbar{flex:0 0 auto; display:flex; align-items:center; gap:12px; padding:16px 16px 10px; position:relative; z-index:5}\n  .back{width:44px; height:44px; border-radius:13px; border:1px solid var(--line); background:var(--panel);\n    color:var(--ink); font-size:22px; display:flex; align-items:center; justify-content:center; cursor:pointer; flex:0 0 auto; transition:opacity .2s}\n  .back[disabled]{opacity:.28; pointer-events:none}\n  .prog{flex:1; display:flex; gap:5px}\n  .seg{flex:1; height:4px; border-radius:99px; background:#1c1c1c; overflow:hidden}\n  .seg i{display:block; height:100%; width:0; background:var(--teal); border-radius:99px; transition:width .4s ease}\n  .seg.done i,.seg.cur i{width:100%}\n  .stepn{flex:0 0 auto; font-size:11px; color:var(--dim); font-weight:800; min-width:26px; text-align:center}\n  .lang{flex:0 0 auto; font-size:11px; font-weight:800; color:var(--teal); background:var(--panel);\n    border:1px solid var(--line); border-radius:99px; padding:7px 11px; cursor:pointer; letter-spacing:.4px}\n  .logotxt{flex:0 0 auto; height:30px; width:auto; object-fit:contain; display:block; user-select:none}\n\n  .stage{flex:1; overflow:hidden; position:relative}\n  .screen{position:absolute; inset:0; overflow-y:auto; -webkit-overflow-scrolling:touch;\n    display:flex; flex-direction:column; padding:14px 22px 26px}\n  .screen.in-fwd{animation:inFwd .36s cubic-bezier(.22,.61,.36,1) both}\n  .screen.in-back{animation:inBack .36s cubic-bezier(.22,.61,.36,1) both}\n  .screen.out-fwd{animation:outFwd .36s cubic-bezier(.22,.61,.36,1) both}\n  .screen.out-back{animation:outBack .36s cubic-bezier(.22,.61,.36,1) both}\n  @keyframes inFwd{from{transform:translateX(-100%);opacity:.4} to{transform:translateX(0);opacity:1}}\n  @keyframes outFwd{from{transform:translateX(0);opacity:1} to{transform:translateX(100%);opacity:.2}}\n  @keyframes inBack{from{transform:tra