ovision-handler.\n- מופע יחיד, מאזין אחד בלבד (כלל ברזל — בדוק `ss -ltnp` + getWebhookInfo, אין כפילות), מוניטור פעיל.\n- בדיקת e2e: שני מספרי שולח שונים → שני סוכנים נפרדים, כל אחד מבודד, כל אחד מופיע ב-`ncl groups list` ובדשבורד.\n- הכל על branch, לא הרסני, commit מסודר בסוף.\n\n## אילוצים\n- אל תיגע בזהות הפרטיות: משתמשים שונים = סוכנים נפרדים לחלוטין, אפס דליפה בין שיחות.\n- שמור על התיקון הקיים של ניתוב התשובות (whatsapp.ts) — אל תשבור אותו.\n- Cloud API / 360dialog = לפרודקשן בהמשך, לא ב-Phase הזה.\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2146,"cache_read_input_tokens":85712,"output_tokens":3555,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":2146,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3555,"cache_read_input_tokens":85712,"cache_creation_input_tokens":2146,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2146},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CdWWrkj5LCRCSbBGPZdTa","type":"assistant","uuid":"f79ab97c-9a90-4c0e-ac71-902bc3024f9f","timestamp":"2026-07-29T14:36:30.254Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"029e875a-f3ed-485c-9d41-799f407f317f","version":"2.1.197","gitBranch":"HEAD"}
