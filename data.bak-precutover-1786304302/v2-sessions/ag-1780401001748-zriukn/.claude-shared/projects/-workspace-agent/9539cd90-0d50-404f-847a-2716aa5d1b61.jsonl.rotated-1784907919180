\n568\t\n569\tfunction buildSlideHTML(s, i) {\n570\t  const ov = `<div class=\"s-ov\"></div>`;\n571\t\n572\t  if (s.type === 'cover') {\n573\t    return ov + `<div class=\"s-wrap centered\">\n574\t      <img class=\"cover-logo\" src=\"payme-logo.jpg\" alt=\"PayMe\">\n575\t      <div class=\"cover-tag\">Strategic Partner Sales</div>\n576\t      <h1 class=\"cover-h\">100,000 ₪ MRR נטו.<br><em>בארבעה חודשים.</em></h1>\n577\t      <div class=\"cover-line\">לא ניתחתי שוק. בניתי תוכנית שותפויות שאפשר לפתוח בה את יום העבודה הראשון.</div>\n578\t      <div class=\"cover-meta\"><span>הוגש על ידי</span><span class=\"cover-dot\"></span><b>אליה בן כנען</b></div>\n579\t    </div>`;\n580\t  }\n581\t\n582\t  if (s.type === 'process') {\n583\t    const cards = s.steps.map((c,ci)=>`\n584\t      <div class=\"proc-card\" id=\"proc-card-${i}-${ci}\"><div class=\"proc-num\">${c.num}</div><h3>${c.h}</h3><p>${c.p}</p></div>`).join('');\n585\t    const band = s.band.map(e=>`<div class=\"proc-eng\"><b>${e.b}</b><span>${e.s}</span></div>`).join('');\n586\t    const dir = s.dir ? `<div class=\"proc-dir\"><span class=\"pd-tag\">הכיוון</span>\n587\t      <div class=\"pd-eq\"><b>100,000 ₪</b><span>נטו לחודש</span></div><i class=\"pd-op\">÷</i>\n588\t      <div class=\"pd-eq\"><b>100-150 ₪</b><span>ARPU נטו למשתמש</span></div><i class=\"pd-op\">=</i>\n589\t      <div class=\"pd-eq pd-res\"><b>~700-1,000</b><span>משתמשים לגייס</span></div></div>` : '';\n590\t    return ov + `<div class=\"s-wrap\">\n591\t      <div class=\"label-sm\">${s.kicker}</div><div class=\"rule\"></div>\n592\t      <h1 class=\"h-lg\" id=\"hl-${i}\"></h1><p class=\"body-t\" id=\"bd-${i}\"></p>\n593\t      <div class=\"proc-grid\">${cards}</div><div class=\"proc-band\">${band}</div>${dir}\n594\t    </div>`;\n595\t  }\n596\t\n597\t  if (s.type === 'approach') {\n598\t    const chs = s.chapters.map((c,ci)=>`\n599\t      <div class=\"ap-ch\" id=\"ap-ch-${i}-${ci}\"><div class=\"ap-bar\"></div><div><h4>${c.h}</h4><p>${c.p}</p></div></div>`).join('');"}]},"uuid":"7e958456-c035-4952-971c-430b7a20c9f8","timestamp":"2026-07-23T07:10:14.636Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/agent/payme_deck/index.html","content":"  </div>\n  <div class=\"nav-logo\"><img src=\"payme-logo.jpg\" alt=\"PayMe\"></div>\n</nav>\n\n<div id=\"deck\"></div>\n\n<div id=\"bottombar\">\n  <div id=\"arrows\">\n    <button class=\"arr-btn\" id=\"arr-fwd\">&#8592;</button>\n    <button class=\"arr-btn\" id=\"arr-back\">&#8594;</button>\n  </div>\n  <div id=\"progress\"></div>\n  <div id=\"slide-lbl\"></div>\n</div>\n\n<script>\nconst STAGES = [\n  { n: 'חודש 1', t: 'תכנון\\nוהכנה', mrr: '5,000 ₪', bullets: [\n    'בניית התוכנית והנכסים השיווקיים, מיפוי השוק וההזדמנויות האמיתיות',\n    'מחקר ודגימה בלבד, בלי תהליך מכירה אקטיבי עדיין',\n    'נגיעות חמות למעגל הקרוב ולקשרי Inbound מוכרים, לא Sales Cycle',\n    'פתיחת ערוצי ההפצה: לינקדאין, מייל, רשת אישית, נוכחות ראשונה בסושיאל'\n  ]},\n  { n: 'חודש 2', t: 'מגע ראשון\\nופיילוטים', mrr: '13,600 ₪', bullets: [\n    'מגע אמיתי ראשון עם השוק: פנייה יזומה, ניוזלטרים ו-WhatsApp על השירות המתאים',\n    'קביעת פגישות וקיומן, שליחת חומרים תומכים',\n    'דגימה טלפונית להבין מאיפה מגיע הפידבק',\n    'אחרי כל פגישה יוצאת הצעת מחיר'\n  ]},\n  { n: 'חודש 3', t: 'הבשלה', mrr: '47,000 ₪', bullets: [\n    'הצעות מותאמות אישית ומעקבים רצים, מתחילים משאים ומתנים מורכבים לסגירה',\n    'עסקאות על השולחן, ותהליכים מבשילים שכבר רואים שייסגרו בחודש הבא',\n    'מחממים את הלקוחות המדויקים בעלי הכוונה הגבוהה',\n    'הרחבת ה-Inbound נמשכת במקביל'\n  ]},\n  { n: 'חודש 4', t: 'סגירות\\nואופטימיזציה', mrr: '102,100 ₪', bullets: [\n    'מתחילים לסגור עסקאות',\n    'אופטימיזציה: להשקיע בחשבונות הרציניים, לשחרר את אלה שלא מתקדמים',\n    'בדיקת פרוספקטים מקבילים באותם סגמנטים לפי פידבק מהשטח',\n    'חוצים את היעד: מעל 100K MRR נטו'\n  ]}\n];\n\nconst SLIDES = [\n  { label: 'שער', type: 'cover' },\n  { label: 'מי מאחורי הדק', type: 'profile',\n    kicker: 'מי מאחורי הדק',\n    photo: 'elia.png',\n    name: 'אליה בן כנען',\n    role: 'פיתוח עסקי · אסטרטגיה שיווקית · 15 שנה',\n    pts: [\n      '<b>15 שנה בפיתוח עסקי ואסטרטגיה שיווקית</b>, מהמפגש הראשון ועד סגירת העסקה.',\n      'עבודת שטח מול שותפים: לפתוח דלתות, לבנות ערך משותף ולהניע תהליך מסחרי עד הסוף.',\n      'את המתודה הזו כבר הפעלתי בשטח: מיפוי שוק, פתיחת הדלת הנכונה וסגירת שותפויות מסחריות מקצה לקצה. בדיוק מה שהתפקיד דורש.'\n    ]\n  },\n  { label: 'איך ניגשתי', type: 'approach', cycle: true,\n    kicker: 'איך ניגשתי',\n    hl: 'לא ניתחתי שוק.<br><em>בניתי מפה שאפשר לפתוח בה את היום הראשון.</em>',\n    sub: 'ארבעה חלקים שמרכיבים את התמונה. תכף אני לוקח אתכם על כל אחד מהם.',\n    chapters: [\n      { h: 'אפיון שוק', p: 'מי בכלל השחקנים, ואיפה הפוטנציאל האמיתי.' },\n      { h: 'חלוקה — Inbound / Outbound', p: 'מינוף שותפים קיימים מול פתיחת קרקע חדשה.' },\n      { h: 'מתודה — תעדוף שותפים', p: 'לזהות את הנכון בזמן הנכון, לא לרדוף אחרי כמות.' },\n      { h: 'הכסף — הדרך ל-MRR', p: 'איך כל זה מצטבר ל-100,000 ₪ נטו בחודש.' }\n    ]\n  },\n  { label: 'איך בניתי את האסטרטגיה', type: 'process', dir: true,\n    kicker: 'האסטרטגיה',\n    hl: 'איך בניתי\\n<em>את האסטרטגיה</em>',\n    bd: 'לא ניחוש. תהליך של ארבעה שלבים, מרוחב של השוק אל תוכנית שאפשר להריץ.',\n    steps: [\n      { num: '1', h: 'מחקר שוק', p: '5 סגמנטים, 40+ שותפים פוטנציאליים' },\n      { num: '2', h: 'סינון ופוקוס', p: 'הסגמנטים עם הפוטנציאל הגבוה ביותר' },\n      { num: '3', h: 'חלוקה', p: 'Inbound (מינוף קיימים) + Outbound (שותפים חדשים)' },\n      { num: '4', h: 'תוכנית אופרטיבית', p: 'למי פונים, מה אומרים, מתי סוגרים, כמה מכניס' }\n    ],\n    band: [\n      { b: 'Inbound', s: '4 שותפים קיימים · הרחבת מוצרים · ~90,000 עסקים' },\n      { b: 'Outbound', s: '6 שותפים חדשים · 5 סגמנטים · ~20,000 עסקים' }\n    ]\n  },\n  { label: 'שני מנועים', type: 'split', cycle: true,\n    hl: 'שני מנועים.\\n<em>יעד אחד.</em>',\n    bd: 'לא הימרתי הכל על עסקאות חדשות. חצי מהתוכנית מגדל שותפים שכבר בפנים, מהיר ובסיכון נמוך. החצי השני פותח קרקע חדשה. אם אחד מתעכב, השני מפצה.',\n    cards: [\n      { step: 'מנוע 01', hl: 'Inbound', bd: 'ארבעה שותפים שכבר עובדים עם PayMe. מרחיבים את מה שהם מוכרים, מתשלומים אל הנהלת חשבונות ושיווק. המעגל הקרוב קודם, בלי להתחיל מאפס.' },\n      { step: 'מנוע 02', hl: 'Outbound', bd: 'שש שותפויות חדשות שבהן PayMe עדיין לא נמצאת, שנבחרו כי ההתאמה ברורה וה-Sales Cycle קצר.' }\n    ]\n  },\n  { label: 'תעדוף שותפים', type: 'priority', cycle: true,\n    kicker: 'המתודולוגיה',\n    hl: 'מתודולוגיה <em>לתעדוף שותפים</em>',\n    sub: 'לא כל שותף נמצא באותה רמת בשלות. לכן גם אסטרטגיית הפנייה חייבת להשתנות בהתאם.',\n    cards: [\n      { emoji: '🔥', eyebrow: 'Ready to Partner', h: 'שותפים רעבים',\n        desc: ['מחפשים חדשנות', 'רוצים להרחיב את המוצר', 'פתוחים לשותפויות', 'מחפשים יתרון תחרותי'],\n        strat: 'Direct Outbound' },\n      { emoji: '⚡', eyebrow: 'Problem, Low Awareness', h: 'יש כאב, אין מודעות',\n        desc: ['הכאב קיים', 'אין הבנה שיש פתרון', 'קשה יותר לייצר פגישה'],\n        strat: 'Education & Enablement' },\n      { emoji: '🌱', eyebrow: 'Future Opportunity', h: 'עדיין לא בשלים',\n        desc: ['אין עדיפות עסקית', 'אין דחיפות', 'פוטנציאל עתידי'],\n        strat: 'Relationship Building' }\n    ],\n    mid: 'המטרה היא לא לפנות ליותר שותפים — אלא לזהות את אלו שנמצאים בנקודת הזמן הנכונה לשיתוף פעולה.',\n    close: 'האסטרטגיה הזאת היא לא רשימת שותפים. <em>היא הסינון שהוביל אליה.</em>'\n  },\n  { label: 'Inbound · מוצרים משלימים', type: 'table',\n    kicker: 'מנוע 01 · Inbound',\n    hl: 'מוצרים משלימים <em>לשותפים קיימים</em>',\n    sub: 'כל שותף כבר משתמש במוצר אחד של PayMe. אלה הפתחים להוסיף מוצר שני. פער אחד מאומת. השאר השערות שדורשות שיחת גילוי לפני הקצאת משאבים.',\n    cols: ['שותף', 'משתמש היום', 'מוצר להוסיף', 'למה', 'סטטוס', 'MRR משוער'],\n    rows: [\n      ['Wix', 'Payments בלבד', 'Accounting (חשבוניות IL)', 'אין חשבוניות מאושרות רשות המסים לסוחרים ישראלים. חובה חוקית עם אפס כיסוי היום.', '<span class=\"st-ok\">מאומת</span>', '<span class=\"num\">7,500 ₪</span>'],\n