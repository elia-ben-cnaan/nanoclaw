{"parentUuid":"112bd93d-0f54-4bb8-81dc-d31800986419","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/build_cover.mjs","content":{"type":"text","file":{"filePath":"/workspace/agent/build_cover.mjs","content":"import { createRequire } from 'module';\nconst require = createRequire('/workspace/agent/');\nconst sharp = require('sharp');\n\nconst W = 1200, H = 630;\nconst TEAL = '#56EDD6';\nconst MUTED = '#93AAA6';\nconst DOTCOL = '#3E6B65';\n\n// render a text line to a tight-trimmed PNG buffer, return {data,width,height}\nasync function text(svgInner, {size, weight, family, fill='#FFFFFF', rtl=false, ls=''}) {\n  const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1600\" height=\"220\">\n    <text x=\"800\" y=\"140\" text-anchor=\"middle\" font-family=\"${family}\" font-weight=\"${weight}\"\n      font-size=\"${size}\" fill=\"${fill}\" ${rtl?'direction=\"rtl\"':''} ${ls?`letter-spacing=\"${ls}\"`:''}>${svgInner}</text></svg>`;\n  const r = await sharp(Buffer.from(svg)).png().trim().toBuffer({resolveWithObject:true});\n  return {data:r.data, width:r.info.width, height:r.info.height};\n}\n\nfunction bg() {\n  const svg = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"${W}\" height=\"${H}\">\n    <defs>\n      <linearGradient id=\"g\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0\" stop-color=\"#04100E\"/>\n        <stop offset=\"0.55\" stop-color=\"#08221F\"/>\n        <stop offset=\"1\" stop-color=\"#0F3E38\"/>\n      </linearGradient>\n      <radialGradient id=\"glow\" cx=\"0.22\" cy=\"0.5\" r=\"0.5\">\n        <stop offset=\"0\" stop-color=\"#0F756D\" stop-opacity=\"0.55\"/>\n        <stop offset=\"1\" stop-color=\"#0F756D\" stop-opacity=\"0\"/>\n      </radialGradient>\n    </defs>\n    <rect width=\"${W}\" height=\"${H}\" fill=\"url(#g)\"/>\n    <rect width=\"${W}\" height=\"${H}\" fill=\"url(#glow)\"/>\n    <rect x=\"8\" y=\"8\" width=\"${W-16}\" height=\"${H-16}\" rx=\"22\" fill=\"none\" stroke=\"#1B4C46\" stroke-width=\"1.5\"/>\n  </svg>`;\n  return sharp(Buffer.from(svg)).png().toBuffer();\n}\n\nasync function build(lang) {\n  const he = lang === 'he';\n  const mascotH = 300;\n  const mascot = await sharp('/tmp/mascot.png').resize({height:mascotH}).png().toBuffer();\n  const mascotMeta = await sharp(mascot).metadata();\n  const mascotW = mascotMeta.width;\n  const wmH = 104;\n  const wordmark = await sharp('/tmp/wordmark.png').resize({height:wmH}).png().toBuffer();\n  const wmMeta = await sharp(wordmark).metadata();\n\n  const fam = he ? 'Assistant' : 'Rubik';\n  const headInner = he\n    ? 'העובד הבא שלך הוא <tspan fill=\"'+TEAL+'\">סוכן AI.</tspan>'\n    : 'Your next hire is an <tspan fill=\"'+TEAL+'\">AI agent.</tspan>';\n  const subStr = he\n    ? 'קליק אחד, והוא מתחיל לעבוד איתך.'\n    : 'One click, and it starts working with you.';\n\n  const head = await text(headInner, {size:46, weight:700, family:fam, rtl:he});\n  const sub  = await text(subStr,   {size:25, weight:400, family:fam, fill:MUTED, rtl:he});\n  const dot  = await text('CLICK2AGENT.COM', {size:17, weight:500, family:'Rubik', fill:DOTCOL, ls:'2'});\n\n  // vertical stack metrics\n  const gap1 = 30, gap2 = 16;\n  const stackH = wmH + gap1 + head.height + gap2 + sub.height;\n  let y = Math.round((H - stackH)/2);\n  const mascotX = 66;\n  const mascotY = Math.round((H - mascotH)/2);\n\n  const layers = [];\n  layers.push({input:mascot, left:mascotX, top:mascotY});\n\n  if (!he) {\n    const x0 = mascotX + mascotW + 58;\n    layers.push({input:wordmark, left:x0, top:y});\n    layers.push({input:head.data, left:x0, top:y + wmH + gap1});\n    layers.push({input:sub.data,  left:x0, top:y + wmH + gap1 + head.height + gap2});\n  } else {\n    const xR = W - 70; // right edge\n    layers.push({input:wordmark, left:xR - wmMeta.width, top:y});\n    layers.push({input:head.data, left:xR - head.width, top:y + wmH + gap1});\n    layers.push({input:sub.data,  left:xR - sub.width,  top:y + wmH + gap1 + head.height + gap2});\n  }\n  // footer .com bottom-right\n  layers.push({input:dot.data, left:W - 70 - dot.width, top:H - 52});\n\n  const out = `/workspace/agent/tmp_shellano_hotfix/c2a_cover_${lang}.png`;\n  await sharp(await bg()).composite(layers).png().toFile(out);\n  console.log('wrote', out, 'stackH', stackH, 'mascotW', mascotW);\n}\n\nawait build('en');\nawait build('he');\n","numLines":92,"startLine":1,"totalLines":92}},"displayPath":"build_cover.mjs"},"type":"attachment","uuid":"97295bff-adb5-4894-9622-ddec0e9c0d04","timestamp":"2026-07-30T13:55:53.365Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b8e5a041-8777-4971-96a5-1f43dc881d7e","version":"2.1.197","gitBranch":"HEAD","slug":"wondrous-dancing-pnueli"}
