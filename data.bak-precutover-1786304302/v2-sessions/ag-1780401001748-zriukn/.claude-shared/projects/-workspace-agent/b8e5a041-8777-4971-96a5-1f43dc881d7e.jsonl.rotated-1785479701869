{"parentUuid":"1f6415a3-6f1c-4b00-b65c-7bb2f7d19e0a","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/api/app-summary.js","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/api/app-summary.js","content":"// App journey funnel — proxies the VM tracking endpoint (provision.shellano.com/app/summary),\n// which owns the anonymous event store on SQLite. Moved off Vercel Blob (suspended quota).\n// The authenticated summary URL (with its ADMIN_KEY) lives in APP_SUMMARY_URL server-side and\n// never reaches the browser. The VM already folds events per visitor and computes the funnel;\n// we only humanize the source labels here so the board renders consistent Hebrew names.\nconst KNOWN = {\n  shellano: \"שלנו · וואטסאפ\",\n  click2agent: \"קליק טו אייג'נט · וואטסאפ\",\n  c2a: \"קליק טו אייג'נט · וואטסאפ\",\n  linkedin: \"לינקדאין\",\n  li: \"לינקדאין\",\n  avigail: \"אביגיל\",\n  lnd: \"קבוצת לינקדאין\",\n  facebook: \"פייסבוק\",\n  fb: \"פייסבוק\",\n  instagram: \"אינסטגרם\",\n  ig: \"אינסטגרם\",\n  wa: \"וואטסאפ\",\n  whatsapp: \"וואטסאפ\",\n};\nfunction labelFor(raw) {\n  const s = String(raw || \"\").trim();\n  if (!s || s === \"לא ידוע\" || s === \"null\") return \"לא מסומן\";\n  const low = s.toLowerCase();\n  if (KNOWN[low]) return KNOWN[low];\n  return low.split(/[-_]/).map((p) => KNOWN[p] || p).join(\" · \");\n}\n\nmodule.exports = async function handler(req, res) {\n  res.setHeader('Cache-Control', 'no-store');\n  const url = process.env.APP_SUMMARY_URL;\n  if (!url) {\n    return res.status(200).json({ ok: false, error: \"summary not configured\" });\n  }\n  try {\n    const r = await fetch(url, { headers: { Accept: \"application/json\" } });\n    if (!r.ok) return res.status(200).json({ ok: false, error: \"upstream \" + r.status });\n    const data = await r.json();\n    if (!data || data.ok === false) {\n      return res.status(200).json({ ok: false, error: (data && data.error) || \"no data\" });\n    }\n\n    // Humanize source labels, keeping the VM's computed counts intact.\n    const bySource = Array.isArray(data.bySource)\n      ? data.bySource\n          .map((o) => ({\n            label: labelFor(o.label),\n            entered: +o.entered || 0,\n            reachedForm: +o.reachedForm || 0,\n            submitted: +o.submitted || 0,\n          }))\n          .sort((a, b) => b.entered - a.entered)\n      : [];\n\n    return res.status(200).json({\n      ok: true,\n      funnel: data.funnel || { entered: 0, clicked: 0, reachedForm: 0, submitted: 0, droppedNoForm: 0, abandonedForm: 0 },\n      totals: data.totals || {\n        total_visits: 0,\n        unique_visitors: 0,\n        last_24h: { visits: 0, unique_visitors: 0 },\n        last_7d: { visits: 0, unique_visitors: 0 },\n      },\n      depth: Array.isArray(data.depth) ? data.depth : [0, 0, 0, 0, 0],\n      medDwellMs: +data.medDwellMs || 0,\n      bySource,\n      generated_at: data.generated_at || new Date().toISOString(),\n    });\n  } catch (e) {\n    return res.status(200).json({ ok: false, error: String((e && e.message) || e) });\n  }\n};\n","numLines":73,"startLine":1,"totalLines":73}},"displayPath":"nanohub_demo/api/app-summary.js"},"type":"attachment","uuid":"88f7bb47-eb13-4f54-85c3-31875c190a89","timestamp":"2026-07-31T06:16:33.825Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b8e5a041-8777-4971-96a5-1f43dc881d7e","version":"2.1.197","gitBranch":"HEAD","slug":"wondrous-dancing-pnueli"}
{"parentUuid":"88f7bb47-eb13-4f54-85c3-31875c190a89","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/api/register.js","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/api/register.js","content":"// Pilot registration endpoint.\n// Validates the new user, then tries to provision a real agent + Telegram deep link\n// via the host provisioner (HOST_PROVISION_URL). If the host piece is not wired yet,\n// it returns status:\"pending\" with the shared-bot fallback link, so the flow never breaks\n// and no registration is lost.\n\nconst BOT = process.env.PILOT_BOT || \"joni_agent_bot\";\n\nfunction bad(res, msg) {\n  res.status(400).json({ ok: false, error: msg });\n}\n\nmodule.exports = async (req, res) => {\n  res.setHeader(\"Access-Control-Allow-Origin\", \"*\");\n  res.setHeader(\"Access-Control-Allow-Methods\", \"POST, OPTIONS\");\n  res.setHeader(\"Access-Control-Allow-Headers\", \"Content-Type\");\n  if (req.method === \"OPTIONS\") return res.status(200).end();\n  if (req.method !== \"POST\") return bad(res, \"method\");\n\n  let body = req.body;\n  if (typeof body === \"string\") {\n    try { body = JSON.parse(body); } catch { return bad(res, \"json\"); }\n  }\n  body = body || {};\n\n  const name = String(body.name || \"\").trim();\n  const phone = String(body.phone || \"\").trim();\n  const email = String(body.email || \"\").trim();\n  let gender = String(body.gender || \"\").trim();\n  const lang = String(body.lang || \"he\").trim();\n  const src = String(body.src || \"\").trim().slice(0, 64);\n\n  if (name.length < 2) return bad(res, \"name\");\n  // Phone and email are optional (name-only onboarding). If provided, they must be valid.\n  if (phone && !/^[\\d+][\\d\\-\\s()]{6,}$/.test(phone)) return bad(res, \"phone\");\n  if (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return bad(res, \"email\");\n  // gender is optional; only keep it if it's a recognized value.\n  if (![\"m\", \"f\"].includes(gender)) gender = \"\";\n\n  const lead = { name, phone, email, gender, lang, src, ts: new Date().toISOString() };\n\n  // Never lose a registration: log it (visible in Vercel function logs) and forward if a sink is set.\n  console.log(\"[pilot-register]\", JSON.stringify(lead));\n  if (process.env.LEAD_SINK_URL) {\n    try {\n      await fetch(process.env.LEAD_SINK_URL, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify(lead),\n      });\n    } catch (e) { console.log(\"[pilot-register] sink failed\", String(e)); }\n  }\n\n  // The real chain: ask the host provisioner to create the agent + mint a Telegram pairing code.\n  if (process.env.HOST_PROVISION_URL) {\n    try {\n      const r = await fetch(process.env.HOST_PROVISION_URL, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n          ...(process.env.HOST_PROVISION_TOKEN\n            ? { Authorization: `Bearer ${process.env.HOST_PROVISION_TOKEN}` }\n            : {}),\n        },\n        body: JSON.stringify(lead),\n      });\n      if (r.ok) {\n        const data = await r.json();\n        if (data && data.deepLink) {\n          // t.me is under a global DNS outage (NXDOMAIN); telegram.me resolves and\n          // opens the same bot. Rewrite so users can actually reach the pairing link.\n          const link = String(data.deepLink).replace(/^https?:\\/\\/t\\.me\\//, \"https://telegram.me/\");\n          return res.status(200).json({ ok: true, status: \"live\", deepLink: link });\n        }\n      }\n      console.log(\"[pilot-register] provision non-ok\", r.status);\n    } catch (e) {\n      console.log(\"[pilot-register] provision failed\", String(e));\n    }\n  }\n\n  // Host piece not wired yet: keep the flow alive, send them to the shared bot.\n  return res.status(200).json({\n    ok: true,\n    status: \"pending\",\n    deepLink: `https://telegram.me/${BOT}`,\n  });\n};\n","numLines":89,"startLine":1,"totalLines":89}},"displayPath":"nanohub_demo/api/register.js"},"type":"attachment","uuid":"17b2b78e-1a24-4139-b26f-9356fbfb0066","timestamp":"2026-07-31T06:16:33.824Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b8e5a041-8777-4971-96a5-1f43dc881d7e","version":"2.1.197","gitBranch":"HEAD","slug":"wondrous-dancing-pnueli"}
