{"parentUuid":"d8381b0e-5d27-4a2d-9fb0-2b2fb7b73dab","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/api/app-summary.js","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/api/app-summary.js","content":"// App journey funnel — reads evapp/ blobs (written by /api/ta) and computes the\n// interface-monitoring funnel Elia asked for: entered → saw screens → clicked →\n// reached the form → left details / dropped, grouped by source link.\n// Same store as the guide, distinct prefix, so the guide's summary is untouched.\nconst KNOWN = {\n  shellano: \"שלנו · וואטסאפ\",\n  click2agent: \"קליק טו אייג'נט · וואטסאפ\",\n  c2a: \"קליק טו אייג'נט · וואטסאפ\",\n  linkedin: \"לינקדאין\",\n  facebook: \"פייסבוק\",\n  instagram: \"אינסטגרם\",\n};\nfunction labelFor(raw) {\n  const s = String(raw || \"\").trim();\n  if (!s || s === \"לא ידוע\" || s === \"null\") return \"לא מסומן\";\n  const low = s.toLowerCase();\n  if (KNOWN[low]) return KNOWN[low];\n  return low.split(/[-_]/).map((p) => KNOWN[p] || p).join(\" · \");\n}\n\nasync function loadAll(list) {\n  const out = [];\n  let cursor;\n  do {\n    const page = await list({ prefix: 'evapp/', cursor, limit: 1000 });\n    const batch = page.blobs || [];\n    for (let i = 0; i < batch.length; i += 30) {\n      const slice = batch.slice(i, i + 30);\n      const recs = await Promise.all(slice.map(async (b) => {\n        try { const r = await fetch(b.url); return await r.json(); } catch { return null; }\n      }));\n      for (const r of recs) if (r) out.push(r);\n    }\n    cursor = page.cursor;\n  } while (cursor);\n  return out;\n}\n\nmodule.exports = async function handler(req, res) {\n  res.setHeader('Cache-Control', 'no-store');\n  try {\n    const { list } = await import('@vercel/blob');\n    const recs = await loadAll(list);\n\n    // Fold every event for a visitor into a single journey (sessions are richer than visits).\n    const V = new Map(); // vid -> journey\n    for (const r of recs) {\n      const vid = r.vid || 'anon';\n      let j = V.get(vid);\n      if (!j) { j = { vid, src: '', maxStep: 0, dwell: 0, clicked: false, reachedForm: false, submitted: false, lastTs: '' }; V.set(vid, j); }\n      if (r.src && !j.src) j.src = r.src;\n      const step = +r.max_step || 0;\n      if (step > j.maxStep) j.maxStep = step;\n      if ((+r.dwell_ms || 0) > j.dwell) j.dwell = +r.dwell_ms || 0;\n      if (r.submitted) j.submitted = true;\n      const evs = Array.isArray(r.events) ? r.events : [];\n      for (const e of evs) {\n        const name = e && (e.e || e.name || '');\n        if (name === 'cta_click') j.clicked = true;\n        if (name === 'reached_form') j.reachedForm = true;\n        if (name === 'register_submit') j.submitted = true;\n      }\n      // screen 4 = the form screen in the N=5 app (0..4)\n      if (j.maxStep >= 4) j.reachedForm = true;\n      const t = r.received_at || r.ts || '';\n      if (t > j.lastTs) j.lastTs = t;\n    }\n\n    const journeys = [...V.values()];\n    const entered = journeys.length;\n    const clicked = journeys.filter((j) => j.clicked || j.maxStep >= 1).length;\n    const reachedForm = journeys.filter((j) => j.reachedForm).length;\n    const submitted = journeys.filter((j) => j.submitted).length;\n    const droppedNoForm = entered - reachedForm;\n    const abandonedForm = reachedForm - submitted; // saw the form, left no details\n    const dwells = journeys.map((j) => j.dwell).filter((x) => x > 0).sort((a, b) => a - b);\n    const medDwell = dwells.length ? dwells[Math.floor(dwells.length / 2)] : 0;\n\n    // screen-depth distribution (how far people got): screens 0..4\n    const depth = [0, 0, 0, 0, 0];\n    for (const j of journeys) { const s = Math.min(4, Math.max(0, j.maxStep)); for (let k = 0; k <= s; k++) depth[k]++; }\n\n    // by source: entered / reached form / submitted\n    const bySrcMap = new Map();\n    for (const j of journeys) {\n      const label = labelFor(j.src);\n      let o = bySrcMap.get(label);\n      if (!o) { o = { label, entered: 0, reachedForm: 0, submitted: 0 }; bySrcMap.set(label, o); }\n      o.entered++; if (j.reachedForm) o.reachedForm++; if (j.submitted) o.submitted++;\n    }\n    const bySource = [...bySrcMap.values()].sort((a, b) => b.entered - a.entered);\n\n    return res.status(200).json({\n      ok: true,\n      funnel: { entered, clicked, reachedForm, submitted, droppedNoForm, abandonedForm },\n      depth,       // index = screen number, value = visitors who reached at least that screen\n      medDwellMs: medDwell,\n      bySource,\n      generated_at: new Date().toISOString(),\n    });\n  } catch (e) {\n    return res.status(200).json({ ok: false, error: String((e && e.message) || e) });\n  }\n};\n","numLines":105,"startLine":1,"totalLines":105}},"displayPath":"nanohub_demo/api/app-summary.js"},"type":"attachment","uuid":"93859e02-649c-4cb6-8c76-e2aaaffdcf70","timestamp":"2026-07-11T21:21:30.453Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b0b43f8a-4b7b-497b-a61a-9ff51bce7b01","version":"2.1.197","gitBranch":"HEAD","slug":"steady-foraging-treehouse"}
{"parentUuid":"93859e02-649c-4cb6-8c76-e2aaaffdcf70","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/api/ta.js","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/api/ta.js","content":"// App journey tracker — one blob per event under the evapp/ prefix.\n// Shares the blob store with the guide engine but a different prefix, so the guide's\n// summary (which reads ev/ + lead/) is untouched. Accepts type:'visit' | 'session'.\n// text/plain body (sendBeacon / fetch keepalive). Same-origin from the board's project;\n// CORS-open so the app landing (shellano.com / click2agent.com) can beacon in cross-origin.\nmodule.exports = async function handler(req, res) {\n  const { put } = await import('@vercel/blob');\n  res.setHeader('Access-Control-Allow-Origin', '*');\n  res.setHeader('Access-Control-Allow-Methods', 'POST, OPTIONS');\n  res.setHeader('Access-Control-Allow-Headers', 'Content-Type');\n  if (req.method === 'OPTIONS') { res.status(200).end(); return; }\n  if (req.method !== 'POST') { res.status(405).json({ ok: false }); return; }\n\n  let data = null;\n  try {\n    const raw = req.body;\n    if (raw && typeof raw === 'object' && !Buffer.isBuffer(raw)) data = raw;\n    else {\n      const s = Buffer.isBuffer(raw) ? raw.toString('utf8')\n              : (typeof raw === 'string' ? raw : await readRaw(req));\n      data = JSON.parse(s);\n    }\n  } catch (e) { res.status(200).json({ ok: false, error: 'bad json' }); return; }\n  if (!data || typeof data !== 'object') { res.status(200).json({ ok: false }); return; }\n\n  const type = data.type === 'session' ? 'session' : 'visit';\n  try {\n    const rec = {\n      kind: type,\n      vid: String(data.vid || ''),\n      page: data.page || 'app',\n      src: (data.src || '').slice(0, 64),\n      lang: data.lang || '',\n      referrer: data.referrer || '',\n      ua: (data.ua || '').slice(0, 300),\n      ts: data.ts || '',\n      received_at: new Date().toISOString(),\n    };\n    if (type === 'session') {\n      rec.dwell_ms = +data.dwell_ms || 0;\n      rec.max_step = +data.max_step || 0;\n      rec.max_scroll = +data.max_scroll || 0;\n      rec.submitted = !!data.submitted;\n      rec.events = Array.isArray(data.events) ? data.events.slice(0, 90) : [];\n    }\n    await put(`evapp/${rec.vid || 'anon'}-${Date.now()}-${rand()}.json`, JSON.stringify(rec),\n      { access: 'public', contentType: 'application/json', addRandomSuffix: false });\n    res.status(200).json({ ok: true });\n  } catch (e) {\n    res.status(200).json({ ok: false, error: String(e && e.message || e) });\n  }\n};\n\nfunction rand() { return Math.random().toString(36).slice(2, 8); }\nfunction readRaw(req) {\n  return new Promise((resolve) => {\n    let s = ''; req.on('data', c => s += c); req.on('end', () => resolve(s)); req.on('error', () => resolve(''));\n  });\n}\n","numLines":60,"startLine":1,"totalLines":60}},"displayPath":"nanohub_demo/api/ta.js"},"type":"attachment","uuid":"ec02d307-afaf-4384-a883-25c8974bfbd5","timestamp":"2026-07-11T21:21:30.457Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b0b43f8a-4b7b-497b-a61a-9ff51bce7b01","version":"2.1.197","gitBranch":"HEAD","slug":"steady-foraging-treehouse"}
