up by source ourselves so labels are consistent + extensible\n    const counts = {};\n    for (const a of agents) {\n      const key = labelFor(a.source);\n      counts[key] = (counts[key] || 0) + 1;\n    }\n    const bySource = Object.entries(counts)\n      .map(([label, count]) => ({ label, count }))\n      .sort((x, y) => y.count - x.count);\n\n    const entries = agents\n      .map((a) => ({\n        name: a.userName || a.friendlyName || \"\",\n        phone: a.phone || \"\",\n        email: a.email || \"\",\n        source: labelFor(a.source),\n        when: a.createdAt || null,\n        status: a.status || \"\",\n      }))\n      .sort((x, y) => String(y.when || \"\").localeCompare(String(x.when || \"\")));\n\n    return res.status(200).json({\n      ok: true,\n      total: agents.length,\n      bySource,\n      entries,\n      generated_at: new Date().toISOString(),\n    });\n  } catch (e) {\n    return res.status(200).json({ ok: false, error: String((e && e.message) || e) });\n  }\n};\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1110,"cache_read_input_tokens":79973,"output_tokens":3235,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1110,"ephemeral_5m_input_tokens":0},"inference_geo":"not_available","iterations":[{"input_tokens":2,"output_tokens":3235,"cache_read_input_tokens":79973,"cache_creation_input_tokens":1110,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1110},"type":"message"}],"speed":"standard"},"diagnostics":null},"requestId":"req_011CcvtULug7CJWpzesZrFLQ","type":"assistant","uuid":"594980e0-9549-47c5-a5ce-6743df56e96d","timestamp":"2026-07-11T20:19:21.773Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"b0b43f8a-4b7b-497b-a61a-9ff51bce7b01","version":"2.1.197","gitBranch":"HEAD","slug