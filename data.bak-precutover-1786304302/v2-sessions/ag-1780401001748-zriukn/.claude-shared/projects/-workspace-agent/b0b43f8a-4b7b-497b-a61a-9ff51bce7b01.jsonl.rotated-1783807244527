{"parentUuid":"54a39156-d262-4293-a07d-13847bdebc18","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/board.html","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/board.html","content":"<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"robots\" content=\"noindex,nofollow\">\n<title>NanoCo · בורד מוניטורינג</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#000; --card:#101010; --card2:#181818; --line:#3A3A3A;\n    --ink:#fff; --muted:#B0B0B0; --teal:#56EDD6; --action:#0F756D; --orange:#E85D3A;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--paper);color:var(--ink);font-family:Heebo,system-ui,sans-serif}\n  .wrap{max-width:1000px;margin:0 auto;padding:18px 16px 60px}\n  header{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}\n  .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:18px}\n  .dot{width:12px;height:12px;border-radius:50%;background:var(--teal)}\n  /* toggle */\n  .tabs{display:inline-flex;background:var(--card);border:1px solid var(--line);border-radius:999px;padding:4px}\n  .tab{border:0;background:transparent;color:var(--muted);font-family:inherit;font-weight:700;font-size:14px;padding:8px 20px;border-radius:999px;cursor:pointer;transition:.15s}\n  .tab.on{background:var(--teal);color:#00201d}\n  .bar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:6px 0 14px;flex-wrap:wrap}\n  .upd{color:var(--muted);font-size:13px}\n  .btn{background:var(--action);color:#fff;border:0;border-radius:10px;padding:9px 18px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer}\n  .btn:disabled{opacity:.5;cursor:default}\n  /* kpis */\n  .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}\n  .kpi{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px}\n  .kpi .n{font-size:30px;font-weight:800;line-height:1}\n  .kpi .l{color:var(--muted);font-size:12px;margin-top:6px}\n  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:14px}\n  .panel h3{margin:0 0 12px;font-size:15px;font-weight:700}\n  .lrow{display:flex;align-items:center;gap:10px;margin:9px 0}\n  .lrow .nm{flex:0 0 42%;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  .lrow .tr{flex:1;height:8px;background:var(--card2);border-radius:6px;overflow:hidden}\n  .lrow .tr i{display:block;height:100%;background:var(--teal)}\n  .lrow .ct{flex:0 0 auto;font-weight:700;font-size:14px;min-width:26px;text-align:left}\n  .lrow .pc{flex:0 0 auto;color:var(--muted);font-size:12px;min-width:38px;text-align:left}\n  table{width:100%;border-collapse:collapse;font-size:13px}\n  th,td{text-align:right;padding:9px 8px;border-bottom:1px solid var(--line)}\n  th{color:var(--muted);font-weight:500;font-size:12px}\n  .ltr{direction:ltr;text-align:right}\n  .tag{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;background:var(--card2);color:var(--teal)}\n  .empty,.mini-empty{color:var(--muted);font-size:13px;padding:8px 0}\n  .err{color:var(--orange);font-size:13px;padding:8px 0}\n  iframe{width:100%;height:2200px;border:0;border-radius:14px;background:#000}\n  .hide{display:none}\n  .hint{color:var(--muted);font-size:12px;margin-top:-4px;margin-bottom:12px}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div class=\"brand\"><span class=\"dot\"></span> בורד מוניטורינג</div>\n    <div class=\"tabs\">\n      <button class=\"tab on\" id=\"tab-app\" data-view=\"app\">אפליקציה</button>\n      <button class=\"tab\" id=\"tab-guide\" data-view=\"guide\">מדריך</button>\n    </div>\n  </header>\n\n  <!-- ===== APP VIEW ===== -->\n  <section id=\"view-app\">\n    <div class=\"bar\">\n      <div class=\"upd\" id=\"app-upd\">—</div>\n      <button class=\"btn\" id=\"app-refresh\">רענן</button>\n    </div>\n    <p class=\"hint\">כניסות לאפליקציה לפי קישור המקור. מתעדכן רק בלחיצה על \"רענן\".</p>\n    <div id=\"app-error\"></div>\n\n    <div class=\"kpis\">\n      <div class=\"kpi\"><div class=\"n\" id=\"k-total\">0</div><div class=\"l\">סה״כ כניסות</div></div>\n      <div class=\"kpi\"><div class=\"n\" id=\"k-sources\">0</div><div class=\"l\">מקורות פעילים</div></div>\n      <div class=\"kpi\"><div class=\"n\" id=\"k-tagged\">0</div><div class=\"l\">מתויגות למקור</div></div>\n    </div>\n\n    <div class=\"panel\">\n      <h3>כניסות לפי מקור</h3>\n      <div id=\"p-source\"><div class=\"mini-empty\">לחצי \"רענן\" לטעינה</div></div>\n    </div>\n\n    <div class=\"panel\">\n      <h3>רשימת כניסות</h3>\n      <div id=\"p-entries\"><div class=\"empty\">—</div></div>\n    </div>\n  </section>\n\n  <!-- ===== GUIDE VIEW ===== -->\n  <section id=\"view-guide\" class=\"hide\">\n    <div class=\"bar\">\n      <div class=\"upd\">בורד המדריך · מבקרים, לידים ופאנל</div>\n      <button class=\"btn\" id=\"guide-refresh\">רענן</button>\n    </div>\n    <p class=\"hint\">בורד המדריך הקיים, ללא שינוי. נטען בלחיצה.</p>\n    <iframe id=\"guide-frame\" data-src=\"https://nanoshellano.vercel.app/leads-dash-9f3k2a.html\" title=\"בורד המדריך\"></iframe>\n  </section>\n</div>\n\n<script>\n  var $ = function(id){ return document.getElementById(id); };\n  function esc(s){ return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];}); }\n\n  /* ---------- view toggle ---------- */\n  function show(view){\n    var app = view==='app';\n    $('view-app').classList.toggle('hide', !app);\n    $('view-guide').classList.toggle('hide', app);\n    $('tab-app').classList.toggle('on', app);\n    $('tab-guide').classList.toggle('on', !app);\n    if(!app) ensureGuide();\n  }\n  $('tab-app').addEventListener('click', function(){ show('app'); });\n  $('tab-guide').addEventListener('click', function(){ show('guide'); });\n\n  /* ---------- guide: lazy-load the existing board (untouched) ---------- */\n  function ensureGuide(force){\n    var f = $('guide-frame');\n    if(force || !f.src){ f.src = f.getAttribute('data-src') + (force?('?_='+Date.now()):''); }\n  }\n  $('guide-refresh').addEventListener('click', function(){ ensureGuide(true); });\n\n  /* ---------- app board ---------- */\n  function renderSources(el, list, total){\n    if(!list || !list.length){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n    var max = Math.max.apply(null, list.map(function(e){return e.count;}).concat([1]));\n    el.innerHTML = list.map(function(p){\n      var pc = total ? Math.round(p.count/total*100) : 0;\n      return '<div class=\"lrow\"><span class=\"nm\" title=\"'+esc(p.label)+'\">'+esc(p.label)+'</span>'\n        + '<span class=\"tr\"><i style=\"width:'+Math.round(p.count/max*100)+'%\"></i></span>'\n        + '<span class=\"ct\">'+p.count+'</span><span class=\"pc\">'+pc+'%</span></div>';\n    }).join('');\n  }\n  function renderEntries(el, entries){\n    if(!entries || !entries.length){ el.innerHTML='<div class=\"empty\">אין עדיין כניסות</div>'; return; }\n    var rows = entries.map(function(e){\n      var t = e.when ? new Date(e.when).toLocaleString('he-IL') : '';\n      return '<tr><td>'+esc(t)+'</td><td>'+esc(e.name)+'</td>'\n        + '<td class=\"ltr\">'+esc(e.phone)+'</td>'\n        + '<td class=\"ltr\">'+(e.email?'<a href=\"mailto:'+esc(e.email)+'\" style=\"color:var(--teal)\">'+esc(e.email)+'</a>':'')+'</td>'\n        + '<td><span class=\"tag\">'+esc(e.source)+'</span></td></tr>';\n    }).join('');\n    el.innerHTML = '<table><thead><tr><th>מתי</th><th>שם</th><th>טלפון</th><th>אימייל</th><th>מקור</th></tr></thead><tbody>'+rows+'</tbody></table>';\n  }\n  function paintApp(d){\n    if(!d || !d.ok){ $('app-error').innerHTML='<div class=\"err\">לא הצלחתי לטעון נתונים'+(d&&d.error?': '+esc(d.error):'')+'</div>'; $('app-refresh').disabled=false; return; }\n    $('app-error').innerHTML='';\n    var total = d.total||0;\n    var tagged = (d.bySource||[]).filter(function(s){return s.label!=='לא מסומן';}).reduce(function(a,s){return a+s.count;},0);\n    var realSources = (d.bySource||[]).filter(function(s){return s.label!=='לא מסומן';}).length;\n    $('k-total').textContent = total;\n    $('k-sources').textContent = realSources;\n    $('k-tagged').textContent = tagged;\n    renderSources($('p-source'), d.bySource, total);\n    renderEntries($('p-entries'), d.entries);\n    var t = d.generated_at ? new Date(d.generated_at) : new Date();\n    $('app-upd').textContent = 'עודכן ' + t.toLocaleString('he-IL');\n    $('app-refresh').disabled=false;\n  }\n  function loadApp(){\n    $('app-refresh').disabled=true;\n    $('app-upd').textContent='טוען…';\n    fetch('/api/app-entries?_='+Date.now(), {cache:'no-store'})\n      .then(function(r){ return r.json(); })\n      .then(paintApp)\n      .catch(function(e){ paintApp({ok:false,error:String(e&&e.message||e)}); });\n  }\n  $('app-refresh').addEventListener('click', loadApp);\n\n  /* first load: app view, fetch once (a load IS a manual open) */\n  loadApp();\n</script>\n</body>\n</html>\n","numLines":177,"startLine":1,"totalLines":177}},"displayPath":"board.html"},"type":"attachment","uuid":"8e492908-47be-4679-94c6-6cecacd3c6a6","timestamp":"2026-07-11T20:46:15.352Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent/nanohub_demo","sessionId":"b0b43f8a-4b7b-497b-a61a-9ff51bce7b01","version":"2.1.197","gitBranch":"HEAD","slug":"steady-foraging-treehouse"}
{"parentUuid":"8e492908-47be-4679-94c6-6cecacd3c6a6","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/api/app-entries.js","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/api/app-entries.js","content":"// App-entries feed for the monitoring board (the \"אפליקציה\" tab).\n// Server-side proxy to the host admin data (provision.shellano.com/admin/agents).\n// The admin key lives in ADMIN_AGENTS_URL (a full authenticated URL) and never\n// reaches the browser. Returns entries grouped by source + a flat entry list.\n//\n// Source labels are OPEN by design: any new campaign key (?src=linkedin, ?src=shellano-facebook, ...)\n// flows straight through and gets a humanized label automatically — no code change per link.\n\nconst KNOWN = {\n  shellano: \"שלנו · וואטסאפ\",\n  click2agent: \"קליק טו אייג'נט · וואטסאפ\",\n  c2a: \"קליק טו אייג'נט · וואטסאפ\",\n  linkedin: \"לינקדאין\",\n  facebook: \"פייסבוק\",\n  instagram: \"אינסטגרם\",\n};\n\nfunction labelFor(raw) {\n  const s = String(raw || \"\").trim();\n  if (!s || s === \"לא ידוע\" || s === \"null\") return \"לא מסומן\";\n  const low = s.toLowerCase();\n  if (KNOWN[low]) return KNOWN[low];\n  // campaign convention: product-channel  (e.g. shellano-linkedin)\n  const parts = low.split(/[-_]/).map((p) => KNOWN[p] || p);\n  return parts.join(\" · \");\n}\n\nmodule.exports = async (req, res) => {\n  res.setHeader(\"Cache-Control\", \"no-store\");\n  const url = process.env.ADMIN_AGENTS_URL;\n  if (!url) {\n    return res.status(200).json({ ok: false, error: \"feed not configured\" });\n  }\n  try {\n    const r = await fetch(url, { headers: { Accept: \"application/json\" } });\n    if (!r.ok) return res.status(200).json({ ok: false, error: \"upstream \" + r.status });\n    const data = await r.json();\n    const agents = Array.isArray(data.agents) ? data.agents : [];\n\n    // regroup by source ourselves so labels are consistent + extensible\n    const counts = {};\n    for (const a of agents) {\n      const key = labelFor(a.source);\n      counts[key] = (counts[key] || 0) + 1;\n    }\n    const bySource = Object.entries(counts)\n      .map(([label, count]) => ({ label, count }))\n      .sort((x, y) => y.count - x.count);\n\n    const entries = agents\n      .map((a) => ({\n        name: a.userName || a.friendlyName || \"\",\n        phone: a.phone || \"\",\n        email: a.email || \"\",\n        source: labelFor(a.source),\n        when: a.createdAt || null,\n        status: a.status || \"\",\n      }))\n      .sort((x, y) => String(y.when || \"\").localeCompare(String(x.when || \"\")));\n\n    return res.status(200).json({\n      ok: true,\n      total: agents.length,\n      bySource,\n      entries,\n      generated_at: new Date().toISOString(),\n    });\n  } catch (e) {\n    return res.status(200).json({ ok: false, error: String((e && e.message) || e) });\n  }\n};\n","numLines":72,"startLine":1,"totalLines":72}},"displayPath":"api/app-entries.js"},"type":"attachment","uuid":"16d6fed4-f69b-41ab-a343-62b25447535b","timestamp":"2026-07-11T20:46:15.117Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent/nanohub_demo","sessionId":"b0b43f8a-4b7b-497b-a61a-9ff51bce7b01","version":"2.1.197","gitBranch":"HEAD","slug":"steady-foraging-treehouse"}
