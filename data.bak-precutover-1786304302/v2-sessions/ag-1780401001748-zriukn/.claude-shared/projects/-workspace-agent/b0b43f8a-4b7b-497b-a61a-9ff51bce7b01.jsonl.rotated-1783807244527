  executive:'הנהלה', finance:'כספים', hr:'משאבי אנוש', operations:'תפעול',\n    'job-seekers':'מחפשי עבודה', it:'IT', 'customer-support':'תמיכת לקוחות',\n    'customer-success':'הצלחת לקוח', recruiters:'גיוס', 'project-management':'ניהול פרויקטים',\n    'learning-development':'למידה ופיתוח'\n  };\n\n  function renderSources(el, bySource, total){\n    var entries = Object.entries(bySource || {});\n    if(!entries.length){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n    var merged = {};\n    entries.forEach(function(e){\n      var info = srcInfo(e[0]);\n      if(!merged[info.label]) merged[info.label] = {v:0, rank:info.rank};\n      merged[info.label].v += e[1];\n    });\n    var list = Object.entries(merged).sort(function(a,b){ return a[1].rank - b[1].rank || b[1].v - a[1].v; });\n    var max = Math.max.apply(null, list.map(function(e){return e[1].v;}).concat([1]));\n    el.innerHTML = list.map(function(p){\n      var pc = total ? Math.round(p[1].v/total*100) : 0;\n      return '<div class=\"lrow\"><span class=\"nm\" title=\"'+esc(p[0])+'\">'+esc(p[0])+'</span>'\n        + '<span class=\"tr\"><i style=\"width:'+Math.round(p[1].v/max*100)+'%\"></i></span>'\n        + '<span class=\"ct\">'+p[1].v+'</span><span class=\"pc\">'+pc+'%</span></div>';\n    }).join('');\n  }\n\n  function renderRoles(el, byRole){\n    // only real role pages; drop home/guide/qa\n    var entries = Object.entries(byRole || {}).filter(function(e){\n      return ['index','guide','qa'].indexOf(e[0])===-1;\n    }).sort(function(a,b){ return b[1]-a[1]; });\n    if(!entries.length){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n    var max = Math.max.apply(null, entries.map(function(e){return e[1];}).concat([1]));\n    el.innerHTML = entries.map(function(p){\n      var label = ROLE_LABELS[p[0]] || p[0];\n      return '<div class=\"lrow\"><span class=\"nm\" title=\"'+esc(label)+'\">'+esc(label)+'</span>'\n        + '<span class=\"tr\"><i style=\"width:'+Math.round(p[1]/max*100)+'%\"></i></span>'\n        + '<span class=\"ct\">'+p[1]+'</span></div>';\n    }).join('');\n  }\n\n  /* ---------- funnel: count + avg dwell per stage ---------- */\n  function renderFunnel(el, data){\n    var f = data.funnel || {};\n    var total = (data.uniques && data.uniques.total) || 0;\n    var direct = Math.max(0, total - (f.home||0));\n    var rows = [\n      {ttl:'נכנסו לאתר', v:total, pct100:true},\n      {ttl:'צפו בעמוד הפתיחה', v:f.home||0, dwell:(f.dwell&&f.dwell.home)||0,\n        hint: direct>0 ? direct+' נכנסו ישר לעמוד תפקיד/מדריך דרך לינק' : ''},\n      {ttl:'לחצו \"בואו נתחיל\" · עמוד התפקיד', v:f.role_page||0, dwell:(f.dwell&&f.dwell.role)||0, drop:true},\n      {ttl:'נכנסו למדריך עצמו', v:f.guide||0, dwell:(f.dwell&&f.dwell.guide)||0, drop:true},\n      {ttl:'הגיעו לשלב ההתקנה', v:f.install_step5||0, drop:true},\n      {ttl:'סיימו את המדריך', v:f.finished||0, drop:true, last:true}\n    ];\n    var max = Math.max.apply(null, rows.map(function(r){return r.v;}).concat([1]));\n    var prev = null;\n    el.innerHTML = rows.map(function(r){\n      var meta = [];\n      if(r.pct100) meta.push('<span class=\"pill\">100%</span>');\n      if(r.dwell && r.dwell>0) meta.push('<span class=\"pill\">⏱ '+clock(r.dwell)+'</span>');\n      if(r.drop && prev!=null && prev>0 && r.v<prev){\n        meta.push('<span class=\"drop\">↓ '+Math.round((1-r.v/prev)*100)+'% נשירה</span>');\n      }\n      if(r.hint) meta.push('<span class=\"fhint\">'+esc(r.hint)+'</span>');\n      if(r.last) meta.push('<span class=\"fhint\">סיום = מי שבאמת הקים סוכן</span>');\n      prev = r.v;\n      return '<div class=\"frow\"><div class=\"ftop\"><span class=\"fttl\">'+esc(r.ttl)+'</span><span class=\"fnum\">'+r.v+'</span></div>'\n        + '<div class=\"fbar\"><i style=\"width:'+Math.round(r.v/max*100)+'%\"></i></div>'\n        + (meta.length?'<div class=\"fmeta\">'+meta.join('')+'</div>':'') + '</div>';\n    }).join('');\n  }\n\n  /* ---------- tool