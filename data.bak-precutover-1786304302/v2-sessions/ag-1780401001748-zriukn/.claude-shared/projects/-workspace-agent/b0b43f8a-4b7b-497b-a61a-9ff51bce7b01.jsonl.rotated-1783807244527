message || e)); });\n  }\n\n  /* ---------- leads at the bottom, no password ---------- */\n  function leadPosition(source){\n    var s = String(source||'').toLowerCase();\n    if(s.indexOf('picker-updates')===0 || (s.indexOf('updates')!==-1 && s.indexOf('guide')===-1)) return {label:'התחלה', cls:'t-start'};\n    if(s.indexOf('finish')!==-1 || s.indexOf('guide')===0 || s==='guide-he' || s==='guide-en') return {label:'סוף', cls:'t-end'};\n    return {label:'אמצע', cls:'t-mid'};\n  }\n  function isTest(l){\n    var s = String(l.source||'').toLowerCase(), em = String(l.email||'').toLowerCase(), nm = String(l.name||'').toLowerCase();\n    return s.indexOf('qa')!==-1 || s.indexOf('test')!==-1 || em.indexOf('test')!==-1 || em.indexOf('qa+')!==-1 || nm.indexOf('test')!==-1 || nm.indexOf('בדיקה')!==-1;\n  }\n  function leadRows(leads, withPos){\n    return leads.map(function(l){\n      var t = new Date(l.when).toLocaleString('he-IL');\n      var pos = withPos ? leadPosition(l.source) : null;\n      return '<tr><td>'+esc(t)+'</td><td>'+esc(l.name)+'</td>'\n        + '<td class=\"ltr\">'+(l.email?'<a href=\"mailto:'+esc(l.email)+'\" style=\"color:var(--teal)\">'+esc(l.email)+'</a>':'')+'</td>'\n        + (withPos?'<td><span class=\"tag '+pos.cls+'\">'+esc(pos.label)+'</span></td>':'<td>'+esc(l.source)+'</td>')+'</tr>';\n    }).join('');\n  }\n  function renderLeads(d){\n    if(!d || !d.ok){ $('leads-body').innerHTML = '<div class=\"empty\">לא ניתן לטעון לידים כרגע</div>'; return; }\n    var all = d.leads || [], real=[], test=[];\n    all.forEach(function(l){ (isTest(l)?test:real).push(l); });\n    $('leads-count').textContent = '· ' + real.length;\n    if(!real.length){ $('leads-body').innerHTML = '<div class=\"empty\">אין עדיין לידים אמיתיים</div>'; }\n    else { $('leads-body').innerHTML = '<table><thead><tr><th>מתי</th><th>שם</th><th>אימייל</th><th>מאיפה בטופס</th></tr></thead><tbody>'+leadRows(real,true)+'</tbody></table>'; }\n    if(test.length){\n      $('test-wrap').st