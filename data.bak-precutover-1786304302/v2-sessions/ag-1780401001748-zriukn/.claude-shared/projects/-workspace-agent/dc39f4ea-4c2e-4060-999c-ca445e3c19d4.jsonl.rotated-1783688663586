{"parentUuid":"681e8a6c-aba7-43c7-92a2-ba37e717ecda","isSidechain":false,"attachment":{"type":"file","filename":"/tmp/mockup_pilot_v1.html","content":{"type":"text","file":{"filePath":"/tmp/mockup_pilot_v1.html","content":"<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@400;500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n:root{\n  --bg:#000000;--surface:#101010;--surface2:#181818;\n  --text:#FFFFFF;--muted:#B0B0B0;--teal:#56EDD6;--border:#3A3A3A;--orange:#E85D3A;\n}\n*{margin:0;padding:0;box-sizing:border-box}\nhtml,body{height:100%}\nbody{background:#1a1a1a;font-family:'Heebo',sans-serif;display:flex;align-items:center;justify-content:center;min-height:100dvh;padding:8px 0}\n.phone{position:relative;width:min(410px,100vw);height:min(820px,calc(100dvh - 32px));background:var(--bg);border:1px solid #262626;border-radius:24px;overflow:hidden;display:flex;flex-direction:column}\n\n/* header */\n.app-header{flex:0 0 auto;display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px 10px}\n.back-btn{width:34px;height:34px;border-radius:50%;border:1px solid var(--border);background:var(--surface);color:var(--muted);display:flex;align-items:center;justify-content:center}\n.lang-toggle{display:flex;border:1px solid var(--border);border-radius:9px;overflow:hidden}\n.lang-toggle button{border:none;background:transparent;color:var(--muted);font-family:inherit;font-size:12px;padding:6px 11px}\n.lang-toggle button.on{background:var(--surface2);color:var(--teal);font-weight:600}\n.logo-area{color:var(--teal);font-size:15px;font-weight:700;letter-spacing:.3px}\n\n/* slide */\n.stage{flex:1 1 auto;min-height:0;overflow-y:auto;scrollbar-width:none;padding:6px 20px 0}\n.stage::-webkit-scrollbar{display:none}\n\nh1{font-size:26px;line-height:1.28;font-weight:700;color:var(--text);margin-bottom:6px}\n.sub{color:var(--muted);font-size:14px;line-height:1.6;margin-bottom:20px}\n\n/* numbered cards — visually distinct from icon cards */\n.n-cards{display:flex;flex-direction:column;gap:11px}\n.n-card{background:var(--surface);border-radius:14px;padding:14px 16px 14px 14px;display:flex;gap:13px;align-items:flex-start;border:1px solid var(--border)}\n.n-badge{flex:0 0 auto;width:28px;height:28px;border-radius:8px;background:#0F756D;display:flex;align-items:center;justify-content:center;font-size:13px;font-weight:700;color:var(--teal);margin-top:1px}\n.n-body{}\n.n-title{font-size:14px;font-weight:700;color:var(--text);margin-bottom:4px}\n.n-desc{font-size:13px;color:var(--muted);line-height:1.55}\n.n-desc a{color:var(--teal);text-decoration:none}\n\n.foot-note{color:#555;font-size:12.5px;text-align:center;margin-top:14px;margin-bottom:6px}\n\n/* bottom */\n.cta-zone{flex:0 0 auto;padding:10px 20px 20px;display:flex;flex-direction:column;gap:11px}\n.dots{display:flex;justify-content:center;gap:7px}\n.dots span{width:7px;height:7px;border-radius:50%;background:#333;display:inline-block}\n.dots span.on{background:var(--teal);width:19px;border-radius:4px}\n.cta{width:100%;border:none;border-radius:12px;background:var(--teal);color:#04211C;font-family:inherit;font-size:15.5px;font-weight:700;padding:14px;cursor:pointer}\n</style>\n</head>\n<body>\n<div class=\"phone\">\n\n  <div class=\"app-header\">\n    <div class=\"back-btn\">\n      <svg width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\"><path d=\"M9 18l6-6-6-6\"/></svg>\n    </div>\n    <div class=\"logo-area\">Shellano</div>\n    <div class=\"lang-toggle\"><button>EN</button><button class=\"on\">עב</button></div>\n  </div>\n\n  <div class=\"stage\">\n    <h1>פיילוט — וזה בכוונה</h1>\n    <p class=\"sub\">התנסות אמיתית, לזמן מוגבל. לא כדי להרשים — כדי ללמוד.</p>\n\n    <div class=\"n-cards\">\n\n      <div class=\"n-card\">\n        <div class=\"n-badge\">1</div>\n        <div class=\"n-body\">\n          <div class=\"n-title\">למה בכלל פיילוט?</div>\n          <div class=\"n-desc\">עולם העבודה משתנה. מי שיודע לנהל סוכן AI יהיה שלב אחד קדימה. הפיילוט הוא המקום להתאמן — על חשבוני, בלי לחץ.</div>\n        </div>\n      </div>\n\n      <div class=\"n-card\">\n        <div class=\"n-badge\">2</div>\n        <div class=\"n-body\">\n          <div class=\"n-title\">מה ג'וני עושה</div>\n          <div class=\"n-desc\">ג'וני מנהל איתך שיחה אמיתית בטלגרם. חושב איתך, מנסה להבין את התפקיד שלך, ולומד ממך. מה שראית בדמו — זה הכיוון.</div>\n        </div>\n      </div>\n\n      <div class=\"n-card\">\n        <div class=\"n-badge\">3</div>\n        <div class=\"n-body\">\n          <div class=\"n-title\">10 ימים, בחינם — ואחרי?</div>\n          <div class=\"n-desc\">הפיילוט פתוח לעשרה ימים, על חשבוני. לא ניקח ממך כסף — בשום שלב. אחרי שסיימת, אם רצית להמשיך, הכנתי <a href=\"#\">מדריך להקמת NanoClaw משלך</a>.</div>\n        </div>\n      </div>\n\n    </div>\n\n    <p class=\"foot-note\">אנחנו כאן בשביל להכין אותך.</p>\n  </div>\n\n  <div class=\"cta-zone\">\n    <div class=\"dots\">\n      <span></span><span></span><span></span><span class=\"on\"></span><span></span>\n    </div>\n    <button class=\"cta\">יאללה, נרשמים</button>\n  </div>\n\n</div>\n</body>\n</html>\n","numLines":108,"startLine":1,"totalLines":108}},"displayPath":"../../tmp/mockup_pilot_v1.html"},"type":"attachment","uuid":"5915c5dd-9f35-485e-bda2-9070e3b13881","timestamp":"2026-07-09T11:11:00.724Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"dc39f4ea-4c2e-4060-999c-ca445e3c19d4","version":"2.1.197","gitBranch":"HEAD","slug":"pure-plotting-melody"}
