n: row;\n        align-items: stretch;\n      }\n\n      .persona-card {\n        flex: 1;\n      }\n    }\n  </style>\n</head>\n\n<body>\n  <main class=\"page\">\n\n    <header>\n      <div class=\"logo\">NanoShellano</div>\n      <div class=\"tagline\">הסוכן האישי שלך</div>\n    </header>\n\n    <div class=\"content-wrap\">\n\n      <section class=\"hero\">\n        <h1>יש לך אדם שמנהל את יומך.</h1>\n        <p class=\"subheadline\">לא צ'אט. לא בוט. סוכן שמדבר, מחליט ופועל בשבילך. מסביב לשעון.</p>\n\n        <form class=\"form\">\n          <input type=\"email\" placeholder=\"המייל שלך\" required>\n          <button type=\"submit\">אני רוצה סוכן כזה</button>\n        </form>\n\n        <div class=\"note\">בלי דמי כניסה. בלי כרטיס אשראי. רק אנחנו נודיע לך.</div>\n      </section>\n\n      <section class=\"card-section\">\n        <h2>מה זה בכלל?</h2>\n        <p class=\"body-text\">\n          תחשוב על מישהו שמכיר אותך, יודע מה חשוב לך, ויודע לדאוג לדברים בלי שתבקש.\n          זה NanoShellano. לא עוד אפליקציה שצריך לפתוח, משהו שעובד בשבילך ברקע, כל היום.\n          אתה מדבר אליו בוואטסאפ או בטלגרם. הוא עושה.\n        </p>\n      </section>\n\n      <section class=\"card-section\">\n        <h2>איך נראה יום עם הסוכן?</h2>\n\n        <div class=\"timeline\">\n          <div class=\"timeline-item\"><span class=\"time\">08:45</span> שלח לך סיכום כל הפגישות מאתמול לפני שקמת</div>\n          <div class=\"timeline-item\"><span class=\"time\">10:30</span> הזכיר שיש הצעת מחיר שלא ענו עליה כבר 3 ימים</div>\n          <div class=\"timeline-item\"><span class=\"time\">12:00</span> הכין טיוטת מייל לפגישה של מחר. אישרת בלחיצה</div>\n          <div class=\"timeline-item\"><span class=\"time\">16:30</span> עדכן מי מהצוות עדיין ממתין לתשובה ממך</div>\n          <div class=\"timeline-item\"><span class=\"time\">19:00</span> סגר את היום עם רשימה מסודרת למחר</div>\n        </div>\n      </section>\n\n    </div>\n\n    <section>\n      <div class=\"content-wrap\">\n        <h2>למי זה מתאים?</h2>\n      </div>\n\n      <div class=\"cards\">\n        <div class=\"persona-card\">\n          <div class=\"icon\">💼</div>\n          <h3>בעלי עסקים</h3>\n          <p>הסוכן מנהל לידים, שולח מיילים בשמך, מתאם פגישות ומזכיר מה צריך לעקוב. אתה סוגר עסקאות, הוא מטפל בכל השאר.</p>\n        </div>\n\n        <div class=\"persona-card\">\n          <div class=\"icon\">📊</div>\n          <h3>מנהלים</h3>\n          <p>מסכם דוחות לפני הפגישה, שולח עדכונים לצוות, מזכיר מה נשאר פתוח. פחות מה נשכח, יותר מה נעשה.</p>\n        </div>\n\n        <div class=\"persona-card\">\n          <div class=\"icon\">🧑‍💻</div>\n          <h3>עצמאים ופרילנסרים</h3>\n          <p>עובד כשאתה ישן. בבוקר יש לך הצעות מחיר מוכנות, מיילים ממוינים, ורשימת עדיפויות מסודרת.</p>\n        </div>\n      </div>\n    </section>\n\n    <div class=\"content-wrap\">\n\n      <section class=\"bottom-cta\">\n        <h2>מוכן שיהיה לך אחד?</h2>\n        <p>אנחנו בבנייה. תשאיר מייל ואנחנו נודיע לך ראשון.</p>\n\n        <form class=\"form\">\n          <input type=\"email\" placeholder=\"המייל שלך\" required>\n          <button type=\"submit\">אני רוצה להיות ראשון</button>\n        </form>\n      </section>\n\n      <footer>\n        <div>NanoShellano / הסוכן האישי שלך</div>\n        <div>עדיין בבנייה | הצטרף לרשימת ההמתנה</div>\n      </footer>\n\n    </div>\n\n  </main>\n</body>\n</html>\n","numLines":390,"startLine":1,"totalLines":390}},"displayPath":"nanoshellano/nanoshellano-site/public/landing.html"},"type":"attachment","uuid":"78479799-817e-47b7-ae76-c6f5aef152dd","timestamp":"2026-07-09T14:01:47.839Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"dc39f4ea-4c2e-4060-999c-ca445e3c19d4","version":"2.1.197","gitBranch":"HEAD","slug":"pure-plotting-melody"}
