"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" viewBox=\"0 0 24 24\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      </button>\n    </div>\n    <div class=\"header-side\">\n      <!-- logo placeholder -->\n      <svg width=\"90\" height=\"22\" viewBox=\"0 0 90 22\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n        <text x=\"0\" y=\"17\" font-family=\"Heebo,Arial\" font-weight=\"700\" font-size=\"16\" fill=\"#56EDD6\">Shellano</text>\n      </svg>\n    </div>\n    <div class=\"header-side\">\n      <div class=\"lang-toggle\"><button>EN</button><button class=\"on\">עב</button></div>\n    </div>\n  </div>\n\n  <div class=\"stage\">\n    <div class=\"slide\">\n      <h1>מקימים לך <span class=\"accent\">סוכן</span></h1>\n      <p class=\"lead\">שם, מייל וטלפון. הסוכן יפתח אצלך בטלגרם תוך דקה.</p>\n\n      <!-- telegram checkbox -->\n      <div class=\"tg-check-wrap\">\n        <label class=\"consent\">\n          <input type=\"checkbox\" id=\"hasTg\" onchange=\"toggleDl(this)\">\n          <span>יש לי טלגרם מותקן</span>\n        </label>\n        <div id=\"dlRow\" style=\"margin-top:10px;margin-right:25px\">\n          <a href=\"#\" class=\"consent\" style=\"color:var(--teal);font-size:13px;text-decoration:none\">הורדת Telegram ←</a>\n        </div>\n      </div>\n\n      <form novalidate>\n        <div class=\"name-row\">\n          <div class=\"field\">\n            <label>שם פרטי</label>\n            <input type=\"text\" placeholder=\"השם שלך\">\n          </div>\n          <div class=\"field\">\n            <label>שם משפחה</label>\n            <input type=\"text\" placeholder=\"שם משפחה\">\n          </div>\n        </div>\n        <div class=\"field\">\n          <label>אימייל</label>\n          <input type=\"email\" placeholder=\"name@company.com\">\n        </div>\n        <div class=\"field\">\n          <label>טלפון</label>\n          <input type=\"tel\" placeholder=\"050-0000000\">\n        </div>\n        <label class=\"consent\">\n          <input type=\"checkbox\">\n          <span>קראתי ואישרתי את <a href=\"#\">מדיניות הפרטיות ותנאי השימוש</a></span>\n        </label>\n      </form>\n    </div>\n  </div>\n\n  <div class=\"cta-zone\">\n    <div class=\"dots\">\n      <button></button><button></button><button></button><button></button><button class=\"on\"></button><button></button>\n    </div>\n    <button class=\"cta\">פתחו לי סוכן</button>\n    <div class=\"cta-foot\">הפרטים נשמרים אצלך בלבד. בלי ספאם.</div>\n  </div>\n\n</div>\n<script>\nfunction toggleDl(cb){document.getElementById('dlRow').style.display=cb.checked?'none':'block'}\n</script>\n</body>\n</html>\n","numLines":136,"startLine":1,"totalLines":136}},"displayPath":"../../tmp/mockup_form_v4.html"},"type":"attachment","uuid":"9be465b1-2429-4a63-81bb-ef24db8b826e","timestamp":"2026-07-09T09:20:32.788Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"dc39f4ea-4c2e-4060-999c-ca445e3c19d4","version":"2.1.197","gitBranch":"HEAD","slug":"pure-plotting-melody"}
