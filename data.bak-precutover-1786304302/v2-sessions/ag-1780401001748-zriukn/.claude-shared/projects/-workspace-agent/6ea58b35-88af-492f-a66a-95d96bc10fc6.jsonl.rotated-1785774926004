ad>\n55\t<body>\n56\t<div class=\"wrap\">\n57\t  <header>\n58\t    <div class=\"brand\"><span class=\"dot\"></span> בורד מוניטורינג</div>\n59\t    <div class=\"tabs\">\n60\t      <button class=\"tab on\" id=\"tab-app\" data-view=\"app\">אפליקציה</button>\n61\t      <button class=\"tab\" id=\"tab-guide\" data-view=\"guide\">מדריך</button>\n62\t    </div>\n63\t  </header>\n64\t\n65\t  <!-- ===== APP VIEW ===== -->\n66\t  <section id=\"view-app\">\n67\t    <div class=\"bar\">\n68\t      <div class=\"upd\" id=\"app-upd\">—</div>\n69\t      <button class=\"btn\" id=\"app-refresh\">רענן</button>\n70\t    </div>\n71\t    <p class=\"hint\">מוניטורינג על כל מי שנכנס לקישור — לא רק מי שהשאיר פרטים. מתעדכן רק בלחיצה על \"רענן\".</p>\n72\t    <div id=\"app-error\"></div>\n73\t\n74\t    <div class=\"kpis\" style=\"grid-template-columns:repeat(4,1fr)\">\n75\t      <div class=\"kpi\"><div class=\"n\" id=\"k-visits\">0</div><div class=\"l\">סה\"כ ביקורים (Total Visits)</div></div>\n76\t      <div class=\"kpi\"><div class=\"n\" id=\"k-unique\">0</div><div class=\"l\">מבקרים ייחודיים (Unique Visitors)</div></div>\n77\t      <div class=\"kpi\"><div class=\"n\" id=\"k-24h\">0</div><div class=\"l\">מבקרים ייחודיים · 24 שעות</div></div>\n78\t      <div class=\"kpi\"><div class=\"n\" id=\"k-7d\">0</div><div class=\"l\">מבקרים ייחודיים · 7 ימים</div></div>\n79\t    </div>\n80\t\n81\t    <div class=\"kpis\">\n82\t      <div class=\"kpi\"><div class=\"n\" id=\"k-entered\">0</div><div class=\"l\">נכנסו לממשק (= מבקרים ייחודיים)</div></div>\n83\t      <div class=\"kpi\"><div class=\"n\" id=\"k-form\">0</div><div class=\"l\">הגיעו לטופס</div></div>\n84\t      <div class=\"kpi\"><div class=\"n\" id=\"k-left\">0</div><div class=\"l\">השאירו פרטים</div></div>\n85\t    </div>\n86\t\n87\t    <div class=\"panel\">\n88\t      <h3>מסע בממשק</h3>\n89\t      <div id=\"p-funnel\"><div class=\"mini-empty\">לחצי \"רענן\" לטעינה</div></div>\n90\t    </div>\n91\t\n92\t    <div class=\"panel\">\n93\t      <h3>עומק צפייה במסכים</h3>\n94\t      <p class=\"hint\" style=\"margin-top:-2px\">כמה מבקרים הגיעו לפחות עד כל מסך</p>\n95\t      <div id=\"p-depth\"><div class=\"mini-empty\">—</div></div>\n96\t    </div>\n97\t\n98\t    <div class=\"panel\">\n99\t      <h3>לפי מקור</h3>\n100\t      <div id=\"p-source\"><div class=\"mini-empty\">—</div></div>\n101\t    </div>\n102\t\n103\t    <div class=\"panel\">\n104\t      <h3>מי שהשאיר פרטים</h3>\n105\t      <div id=\"p-entries\"><div class=\"empty\">—</div></div>\n106\t    </div>\n107\t  </section>\n108\t\n109\t  <!-- ===== GUIDE VIEW (legacy source disconnected) ===== -->\n110\t  <section id=\"view-guide\" class=\"hide\">\n111\t    <div class=\"panel\">\n112\t      <h3>בורד המדריך — מנותק מהבורד הזה</h3>\n113\t      <p class=\"hint\" style=\"margin:0 0 10px\">\n114\t        הבורד הישן של המדריך נשען על מאגר Vercel Blob הישן (מקור הנתונים שהוחלף) ומודד נכס אחר —\n115\t        עמודי המדריך, לא האפליקציה. המספרים שלו אינם ברי-השוואה למספרים כאן, ולכן הוא לא נטען\n116\t        יותר אוטומטית לתוך הבורד הזה. מקור האמת לאפליקציה: SQLite על ה-VM דרך /api/app-summary.\n117\t      </p>\n118\t      <button class=\"btn\" onclick=\"window.open('https://nanoshellano.vercel.app/leads-dash-9f3k2a.html','_blank')\">פתח את בורד המדריך הישן (ארכיון) ↗</button>\n119\t    </div>\n120\t  </section>\n121\t</div>\n122\t\n123\t<script>\n124\t  var $ = function(id){ return document.getElementById(id); };\n125\t  function esc(s){ return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];}); }\n126\t\n127\t  /* ---------- view toggle ---------- */\n128\t  function show(view){\n129\t    var app = view==='app';\n130\t    $('view-app').classList.toggle('hide', !app);\n131\t    $('view-guide').classList.toggle('hide', app);\n132\t    $('tab-app').classList.toggle('on', app);\n133\t    $('tab-guide').classList.toggle('on', !app);\n134\t  }\n135\t  $('tab-app').addEventListener('click', function(){ show('app'); });\n136\t  $('tab-guide').addEventListener('click', function(){ show('guide'); });\n137\t\n138\t  /* ---------- app board: journey funnel ---------- */\n139\t  var SCREENS = ['פתיחה','הדגמה','יכולות','פיילוט','טופס'];\n140\t  function bars(el, rows, total, unit){\n141\t    if(!rows || !rows.length){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n142\t    var max = Math.max.apply(null, rows.map(function(e){return e.count;}).concat([1]));\n143\t    el.innerHTML = rows.map(function(p){\n144\t      var pc = total ? Math.round(p.count/total*100) : 0;\n145\t      return '<div class=\"lrow\"><span class=\"nm\" title=\"'+esc(p.label)+'\">'+esc(p.label)+'</span>'\n146\t        + '<span class=\"tr\"><i style=\"width:'+Math.round(p.count/max*100)+'%\"></i></span>'\n147\t        + '<span class=\"ct\">'+p.count+'</span><span class=\"pc\">'+(unit===false?'':pc+'%')+'</span></div>';\n148\t    }).join('');\n149\t  }\n150\t  function renderFunnel(el, f){\n151\t    if(!f){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n152\t    var e = f.entered||0;\n153\t    var rows = [\n154\t      {label:'נכנסו לממשק', count:e},\n155\t      {label:'התקדמו מעבר לפתיחה', count:f.clicked||0},\n156\t      {label:'הגיעו לטופס', count:f.reachedForm||0},\n157\t      {label:'השאירו פרטים', count:f.submitted||0},\n158\t    ];\n159\t    bars(el, rows, e);\n160\t    var extra = '<div class=\"lrow\" style=\"margin-top:10px\"><span class=\"nm\" style=\"color:var(--orange)\">נשרו בלי להשאיר פרטים</span>'\n161\t      + '<span class=\"tr\"><i style=\"width:'+(e?Math.round((f.droppedNoForm||0)/e*100):0)+'%;background:var(--orange)\"></i></span>'\n162\t      + '<span class=\"ct\">'+(f.droppedNoForm||0)+'</span><span class=\"pc\">'+(e?Math.round((f.droppedNoForm||0)/e*100):0)+'%</span></div>'\n163\t      + '<div class=\"lrow\"><span class=\"nm\" style=\"color:var(--orange)\">ראו טופס ולא מילאו</span>'\n164\t      + '<span class=\"tr\"><i style=\"width:'+(e?Math.round((f.abandonedForm||0)/e*100):0)+'%;background:var(--orange)\"></i></span>'\n165\t      + '<span class=\"ct\">'+(f.abandonedForm||0)+'</span><span class=\"pc\">'+(e?Math.round((f.abandonedForm||0)/e*100):0)+'%</span></div>';\n166\t    el.innerHTML += extra;\n167\t  }\n168\t  function renderDepth(el, depth, entered){\n169\t    if(!depth || !depth.length){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n170\t    var rows = depth.map(function(c,i){ return {label:(i+1)+'. '+(SCREENS[i]||('מסך '+i)), count:c}; });\n171\t    bars(el, rows, entered||depth[0]||0);\n172\t  }\n173\t  function renderSources(el, list){\n174\t    if(!list || !list.length){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n175\t    el.innerHTML = list.map(function(s){\n176\t      return '<div class=\"lrow\"><span class=\"nm\" title=\"'+esc(s.label)+'\">'+esc(s.label)+'</span>'\n177\t        + '<span class=\"ct\" style=\"min-width:auto\">'+s.entered+' נכנסו</span>'\n178\t        + '<span class=\"pc\" style=\"min-width:auto\">· '+s.reachedForm+' לטופס · '+s.submitted+' השאירו</span></div>';\n179\t    }).join('');\n180\t  }\n181\t  function renderEntries(el, entries){\n182\t    if(!entries || !entries.length){ el.innerHTML='<div class=\"empty\">אין עדיין מי שהשאיר פרטים</div>'; return; }\n183\t    var rows = entries.map(function(e){\n184\t      var t = e.when ? new Date(e.when).toLocaleString('he-IL') : '';\n185\t      return '<tr><td>'+esc(t)+'</td><td>'+esc(e.name)+'</td>'\n186\t        + '<td class=\"ltr\">'+esc(e.phone)+'</td>'\n187\t        + '<td class=\"ltr\">'+(e.email?'<a href=\"mailto:'+esc(e.email)+'\" style=\"color:var(--teal)\">'+esc(e.email)+'</a>':'')+'</td>'\n188\t        + '<td><span class=\"tag\">'+esc(e.source)+'</span></td></tr>';\n189\t    }).join('');\n190\t    el.innerHTML = '<table><thead><tr><th>מתי</th><th>שם</th><th>טלפון</th><th>אימייל</th><th>מקור</th></tr></thead><tbody>'+rows+'</tbody></table>';\n191\t  }\n192\t  function paintApp(sum, ent){\n193\t    var okS = sum && sum.ok, okE = ent && ent.ok;\n194\t    if(!okS && !okE){ $('app-error').innerHTML='<div class=\"err\">לא הצלחתי לטעון נתונים'+(sum&&sum.error?': '+esc(sum.error):'')+'</div>'; $('app-refresh').disabled=false; return; }\n195\t    $('app-error').innerHTML='';\n196\t    var f = okS ? sum.funnel : null;\n197\t    var tot = (okS && sum.totals) ? sum.totals : null;\n198\t    $('k-visits').textContent  = tot ? (tot.total_visits||0) : 0;\n199\t    $('k-unique').textContent  = tot ? (tot.unique_visitors||0) : 0;\n200\t    $('k-24h').textContent     = tot && tot.last_24h ? (tot.last_24h.unique_visitors||0) : 0;\n201\t    $('k-7d').textContent      = tot && tot.last_7d ? (tot.last_7d.unique_visitors||0) : 0;\n202\t    $('k-entered').textContent = f ? (f.entered||0) : 0;\n203\t    $('k-form').textContent    = f ? (f.reachedForm||0) : 0;\n204\t    $('k-left').textContent    = f ? (f.submitted||0) : (okE ? (ent.total||0) : 0);\n205\t    renderFunnel($('p-funnel'), f);\n206\t    renderDepth($('p-depth'), okS ? sum.depth : null, f ? f.entered : 0);\n207\t    renderSources($('p-source'), okS ? sum.bySource : null);\n208\t    renderEntries($('p-entries'), okE ? ent.entries : null);\n209\t    // Server-stamped freshness: generated_at is minted on the VM at fold time —\n210\t    // shown as UTC so \"is this stale?\" is answerable without local-tz guessing.\n211\t    if (okS && sum.generated_at) {\n212\t      var g = new Date(sum.generated_at);\n213\t      $('app-upd').textContent = 'Last updated (UTC): ' + g.toISOString().replace('T',' ').slice(0,19)\n214\t        + ' · מקומי: ' + g.toLocaleString('he-IL');\n215\t    } else {\n216\t      $('app-upd').textContent = 'אין חותמת שרת';\n217\t    }\n218\t    $('app-refresh').disabled=false;\n219\t  }\n220\t  function loadApp(){\n221\t    $('app-refresh').disabled=true;\n222\t    $('app-upd').textContent='טוען…';\n223\t    var ts = Date.now();\n224\t    Promise.all([\n225\t