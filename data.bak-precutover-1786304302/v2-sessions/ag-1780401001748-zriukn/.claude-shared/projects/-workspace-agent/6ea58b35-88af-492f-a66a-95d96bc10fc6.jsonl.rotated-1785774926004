{"parentUuid":"d5578bfa-d5bb-46f6-baca-0676a2095d61","isSidechain":false,"promptId":"cc2e2a63-704a-4499-987e-5620de9690c6","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DoTWsJncAcAQCFXQQVuArh","type":"tool_result","content":"########## register.js ##########\n// Pilot registration endpoint.\n// Validates the new user, then tries to provision a real agent + Telegram deep link\n// via the host provisioner (HOST_PROVISION_URL). If the host piece is not wired yet,\n// it returns status:\"pending\" with the shared-bot fallback link, so the flow never breaks\n// and no registration is lost.\n\nconst BOT = process.env.PILOT_BOT || \"joni_agent_bot\";\n\nfunction bad(res, msg) {\n  res.status(400).json({ ok: false, error: msg });\n}\n\nmodule.exports = async (req, res) => {\n  res.setHeader(\"Access-Control-Allow-Origin\", \"*\");\n  res.setHeader(\"Access-Control-Allow-Methods\", \"POST, OPTIONS\");\n  res.setHeader(\"Access-Control-Allow-Headers\", \"Content-Type\");\n  if (req.method === \"OPTIONS\") return res.status(200).end();\n  if (req.method !== \"POST\") return bad(res, \"method\");\n\n  let body = req.body;\n  if (typeof body === \"string\") {\n    try { body = JSON.parse(body); } catch { return bad(res, \"json\"); }\n  }\n  body = body || {};\n\n  const name = String(body.name || \"\").trim();\n  const phone = String(body.phone || \"\").trim();\n  const email = String(body.email || \"\").trim();\n  let gender = String(body.gender || \"\").trim();\n  const lang = String(body.lang || \"he\").trim();\n  const src = String(body.src || \"\").trim().slice(0, 64);\n\n  if (name.length < 2) return bad(res, \"name\");\n  // Phone and email are optional (name-only onboarding). If provided, they must be valid.\n  if (phone && !/^[\\d+][\\d\\-\\s()]{6,}$/.test(phone)) return bad(res, \"phone\");\n  if (email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) return bad(res, \"email\");\n  // gender is optional; only keep it if it's a recognized va