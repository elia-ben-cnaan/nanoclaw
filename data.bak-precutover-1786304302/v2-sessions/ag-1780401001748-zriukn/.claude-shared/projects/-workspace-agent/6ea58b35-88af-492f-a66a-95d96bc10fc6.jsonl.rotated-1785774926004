{"parentUuid":"a7e9b5a2-8501-47bc-b6bc-568d2646a1bb","isSidechain":false,"attachment":{"type":"file","filename":"/workspace/agent/nanohub_demo/avigail-board.html","content":{"type":"text","file":{"filePath":"/workspace/agent/nanohub_demo/avigail-board.html","content":"<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"robots\" content=\"noindex,nofollow\">\n<title>NanoCo · בורד אביגיל</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;700;800&display=swap\" rel=\"stylesheet\">\n<style>\n  :root{\n    --paper:#000; --card:#101010; --card2:#181818; --line:#3A3A3A;\n    --ink:#fff; --muted:#B0B0B0; --teal:#56EDD6; --action:#0F756D; --orange:#E85D3A;\n  }\n  *{box-sizing:border-box}\n  body{margin:0;background:var(--paper);color:var(--ink);font-family:Heebo,system-ui,sans-serif}\n  .wrap{max-width:1000px;margin:0 auto;padding:18px 16px 60px}\n  header{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:6px}\n  .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:19px}\n  .dot{width:12px;height:12px;border-radius:50%;background:var(--teal)}\n  .sub{color:var(--muted);font-size:13px;margin:0 0 16px}\n  .bar{display:flex;align-items:center;justify-content:space-between;gap:10px;margin:6px 0 14px;flex-wrap:wrap}\n  .upd{color:var(--muted);font-size:13px}\n  .btn{background:var(--action);color:#fff;border:0;border-radius:10px;padding:9px 18px;font-family:inherit;font-weight:700;font-size:14px;cursor:pointer}\n  .btn:disabled{opacity:.5;cursor:default}\n  .kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}\n  .kpi{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px}\n  .kpi.big{border-color:var(--teal)}\n  .kpi .n{font-size:34px;font-weight:800;line-height:1}\n  .kpi .l{color:var(--muted);font-size:12px;margin-top:6px}\n  .panel{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin-bottom:14px}\n  .panel h3{margin:0 0 4px;font-size:15px;font-weight:700}\n  .panel .ph{color:var(--muted);font-size:12px;margin:0 0 12px}\n  /* channel cards */\n  .chans{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}\n  .chan{background:var(--card2);border:1px solid var(--line);border-radius:12px;padding:14px}\n  .chan .cn{font-weight:700;font-size:14px;margin-bottom:10px;display:flex;align-items:center;gap:7px}\n  .chan .cn .ic{width:9px;height:9px;border-radius:50%;background:var(--teal);flex:0 0 auto}\n  .chan .big{font-size:28px;font-weight:800;line-height:1}\n  .chan .biglab{color:var(--muted);font-size:11px;margin:4px 0 12px}\n  .chan .stat{display:flex;justify-content:space-between;font-size:13px;margin:5px 0;color:var(--muted)}\n  .chan .stat b{color:var(--ink);font-weight:700}\n  .lrow{display:flex;align-items:center;gap:10px;margin:9px 0}\n  .lrow .nm{flex:0 0 34%;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n  .lrow .tr{flex:1;height:8px;background:var(--card2);border-radius:6px;overflow:hidden}\n  .lrow .tr i{display:block;height:100%;background:var(--teal)}\n  .lrow .ct{flex:0 0 auto;font-weight:700;font-size:14px;min-width:26px;text-align:left}\n  .lrow .pc{flex:0 0 auto;color:var(--muted);font-size:12px;min-width:40px;text-align:left}\n  table{width:100%;border-collapse:collapse;font-size:13px}\n  th,td{text-align:right;padding:9px 8px;border-bottom:1px solid var(--line)}\n  th{color:var(--muted);font-weight:500;font-size:12px}\n  .ltr{direction:ltr;text-align:right}\n  .tag{display:inline-block;padding:2px 9px;border-radius:999px;font-size:12px;background:var(--card2);color:var(--teal)}\n  .empty,.mini-empty{color:var(--muted);font-size:13px;padding:8px 0}\n  .err{color:var(--orange);font-size:13px;padding:8px 0}\n  @media(max-width:640px){.kpis{grid-template-columns:1fr}.chans{grid-template-columns:1fr}}\n</style>\n</head>\n<body>\n<div class=\"wrap\">\n  <header>\n    <div class=\"brand\"><span class=\"dot\"></span> בורד אביגיל · מוניטורינג</div>\n    <button class=\"btn\" id=\"refresh\">רענן</button>\n  </header>\n  <p class=\"sub\">רק הכניסות שהגיעו מהקישורים של אביגיל, מופרדות לפי העמוד שממנו נכנסו. מתעדכן בלחיצה על \"רענן\".</p>\n  <div class=\"bar\"><div class=\"upd\" id=\"upd\">—</div></div>\n  <div id=\"error\"></div>\n\n  <div class=\"kpis\">\n    <div class=\"kpi big\"><div class=\"n\" id=\"k-entered\">0</div><div class=\"l\">נכנסו מהקישורים של אביגיל (סה\"כ)</div></div>\n    <div class=\"kpi\"><div class=\"n\" id=\"k-form\">0</div><div class=\"l\">הגיעו לטופס</div></div>\n    <div class=\"kpi\"><div class=\"n\" id=\"k-left\">0</div><div class=\"l\">השאירו פרטים</div></div>\n  </div>\n\n  <div class=\"panel\">\n    <h3>לפי עמוד כניסה</h3>\n    <p class=\"ph\">כל קישור שנתנו לאביגיל, בנפרד: כמה נכנסו · הגיעו לטופס · השאירו פרטים</p>\n    <div class=\"chans\" id=\"chans\"><div class=\"mini-empty\">—</div></div>\n  </div>\n\n  <div class=\"panel\">\n    <h3>פירוט הכניסות</h3>\n    <p class=\"ph\">גרף השוואתי בין הערוצים של אביגיל</p>\n    <div id=\"p-source\"><div class=\"mini-empty\">—</div></div>\n  </div>\n\n  <div class=\"panel\">\n    <h3>מי שהשאיר פרטים (מהקישורים של אביגיל)</h3>\n    <div id=\"p-entries\"><div class=\"empty\">—</div></div>\n  </div>\n</div>\n\n<script>\n  var $ = function(id){ return document.getElementById(id); };\n  function esc(s){ return String(s==null?'':s).replace(/[&<>\"]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;'}[c];}); }\n\n  // A source belongs to Avigail if its (humanized or raw) label references her.\n  function isAvigail(label){ return /אביגיל|avigail/i.test(String(label||'')); }\n  // Strip the \"אביגיל ·\" prefix so the channel card shows just the page (וואטסאפ / לינקדאין / פייסבוק).\n  function chanName(label){\n    var s = String(label||'').replace(/avigail/ig,'אביגיל');\n    return s.replace(/^\\s*אביגיל\\s*·?\\s*/,'').trim() || 'ללא עמוד';\n  }\n\n  function renderChans(el, list){\n    if(!list || !list.length){ el.innerHTML='<div class=\"mini-empty\">עוד לא נכנס אף אחד מהקישורים של אביגיל</div>'; return; }\n    el.innerHTML = list.map(function(s){\n      return '<div class=\"chan\"><div class=\"cn\"><span class=\"ic\"></span>'+esc(chanName(s.label))+'</div>'\n        + '<div class=\"big\">'+(s.entered||0)+'</div><div class=\"biglab\">נכנסו</div>'\n        + '<div class=\"stat\"><span>הגיעו לטופס</span><b>'+(s.reachedForm||0)+'</b></div>'\n        + '<div class=\"stat\"><span>השאירו פרטים</span><b>'+(s.submitted||0)+'</b></div></div>';\n    }).join('');\n  }\n  function renderSources(el, list){\n    if(!list || !list.length){ el.innerHTML='<div class=\"mini-empty\">אין נתונים עדיין</div>'; return; }\n    var max = Math.max.apply(null, list.map(function(e){return e.entered||0;}).concat([1]));\n    el.innerHTML = list.map(function(s){\n      return '<div class=\"lrow\"><span class=\"nm\" title=\"'+esc(chanName(s.label))+'\">'+esc(chanName(s.label))+'</span>'\n        + '<span class=\"tr\"><i style=\"width:'+Math.round((s.entered||0)/max*100)+'%\"></i></span>'\n        + '<span class=\"ct\">'+(s.entered||0)+'</span>'\n        + '<span class=\"pc\">· '+(s.submitted||0)+' השאירו</span></div>';\n    }).join('');\n  }\n  function renderEntries(el, entries){\n    if(!entries || !entries.length){ el.innerHTML='<div class=\"empty\">אין עדיין מי שהשאיר פרטים מהקישורים של אביגיל</div>'; return; }\n    var rows = entries.map(function(e){\n      var t = e.when ? new Date(e.when).toLocaleString('he-IL') : '';\n      return '<tr><td>'+esc(t)+'</td><td>'+esc(e.name)+'</td>'\n        + '<td class=\"ltr\">'+esc(e.phone)+'</td>'\n        + '<td><span class=\"tag\">'+esc(chanName(e.source))+'</span></td></tr>';\n    }).join('');\n    el.innerHTML = '<table><thead><tr><th>מתי</th><th>שם</th><th>טלפון</th><th>עמוד כניסה</th></tr></thead><tbody>'+rows+'</tbody></table>';\n  }\n\n  function paint(sum, ent){\n    var okS = sum && sum.ok, okE = ent && ent.ok;\n    if(!okS && !okE){ $('error').innerHTML='<div class=\"err\">לא הצלחתי לטעון נתונים'+(sum&&sum.error?': '+esc(sum.error):'')+'</div>'; $('refresh').disabled=false; return; }\n    $('error').innerHTML='';\n\n    var raw = (okS && Array.isArray(sum.bySource) ? sum.bySource : [])\n      .filter(function(s){ return isAvigail(s.label); });\n    var m = {}, order = [];\n    raw.forEach(function(s){\n      var k = s.label;\n      if(!m[k]){ m[k]={label:k,entered:0,reachedForm:0,submitted:0}; order.push(k); }\n      m[k].entered+=s.entered||0; m[k].reachedForm+=s.reachedForm||0; m[k].submitted+=s.submitted||0;\n    });\n    var av = order.map(function(k){return m[k];}).sort(function(a,b){ return (b.entered||0)-(a.entered||0); });\n\n    var tEnt=0, tForm=0, tSub=0;\n    av.forEach(function(s){ tEnt+=s.entered||0; tForm+=s.reachedForm||0; tSub+=s.submitted||0; });\n    $('k-entered').textContent = tEnt;\n    $('k-form').textContent    = tForm;\n    $('k-left').textContent    = tSub;\n\n    renderChans($('chans'), av);\n    renderSources($('p-source'), av);\n\n    var avEntries = (okE && Array.isArray(ent.entries) ? ent.entries : [])\n      .filter(function(e){ return isAvigail(e.source); });\n    renderEntries($('p-entries'), avEntries);\n\n    if (okS && sum.generated_at) {\n      var g = new Date(sum.generated_at);\n      $('upd').textContent = 'עודכן (UTC): ' + g.toISOString().replace('T',' ').slice(0,19)\n        + ' · מקומי: ' + g.toLocaleString('he-IL');\n    } else { $('upd').textContent = 'אין חותמת שרת'; }\n    $('refresh').disabled=false;\n  }\n  function load(){\n    $('refresh').disabled=true;\n    $('upd').textContent='טוען…';\n    var ts = Date.now();\n    Promise.all([\n      fetch('/api/app-summary?_='+ts, {cache:'no-store'}).then(function(r){return r.json();}).catch(function(e){return {ok:false,error:String(e&&e.message||e)};}),\n      fetch('/api/app-entries?_='+ts, {cache:'no-store'}).then(function(r){return r.json();}).catch(function(){return {ok:false};})\n    ]).then(function(res){ paint(res[0], res[1]); });\n  }\n  $('refresh').addEventListener('click', load);\n  load();\n</script>\n</body>\n</html>\n","numLines":185,"startLine":1,"totalLines":185}},"displayPath":"nanohub_demo/avigail-board.html"},"type":"attachment","uuid":"708caff3-864a-4c20-9ec4-3280fafbf697","timestamp":"2026-08-02T12:35:09.966Z","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"6ea58b35-88af-492f-a66a-95d96bc10fc6","version":"2.1.197","gitBranch":"HEAD","slug":"wobbly-cuddling-shell"}
