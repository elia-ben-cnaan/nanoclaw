 String(raw || \"\").trim();\n  if (!s || s === \"לא ידוע\" || s === \"null\") return \"לא מסומן\";\n  const low = s.toLowerCase();\n  if (KNOWN[low]) return KNOWN[low];\n  // campaign convention: product-channel  (e.g. shellano-linkedin)\n  const parts = low.split(/[-_]/).map((p) => KNOWN[p] || p);\n  return parts.join(\" · \");\n}\n\nmodule.exports = async (req, res) => {\n  res.setHeader(\"Cache-Control\", \"no-store\");\n  const url = process.env.ADMIN_AGENTS_URL;\n  if (!url) {\n    return res.status(200).json({ ok: false, error: \"feed not configured\" });\n  }\n  try {\n    const r = await fetch(url, { headers: { Accept: \"application/json\" } });\n    if (!r.ok) return res.status(200).json({ ok: false, error: \"upstream \" + r.status });\n    const data = await r.json();\n    const agents = Array.isArray(data.agents) ? data.agents : [];\n\n    // regroup by source ourselves so labels are consistent + extensible\n    const counts = {};\n    for (const a of agents) {\n      const key = labelFor(a.source);\n      counts[key] = (counts[key] || 0) + 1;\n    }\n    const bySource = Object.entries(counts)\n      .map(([label, count]) => ({ label, count }))\n      .sort((x, y) => y.count - x.count);\n\n    const entries = agents\n      .map((a) => ({\n        name: a.userName || a.friendlyName || \"\",\n        phone: a.phone || \"\",\n        email: a.email || \"\",\n        source: labelFor(a.source),\n        when: a.createdAt || null,\n        status: a.status || \"\",\n      }))\n      .sort((x, y) => String(y.when || \"\").localeCompare(String(x.when || \"\")));\n\n    return res.status(200).json({\n      ok: true,\n      total: agents.length,\n      bySource,\n      entries,\n      generated_at: new Date().toISOString(),\n    });\n  } catch (e) {\n    return res.status(200).json({ ok: false, error: String((e && e.message) || e) });\n  }\n};\n","structuredPatch":[{"oldStart":11,"oldLines":8,"newStart":11,"newLines":15,"lines":["   click2agent: \"קליק טו אייג'נט · וואטסאפ\",","   c2a: \"קליק טו אייג'נט · וואטסאפ\",","   linkedin: \"לינקדאין\",","+  li: \"לינקדאין\",","+  avigail: \"אביגיל\",","+  lnd: \"קבוצת לינקדאין\",","   facebook: \"פייסבוק\",","+  fb: \"פייסבוק\",","   instagram: \"אינסטגרם\",","+  ig: \"אינסטגרם\",","+  wa: \"וואטסאפ\",","+  whatsapp: \"וואטסאפ\","," };"," "," function labelFor(raw) {"]}],"userModified":false,"replaceAll":false},"sourceToolAssistantUUID":"d5ae5b97-baac-4296-a4df-e4096e31b9ee","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent/nanohub_demo","sessionId":"6ea58b35-88af-492f-a66a-95d96bc10fc6","version":"2.1.197","gitBranch":"HEAD","slug":"wobbly-cuddling-shell"}
