lex}\n\n  .manifesto-line{\n    flex:0 0 auto;text-align:center;color:var(--muted);font-size:13px;line-height:1.5;\n    padding:12px 6px 2px;\n  }\n  .manifesto-line b{color:var(--teal);font-weight:600}\n\n  /* ---------- slides 3-4: security / install ---------- */\n  .cards{display:flex;flex-direction:column;gap:9px;margin-top:16px}\n  .card{\n    display:flex;gap:12px;align-items:flex-start;\n    background:var(--surface);border:1px solid #242424;border-radius:14px;padding:12px 13px;\n  }\n  .card.featured{border-color:var(--teal-line);background:#0d1614}\n  /* reading highlight: glides card to card at reading pace */\n  .card{transition:border-color .6s ease,background .6s ease,box-shadow .6s ease}\n  .card.reading{border-color:var(--teal);background:#0d1614;box-shadow:0 0 0 1px var(--teal-line)}\n  .card.reading .ic{background:#183430}\n  .card .ic{\n    width:34px;height:34px;border-radius:9px;background:#132320;color:var(--teal);\n    display:flex;align-items:center;justify-content:center;flex:0 0 auto;margin-top:1px;\n  }\n  .card .ic.ic-img{overflow:hidden;border-radius:50%;background:#0e1420}\n  .card .ic.ic-img img{width:100%;height:100%;object-fit:cover;display:block}\n  .card h3{font-size:13.8px;font-weight:600;line-height:1.35}\n  .card p{color:var(--muted);font-size:12.6px;line-height:1.55;margin-top:3px}\n  /* pilot page: personal note list (lighter than cards) */\n  .pnotes{display:flex;flex-direction:column;margin-top:20px}\n  .pnote{display:flex;gap:14px;align-items:flex-start;padding:16px 2px}\n  .pnote + .pnote{border-top:1px solid var(--border)}\n  .pn-num{flex:0 0 auto;width:29px;height:29px;border-radius:9px;background:#0d1614;border:1px solid var(--teal-line);color:var(--teal);font-weight:700;font-size:14.5px;display:flex;align-items:center;justify-content:center;margin-top:1px}\n  .pnote h3{font-size:15px;font-weight:600;line-height:1.35;margin:0}\n  .pnote p{color:var(--muted);font-size:13px;line-height:1.55;margin-top:4px}\n  .soul{color:#7d7d7d;font-size:12px;line-height:1.6;text-align:center;margin-top:auto;padding-top:16px;padding-bottom:8px}\n  .soul .accent{color:var(--teal);font-weight:700}\n\n  /* staggered reveal (security) */\n  .reveal-item{opacity:0;transform:translateY(12px);transition:opacity .5s ease,transform .5s ease}\n  .reveal-item.in{opacity:1;transform:none}\n  @media (prefers-reduced-motion:reduce){ .reveal-item{opacity:1;transform:none;transition:none} }\n\n  .steps{display:flex;flex-direction:column;gap:0;margin-top:16px}\n  .step{display:flex;gap:13px;position:relative;padding-bottom:16px}\n  .step:not(:last-child)::before{\n    content:\"\";position:absolute;inset-inline-start:15px;top:34px;bottom:2px;width:1px;background:var(--teal-dim);\n  }\n  .step-num{\n    width:31px;height:31px;border-radius:50%;background:#0d1614;border:1px solid var(--teal-dim);\n    color:var(--teal);font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;\n    flex:0 0 auto;position:relative;z-index:1;\n  }\n  .step h3{font-size:14.2px;font-weight:600;line-height:1.4;padding-top:5px}\n  .step p{color:var(--muted);font-size:12.8px;line-height:1.6;margin-top:4px}\n  .dl-prompt{color:var(--muted);font-size:12.5px;margin-top:14px}\n  .dl-row{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}\n  .dl-row a{\n    text-decoration:none;color:var(--teal);font-size:12.5px;font-weight:500;\n    border:1px solid var(--teal-line);background:#0d1614;border-radius:9px;padding:7px 12px;\n    transition:border-color .15s,background .15s;\n  }\n  .dl-row a:hover{border-color:var(--teal);background:#11201c}\n  .footnote{color:#7d7d7d;font-size:12px;text-align:center;margin-top:6px;padding-bottom:8px}\n\n  /* ---------- slide 5: signup ---------- */\n  form{display:flex;flex-direction:column;gap:11px;margin-top:16px;padding-bottom:8px}\n  .name-row{display:flex;gap:10px}\n  .name-row .field{flex:1 1 0;min-width:0}\n  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}\n  .field input{\n    width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;\n    color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;outline:none;\n    transition:border-color .15s;\n  }\n  .field input:focus{border-color:var(--teal)}\n  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n  .field.invalid input{border-color:var(--orange)}\n  .field.invalid .err{display:block}\n  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n  .consent input{width:16px;height:16px;accent-color:var(--teal);margin-top:1px;flex:0 0 auto}\n  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n  .consent.invalid{color:var(--orange)}\n\n  /* ---------- slide 6: done ---------- */\n  .done{justify-content:center;text-align:center}\n  .done-avatar{\n    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n    border:2px solid var(--teal-line);background:#0d1614;\n  }\n  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n  .done h1{font-size:26px}\n  .done .lead{max-width:300px;margin-inline:auto}\n  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n\n  /* ---------- bottom zone ---------- */\n  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n  .nav-row{display:flex;align-items:center;justify-content:space-between;gap:10px}\n  html[dir=\"ltr\"] .nav-row .nav-arr svg{transform:scaleX(-1)}\n  .dots{display:flex;justify-content:center;gap:7px;flex:1 1 auto}\n  .dots button{\n    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n    transition:background .2s,width .2s;\n  }\n  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n  .cta{\n    width:100%;border:none;border-radius:12px;background:var(--teal);color:#04211C;\n    font-family:inherit;font-size:15.5px;font-weight:700;padding:14px;cursor:pointer;\n    transition:filter .15s;\n  }\n  .cta:hover{filter:brightness(1.07)}\n  .cta:disabled{opacity:.6;cursor:default}\n  /* fixed-height sub-line keeps the bottom zone identical on every screen */\n  .cta-sub{height:17px;display:flex;align-items:center;justify-content:center}\n  .swipe-hint{\n    display:none;justify-content:center;align-items:center;gap:6px;\n    color:#8a8a8a;font-size:12.5px;\n  }\n  .swipe-hint svg{color:var(--teal);animation:nudge 1.6s ease-in-out infinite}\n  html[dir=\"ltr\"] .swipe-hint svg{transform:scaleX(-1)}\n  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n  html[dir=\"ltr\"] .swipe-hint svg{animation:nudgeLtr 1.6s ease-in-out infinite}\n  @keyframes nudgeLtr{0%,100%{transform:scaleX(-1) translateX(0)}50%{transform:scaleX(-1) translateX(-5px)}}\n  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n  @media (max-height:700px){\n    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n  }\n</style>\n</head>\n<body>\n\n<div class=\"phone\" id=\"phone\">\n  <div class=\"app-header\">\n    <img class=\"logo-icon\" src=\"nanoshellano-mascot.png\" alt=\"NanoShellano\">\n    <div class=\"header-side\">\n      <div class=\"lang-toggle\" id=\"langToggle\" role=\"group\" aria-label=\"Language\">\n        <button data-lang=\"he\" class=\"on\">HB</button><span class=\"lt-sep\">|</span><button data-lang=\"en\">EN</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"stage\" id=\"stage\">\n\n    <!-- 1 · hero -->\n    <section class=\"slide hero active\">\n      <div>\n        <img class=\"mascot\" src=\"data:image/png;base64,STRIPPED\" alt=\"\">\n        <h1 data-i18n-html=\"heroH1\">התקבל עובד חדש<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span></h1>\n        <p class=\"lead\" data-i18n=\"heroLead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי להיות לפני כולם.</p>\n        <div class=\"trust\" data-i18n-html=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n      </div>\n    </section>\n\n    <!-- 2 · telegram demo (auto simulation, no interaction) -->\n    <section class=\"slide demo before\">\n      <h1 class=\"demo-h1\" data-i18n-html=\"demoH1\">כך נראה יום עבודה עם <span class=\"accent\">הסוכן שלך</span></h1>\n      <p class=\"lead demo-lead\" data-i18n=\"demoLead\">4 דוגמאות למשימות שגרתיות שהסוכן יודע לעשות כשהוא מחובר למערכות הארגון.</p>\n      <p class=\"demo-note\" data-i18n=\"demoNote\">הדגמה להמחשה בלבד. החיבור למערכות עדיין לא פעיל.</p>\n      <div class=\"chat-card\" id=\"chatCard\">\n        <div class=\"tg-header\">\n          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n          <div class=\"tg-avatar\"><img src=\"data:image/png;base64,STRIPPED\" alt=\"\"></div>\n          <div class=\"tg-title\">\n            <div class=\"tg-name\" id=\"tgName\">ג'וני</div>\n            <div class=\"tg-status\" id=\"tgStatus\">online</div>\n          </div>\n          <span class=\"tg-menu\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\"/><circle cx=\"12\" cy=\"19\" r=\"1.7\"/></svg></span>\n        </div>\n        <div class=\"chat-log\" id=\"chatLog\"></div>\n        <div class=\"tg-input\">\n          <div class=\"fake-field\">\n            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n            <span>Message</span>\n          </div>\n          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n        </div>\n      </div>\n      <p class=\"manifesto-line\" data-i18n-html=\"manifesto\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n    </section>\n\n    <!-- 3 · security -->\n    <section class=\"slide list-slide before\">\n      <h1 data-i18n-html=\"secH1\">הבטחה <span class=\"accent\">ופרטיות</span></h1>\n      <p class=\"lead\" data-i18n=\"secLead\">הסוכן שלך סגור ומאובטח. 4 נושאים חשובים שכדאי לדעת.</p>\n      <div class=\"cards\" id=\"secCards\">\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n          <div><h3 data-i18n=\"sec1T\">שרת מבודד, משלך בלבד</h3><p data-i18n=\"sec1B\">הסוכן שלך פועל בסביבה סגורה ומבודדת שנפתחת רק עבורך, בלי שאף סוכן אחר או גורם חיצוני יכול לגעת במידע שבתוכה.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n          <div><h3 data-i18n=\"sec2T\">טלגרם, ערוץ פרטי ומוצפן</h3><p data-i18n=\"sec2B\">כל התקשורת עם הסוכן עוברת בטלגרם בלבד, בערוץ מוצפן ונפרד לחלוטין מהמייל, מהדרייב ומכל מערכת אחרת.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n          <div><h3 data-i18n=\"sec3T\">אין גישה לחשבונות הפרטיים שלך</h3><p data-i18n=\"sec3B\">המייל, הדרייב והחשבונות האישיים חסומים לסוכן ברמת ההגדרה. זו בחירה ארכיטקטונית קבועה, לא מגבלה זמנית.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"4.5\"/><path d=\"M10.8 12.2L21 2\"/><path d=\"M15 8l3 3\"/></svg></div>\n          <div><h3 data-i18n=\"sec4T\">כלי AI חיצוניים, במפתחות שלך בלבד</h3><p data-i18n=\"sec4B\">חיבור לכלי AI חיצוניים (מצגות, וידאו, תוכן) נעשה רק דרך מפתחות ה־API הפרטיים שלך. המפתחות סגורים, לא ניתנים להעברה, וניתן לנתק אותם בכל רגע.</p></div>\n        </div>\n      </div>\n      <p class=\"soul\" data-i18n-html=\"soul\">מוח של AI, גוף של NanoClaw, ונשמה של <span class=\"accent\">אליה בן כנען</span>.</p>\n    </section>\n\n    <!-- 4 · pilot -->\n    <section class=\"slide list-slide before pilot-slide\">\n      <h1 data-i18n-html=\"pilH1\">עשרה ימים <span class=\"accent\">בעולם החדש</span></h1>\n      <p class=\"lead\" data-i18n=\"pilLead\">עולם העבודה משתנה מול העיניים, ואני רוצה שתרגישו את זה בעצמכם.</p>\n      <div class=\"pnotes\">\n        <div class=\"pnote\"><span class=\"pn-num\">1</span><div><h3 data-i18n=\"pil1T\">חינם לגמרי</h3><p data-i18n=\"pil1B\">עשרה ימים על חשבוני, מהמשאבים שלי, כדי שתוכלו פשוט להתנסות.</p></div></div>\n        <div class=\"pnote\"><span class=\"pn-num\">2</span><div><h3 data-i18n=\"pil2T\">מספיק זמן להכיר</h3><p data-i18n=\"pil2B\">עשרה ימים זה בדיוק הזמן להתרגל לסוכן ולראות איך זה משנה לכם את היום.</p></div></div>\n        <div class=\"pnote\"><span class=\"pn-num\">3</span><div><h3 data-i18n=\"pil3T\">ומשם, שלכם</h3><p data-i18n=\"pil3B\">כשתרגישו את ההבדל, תקימו סוכן משלכם ותמשיכו הלאה.</p></div></div>\n      </div>\n      <p class=\"soul\" data-i18n-html=\"pilSoul\">שלכם, <span class=\"accent\">אליה בן כנען</span>.</p>\n    </section>\n\n    <!-- 5 · signup -->\n    <section class=\"slide list-slide before\">\n      <h1 data-i18n-html=\"formH1\">הסוכן <span class=\"accent\">נכנס לעבודה</span></h1>\n      <p class=\"lead\" style=\"margin-top:8px\" data-i18n=\"formLead\">הסוכן שלך עובד מתוך טלגרם, ומשם תתנהל כל העבודה איתו. טלגרם זמין גם בנייד וגם במחשב, כדי שיהיה לך נוח לעבוד מכל מקום. עוד כמה פרטים, והוא כבר מתחיל.</p>\n      <p class=\"dl-prompt\" data-i18n=\"dlPrompt\">צריך את טלגרם? הורד בדקה:</p>\n      <div class=\"dl-row\" style=\"margin-top:8px\">\n        <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlMobile\">הורדת טלגרם לנייד ←</a>\n        <a href=\"https://desktop.telegram.org/\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlDesktop\">הורדת טלגרם למחשב ←</a>\n      </div>\n      <form id=\"signupForm\" novalidate>\n        <div class=\"name-row\">\n          <div class=\"field\" id=\"fFirst\">\n            <label for=\"inFirst\" data-i18n=\"firstL\">שם פרטי</label>\n            <input id=\"inFirst\" type=\"text\" placeholder=\"השם שלך\" autocomplete=\"given-name\" data-i18n-ph=\"firstPh\">\n            <div class=\"err\" data-i18n=\"firstE\">נא להזין שם פרטי</div>\n          </div>\n          <div class=\"field\" id=\"fLast\">\n            <label for=\"inLast\" data-i18n=\"lastL\">שם משפחה</label>\n            <input id=\"inLast\" type=\"text\" placeholder=\"שם משפחה\" autocomplete=\"family-name\" data-i18n-ph=\"lastPh\">\n            <div class=\"err\" data-i18n=\"lastE\">נא להזין שם משפחה</div>\n          </div>\n        </div>\n        <div class=\"field\" id=\"fEmail\">\n          <label for=\"inEmail\" data-i18n=\"emailL\">אימייל</label>\n          <input id=\"inEmail\" type=\"email\" placeholder=\"name@company.com\" autocomplete=\"email\">\n          <div class=\"err\" data-i18n=\"emailE\">נא להזין אימייל תקין</div>\n        </div>\n        <div class=\"field\" id=\"fPhone\">\n          <label for=\"inPhone\" data-i18n=\"phoneL\">טלפון</label>\n          <input id=\"inPhone\" type=\"tel\" placeholder=\"050-0000000\" autocomplete=\"tel\">\n          <div class=\"err\" data-i18n=\"phoneE\">נא להזין מספר טלפון תקין</div>\n        </div>\n        <label class=\"consent\" id=\"tgConsentWrap\">\n          <input type=\"checkbox\" id=\"inTgConsent\">\n          <span data-i18n=\"tgConsent\">הורדתי טלגרם, אפשר להתחיל</span>\n        </label>\n        <label class=\"consent\" id=\"consentWrap\">\n          <input type=\"checkbox\" id=\"inConsent\">\n          <span data-i18n-html=\"consent\">קראתי ואישרתי את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a></span>\n        </label>\n      </form>\n    </section>\n\n  </div>\n\n  <div class=\"cta-zone\">\n    <div class=\"nav-row\">\n      <button class=\"nav-arr\" id=\"arrBack\" aria-label=\"הקודם\" disabled>\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      </button>\n      <div class=\"dots\" id=\"dots\"></div>\n      <button class=\"nav-arr\" id=\"arrFwd\" aria-label=\"הבא\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n      </button>\n    </div>\n    <button class=\"cta\" id=\"ctaBtn\">קדימה, הסוכן שלך מחכה</button>\n    <div class=\"cta-sub\">\n      <div class=\"swipe-hint\" id=\"swipeHint\">\n        <span data-i18n=\"swipeHint\">החליקו לראות אותו בפעולה</span>\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n      </div>\n      <div class=\"cta-foot\" id=\"ctaFoot\"></div>\n    </div>\n  </div>\n</div>\n\n<div class=\"caption\">Shellano</div>\n\n<script>\n/* ================= i18n ================= */\nconst S = {\n  he: {\n    docTitle: 'NanoShellano · הסוכן האישי שלך',\n    backAria: 'חזרה',\n    heroH1: 'התקבל עובד חדש<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span>',\n    heroLead: 'כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי להיות לפני כולם.',\n    trust: 'חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין',\n    manifesto: 'הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b>',\n    demoH1: 'כך נראה יום עבודה עם <span class=\"accent\">הסוכן שלך</span>',\n    demoLead: '4 דוגמאות למשימות שגרתיות שהסוכן יודע לעשות כשהוא מחובר למערכות הארגון.',\n    demoNote: 'הדגמה להמחשה בלבד. החיבור למערכות עדיין לא פעיל.',\n    tgName: \"ג'וני\",\n    secH1: 'הבטחה <span class=\"accent\">ופרטיות</span>',\n    secLead: 'הסוכן שלך סגור ומאובטח. 4 דברים שחשוב לדעת.',\n    sec1T: 'סביבה מבודדת, שלך בלבד', sec1B: 'הסוכן פועל בסביבה סגורה שנפתחת רק עבורך. אף גורם מבחוץ לא נוגע במידע שבתוכה.',\n    sec2T: 'טלגרם, ערוץ פרטי ומוצפן', sec2B: 'כל השיחה עוברת בטלגרם בלבד, מוצפנת ונפרדת מהמייל, מהדרייב ומכל מערכת אחרת.',\n    sec3T: 'אין גישה לחשבונות שלך', sec3B: 'המייל, הדרייב והחשבונות חסומים לסוכן. בחירה ארכיטקטונית קבועה, לא מגבלה זמנית.',\n    sec4T: 'כלי AI חיצוניים, במפתחות שלך', sec4B: 'חיבור לכלים חיצוניים נעשה רק דרך מפתחות ה־API שלך. סגורים, לא ניתנים להעברה, ומנותקים בלחיצה.',\n    sec5T: 'מחיקה מלאה, בכל רגע', sec5B: \"אפשר למחוק את כל היסטוריית הצ'אט ולסגור את הסוכן לחלוטין בלחיצה אחת, בלי שאריות.\",\n    soul: 'מוח של AI, גוף של NanoClaw, ונשמה של <span class=\"accent\">אליה בן כנען</span>.',\n    pilH1: 'עשרה ימים <span class=\"accent\">בעולם החדש</span>',\n    pilLead: 'עולם העבודה משתנה מול העיניים, ואני רוצה שתרגישו את זה בעצמכם.',\n    pil1T: 'חינם לגמרי', pil1B: 'עשרה ימים על חשבוני, מהמשאבים שלי, כדי שתוכלו פשוט להתנסות.',\n    pil2T: 'מספיק זמן להכיר', pil2B: 'עשרה ימים זה בדיוק הזמן להתרגל לסוכן ולראות איך זה משנה לכם את היום.',\n    pil3T: 'ומשם, שלכם', pil3B: 'כשתרגישו את ההבדל, תקימו סוכן משלכם ותמשיכו הלאה.',\n    pilSoul: 'שלכם, <span class=\"accent\">אליה בן כנען</span>.',\n    installH1: 'איך זה הולך להיות',\n    installLead: 'ארבעה צעדים, מהרגע שלוחצים ועד שהסוכן עובד בשבילך.',\n    st1T: 'הטלגרם, הערוץ הפרטי שלך', st1B: 'זמין באפליקציה לנייד, באפליקציה למחשב, וגם בדפדפן. מהיר, מסונכרן, ונוח לעבודה. אם יש לך כבר, אפשר לדלג לשלב הבא.',\n    dlMobile: 'להורדה לנייד ←', dlDesktop: 'להורדה למחשב ←',\n    st2T: 'פותחים לך משתמש אישי', st2B: 'שם, טלפון ומייל. דרכם נפתח לך חשבון פרטי שלך בלבד, שאף אחד אחר לא נכנס אליו, גם לא אנחנו.',\n    st3T: 'הסוכן שלך נבנה אוטומטית', st3B: 'ברגע שמאשרים, מתחילה הקמה אוטומטית של הסוכן האישי שלך. דקה-שתיים, ואנחנו מוודאים שהכל מוכן ומותאם רק לך.',\n    st4T: 'השיחה הראשונה, בטלגרם', st4B: 'הסוכן נפתח אצלך בטלגרם, מציג את עצמו, ומכאן ז