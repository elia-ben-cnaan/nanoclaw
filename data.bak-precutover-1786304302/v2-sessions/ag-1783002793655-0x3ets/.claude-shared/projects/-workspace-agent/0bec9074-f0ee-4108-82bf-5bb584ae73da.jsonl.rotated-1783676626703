   background:var(--tg-bg) url(\"data:image/svg+xml,__DOODLES__\") repeat;\n    background-size:260px 260px;\n  }\n  .tg-header{\n    flex:0 0 auto;display:flex;align-items:center;gap:10px;\n    padding:9px 12px;background:var(--tg-header);direction:ltr;\n  }\n  .tg-header .tg-back{color:#aebadc;display:flex}\n  .tg-avatar{width:34px;height:34px;border-radius:50%;overflow:hidden;background:#0e1420;flex:0 0 auto}\n  .tg-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n  .tg-title{flex:1 1 auto;min-width:0;direction:rtl;text-align:right}\n  .tg-name{font-size:14px;font-weight:600;color:#fff;line-height:1.2}\n  .tg-status{font-size:11.5px;color:#7d9bd6;line-height:1.3}\n  .tg-status.typing{color:#6fb2f2}\n  .tg-menu{color:#aebadc;display:flex}\n\n  .chat-log{\n    flex:1 1 auto;min-height:0;overflow-y:auto;padding:12px 10px 10px;\n    display:flex;flex-direction:column;gap:7px;scrollbar-width:none;scroll-behavior:smooth;\n  }\n  .chat-log::-webkit-scrollbar{display:none}\n  .msg-row{display:flex;direction:ltr;flex:0 0 auto}\n  .msg-row.bot{justify-content:flex-start}\n  .msg-row.me{justify-content:flex-end}\n  .bubble{\n    max-width:82%;padding:7px 11px 6px;border-radius:15px;\n    direction:rtl;text-align:right;font-size:13.8px;line-height:1.52;color:#f2f5fa;\n    animation:pop .22s ease;\n  }\n  @keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n  @media (prefers-reduced-motion:reduce){ .bubble{animation:none} }\n  .bot .bubble{background:var(--tg-in);border-bottom-left-radius:5px}\n  .me .bubble{background:linear-gradient(135deg,var(--tg-out-a),var(--tg-out-b));border-bottom-right-radius:5px}\n  .stamp{\n    display:flex;direction:ltr;justify-content:flex-start;align-items:center;gap:3px;\n    margin-top:3px;font-size:10.5px;color:#93a3c0;\n  }\n  .me .stamp{color:#cfe0ff}\n  .stamp svg{display:block}\n\n  .doc{display:flex;align-items:center;gap:9px;direction:rtl;margin-top:6px;margin-bottom:2px}\n  .doc-ic{width:34px;height:34px;border-radius:50%;background:#3f7be8;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n  .bot .doc-ic{background:#33415c}\n  .doc-name{font-size:12.8px;font-weight:600;color:#fff;line-height:1.3}\n  .doc-kind{font-size:10.8px;color:#9fb0d0}\n\n  .receipt-head{display:flex;align-items:center;gap:6px;color:var(--teal);font-weight:600;font-size:12.8px;margin-bottom:6px}\n  .receipt-row{display:flex;align-items:flex-start;gap:7px;font-size:12.6px;color:#cdd8ea;line-height:1.5;padding:2px 0}\n  .receipt-row svg{flex:0 0 auto;margin-top:3px}\n\n  .typing-bubble{display:flex;gap:4px;align-items:center;padding:11px 13px}\n  .typing-bubble i{width:6px;height:6px;border-radius:50%;background:#8fa3c4;animation:blink 1.1s infinite}\n  .typing-bubble i:nth-child(2){animation-delay:.18s}\n  .typing-bubble i:nth-child(3){animation-delay:.36s}\n  @keyframes blink{0%,70%,100%{opacity:.25}35%{opacity:1}}\n\n  .kb{display:flex;flex-direction:column;gap:5px;margin-top:2px;width:min(82%,300px)}\n  .msg-row.kb-row{justify-content:flex-start}\n  .kb button{\n    border:none;border-radius:9px;background:var(--tg-kb);color:#cfe0ff;\n    font-family:inherit;font-size:13px;padding:9px 12px;cursor:pointer;\n    display:flex;align-items:center;justify-content:center;gap:7px;direction:rtl;\n    transition:background .15s;\n  }\n  .kb button:hover{background:#2e3d58}\n  .kb button.done{color:#8494b3}\n  .kb button.pressed{background:#3a4d70}\n  .kb button:disabled{cursor:default}\n\n  .tg-input{\n    flex:0 0 auto;display:flex;align-items:center;gap:10px;direction:ltr;\n    padding:8px 10px;background:var(--tg-input);\n  }\n  .tg-input .fake-field{\n    flex:1 1 auto;display:flex;align-items:center;gap:9px;color:#7a8699;font-size:14px;direction:ltr;\n  }\n  .tg-mic{width:38px;height:38px;border-radius:50%;background:#3f7be8;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n  .tg-clip{color:#7a8699;display:flex}\n\n  .manifesto-line{\n    flex:0 0 auto;text-align:center;color:var(--muted);font-size:13px;line-height:1.5;\n    padding:12px 6px 2px;\n  }\n  .manifesto-line b{color:var(--text);font-weight:600}\n\n  /* ---------- slides 3-4: security / install ---------- */\n  .list-slide h1{margin-top:6px}\n  .cards{display:flex;flex-direction:column;gap:9px;margin-top:16px}\n  .card{\n    display:flex;gap:12px;align-items:flex-start;\n    background:var(--surface);border:1px solid #242424;border-radius:14px;padding:12px 13px;\n  }\n  .card.featured{border-color:#1f4a43;background:#0d1614}\n  .card .ic{\n    width:34px;height:34px;border-radius:9px;background:#132320;color:var(--teal);\n    display:flex;align-items:center;justify-content:center;flex:0 0 auto;margin-top:1px;\n  }\n  .card h3{font-size:13.8px;font-weight:600;line-height:1.35}\n  .card p{color:var(--muted);font-size:12.6px;line-height:1.55;margin-top:3px}\n  .soul{color:#7d7d7d;font-size:12px;line-height:1.6;text-align:center;margin-top:14px;padding-bottom:8px}\n\n  .steps{display:flex;flex-direction:column;gap:0;margin-top:16px}\n  .step{display:flex;gap:13px;position:relative;padding-bottom:16px}\n  .step:not(:last-child)::before{\n    content:\"\";position:absolute;right:15px;top:34px;bottom:2px;width:1px;background:#2a2a2a;\n  }\n  .step-num{\n    width:31px;height:31px;border-radius:50%;background:var(--surface2);border:1px solid var(--border);\n    color:var(--teal);font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;\n    flex:0 0 auto;position:relative;z-index:1;\n  }\n  .step h3{font-size:14.2px;font-weight:600;line-height:1.4;padding-top:5px}\n  .step p{color:var(--muted);font-size:12.8px;line-height:1.6;margin-top:4px}\n  .dl-row{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}\n  .dl-row a{\n    text-decoration:none;color:var(--text);font-size:12.5px;\n    border:1px solid var(--border);background:var(--surface);border-radius:9px;padding:7px 12px;\n    transition:border-color .15s;\n  }\n  .dl-row a:hover{border-color:var(--teal)}\n  .footnote{color:#7d7d7d;font-size:12px;text-align:center;margin-top:6px;padding-bottom:8px}\n\n  /* ---------- slide 5: signup ---------- */\n  .bridge{\n    background:#0d1614;border:1px solid #1f4a43;border-radius:14px;\n    padding:13px 14px;margin-top:16px;\n  }\n  .bridge h3{font-size:13.5px;font-weight:600;color:var(--teal)}\n  .bridge-row{display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-size:13px;color:#d6d6d6;line-height:1.5}\n  .bridge-row svg{flex:0 0 auto;margin-top:3px}\n  .bridge .link-line{color:#8a8a8a;font-size:12px;line-height:1.55;margin-top:10px}\n\n  form{display:flex;flex-direction:column;gap:11px;margin-top:16px;padding-bottom:8px}\n  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}\n  .field input{\n    width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;\n    color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;outline:none;\n    transition:border-color .15s;\n  }\n  .field input:focus{border-color:var(--teal)}\n  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n  .field.invalid input{border-color:var(--orange)}\n  .field.invalid .err{display:block}\n  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n  .consent input{width:16px;height:16px;accent-color:var(--action);margin-top:1px;flex:0 0 auto}\n  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n  .consent.invalid{color:var(--orange)}\n\n  /* ---------- slide 6: done ---------- */\n  .done{justify-content:center;text-align:center}\n  .done-avatar{\n    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n    border:2px solid #1f4a43;background:#0d1614;\n  }\n  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n  .done h1{font-size:26px}\n  .done .lead{max-width:300px;margin-inline:auto}\n  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n\n  /* ---------- bottom zone ---------- */\n  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n  .dots{display:flex;justify-content:center;gap:7px}\n  .dots button{\n    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n    transition:background .2s,width .2s;\n  }\n  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n  .cta{\n    width:100%;border:none;border-radius:12px;background:var(--action);color:#fff;\n    font-family:inherit;font-size:15.5px;font-weight:600;padding:14px;cursor:pointer;\n    transition:filter .15s;\n  }\n  .cta:hover{filter:brightness(1.12)}\n  .cta:disabled{opacity:.6;cursor:default}\n  .swipe-hint{\n    display:none;justify-content:center;align-items:center;gap:6px;\n    color:#8a8a8a;font-size:12.5px;\n  }\n  .swipe-hint svg{animation:nudge 1.6s ease-in-out infinite}\n  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n  @media (max-height:700px){\n    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n  }\n</style>\n</head>\n<body>\n\n<div class=\"phone\" id=\"phone\">\n  <div class=\"app-header\">\n    <button class=\"back-btn\" id=\"backBtn\" aria-label=\"חזרה\" disabled>\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n    </button>\n    <div class=\"logo\"><img src=\"__BODY__\" alt=\"מאסקוט Shellano\"><span>Nano<b>Shellano</b></span></div>\n  </div>\n\n  <div class=\"stage\" id=\"stage\">\n\n    <!-- 1 · hero -->\n    <section class=\"slide hero active\">\n      <div>\n        <img class=\"mascot\" src=\"__BODY__\" alt=\"\">\n        <h1>התקבל עובד חדש.<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span></h1>\n        <p class=\"lead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי שתהיה לפני כולם.</p>\n        <div class=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n      </div>\n    </section>\n\n    <!-- 2 · telegram demo -->\n    <section class=\"slide demo before\">\n      <div class=\"chat-card\" id=\"chatCard\">\n        <div class=\"tg-header\">\n          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n          <div class=\"tg-avatar\"><img src=\"__FACE__\" alt=\"\"></div>\n          <div class=\"tg-title\">\n            <div class=\"tg-name\">הסוכן שלך</div>\n            <div class=\"tg-status\" id=\"tgStatus\">online</div>\n          </div>\n          <span class=\"tg-menu\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\"/><circle cx=\"12\" cy=\"19\" r=\"1.7\"/></svg></span>\n        </div>\n        <div class=\"chat-log\" id=\"chatLog\"></div>\n        <div class=\"tg-input\">\n          <div class=\"fake-field\">\n            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n            <span>Message</span>\n          </div>\n          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n        </div>\n      </div>\n      <p class=\"manifesto-line\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n    </section>\n\n    <!-- 3 · security -->\n    <section class=\"slide list-slide before\">\n      <h1>מאובטח, ורק שלך.</h1>\n      <p class=\"lead\">לפני שמכניסים סוכן לחיים שלך מגיע לך לדעת מה קורה עם המידע. הנה ההבטחה בחמש נקודות.</p>\n      <div class=\"cards\">\n        <div class=\"card featured\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n          <div><h3>סוכן מבודד, על שרת משלך</h3><p>רץ על שרת NanoClaw מבודד ששייך רק לך, בלי גישה חיצונית או ערבוב מידע עם אף אחד.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n          <div><h3>בטלגרם, ערוץ סגור ומוצפן</h3><p>ערוץ התקשורת היחיד שלך והמאובטח ביותר, נפרד לגמרי מהמייל ומהדרייב.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n          <div><h3>לא מתחבר למערכות אישיות</h3><p>מייל דרייב וחשבונות פרטיים חסומים לו בהגדרות, וזאת בחירה ולא מגבלה זמנית.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"4.5\"/><path d=\"M10.8 12.2L21 2\"/><path d=\"M15 8l3 3\"/></svg></div>\n          <div><h3>כלי AI חיצוניים, דרך המפתחות שלך</h3><p>מצגות וידאו ותוכן דרך המפתחות שלך, עם ניתוק בלחיצה.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h18\"/><path d=\"M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2\"/><path d=\"M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6\"/></svg></div>\n          <div><h3>מחיקה מלאה בכל רגע</h3><p>מוחקים את כל היסטוריית הצ'אט וסוגרים את הסוכן בלחיצה אחת.</p></div>\n        </div>\n      </div>\n      <p class=\"soul\">מוח של ה-AI המתקדם בעולם, גוף של NanoClaw, ונשמה של אליה בן כנען.</p>\n    </section>\n\n    <!-- 4 · install -->\n    <section class=\"slide list-slide before\">\n      <h1>איך זה הולך להיות.</h1>\n      <p class=\"lead\">ארבעה צעדים, מהרגע שלוחצים ועד שהסוכן עובד בשבילך.</p>\n      <div class=\"steps\">\n        <div class=\"step\">\n          <div class=\"step-num\">1</div>\n          <div>\n            <h3>הטלגרם, הערוץ הפרטי שלך</h3>\n            <p>זמין באפליקציה לנייד, באפליקציה למחשב, וגם בדפדפן. מהיר, מסונכרן, ונוח לעבודה. אם יש לך כבר, דלג לשלב הבא.</p>\n            <div class=\"dl-row\">\n              <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">להורדה לנייד ←</a>\n              <a href=\"https://desktop.telegram.org/\" target=\"_blank\" rel=\"noopener\">להורדה למחשב ←</a>\n            </div>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">2</div>\n          <div>\n            <h3>פותחים לך משתמש אישי</h3>\n            <p>שם, טלפון ומייל. דרכם נפתח לך חשבון פרטי שלך בלבד, שאף אחד אחר לא נכנס אליו, גם לא אנחנו.</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">3</div>\n          <div>\n            <h3>הסוכן שלך נבנה אוטומטית</h3>\n            <p>ברגע שאתה מאשר, מתחילה הקמה אוטומטית של הסוכן האישי שלך. דקה-שתיים, ואנחנו מוודאים שהכל מוכן ומותאם רק לך.</p>\n          </div>\n        </div>\n        <div class=\"step\">\n          <div class=\"step-num\">4</div>\n          <div>\n            <h3>השיחה הראשונה, בטלגרם</h3>\n            <p>הסוכן נפתח אצלך בטלגרם, מציג את עצמו, ומכאן זה רק שיחה.</p>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- 5 · signup -->\n    <section class=\"slide list-slide before\">\n      <h1>פותחים לך משתמש.</h1>\n      <p class=\"lead\" style=\"margin-top:8px\">שם, מייל וטלפון. הסוכן יפתח אצלך בטלגרם תוך דקה.</p>\n      <div class=\"bridge\">\n        <h3>מה מקבלים עכשיו</h3>\n        <div class=\"bridge-row\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg><span>סוכן אישי בטלגרם, מהיום</span></div>\n        <div class=\"bridge-row\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg><span>סביבה בטוחה, בלי גישה למערכות של החברה</span></div>\n        <div class=\"bridge-row\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg><span>בהמשך, כשתחליטו, פותחים לו חיבורים</span></div>\n        <p class=\"link-line\">כל מה שראיתם בדמו הוא לאן זה הולך. הטעימה מתחילה היום.</p>\n      </div>\n      <form id=\"signupForm\" novalidate>\n        <div class=\"field\" id=\"fName\">\n          <label for=\"inName\">שם מלא</label>\n          <input id=\"inName\" type=\"text\" placeholder=\"השם שלך\" autocomplete=\"name\">\n          <div class=\"err\">נא להזין שם</div>\n        </div>\n        <div class=\"field\" id=\"fEmail\">\n          <label for=\"inEmail\">אימייל</label>\n          <input id=\"inEmail\" type=\"email\" placeholder=\"name@company.com\" autocomplete=\"email\">\n          <div class=\"err\">נא להזין אימייל תקין</div>\n        </div>\n        <div class=\"field\" id=\"fPhone\">\n          <label for=\"inPhone\">טלפון</label>\n          <input id=\"inPhone\" type=\"tel\" placeholder=\"050-0000000\" autocomplete=\"tel\">\n          <div class=\"err\">נא להזין מספר טלפון תקין</div>\n        </div>\n        <label class=\"consent\" id=\"consentWrap\">\n          <input type=\"checkbox\" id=\"inConsent\">\n          <span>קראתי ואני מאשר את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a></span>\n        </label>\n      </form>\n    </section>\n\n    <!-- 6 · done -->\n    <section class=\"slide done before\">\n      <div>\n        <div class=\"done-avatar\"><img src=\"__FACE__\" alt=\"\"></div>\n        <h1 id=\"doneTitle\">הסוכן שלך מחכה בטלגרם.</h1>\n        <p class=\"lead\">הוא כבר כתב לך הודעה ראשונה. לחיצה אחת, ואתם מתחילים.</p>\n        <p class=\"rescue\">לא הגיע קישור? עדיין אין טלגרם?<br><a id=\"rescueLink\">חזרה לשלבי ההתקנה</a></p>\n      </div>\n    </section>\n\n  </div>\n\n  <div class=\"cta-zone\">\n    <div class=\"dots\" id=\"dots\"></div>\n    <button class=\"cta\" id=\"ctaBtn\">בוא, הסוכן שלך מחכה</button>\n    <div class=\"swipe-hint\" id=\"swipeHint\">\n      <span>החלק לראות אותו בפעולה</span>\n      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n    </div>\n    <div class=\"cta-foot\" id=\"ctaFoot\"></div>\n  </div>\n</div>\n\n<div class=\"caption\">Shellano · מוקאפ v3 · הדמו במסך 2 אינטראקטיבי</div>\n\n<script>\n/* ================= navigation ================= */\nconst slides = Array.from(document.querySelectorAll('.slide'));\nconst N = slides.length;\nlet current = 0;\nlet userName = '';\n\nconst backBtn = document.getElementById('backBtn');\nconst ctaBtn  = document.getElementById('ctaBtn');\nconst swipeHint = document.getElementById('swipeHint');\nconst ctaFoot = document.getElementById('ctaFoot');\nconst dotsEl  = document.getElementById('dots');\n\nconst CTA = [\n  { label:'בוא, הסוכן שלך מחכה', action:'next', hint:true },\n  { label:'ורגע, כמה זה בטוח?', action:'next' },\n  { label:'אוקיי, איך מתחילים?', action:'next' },\n  { label:'יאללה, מתחילים לעבוד', action:'next', foot:'כל הסיפור, ארבע דקות כולל הורדה.' },\n  { label:'פתח לי סוכן', action:'submit', foot:'הפרטים נשמרים אצלך בלבד. בלי ספאם.' },\n  { label:'פתח בטלגרם', action:'telegram' }\n];\n\nfor (let i = 0; i < N; i++) {\n  const b = document.createElement('button');\n  b.setAttribute('aria-label', 'מסך ' + (i + 1));\n  b.onclick = () => goTo(i);\n  dotsEl.appendChild(b);\n}\nconst dots = Array.from(dotsEl.children);\n\nfunction render(){\n  slides.forEach((s,i)=>{\n    s.classList.toggle('active', i===current);\n    s.classList.toggle('before', i>current);\n  });\n  dots.forEa