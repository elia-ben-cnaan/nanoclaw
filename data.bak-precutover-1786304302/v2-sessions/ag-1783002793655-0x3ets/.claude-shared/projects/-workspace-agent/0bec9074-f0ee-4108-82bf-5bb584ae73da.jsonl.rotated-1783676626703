ait(500); step(gen);\n  const t = typingOn();\n  await wait(800); step(gen);\n  typingOff(t);\n  let html = '<div class=\"receipt-head\">' + CHECK_TEAL + '<span>' + sc.receipt.title + '</span></div>';\n  sc.receipt.rows.forEach(r=>{ html += '<div class=\"receipt-row\">' + CHECK_TEAL + '<span>' + r + '</span></div>'; });\n  bubble('bot', html, true);\n}\n\nasync function fadeClear(gen){\n  chatLog.style.transition = 'opacity .45s ease';\n  chatLog.style.opacity = '0';\n  await wait(480); step(gen);\n  chatLog.innerHTML = '';\n  chatLog.style.opacity = '1';\n}\n\nasync function runLoop(gen){\n  try {\n    await wait(500);\n    while (true){\n      await botSays(gen, T().demoGreeting);\n      await wait(1500);\n      for (let i = 0; i < SC().length; i++){\n        await playScenario(gen, i);\n        await wait(2400); step(gen);\n        if (i < SC().length - 1){ await fadeClear(gen); }\n      }\n      await botSays(gen, T().demoClosing, true);\n      await wait(5200); step(gen);\n      await fadeClear(gen);\n    }\n  } catch(e){ /* stale generation: a newer run owns the stage */ }\n}\n\nfunction restartDemo(){\n  demoGen++;\n  chatLog.innerHTML = '';\n  chatLog.style.opacity = '1';\n  tgStatus.textContent = 'online';\n  tgStatus.classList.remove('typing');\n  if (demoStarted) runLoop(demoGen);\n}\n\nfunction demoEnter(){\n  if (demoStarted) return;\n  demoStarted = true;\n  runLoop(++demoGen);\n}\n\napplyLang();\n</script>\n</body>\n</html>\n","structuredPatch":[],"originalFile":null,"userModified":false},"sourceToolAssistantUUID":"119c25ca-7226-4590-98b1-aed87e03a444","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"0bec9074-f0ee-4108-82bf-5bb584ae73da","version":"2.1.197","gitBranch":"HEAD","slug":"polished-jumping-turing"}
