t-b));border-bottom-right-radius:5px}\n115\t  .stamp{\n116\t    display:flex;direction:ltr;justify-content:flex-start;align-items:center;gap:3px;\n117\t    margin-top:3px;font-size:10.5px;color:#93a3c0;\n118\t  }\n119\t  .me .stamp{color:#cfe0ff}\n120\t  .stamp svg{display:block}\n121\t\n122\t  .doc{display:flex;align-items:center;gap:9px;direction:rtl;margin-top:6px;margin-bottom:2px}\n123\t  .doc-ic{width:34px;height:34px;border-radius:50%;background:#3f7be8;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n124\t  .bot .doc-ic{background:#33415c}\n125\t  .doc-name{font-size:12.8px;font-weight:600;color:#fff;line-height:1.3}\n126\t  .doc-kind{font-size:10.8px;color:#9fb0d0}\n127\t\n128\t  .receipt-head{display:flex;align-items:center;gap:6px;color:var(--teal);font-weight:600;font-size:12.8px;margin-bottom:6px}\n129\t  .receipt-row{display:flex;align-items:flex-start;gap:7px;font-size:12.6px;color:#cdd8ea;line-height:1.5;padding:2px 0}\n130\t  .receipt-row svg{flex:0 0 auto;margin-top:3px}\n131\t\n132\t  .typing-bubble{display:flex;gap:4px;align-items:center;padding:11px 13px}\n133\t  .typing-bubble i{width:6px;height:6px;border-radius:50%;background:#8fa3c4;animation:blink 1.1s infinite}\n134\t  .typing-bubble i:nth-child(2){animation-delay:.18s}\n135\t  .typing-bubble i:nth-child(3){animation-delay:.36s}\n136\t  @keyframes blink{0%,70%,100%{opacity:.25}35%{opacity:1}}\n137\t\n138\t  .kb{display:flex;flex-direction:column;gap:5px;margin-top:2px;width:min(82%,300px)}\n139\t  .msg-row.kb-row{justify-content:flex-start}\n140\t  .kb button{\n141\t    border:none;border-radius:9px;background:var(--tg-kb);color:#cfe0ff;\n142\t    font-family:inherit;font-size:13px;padding:9px 12px;cursor:pointer;\n143\t    display:flex;align-items:center;justify-content:center;gap:7px;direction:rtl;\n144\t    transition:background .15s;\n145\t  }\n146\t  .kb button:hover{background:#2e3d58}\n147\t  .kb button.done{color:#8494b3}\n148\t  .kb button.pressed{background:#3a4d70}\n149\t  .kb button:disabled{cursor:default}\n150\t\n151\t  .tg-input{\n152\t    flex:0 0 auto;display:flex;align-items:center;gap:10px;direction:ltr;\n153\t    padding:8px 10px;background:var(--tg-input);\n154\t  }\n155\t  .tg-input .fake-field{\n156\t    flex:1 1 auto;display:flex;align-items:center;gap:9px;color:#7a8699;font-size:14px;direction:ltr;\n157\t  }\n158\t  .tg-mic{width:38px;height:38px;border-radius:50%;background:#3f7be8;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n159\t  .tg-clip{color:#7a8699;display:flex}\n160\t\n161\t  .manifesto-line{\n162\t    flex:0 0 auto;text-align:center;color:var(--muted);font-size:13px;line-height:1.5;\n163\t    padding:12px 6px 2px;\n164\t  }\n165\t  .manifesto-line b{color:var(--text);font-weight:600}\n166\t\n167\t  /* ---------- slides 3-4: security / install ---------- */\n168\t  .list-slide h1{margin-top:6px}\n169\t  .cards{display:flex;flex-direction:column;gap:9px;margin-top:16px}\n170\t  .card{\n171\t    display:flex;gap:12px;align-items:flex-start;\n172\t    background:var(--surface);border:1px solid #242424;border-radius:14px;padding:12px 13px;\n173\t  }\n174\t  .card.featured{border-color:#1f4a43;background:#0d1614}\n175\t  .card .ic{\n176\t    width:34px;height:34px;border-radius:9px;background:#132320;color:var(--teal);\n177\t    display:flex;align-items:center;justify-content:center;flex:0 0 auto;margin-top:1px;\n178\t  }\n179\t  .card h3{font-size:13.8px;font-weight:600;line-height:1.35}\n180\t  .card p{color:var(--muted);font-size:12.6px;line-height:1.55;margin-top:3px}\n181\t  .soul{color:#7d7d7d;font-size:12px;line-height:1.6;text-align:center;margin-top:14px;padding-bottom:8px}\n182\t\n183\t  .steps{display:flex;flex-direction:column;gap:0;margin-top:16px}\n184\t  .step{display:flex;gap:13px;position:relative;padding-bottom:16px}\n185\t  .step:not(:last-child)::before{\n186\t    content:\"\";position:absolute;right:15px;top:34px;bottom:2px;width:1px;background:#2a2a2a;\n187\t  }\n188\t  .step-num{\n189\t    width:31px;height:31px;border-radius:50%;background:var(--surface2);border:1px solid var(--border);\n190\t    color:var(--teal);font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;\n191\t    flex:0 0 auto;position:relative;z-index:1;\n192\t  }\n193\t  .step h3{font-size:14.2px;font-weight:600;line-height:1.4;padding-top:5px}\n194\t  .step p{color:var(--muted);font-size:12.8px;line-height:1.6;margin-top:4px}\n195\t  .dl-row{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}\n196\t  .dl-row a{\n197\t    text-decoration:none;color:var(--text);font-size:12.5px;\n198\t    border:1px solid var(--border);background:var(--surface);border-radius:9px;padding:7px 12px;\n199\t    transition:border-color .15s;\n200\t  }\n201\t  .dl-row a:hover{border-color:var(--teal)}\n202\t  .footnote{color:#7d7d7d;font-size:12px;text-align:center;margin-top:6px;padding-bottom:8px}\n203\t\n204\t  /* ---------- slide 5: signup ---------- */\n205\t  .bridge{\n206\t    background:#0d1614;border:1px solid #1f4a43;border-radius:14px;\n207\t    padding:13px 14px;margin-top:16px;\n208\t  }\n209\t  .bridge h3{font-size:13.5px;font-weight:600;color:var(--teal)}\n210\t  .bridge-row{display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-size:13px;color:#d6d6d6;line-height:1.5}\n211\t  .bridge-row svg{flex:0 0 auto;margin-top:3px}\n212\t  .bridge .link-line{color:#8a8a8a;font-size:12px;line-height:1.55;margin-top:10px}\n213\t\n214\t  form{display:flex;flex-direction:column;gap:11px;margin-top:16px;padding-bottom:8px}\n215\t  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}\n216\t  .field input{\n217\t    width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;\n218\t    color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;outline:none;\n219\t    transition:border-color .15s;\n220\t  }\n221\t  .field input:focus{border-color:var(--teal)}\n222\t  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n223\t  .field.invalid input{border-color:var(--orange)}\n224\t  .field.invalid .err{display:block}\n225\t  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n226\t  .consent input{width:16px;height:16px;accent-color:var(--action);margin-top:1px;flex:0 0 auto}\n227\t  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n228\t  .consent.invalid{color:var(--orange)}\n229\t\n230\t  /* ---------- slide 6: done ---------- */\n231\t  .done{justify-content:center;text-align:center}\n232\t  .done-avatar{\n233\t    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n234\t    border:2px solid #1f4a43;background:#0d1614;\n235\t  }\n236\t  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n237\t  .done h1{font-size:26px}\n238\t  .done .lead{max-width:300px;margin-inline:auto}\n239\t  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n240\t  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n241\t\n242\t  /* ---------- bottom zone ---------- */\n243\t  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n244\t  .dots{display:flex;justify-content:center;gap:7px}\n245\t  .dots button{\n246\t    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n247\t    transition:background .2s,width .2s;\n248\t  }\n249\t  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n250\t  .cta{\n251\t    width:100%;border:none;border-radius:12px;background:var(--action);color:#fff;\n252\t    font-family:inherit;font-size:15.5px;font-weight:600;padding:14px;cursor:pointer;\n253\t    transition:filter .15s;\n254\t  }\n255\t  .cta:hover{filter:brightness(1.12)}\n256\t  .cta:disabled{opacity:.6;cursor:default}\n257\t  .swipe-hint{\n258\t    display:none;justify-content:center;align-items:center;gap:6px;\n259\t    color:#8a8a8a;font-size:12.5px;\n260\t  }\n261\t  .swipe-hint svg{animation:nudge 1.6s ease-in-out infinite}\n262\t  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n263\t  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n264\t  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n265\t  @media (max-height:700px){\n266\t    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n267\t    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n268\t  }\n269\t</style>\n270\t</head>\n271\t<body>\n272\t\n273\t<div class=\"phone\" id=\"phone\">\n274\t  <div class=\"app-header\">\n275\t    <button class=\"back-btn\" id=\"backBtn\" aria-label=\"חזרה\" disabled>\n276\t      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n277\t    </button>\n278\t    <div class=\"logo\"><img src=\"__BODY__\" alt=\"מאסקוט Shellano\"><span>Nano<b>Shellano</b></span></div>\n279\t  </div>\n280\t\n281\t  <div class=\"stage\" id=\"stage\">\n282\t\n283\t    <!-- 1 · hero -->\n284\t    <section class=\"slide hero active\">\n285\t      <div>\n286\t        <img class=\"mascot\" src=\"__BODY__\" alt=\"\">\n287\t        <h1>התקבל עובד חדש<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span></h1>\n288\t        <p class=\"lead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי שתהיה לפני כולם.</p>\n289\t        <div class=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n290\t      </div>\n291\t    </section>\n292\t\n293\t    <!-- 2 · telegram demo -->\n294\t    <section class=\"slide demo before\">\n295\t      <div class=\"chat-card\" id=\"chatCard\">\n296\t        <div class=\"tg-header\">\n297\t          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n298\t          <div class=\"tg-avatar\"><img src=\"__FACE__\" alt=\"\"></div>\n299\t          <div class=\"tg-title\">\n300\t            <div class=\"tg-name\">הסוכן שלך</div>\n301\t            <div class=\"tg-status\" id=\"tgStatus\">online</div>\n302\t          </div>\n303\t          <span class=\"tg-menu\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\"/><circle cx=\"12\" cy=\"19\" r=\"1.7\"/></svg></span>\n304\t        </div>\n305\t        <div class=\"chat-log\" id=\"chatLog\"></div>\n306\t        <div class=\"tg-input\">\n307\t          <div class=\"fake-field\">\n308\t            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n309\t            <span>Message</span>\n310\t          </div>\n311\t          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n312\t          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n313\t        </div>\n314\t      </div>\n315\t      <p class=\"manifesto-line\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n316\t    </section>\n317\t\n318\t    <!-- 3 · security -->\n319\t    <section class=\"slide list-slide before\">\n320\t      <h1>מאובטח, ורק שלך.</h1>\n321\t      <p class=\"lead\">לפני שמכניסים סוכן לחיים שלך מגיע לך לדעת מה קורה עם המידע. הנה ההבטחה בחמש נקודות.</p>\n322\t      <div class=\"cards\">\n323\t        <div class=\"card featured\">\n324\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n325\t          <div><h3>סוכן מבודד, על שרת משלך</h3><p>רץ על שרת NanoClaw מבודד ששייך רק לך, בלי גישה חיצונית או ערבוב מידע עם אף אחד.</p></div>\n326\t        </div>\n327\t        <div class=\"card\">\n328\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n329\t          <div><h3>בטלגרם, ערוץ סגור ומוצפן</h3><p>ערוץ התקשורת היחיד שלך והמאובטח ביותר, נפרד לגמרי מהמייל ומהדרייב.</p></div>\n330\t        </div>\n331\t        <div class=\"card\">\n332\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n333\t          <div><h3>לא מתחבר למערכות אישיות</h3><p>מייל דרייב וחשבונות פרטיים חסומים לו בהגדרות, וזאת בחירה ולא מגבלה זמנית.</p></div>\n334\t        </div>\n335\t        <div class=\"card\">\n336\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"4.5\"/><path d=\"M10.8 12.2L21 2\"/><path d=\"M15 8l3 3\"/></svg></div>\n337\t          <div><h3>כלי AI חיצוניים, דרך המפתחות שלך</h3><p>מצגות וידאו ותוכן דרך המפתחות שלך, עם ניתוק בלחיצה.</p></div>\n338\t        </div>\n339\t        <div class=\"card\">\n340\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h18\"/><path d=\"M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2\"/><path d=\"M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6\"/></svg></div>\n341\t          <div><h3>מחיקה מלאה בכל רגע</h3><p>מוחקים את כל היסטוריית הצ'אט וסוגרים את הסוכן בלחיצה אחת.</p></div>\n342\t        </div>\n343\t      </div>\n344\t      <p class=\"soul\">מוח של ה-AI המתקדם בעולם, גוף של NanoClaw, ונשמה של אליה בן כנען.</p>\n345\t    </section>\n346\t\n347\t    <!-- 4 · install -->\n348\t    <section class=\"slide list-slide before\">\n349\t      <h1>איך זה הולך להיות.</h1>\n350\t      <p class=\"lead\">ארבעה צעדים, מהרגע שלוחצים ועד שהסוכן עובד בשבילך.</p>\n351\t      <div class=\"steps\">\n352\t        <div class=\"step\">\n353\t          <div class=\"step-num\">1</div>\n354\t          <div>\n355\t            <h3>הטלגרם, הערוץ הפרטי שלך</h3>\n356\t            <p>זמין באפליקציה לנייד, באפליקציה למחשב, וגם בדפדפן. מהיר, מסונכרן, ונוח לעבודה. אם יש לך כבר, דלג לשלב הבא.</p>\n357\t            <div class=\"dl-row\">\n358\t              <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\">להורדה לנייד ←</a>\n359\t              <a href=\"https://desktop.telegram.org/\" target=\"_blank\" rel=\"noopener\">להורדה למחשב ←</a>\n360\t            </div>\n361\t          </div>\n362\t        </div>\n363\t        <div class=\"step\">\n364\t          <div class=\"step-num\">2</div>\n365\t          <div>\n366\t            <h3>פותחים לך משתמש אישי</h3>\n367\t            <p>שם, טלפון ומייל. דרכם נפתח לך חשבון פרטי שלך בלבד, שאף אחד אחר לא נכנס אליו, גם לא אנחנו.</p>\n368\t          </div>\n369\t        </div>\n370\t        <div class=\"step\">\n371\t          <div class=\"step-num\">3</div>\n372\t          <div>\n373\t            <h3>הסוכן שלך נבנה אוטומטית</h3>\n374\t            <p>ברגע שאתה מאשר, מתחילה הקמה אוטומטית של הסוכן האישי שלך. דקה-שתיים, ואנחנו מוודאים שהכל מוכן ומותאם רק לך.</p>\n375\t          </div>\n376\t        </div>\n377\t        <div class=\"step\">\n378\t          <div class=\"step-num\">4</div>\n379\t          <div>\n380\t            <h3>השיחה הראשונה, בטלגרם</h3>\n381\t            <p>הסוכן נפתח אצלך בטלגרם, מציג את עצמו, ומכאן זה רק שיחה.</p>\n382\t          </div>\n383\t        </div>\n384\t      </div>\n385\t    </section>\n386\t\n387\t    <!-- 5 · signup -->\n388\t    <section class=\"slide list-slide before\">\n389\t      <h1>פותחים לך משתמש.</h1>\n390\t      <p class=\"lead\" style=\"margin-top:8px\">שם, מייל וטלפון. הסוכן יפתח אצלך בטלגרם תוך דקה.</p>\n391\t      <div class=\"bridge\">\n392\t        <h3>מה מקבלים עכשיו</h3>\n393\t        <div class=\"bridge-row\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg><span>סוכן אישי בטלגרם, מהיום</span></div>\n394\t        <div class=\"bridge-row\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg><span>סביבה בטוחה, בלי גישה למערכות של החברה</span></div>\n395\t        <div class=\"bridge-row\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg><span>בהמשך, כשתחליטו, פותחים לו חיבורים</span></div>\n396\t        <p class=\"link-line\">כל מה שראיתם בדמו הוא לאן זה הולך. הטעימה מתחילה היום.</p>\n397\t      </div>\n398\t      <form id=\"signupForm\" novalidate>\n399\t        <div class=\"field\" id=\"fName\">\n400\t          <label for=\"inName\">שם מלא</label>\n401\t          <input id=\"inName\" type=\"text\" placeholder=\"השם שלך\" autocomplete=\"name\">\n402\t          <div class=\"err\">נא להזין שם</div>\n403\t        </div>\n404\t        <div class=\"field\" id=\"fEmail\">\n405\t          <label for=\"inEmail\">אימייל</label>\n406\t          <input id=\"inEmail\" type=\"email\" placeholder=\"name@company.com\" autocomplete=\"email\">\n407\t          <div class=\"err\">נא להזין אימייל תקין</div>\n408\t        </div>\n409\t        <div class=\"field\" id=\"fPhone\">\n410\t          <label for=\"inPhone\">טלפון</label>\n411\t          <input id=\"inPhone\" type=\"tel\" placeholder=\"050-0000000\" autocomplete=\"tel\">\n412\t          <div class=\"err\">נא להזין מספר טלפון תקין</div>\n413\t        </div>\n414\t        <label class=\"consent\" id=\"consentWrap\">\n415\t          <input type=\"checkbox\" id=\"inConsent\">\n416\t          <span>קראתי ואני מאשר את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a></span>\n417\t        </label>\n418\t      </form>\n419\t    </section>\n420\t\n421\t    <!-- 6 · done -->\n422\t    <section class=\"slide done before\">\n423\t      <div>\n424\t        <div class=\"done-avatar\"><img src=\"__FACE__\" alt=\"\"></div>\n425\t        <h1 id=\"doneTitle\">הסוכן שלך מחכה בטלגרם.</h1>\n426\t        <p class=\"lead\">הוא כבר כתב לך הודעה ראשונה. לחיצה אחת, ואתם מתחילים.</p>\n427\t        <p class=\"rescue\">לא הגיע קישור? עדיין אין טלגרם?<br><a id=\"rescueLink\">חזרה לשלבי ההתקנה</a></p>\n428\t      </div>\n429\t    </section>\n430\t\n431\t  </div>\n432\t\n433\t  <div class=\"cta-zone\">\n434\t    <div class=\"dots\" id=\"dots\"></div>\n435\t    <button class=\"cta\" id=\"ctaBtn\">בוא, הסוכן שלך מחכה</button>\n436\t    <div class=\"swipe-hint\" id=\"swipeHint\">\n437\t      <span>החלק לראות אותו בפעולה</span>\n438\t      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n439\t    </div>\n440\t    <div class=\"cta-foot\" id=\"ctaFoot\"></div>\n441\t  </div>\n442\t</div>\n443\t\n444\t<div class=\"caption\">Shellano · מוקאפ v3 · הדמו במסך 2 אינטראקטיבי</div>\n445\t\n446\t<script>\n447\t/* ================= navigation ================= */\n448\tconst slides = Array.from(document.querySelectorAll('.slide'));\n449\tconst N = slides.length;\n450\tlet current = 0;\n451\tlet userName = '';\n452\t\n453\tconst backBtn = document.getElementById('backBtn');\n454\tconst ctaBtn  = document.getElementById('ctaBtn');\n455\tconst swipeHint = document.getElementById('swipeHint');\n456\tconst ctaFoot = document.getElementById('ctaFoot');\n457\tconst dotsEl  = document.getElementById('dots');\n458\t\n459\tconst CTA = [\n460\t  { label:'בוא, הסוכן שלך מחכה', action:'next', hint:true },\n461\t  { label:'ורגע, כמה זה בטוח?', action:'next' },\n462\t  { label:'אוקיי, איך מתחילים?', action:'next' },\n463\t  { label:'יאללה, מתחילים לעבוד', action:'next', foot:'כל הסיפור, ארבע דקות כולל הורדה.' },\n464\t  { label:'פתח לי סוכן', action:'submit', foot:'הפרטים נשמרים אצלך בלבד. בלי ספאם.' },\n465\t  { label:'פתח בטלגרם', action:'telegram' }\n466\t];\n467\t\n468\tfor (let i = 0; i < N; i++) {\n469\t  const b = document.createElement('button');\n470\t  b.setAttribute('aria-label', 'מסך ' + (i + 1));\n471\t  b.onclick = () => goTo(i);\n472\t  dotsEl.appendChild(b);\n473\t}\n474\tconst dots = Array.from(dotsEl.children);\n475\t\n476\tfunction render(){\n477\t  slides.forEach((s,i)=>{\n478\t    s.classList.toggle('active', i===current);\n479\t    s.classList.toggle('before', i>current);\n480\t  });\n481\t  dots.forEach((d,i)=>d.classList.toggle('on', i===current));\n482\t  backBtn.disabled = current===0;\n483\t  const c = CTA[current];\n484\t  ctaBtn.textContent = c.label;\n485\t  swipeHint.style.display = c.hint ? 'flex' : 'none';\n486\t  ctaFoot.style.display = c.foot ? 'block' : 'none';\n487\t  ctaFoot.textContent = c.foot || '';\n488\t  if (current===1) demoEnter();\n489\t}\n490\t\n491\tfunction goTo(i){\n492\t  if (i<0 || i>=N || i===current) return;\n493\t  current = i;\n494\t  render();\n495\t}\n496\t\n497\tbackBtn.onclick = ()=>goTo(current-1);\n498\tctaBtn.onclick = ()=>{\n499\t  const a = CTA[current].action;\n500\t  if (a==='next') goTo(current+1);\n501\t  else if (a==='submit') submitForm();\n502\t  else if (a==='telegram') window.open('https://t.me/Nanoco_pilot_bot','_blank');\n503\t};\n504\tdocument.getElementById('rescueLink').onclick = ()=>goTo(3);\n505\t\n506\tdocument.addEventListener('keydown', e=>{\n507\t  if (e.key==='ArrowLeft') goTo(current+1);   /* RTL: forward */\n508\t  if (e.key==='ArrowRight') goTo(current-1);\n509\t});\n510\t\n511\tlet touchX = null, touchY = null;\n512\tconst stage = document.getElementById('stage');\n513\tstage.addEventListener('touchstart', e=>{ touchX=e.touches[0].clientX; touchY=e.touches[0].clientY; }, {passive:true});\n514\tstage.addEventListener('touchend', e=>{\n515\t  if (touchX===null) return;\n516\t  const dx = e.changedTouches[0].clientX - touchX;\n517\t  const dy = e.changedTouches[0].clientY - touchY;\n518\t  if (Math.abs(dx)>48 && Math.abs(dx)>Math.abs(dy)*1.4){\n519\t    if (dx<0) goTo(current+1); else goTo(current-1); /* RTL: swipe-left = forward */\n520\t  }\n521\t  touchX = null;\n522\t}, {passive:true});\n523\t\n524\t/* ================= signup ================= */\n525\tfunction submitForm(){\n526\t  const name = document.getElementById('inName');\n527\t  const email = document.getElementById('inEmail');\n528\t  const phone = document.getElementById('inPhone');\n529\t  const consent = document.getElementById('inConsent');\n530\t  let ok = true;\n531\t  const mark = (wrapId, valid)=>{\n532\t    document.getElementById(wrapId).classList.toggle('invalid', !valid);\n533\t    if (!valid) ok = false;\n534\t  };\n535\t  mark('fName', name.value.trim().length >= 2);\n536\t  mark('fEmail', /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(email.value.trim()));\n537\t  mark('fPhone', /^[\\d+\\-\\s()]{9,15}$/.test(phone.value.trim()));\n538\t  document.getElementById('consentWrap').classList.toggle('invalid', !consent.checked);\n539\t  if (!consent.checked) ok = false;\n540\t  if (!ok) return;\n541\t  userName = name.value.trim().split(/\\s+/)[0];\n542\t  ctaBtn.disabled = true;\n543\t  ctaBtn.textContent = 'מקימים לך סוכן...';\n544\t  setTimeout(()=>{\n545\t    ctaBtn.disabled = false;\n546\t    document.getElementById('doneTitle').textContent = userName + ', הסוכן שלך מחכה בטלגרם.';\n547\t    goTo(5);\n548\t  }, 1400);\n549\t}\n550\t\n551\t/* ================= telegram demo engine ================= */\n552\tconst chatLog = document.getElementById('chatLog');\n553\tconst chatCard = document.getElementById('chatCard');\n554\tconst tgStatus = document.getElementById('tgStatus');\n555\t\n556\tconst CHECK_TEAL = '<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg>';\n557\tconst DBL_CHECK = '<svg width=\"15\" height=\"11\" viewBox=\"0 0 20 12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 6.5L4.5 10 11 2.5\"/><path d=\"M8 6.5L11.5 10 18 2.5\"/></svg>';\n558\tconst DOC_ICON = '<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H7a2 2 0 00-2 2v16a2 2 0 002 2h10a2 2 0 002-2V7z\"/><path d=\"M14 2v5h5\"/></svg>';\n559\t\n560\tconst SCENARIOS = [\n561\t  {\n562\t    btn: 'תעדכן לקוח ותשלח הצעת מחיר',\n563\t    base: [9,12],\n564\t    msgs: [\n565\t      { who:'me',  text:'עדכן את הלקוח בCRM, תכין הצעת מחיר ותשלח לו במייל' },\n566\t      { who:'bot', text:'על איזה סכום ההצעה?' },\n567\t      { who:'me',  text:'45 אלף, כמו שסיכמנו בפגישה' },\n568\t      { who:'bot', text:'עדכנתי בCRM, הכנתי הצעה, וכתבתי טיוטת מייל ללקוח.' },\n569\t      { who:'bot', text:'המייל ממתין לאישורך. תיכנס ותאשר שליחה.' }\n570\t    ],\n571\t    receipt: { title:'בוצע · 3 פעולות', rows:['הלקוח עודכן ב-CRM','הצעת מחיר על 45,000 ₪ מוכנה','טיוטת מייל ממתינה לאישורך'] }\n572\t  },\n573\t  {\n574\t    btn: 'תכין מצגת לישיבה של מחר',\n575\t    base: [11,40],\n576\t    msgs: [\n577\t      { who:'me',  text:'צריך מצגת שמסבירה לצוות את הנוהל החדש, לישיבה מחר בבוקר' },\n578\t      { who:'bot', text:'על זה. משכתי את הנוהל מהמסמך ששיתפת. פנימי או ללקוחות, וכמה שקפים?' },\n579\t      { who:'me',  text:'פנימי, קצר ולעניין' },\n580\t      { who:'bot', text:'בונה: מה משתנה, למה, ומה עושים בפועל, עם דוגמה לכל שלב. 8 שקפים.', file:'מצגת_נוהל.pptx' },\n581\t      { who:'me',  text:'תוסיף גם משהו שהצוות יתרגל עליו' },\n582\t      { who:'bot', text:'הוספתי דף תרגול עם שלושה תרחישים. הכל מוכן לישיבה.', file:'דף_תרגול.pdf' }\n583\t    ],\n584\t    receipt: { title:'בוצע · 3 פעולות', rows:['הנוהל נמשך מהמסמך ששותף','מצגת של 8 שקפים נבנתה','דף תרגול עם שלושה תרחישים נוסף'] }\n585\t  },\n586\t  {\n587\t    btn: 'תקלוט אותי לתפקיד החדש',\n588\t    base: [13,5],\n589\t    msgs: [\n590\t      { who:'me',  text:'התחלתי היום בתפקיד, לא מכיר את המערכות ולא את התהליכים' },\n591\t      { who:'bot', text:'אני אלווה אותך. בניתי תוכנית קליטה לשבועיים, שיבצתי פגישות היכרות ביומן עם האנשים הרלוונטיים, ורשמתי אותך למערכות. נתחיל?' },\n592\t      { who:'me',  text:'כן. ואיך פותחים בקשת רכש לציוד?' },\n593\t      { who:'bot', text:'יש טופס, אבל אני ממלא בשבילך. מה, כמה, ולמי' },\n594\t      { who:'me',  text:'3 מסכים, בערך 6000 שקל' },\n595\t      { who:'bot', text:'מילאתי, צירפתי הצדקה תקציבית, ושלחתי לאישור המנהל שלך. תקבל התראה כשיאושר. ריכזתי לך גם את כל תהליכי הקליטה במקום אחד.', file:'תוכנית_קליטה.pdf' }\n596\t    ],\n597\t    receipt: { title:'בוצע · 4 פעולות', rows:['תוכנית קליטה לשבועיים נבנתה','פגישות היכרות שובצו ביומן','נרשמת לכל המערכות','בקשת רכש נשלחה לאישור המנהל'] }\n598\t  },\n599\t  {\n600\t    btn: 'תנתח את נתוני החודש',\n601\t    base: [16,22],\n602\t    msgs: [\n603\t      { who:'me',  text:'כל שבוע יוצא כלי AI חדש, אני לא מצליח לעקוב' },\n604\t      { who:'bot', text:'אז אל תעקוב. תגיד לי מה צריך, ואני בוחר את הכלי, מתחבר אליו, ומריץ. אתה לא לומד כלום' },\n605\t      { who:'me',  text:'צריך לנתח את הנתונים מהחודש ולהוציא תובנות' },\n606\t      { who:'bot', text:'על זה. בחרתי את הכלי המתאים, הרצתי, וזיהיתי 3 מגמות בולטות. מסדר דוח קריא עם המלצות' },\n607\t      { who:'me',  text:'תכין גם גרסה של עמוד אחד למנהלים' },\n608\t      { who:'bot', text:'הכנתי, עמוד אחד עם השורה התחתונה וההמלצה המרכזית.', file:'דוח_חודשי.pdf' }\n609\t    ],\n610\t    receipt: { title:'בוצע · 3 פעולות', rows:['הכלי המתאים נבחר והורץ','3 מגמות בולטות זוהו בנתונים','דוח מלא + עמוד מסכם למנהלים'] }\n611\t  }\n612\t];\n613\t\n614\tlet played = new Set();\n615\tlet demoStarted = false;\n616\tlet autoMode = true;\n617\tlet busy = false;\n618\tlet timers = [];\n619\tlet msgClock = null;\n620\t\n621\tfunction wait(ms){ return new Promise(res=>{ const t=setTimeout(res, ms); timers.push(t); }); }\n622\tfunction clearTimers(){ timers.forEach(clearTimeout); timers=[]; }\n623\t\n624\tfunction fmtTime(){\n625\t  if (!msgClock) return '';\n626\t  const t = msgClock.h.toString() + ':' + (msgClock.m<10?'0':'') + msgClock.m;\n627\t  msgClock.m += 1;\n628\t  if (msgClock.m>59){ msgClock.m=0; msgClock.h=(msgClock.h+1)%24; }\n629\t  return t;\n630\t}\n631\t\n632\tfunction scrollLog(){ chatLog.scrollTop = chatLog.scrollHeight; }\n633\t\n634\tfunction bubble(who, html, withStamp){\n635\t  const row = document.createElement('div');\n636\t  row.className = 'msg-row ' + who;\n637\t  const b = document.createElement('div');\n638\t  b.className = 'bubble';\n639\t  b.innerHTML = html;\n640\t  if (withStamp){\n641\t    const st = document.createElement('div');\n642\t    st.className = 'stamp';\n643\t    st.innerHTML = (who==='me' ? DBL_CHECK : '') + '<span>' + fmtTime() + '</span>';\n644\t    b.appendChild(st);\n645\t  }\n646\t  row.appendChild(b);\n647\t  chatLog.appendChild(row);\n648\t  scrollLog();\n649\t  return row;\n650\t}\n651\t\n652\tfunction docHtml(name){\n653\t  const kind = name.split('.').pop().toUpperCase();\n654\t  return '<div class=\"doc\"><div class=\"doc-ic\">' + DOC_ICON + '</div><div><div class=\"doc-name\">' + name + '</div><div class=\"doc-kind\">' + kind + '</div></div></div>';\n655\t}\n656\t\n657\tfunction typingOn(){\n658\t  tgStatus.textContent = 'typing…';\n659\t  tgStatus.classList.add('typing');\n660\t  const row = document.createElement('div');\n661\t  row.className = 'msg-row bot typing-row';\n662\t  row.innerHTML = '<div class=\"bubble typing-bubble\"><i></i><i></i><i></i></div>';\n663\t  chatLog.appendChild(row);\n664\t  scrollLog();\n665\t  return row;\n666\t}\n667\tfunction typingOff(row){\n668\t  tgStatus.textContent = 'online';\n669\t  tgStatus.classList.remove('typing');\n670\t  if (row && row.parentNode) row.remove();\n671\t}\n672\t\n673\tfunction keyboard(){\n674\t  const remaining = SCENARIOS.map((s,i)=>i);\n675\t  const row = document.createElement('div');\n676\t  row.className = 'msg-row kb-row';\n677\t  const kb = document.createElement('div');\n678\t  kb.className = 'kb';\n679\t  remaining.forEach(i=>{\n680\t    const btn = document.createElement('button');\n681\t    const done = played.has(i);\n682\t    btn.className = done ? 'done' : '';\n683\t    btn.innerHTML = done ? ('✓ ' + SCENARIOS[i].btn) : SCENARIOS[i].btn;\n684\t    btn.disabled = done;\n685\t    btn.onclick = ()=>{ stopAuto(); runScenario(i, btn); };\n686\t    kb.appendChild(btn);\n687\t  });\n688\t  row.appendChild(kb);\n689\t  chatLog.appendChild(row);\n690\t  scrollLog();\n691\t  return row;\n692\t}\n693\t\n694\tlet lastKb = null;\n695\t\n696\tasync function botSays(html, quick){\n697\t  const t = typingOn();\n698\t  await wait(quick ? 650 : 1050);\n699\t  typingOff(t);\n700\t  return bubble('bot', html, true);\n701\t}\n702\t\n703\tasync function runScenario(idx, pressedBtn){\n704\t  if (busy || played.has(idx)) return;\n705\t  busy = true;\n706\t  if (pressedBtn){ pressedBtn.classList.add('pressed'); await wait(320); }\n707\t  if (lastKb){ lastKb.remove(); lastKb = null; }\n708\t  const sc = SCENARIOS[idx];\n709\t  msgClock = { h: sc.base[0], m: sc.base[1] };\n710\t  played.add(idx);\n711\t  for (const m of sc.msgs){\n712\t    if (m.who==='me'){\n713\t      await wait(650);\n714\t      bubble('me', m.text + (m.file ? docHtml(m.file) : ''), true);\n715\t    } else {\n716\t      const t = typingOn();\n717\t      await wait(1150);\n718\t      typingOff(t);\n719\t      bubble('bot', (m.file ? docHtml(m.file) : '') + m.text, true);\n720\t    }\n721\t  }\n722\t  /* receipt as a telegram-style bot message */\n723\t  await wait(500);\n724\t  const t = typingOn();\n725\t  await wait(800);\n726\t  typingOff(t);\n727\t  let html = '<div class=\"receipt-head\">' + CHECK_TEAL + '<span>' + sc.receipt.title + '</span></div>';\n728\t  sc.receipt.rows.forEach(r=>{ html += '<div class=\"receipt-row\">' + CHECK_TEAL + '<span>' + r + '</span></div>'; });\n729\t  bubble('bot', html, true);\n730\t  await wait(900);\n731\t  if (played.size < SCENARIOS.length){\n732\t    await botSays('רוצה לראות עוד?', true);\n733\t    lastKb = keyboard();\n734\t  } else {\n735\t    await botSays('וזה רק על קצה המזלג. תמשיך הלאה, בפנים נדבר כבר על העבודה שלך.', true);\n736\t  }\n737\t  busy = false;\n738\t  if (autoMode) scheduleAuto();\n739\t}\n740\t\n741\tfunction nextUnplayed(){\n742\t  for (let i=0;i<SCENARIOS.length;i++) if (!played.has(i)) return i;\n743\t  return -1;\n744\t}\n745\t\n746\tlet autoTimer = null;\n747\tfunction scheduleAuto(){\n748\t  if (!autoMode) return;\n749\t  if (autoTimer) clearTimeout(autoTimer);\n750\t  const nxt = nextUnplayed();\n751\t  if (nxt === -1) return;\n752\t  autoTimer = setTimeout(()=>{\n753\t    if (!autoMode || busy || current!==1) return;\n754\t    /* highlight the button as if pressed, then run */\n755\t    let target = null;\n756\t    if (lastKb){\n757\t      target = Array.from(lastKb.querySelectorAll('button')).find(b=>!b.disabled && b.textContent===SCENARIOS[nxt].btn);\n758\t    }\n759\t    runScenario(nxt, target);\n760\t  }, 4000);\n761\t  timers.push(autoTimer);\n762\t}\n763\t\n764\tfunction stopAuto(){\n765\t  if (!autoMode) return;\n766\t  autoMode = false;\n767\t  if (autoTimer) clearTimeout(autoTimer);\n768\t}\n769\t\n770\tchatCard.addEventListener('pointerdown', ()=>{ stopAuto(); }, {capture:true});\n771\t\n772\tasync function demoEnter(){\n773\t  if (demoStarted){\n774\t    if (autoMode && !busy) scheduleAuto();  /* resume auto-demo when returning to this slide */\n775\t    return;\n776\t  }\n777\t  demoStarted = true;\n778\t  msgClock = { h: 9, m: 8 };\n779\t  await wait(500);\n780\t  await botSays('היי, אני הסוכן שלך. אני כאן בטלגרם, זמין תמיד. מה תרצה שאעשה?');\n781\t  lastKb = keyboard();\n782\t  scheduleAuto();\n783\t}\n784\t\n785\trender();\n786\t</script>\n787\t</body>\n788\t</html>\n789\t"}]},"uuid":"ee42977b-2286-44fe-b0f6-132e4d8afc19","timestamp":"2026-07-02T19:24:16.794Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/agent/ux-review/shellano-v3.template.html","content":"<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>NanoShellano · מוקאפ v3</title>\n<style>\n  :root{\n    --bg:#000000; --surface:#101010; --surface2:#181818;\n    --text:#FFFFFF; --muted:#B0B0B0; --teal:#56EDD6; --action:#0F756D;\n    --orange:#E85D3A; --border:#3A3A3A;\n    /* telegram replica palette (inside chat only) */\n    --tg-bg:#1a2332; --tg-doodle:#26314a; --tg-header:#212d44;\n    --tg-in:#212d3b; --tg-out-a:#4f6bE8; --tg-out-b:#3f7be8;\n    --tg-kb:#26334a; --tg-input:#161e2b;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{height:100%}\n  body{\n    background:var(--bg); color:var(--text);\n    font-family:'Inter','Segoe UI',system-ui,-apple-system,sans-serif;\n    display:flex; flex-direction:column; align-items:center; justify-content:center;\n    min-height:100dvh; gap:10px; padding:8px 0;\n  }\n  .caption{color:#5a5a5a;font-size:11.5px;letter-spacing:.4px}\n\n  /* ---------- phone frame ---------- */\n  .phone{\n    position:relative; width:min(410px,100vw); height:min(860px,calc(100dvh - 56px));\n    background:var(--bg); border:1px solid #262626; border-radius:24px;\n    overflow:hidden; display:flex; flex-direction:column;\n  }\n  @media (max-width:430px){ .phone{border:none;border-radius:0;height:100dvh} body{padding:0} .caption{display:none} }\n\n  /* ---------- app header ---------- */\n  .app-header{\n    flex:0 0 auto; display:flex; align-items:center; justify-content:flex-start;\n    gap:10px; padding:14px 16px 10px;\n  }\n  .back-btn{\n    width:34px;height:34px;border-radius:50%;border:1px solid var(--border);\n    background:var(--surface);color:var(--muted);display:flex;align-items:center;justify-content:center;\n    cursor:pointer;flex:0 0 auto;transition:opacity .2s,border-color .2s;\n  }\n  .back-btn:hover:not(:disabled){border-color:#565656;color:var(--text)}\n  .back-btn:disabled{opacity:.22;cursor:default}\n  .logo{display:flex;align-items:center;gap:8px;font-size:15px;color:var(--muted);letter-spacing:.2px}\n  .logo img{height:26px;width:auto;display:block}\n  .logo b{color:var(--text);font-weight:600}\n  .logo .accent{color:var(--teal)}\n\n  /* ---------- stage & slides ---------- */\n  .stage{position:relative;flex:1 1 auto;min-height:0}\n  .slide{\n    position:absolute;inset:0;display:flex;flex-direction:column;\n    padding:4px 20px 0;opacity:0;pointer-events:none;\n    transform:translateX(28px);transition:opacity .34s ease,transform .34s ease;\n    overflow-y:auto;scrollbar-width:none;\n  }\n  .slide::-webkit-scrollbar{display:none}\n  .slide.active{opacity:1;pointer-events:auto;transform:translateX(0)}\n  .slide.before{transform:translateX(-28px)}\n  @media (prefers-reduced-motion:reduce){ .slide{transition:opacity .2s;transform:none!important} }\n\n  h1{font-size:27px;line-height:1.28;font-weight:700;letter-spacing:-.2px}\n  h1 .accent{color:var(--teal)}\n  .lead{color:var(--muted);font-size:14.5px;line-height:1.62;margin-top:12px}\n\n  /* ---------- slide 1: hero ---------- */\n  .hero{justify-content:center;text-align:center;gap:0}\n  .hero .mascot{width:150px;margin:0 auto 18px;display:block}\n  .hero h1{font-size:30px}\n  .hero .lead{margin-top:14px}\n  .trust{margin-top:18px;color:#8a8a8a;font-size:12.5px;letter-spacing:.2px}\n  .trust .sep{color:#3f3f3f;padding:0 7px}\n\n  /* ---------- slide 2: telegram demo ---------- */\n  .demo{padding:4px 14px 0}\n  .chat-card{\n    flex:1 1 auto;min-height:0;display:flex;flex-direction:column;\n    border-radius:18px;overflow:hidden;border:1px solid #232d40;\n    background:var(--tg-bg) url(\"data:image/svg+xml,__DOODLES__\") repeat;\n    background-size:260px 260px;\n  }\n  .tg-header{\n    flex:0 0 auto;display:flex;align-items:center;gap:10px;\n    padding:9px 12px;background:var(--tg-header);direction:ltr;\n  }\n  .tg-header .tg-back{color:#aebadc;display:flex}\n  .tg-avatar{width:34px;height:34px;border-radius:50%;overflow:hidden;background:#0e1420;flex:0 0 auto}\n  .tg-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n  .tg-title{flex:1 1 auto;min-width:0;direction:rtl;text-align:left}\n  .tg-name{font-size:14px;font-weight:600;color:#fff;line-height:1.2}\n  .tg-status{font-size:11.5px;color:#7d9bd6;line-height:1.3}\n  .tg-status.typing{color:#6fb2f2}\n  .tg-menu{color:#aebadc;display:flex}\n\n  .chat-log{\n    flex:1 1 auto;min-height:0;overflow-y:auto;padding:12px 10px 10px;\n    display:flex;flex-direction:column;gap:7px;scrollbar-width:none;scroll-behavior:smooth;\n  }\n  .chat-log::-webkit-scrollbar{display:none}\n  .msg-row{display:flex;direction:ltr;flex:0 0 auto}\n  .msg-row.bot{justify-content:flex-start}\n  .msg-row.me{justify-content:flex-end}\n  .bubble{\n    max-width:82%;padding:7px 11px 6px;border-radius:15px;\n    direction:rtl;text-align:right;font-size:13.8px;line-height:1.52;color:#f2f5fa;\n    animation:pop .22s ease;\n  }\n  @keyframes pop{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}\n  @media (prefers-reduced-motion:reduce){ .bubble{animation:none} }\n  .bot .bubble{background:var(--tg-in);border-bottom-left-radius:5px}\n  .me .bubble{background:linear-gradient(135deg,var(--tg-out-a),var(--tg-out-b));border-bottom-right-radius:5px}\n  .stamp{\n    display:flex;direction:ltr;justify-content:flex-start;align-items:center;gap:3px;\n    margin-top:3px;font-size:10.5px;color:#93a3c0;\n  }\n  .me .stamp{color:#cfe0ff}\n  .stamp svg{display:block}\n\n  .doc{display:flex;align-items:center;gap:9px;direction:rtl;margin-top:6px;margin-bottom:2px}\n  .doc-ic{width:34px;height:34px;border-radius:50%;background:#3f7be8;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n  .bot .doc-ic{background:#33415c}\n  .doc-name{font-size:12.8px;font-weight:600;color:#fff;line-height:1.3}\n  .doc-kind{font-size:10.8px;color:#9fb0d0}\n\n  .receipt-head{display:flex;align-items:center;gap:6px;color:var(--teal);font-weight:600;font-size:12.8px;margin-bottom:6px}\n  .receipt-row{display:flex;align-items:flex-start;gap:7px;font-size:12.6px;color:#cdd8ea;line-height:1.5;padding:2px 0}\n  .receipt-row svg{flex:0 0 auto;margin-top:3px}\n\n  .typing-bubble{display:flex;gap:4px;align-items:center;padding:11px 13px}\n  .typing-bubble i{width:6px;height:6px;border-radius:50%;background:#8fa3c4;animation:blink 1.1s infinite}\n  .typing-bubble i:nth-child(2){animation-delay:.18s}\n  .typing-bubble i:nth-child(3){animation-delay:.36s}\n  @keyframes blink{0%,70%,100%{opacity:.25}35%{opacity:1}}\n\n  .kb{display:flex;flex-direction:column;gap:5px;margin-top:2px;width:min(82%,300px)}\n  .msg-row.kb-row{justify-content:flex-start}\n  .kb button{\n    border:none;border-radius:9px;background:var(--tg-kb);color:#cfe0ff;\n    font-family:inherit;font-size:13px;padding:9px 12px;cursor:pointer;\n    display:flex;align-items:center;justify-content:center;gap:7px;direction:rtl;\n    transition:background .15s;\n  }\n  .kb button:hover{background:#2e3d58}\n  .kb button.done{color:#8494b3}\n  .kb button.pressed{background:#3a4d70}\n  .kb button:disabled{cursor:default}\n\n  .tg-input{\n    flex:0 0 auto;display:flex;align-items:center;gap:10px;direction:ltr;\n    padding:8px 10px;background:var(--tg-input);\n  }\n  .tg-input .fake-field{\n    flex:1 1 auto;display:flex;align-items:center;gap:9px;color:#7a8699;font-size:14px;direction:ltr;\n  }\n  .tg-mic{width:38px;height:38px;border-radius:50%;background:#3f7be8;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n  .tg-clip{color:#7a8699;display:flex}\n\n  .manifesto-line{\n    flex:0 0 auto;text-align:center;color:var(--muted);font-size:13px;line-height:1.5;\n    padding:12px 6px 2px;\n  }\n  .manifesto-line b{color:var(--text);font-weight:600}\n\n  /* ---------- slides 3-4: security / install ---------- */\n  .list-slide h1{margin-top:6px}\n  .cards{display:flex;flex-direction:column;gap:9px;margin-top:16px}\n  .card{\n    display:flex;gap:12px;align-items:flex-start;\n    background:var(--surface);border:1px solid #242424;border-radius:14px;padding:12px 13px;\n  }\n  .card.featured{border-color:#1f4a43;background:#0d1614}\n  .card .ic{\n    width:34px;height:34px;border-radius:9px;background:#132320;color:var(--teal);\n    display:flex;align-items:center;justify-content:center;flex:0 0 auto;margin-top:1px;\n  }\n  .card h3{font-size:13.8px;font-weight:600;line-height:1.35}\n  .card p{color:var(--muted);font-size:12.6px;line-height:1.55;margin-top:3px}\n  .soul{color:#7d7d7d;font-size:12px;line-height:1.6;text-align:center;margin-top:14px;padding-bottom:8px}\n\n  .steps{display:flex;flex-direction:column;gap:0;margin-top:16px}\n  .step{display:flex;gap:13px;position:relative;padding-bottom:16px}\n  .step:not(:last-child)::before{\n    content:\"\";position:absolute;right:15px;top:34px;bottom:2px;width:1px;background:#2a2a2a;\n  }\n  .step-num{\n    width:31px;height:31px;border-radius:50%;background:var(--surface2);border:1px solid var(--border);\n    color:var(--teal);font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;\n    flex:0 0 auto;position:relative;z-index:1;\n  }\n  .step h3{font-size:14.2px;font-weight:600;line-height:1.4;padding-top:5px}\n  .step p{color:var(--muted);font-size:12.8px;line-height:1.6;margin-top:4px}\n  .dl-row{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}\n  .dl-row a{\n    text-decoration:none;color:var(--text);font-size:12.5px;\n    border:1px solid var(--border);background:var(--surface);border-radius:9px;padding:7px 12px;\n    transition:border-color .15s;\n  }\n  .dl-row a:hover{border-color:var(--teal)}\n  .footnote{color:#7d7d7d;font-size:12px;text-align:center;margin-top:6px;padding-bottom:8px}\n\n  /* ---------- slide 5: signup ---------- */\n  .bridge{\n    background:#0d1614;border:1px solid #1f4a43;border-radius:14px;\n    padding:13px 14px;margin-top:16px;\n  }\n  .bridge h3{font-size:13.5px;font-weight:600;color:var(--teal)}\n  .bridge-row{display:flex;gap:8px;align-items:flex-start;margin-top:8px;font-size:13px;color:#d6d6d6;line-height:1.5}\n  .bridge-row svg{flex:0 0 auto;margin-top:3px}\n  .bridge .link-line{color:#8a8a8a;font-size:12px;line-height:1.55;margin-top:10px}\n\n  form{display:flex;flex-direction:column;gap:11px;margin-top:16px;padding-bottom:8px}\n  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}\n  .field input{\n    width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;\n    color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;outline:none;\n    transition:border-color .15s;\n  }\n  .field input:focus{border-color:var(--teal)}\n  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n  .field.invalid input{border-color:var(--orange)}\n  .field.invalid .err{display:block}\n  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n  .consent input{width:16px;height:16px;accent-color:var(--action);margin-top:1px;flex:0 0 auto}\n  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n  .consent.invalid{color:var(--orange)}\n\n  /* ---------- slide 6: done ---------- */\n  .done{justify-content:center;text-align:center}\n  .done-avatar{\n    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n    border:2px solid #1f4a43;background:#0d1614;\n  }\n  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n  .done h1{font-size:26px}\n  .done .lead{max-width:300px;margin-inline:auto}\n  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n\n  /* ---------- bottom zone ---------- */\n  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n  .dots{display:flex;justify-content:center;gap:7px}\n  .dots button{\n    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n    transition:background .2s,width .2s;\n  }\n  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n  .cta{\n    width:100%;border:none;border-radius:12px;background:var(--action);color:#fff;\n    font-family:inherit;font-size:15.5px;font-weight:600;padding:14px;cursor:pointer;\n    transition:filter .15s;\n  }\n  .cta:hover{filter:brightness(1.12)}\n  .cta:disabled{opacity:.6;cursor:default}\n  .swipe-hint{\n    display:none;justify-content:center;align-items:center;gap:6px;\n    color:#8a8a8a;font-size:12.5px;\n  }\n  .swipe-hint svg{animation:nudge 1.6s ease-in-out infinite}\n  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n  @media (max-height:700px){\n    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n  }\n</style>\n</head>\n<body>\n\n<div class=\"phone\" id=\"phone\">\n  <div class=\"app-header\">\n    <button class=\"back-btn\" id=\"backBtn\" aria-label=\"חזרה\" disabled>\n      <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n    </button>\n    <div class=\"logo\"><img src=\"__BODY__\" alt=\"מאסקוט Shellano\"><span>Nano<b>Shellano</b></span></div>\n  </div>\n\n  <div class=\"stage\" id=\"stage\">\n\n    <!-- 1 · hero -->\n    <section class=\"slide hero active\">\n      <div>\n        <img class=\"mascot\" src=\"__BODY__\" alt=\"\">\n        <h1>התקבל עובד חדש<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span></h1>\n        <p class=\"lead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי שתהיה לפני כולם.</p>\n        <div class=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n      </div>\n    </section>\n\n    <!-- 2 · telegram demo -->\n    <section class=\"slide demo before\">\n      <div class=\"chat-card\" id=\"chatCard\">\n        <div class=\"tg-header\">\n          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n          <div class=\"tg-avatar\"><img src=\"__FACE__\" alt=\"\"></div>\n          <div class=\"tg-title\">\n            <div class=\"tg-name\">הסוכן שלך</div>\n            <div class=\"tg-status\" id=\"tgStatus\">online</div>\n          </div>\n          <span class=\"tg-menu\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\"/><circle cx=\"12\" cy=\"19\" r=\"1.7\"/></svg></span>\n        </div>\n        <div class=\"chat-log\" id=\"chatLog\"></div>\n        <div class=\"tg-input\">\n          <div class=\"fake-field\">\n            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n            <span>Message</span>\n          </div>\n          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n        </div>\n      </div>\n      <p class=\"manifesto-line\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n    </section>\n\n    <!-- 3 · security -->\n    <section class=\"slide list-slide before\">\n      <h1>מאובטח, ורק שלך.</h1>\n      <p class=\"lead\">לפני שמכניסים סוכן לחיים שלך מגיע לך לדעת מה קורה עם המידע. הנה ההבטחה בחמש נקודות.</p>\n      <div class=\"cards\">\n        <div class=\"card featured\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n          <div><h3>סוכן מבודד, על שרת משלך</h3><p>רץ על שרת NanoClaw מבודד ששייך רק לך, בלי גישה חיצונית או ערבוב מידע עם אף אחד.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n          <div><h3>בטלגרם, ערוץ סגור ומוצפן</h3><p>ערוץ התקשורת היחיד שלך והמאובטח ביותר, נפרד לגמרי מהמייל ומהדרייב.</p></div>\n        </div>\n        <div class=\"card\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n          <div><h3>לא מתחבר למערכות אישיות</h3><p>מייל דרייב וחשבונות פרטיים חסומים לו בהגדרות, וזאת בחירה ולא מגבלה זמנית.</p>