:auto; display:block; filter:drop-shadow(0 4px 14px rgba(0,0,0,.7))}\n  .lang{position:fixed; top:28px; inset-inline-end:44px; z-index:6; font-size:12px; font-weight:800; color:var(--teal);\n    background:rgba(10,14,13,.6); border:1px solid var(--line); border-radius:99px; padding:8px 15px;\n    letter-spacing:.4px; cursor:pointer; backdrop-filter:blur(6px)}\n\n  /* vertical chapter rail (start side) */\n  .rail{position:fixed; inset-inline-start:44px; top:50%; transform:translateY(-50%); z-index:6;\n    display:flex; flex-direction:column; gap:22px}\n  .dot{display:flex; align-items:center; gap:12px; cursor:pointer}\n  .dot i{width:8px; height:8px; border-radius:50%; background:#2a3331; transition:.35s; flex:0 0 auto}\n  .dot span{font-size:11.5px; font-weight:700; color:var(--dim); opacity:0; transform:translateX(6px); transition:.35s; white-space:nowrap}\n  .dot:hover span{opacity:.8; transform:none}\n  .dot.on i{background:var(--teal); box-shadow:0 0 14px rgba(86,237,214,.8); transform:scale(1.5)}\n  .dot.on span{opacity:1; transform:none; color:var(--teal)}\n  .railline{position:fixed; inset-inline-start:47px; top:50%; transform:translateY(-50%); width:1px; height:190px;\n    background:linear-gradient(transparent,#1d2523 20%,#1d2523 80%,transparent); z-index:5}\n\n  /* chapter text overlays */\n  .chapter{position:fixed; z-index:5; max-width:600px; inset-inline-end:9vw; top:50%; transform:translateY(-50%);\n    opacity:0; pointer-events:none; transition:opacity .5s ease, transform .5s ease; text-align:start}\n  .chapter.on{opacity:1; pointer-events:auto; transform:translateY(-50%)}\n  .chapter.leave{opacity:0; transform:translateY(calc(-50% - 26px))}\n  .chapter.enter-prep{opacity:0; transform:translateY(calc(-50% + 26px))}\n  .kick{font-size:13px; font-weight:800; letter-spacing:.22em; color:var(--teal); text-transform:uppercase; margin-bottom:18px;\n    display:flex; align-items:center; gap:12px}\n  .kick::after{content:''; height:1px; width:56px; background:var(--teal-deep)}\n  h1{font-size:64px; line-height:1.08; font-weight:900; margin-bottom:22px; letter-spacing:-.01em;\n    text-shadow:0 6px 40px rgba(0,0,0,.9)}\n  h1 .hl{color:var(--teal)}\n  .sub{color:var(--mut); font-size:17.5px; line-height:1.85; max-width:520px; margin-bottom:30px; text-shadow:0 3px 20px #000}\n  .sub b{color:var(--ink)}\n  .byline{color:var(--dim); font-size:12.5px; font-weight:700; margin-top:18px}\n\n  .cta{display:inline-flex; align-items:center; gap:12px; padding:17px 32px; border:0; border-radius:99px;\n    background:var(--teal); color:var(--on-teal); font-size:16.5px; font-weight:800; font-family:inherit; cursor:pointer;\n    box-shadow:0 0 0 0 rgba(86,237,214,.45); transition:.25s; position:relative}\n  .cta:hover{transform:translateY(-2px); box-shadow:0 14px 44px rgba(86,237,214,.3)}\n  .cta .arr{display:inline-block; transition:.25s}\n  .cta:hover .arr{transform:translateX(-5px)}\n  .ctanote{color:var(--dim); font-size:12px; margin-top:16px}\n\n  /* final chapter: glass form */\n  #ch5 .glass{margin-top:6px; width:430px; background:rgba(10,15,14,.55); border:1px solid rgba(86,237,214,.16);\n    border-radius:22px; padding:26px 26px 24px; backdrop-filter:blur(14px);\n    box-shadow:0 30px 80px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.05)}\n  #ch5 h1{font-size:44px}\n  label{display:block; font-size:12.5px; color:var(--mut); font-weight:700; margin:12px 2px 6px}\n  .inp{width:100%; background:rgba(0,0,0,.45); border:1px solid #223230; border-radius:12px;\n    padding:13px 14px; color:var(--ink); font-size:15px; font-family:inherit}\n  .inp:focus{outline:none; border-color:var(--teal-deep)}\n  .check{display:flex; gap:10px; align-items:flex-start; margin-top:14px; font-size:12px; color:var(--mut); line-height:1.55}\n  .box{flex:0 0 20px; width:20px; height:20px; border-radius:6px; border:1px solid #2a3a38; background:rgba(0,0,0,.4); margin-top:1px}\n  .check a{color:var(--teal); text-decoration:underline}\n  #ch5 .cta{width:100%; justify-content:center; margin-top:18px; border-radius:14px}\n\n  /* bottom hint */\n  .hint{position:fixed; bottom:24px; left:50%; transform:translateX(-50%); z-index:6;\n    font-size:11.5px; color:var(--dim); letter-spacing:.06em; display:flex; align-items:center; gap:10px}\n  .hint .wheel{width:18px; height:28px; border:1.5px solid #3a4442; border-radius:10px; position:relative}\n  .hint .wheel::after{content:''; position:absolute; top:5px; left:50%; margin-left:-1.5px; width:3px; height:6px;\n    border-radius:3px; background:var(--teal); animation:wheeldrop 1.6s ease-in-out infinite}\n  @keyframes wheeldrop{0%{transform:translateY(0); opacity:1} 70%{transform:translateY(9px); opacity:0} 100%{opacity:0}}\n</style>\n</head>\n<body>\n\n<canvas id=\"field\"></canvas>\n<div class=\"vignette\"></div>\n<div class=\"grain\"></div>\n\n<div class=\"brand\"><img src=\"https://nanohubdemo.vercel.app/nanoshellano-lockup-trim.png\" alt=\"NanoShellano\"></div>\n<div class=\"lang\">EN</div>\n\n<div class=\"railline\"></div>\n<div class=\"rail\" id=\"rail\"></div>\n\n<!-- chapters -->\n<section class=\"chapter\" id=\"ch0\">\n  <div class=\"kick\">NanoShellano</div>\n  <h1>עולם העבודה משתנה.<br><span class=\"hl\">כבר עכשיו.</span></h1>\n  <p class=\"sub\">בכל חודש שעובר, סוכני AI נכנסים לעוד מחלקה ולעוד שולחן עבודה. מי שיודע לעבוד עם סוכן יהיה <b>צעד אחד לפני כולם</b>. בלי רקע טכני, בלי קוד.</p>\n  <button class=\"cta\" onclick=\"goTo(1)\">אני רוצה להיכנס לעולם הזה <span class=\"arr\">←</span></button>\n  <p class=\"ctanote\">פיילוט בגישה מוזמנת · גרסה ראשונה</p>\n  <p class=\"byline\">מאת אליה בן כנען</p>\n</section>\n\n<section class=\"chapter\" id=\"ch1\">\n  <div class=\"kick\">למה בחינם</div>\n  <h1>ולמה אני נותן<br>את זה <span class=\"hl\">בחינם</span></h1>\n  <p class=\"sub\">לפני שנה לא ידעתי לכתוב שורת קוד אחת. היום סוכנים עושים בשבילי חצי מהעבודה. במקום לשמור את זה לעצמי, בניתי דרך פשוטה שתעביר גם אותך לצד השני. <b>בלי כרטיס אשראי, בלי התחייבות, בלי קאץ'.</b></p>\n  <button class=\"cta\" onclick=\"goTo(2)\">יפה, ומה עם הפרטיות? <span class=\"arr\">←</span></button>\n</section>\n\n<section class=\"chapter\" id=\"ch2\">\n  <div class=\"kick\">מאובטח</div>\n  <h1>מאובטח,<br><span class=\"hl\">ורק שלך</span></h1>\n  <p class=\"sub\">הסוכן חי בחשבון נפרד ומבודד שמיוחד רק לך. <b>אתה מאשר כל חיבור בעצמך</b>, מנתק ומוחק בכל רגע, והמידע שלך לא נמכר ולא משותף. זו לא הבטחה, זו שליטה אמיתית בידיים שלך.</p>\n  <button class=\"cta\" onclick=\"goTo(3)\">הבנתי, איך זה הולך להיות? <span class=\"arr\">←</span></button>\n</section>\n\n<section class=\"chapter\" id=\"ch3\">\n  <div class=\"kick\">הדרך</div>\n  <h1>חמישה צעדים,<br><span class=\"hl\">כמה דקות</span></h1>\n  <p class=\"sub\">פותחים לך משתמש, מוקם סוכן אישי על שרת מנוהל, קוד אישי נוחת בטלגרם, נכנסים לשיחה, <b>ומחברים כלים בקצב שלך</b>. מייל, יומן, וואטסאפ. הכל בלחיצה, הכל בשליטתך.</p>\n  <button class=\"cta\" onclick=\"goTo(4)\">ומה הוא בעצם עושה? <span class=\"arr\">←</span></button>\n</section>\n\n<section class=\"chapter\" id=\"ch4\">\n  <div class=\"kick\">ככה נעבוד יחד</div>\n  <h1>בקשה אחת,<br><span class=\"hl\">שרשרת פעולות</span></h1>\n  <p class=\"sub\">\"עדכן את הלקוח ב-CRM, תכין הצעת מחיר ותשלח לו במייל\". הסוכן מעדכן, מכין, מנסח, <b>וחוזר אליך עם תוצר גמור</b> שמחכה רק לאישור שלך. מצגות, דוחות, מיילים, אונבורדינג.</p>\n  <button class=\"cta\" onclick=\"goTo(5)\">אז איך מתחילים? <span class=\"arr\">←</span></button>\n</section>\n\n<section class=\"chapter\" id=\"ch5\">\n  <div class=\"kick\">התקנה</div>\n  <h1>ההתקנה,<br><span class=\"hl\">ומשם הקסם</span></h1>\n  <div class=\"glass\">\n    <label>שם מלא</label>\n    <input class=\"inp\" placeholder=\"איך קוראים לך\">\n    <label>טלפון</label>\n    <input class=\"inp\" placeholder=\"050-0000000\">\n    <label>מייל</label>\n    <input class=\"inp\" placeholder=\"you@example.com\">\n    <div class=\"check\"><div class=\"box\"></div><div>קראתי ומאשר את <a>תנאי השימוש והפרטיות</a>. האישור הזה פותח את הסוכן.</div></div>\n    <button class=\"cta\">פתח לי סוכן <span class=\"arr\">←</span></button>\n  </div>\n</section>\n\n<div class=\"hint\"><div class=\"wheel\"></div> גלגלת, חצים או לחיצה על הנקודות</div>\n\n<script>\n'use strict';\n/* ---------- config ---------- */\nconst CHAPTERS = ['פתיחה','בחינם','אבטחה','הדרך','יכולות','הרשמה'];\nconst P_COUNT = 2300;\nconst SHAPE_X = 0.34;   // shape center as fraction of width (visual side; text sits on the start side in RTL)\nconst SHAPE_Y = 0.52;\nconst SHAPE_MAX = 0.62; // of min(vw,vh)\n\nlet W=0, H=0, dpr=1, cur=0, busy=false;\nconst cv = document.getElementById('field');\nconst cx = cv.getContext('2d');\n\n/* glow sprite */\nconst sprite = document.createElement('canvas');\nsprite.width = sprite.height = 64;\n{\n  const s = sprite.getContext('2d');\n  const g = s.createRadialGradient(32,32,0,32,32,32);\n  g.addColorStop(0,'rgba(255,255,255,1)');\n  g.addColorStop(.25,'rgba(140,255,236,.9)');\n  g.addColorStop(.6,'rgba(86,237,214,.28)');\n  g.addColorStop(1,'rgba(86,237,214,0)');\n  s.fillStyle=g; s.fillRect(0,0,64,64);\n}\n\n/* ---------- particles ---------- */\nconst P = [];\nfunction initParticles(){\n  for(let k=0;k<P_COUNT;k++){\n    P.push({\n      x: Math.random()*W, y: Math.random()*H,\n      vx:0, vy:0,\n      tx: Math.random()*W, ty: Math.random()*H,\n      sz: .7+Math.random()*2.3,\n      am: Math.random()*Math.PI*2,          // wander phase\n      sp: .4+Math.random()*1.1,             // wander speed\n      free: true                            // ambient (no shape slot)\n    });\n  }\n}\n\nfunction resize(){\n  dpr = Math.min(window.devicePixelRatio||1, 2);\n  W = window.innerWidth; H = window.innerHeight;\n  cv.width = W*dpr; cv.height = H*dpr;\n  cx.setTransform(dpr,0,0,dpr,0,0);\n}\nwindow.addEventListener('resize', ()=>{ resize(); setShape(cur); });\n\n/* ---------- shape sampling ---------- */\nconst off = document.createElement('canvas');\noff.width = 900; off.height = 760;\nconst oc = off.getContext('2d', {willReadFrequently:true});\n\nfunction samplePoints(draw){\n  oc.clearRect(0,0,off.width,off.height);\n  oc.fillStyle = oc.strokeStyle = '#fff';\n  draw(oc);\n  const img = oc.getImageData(0,0,off.width,off.height).data;\n  const pts=[]; const step=4;\n  for(let y=0;y<off.height;y+=step)\n    for(let x=0;x<off.width;x+=step)\n      if(img[(y*off.width+x)*4+3]>120) pts.push([x,y]);\n  return pts;\n}\n\n/* shape painters (drawn at ~900x760, auto-fit later) */\nconst mascotImg = new Image();\nmascotImg.crossOrigin = 'anonymous';\nlet mascotReady = false;\nmascotImg.onload = ()=>{ mascotReady=true; if(cur===0) setShape(0); };\nmascotImg.onerror = ()=>{ mascotReady=false; };\nmascotImg.src = 'https://nanohubdemo.vercel.app/nanoshellano-mascot.png';\n\nfunction drawRocketFallback(c){\n  c.save(); c.translate(450,380);\n  c.beginPath();                             // body\n  c.moveTo(0,-280); c.quadraticCurveTo(130,-130,130,60);\n  c.lineTo(130,140); c.lineTo(-130,140); c.lineTo(-130,60);\n  c.quadraticCurveTo(-130,-130,0,-280); c.fill();\n  c.globalCompositeOperation='destination-out';\n  c.beginPath(); c.arc(0,-60,62,0,7); c.fill(); // window hole\n  c.globalCompositeOperation='source-over';\n  c.beginPath(); c.moveTo(-130,20); c.lineTo(-230,190); c.lineTo(-130,140); c.fill();  // fins\n  c.beginPath(); c.moveTo(130,20); c.lineTo(230,190); c.lineTo(130,140); c.fill();\n  c.beginPath(); c.moveTo(-60,150); c.quadraticCurveTo(0,320,60,150); c.fill();        // flame\n  c.restore();\n}\nconst SHAPES = [\n  // 0: the mascot itself\n  (c)=>{ if(mascotReady){ c.drawImage(mascotImg,120,50,660,660); } else drawRocketFallback(c); },\n  // 1: the word\n  (c)=>{ c.font='900 240px Heebo,sans-serif'; c.textAlign='center'; c.textBaseline='middle'; c.fillText('בחינם',450,380); },\n  // 2: shield with keyhole\n  (c)=>{\n    c.save(); c.translate(450,380); c.lineWidth=30; c.lineJoin='round';\n    c.beginPath();\n    c.moveTo(0,-270); c.quadraticCurveTo(170,-200,240,-210);\n    c.quadraticCurveTo(250,60,0,270);\n    c.quadraticCurveTo(-250,60,-240,-210);\n    c.quadraticCurveTo(-170,-200,0,-270);\n    c.closePath(); c.stroke();\n    c.beginPath(); c.arc(0,-50,52,0,7); c.fill();\n    c.beginPath(); c.moveTo(-26,-30); c.lineTo(-18,96); c.lineTo(18,96); c.lineTo(26,-30); c.fill();\n    c.restore();\n  },\n  // 3: five nodes on a rising path\n  (c)=>{\n    c.save(); c.translate(450,380); c.lineWidth=16;\n    const pts=[[-330,220],[-165,90],[0,160],[165,-40],[330,-200]];\n    c.beginPath(); c.moveTo(pts[0][0],pts[0][1]);\n    for(let k=1;k<pts.length;k++){\n      const a=pts[k-1], b=pts[k];\n      c.quadraticCurveTo((a[0]+b[0])/2, a[1], (a[0]+b[0])/2, (a[1]+b[1])/2);\n      c.quadraticCurveTo((a[0]+b[0])/2, b[1], b[0], b[1]);\n    }\n    c.stroke();\n    pts.forEach((p,k)=>{ c.beginPath(); c.arc(p[0],p[1], k===4?58:42, 0,7); c.fill(); });\n    c.restore();\n  },\n  // 4: chat bubble with three dots\n  (c)=>{\n    c.save(); c.translate(450,360); c.lineWidth=30; c.lineJoin='round';\n    const r=70,w=560,h=380,x=-w/2,y=-h/2;\n    c.beginPath();\n    c.moveTo(x+r,y); c.lineTo(x+w-r,y); c.quadraticCurveTo(x+w,y,x+w,y+r);\n    c.lineTo(x+w,y+h-r); c.quadraticCurveTo(x+w,y+h,x+w-r,y+h);\n    c.lineTo(x+160,y+h); c.lineTo(x+70,y+h+110); c.lineTo(x+95,y+h);\n    c.lineTo(x+r,y+h); c.quadraticCurveTo(x,y+h,x,y+h-r);\n    c.lineTo(x,y+r); c.quadraticCurveTo(x,y,x+r,y);\n    c.closePath(); c.stroke();\n    [-120,0,120].forEach(dx=>{ c.beginPath(); c.arc(dx,0,40,0,7); c.fill(); });\n    c.restore();\n  },\n  // 5: paper plane\n  (c)=>{\n    c.save(); c.translate(450,380);\n    c.beginPath(); c.moveTo(330,-210); c.lineTo(-330,40); c.lineTo(-140,120); c.lineTo(330,-210); c.fill();\n    c.beginPath(); c.moveTo(330,-210); c.lineTo(-100,150); c.lineTo(-60,290); c.lineTo(30,140); c.lineTo(330,-210); c.fill();\n    c.globalCompositeOperation='destination-out';\n    c.beginPath(); c.moveTo(330,-210); c.lineTo(-120,130); c.lineTo(-104,138); c.closePath(); c.fill();\n    c.restore();\n  }\n];\n\nfunction setShape(idx){\n  const pts = samplePoints(SHAPES[idx]);\n  if(!pts.length) return;\n  // fit into target box\n  let minX=1e9,minY=1e9,maxX=-1e9,maxY=-1e9;\n  pts.forEach(p=>{ if(p[0]<minX)minX=p[0]; if(p[0]>maxX)maxX=p[0]; if(p[1]<minY)minY=p[1]; if(p[1]>maxY)maxY=p[1]; });\n  const bw=maxX-minX||1, bh=maxY-minY||1;\n  const box = Math.min(W,H)*SHAPE_MAX;\n  const sc = Math.min(box/bw, box/bh);\n  const cxp = W*SHAPE_X, cyp = H*SHAPE_Y;\n  // shuffle particle order for organic morphs\n  const order = P.map((_,k)=>k);\n  for(let k=order.length-1;k>0;k--){ const j=(k*2654435761)%(k+1); const t=order[k]; order[k]=order[j]; order[j]=t; }\n  const nShape = Math.min(P_COUNT, pts.length);\n  const stride = pts.length/nShape;\n  for(let k=0;k<P_COUNT;k++){\n    const p = P[order[k]];\n    if(k<nShape){\n      const q = pts[Math.floor(k*stride)];\n      p.tx = cxp + (q[0]-(minX+bw/2))*sc;\n      p.ty = cyp + (q[1]-(minY+bh/2))*sc;\n      p.free = false;\n    }else{\n      p.tx = Math.random()*W; p.ty = Math.random()*H;\n      p.free = true;\n    }\n  }\n}\n\n/* ---------- animation loop ---------- */\nconst mouse = {x:-9999, y:-9999};\nwindow.addEventListener('mousemove', e=>{ mouse.x=e.clientX; mouse.y=e.clientY; });\nlet t=0;\nfunction tick(){\n  t+=0.016;\n  cx.clearRect(0,0,W,H);\n  cx.globalCompositeOperation='lighter';\n  for(let k=0;k<P_COUNT;k++){\n    const p=P[k];\n    const wob = p.free ? 14 : 3.2;\n    const gx = p.tx + Math.cos(t*p.sp+p.am)*wob;\n    const gy = p.ty + Math.sin(t*p.sp*1.3+p.am)*wob;\n    p.vx += (gx-p.x)*0.014; p.vy += (gy-p.y)*0.014;\n    // mouse repulsion\n    const dx=p.x-mouse.x, dy=p.y-mouse.y, d2=dx*dx+dy*dy;\n    if(d2<12100){ const d=Math.sqrt(d2)||1, f=(110-d)/110*1.6; p.vx+=dx/d*f; p.vy+=dy/d*f; }\n    p.vx*=0.90; p.vy*=0.90;\n    p.x+=p.vx; p.y+=p.vy;\n    const a = p.free ? 0.16 : 0.85;\n    const s = p.sz*(p.free?4:6);\n    cx.globalAlpha = a;\n    cx.drawImage(sprite, p.x-s/2, p.y-s/2, s, s);\n  }\n  cx.globalAlpha=1; cx.globalCompositeOperation='source-over';\n  requestAnimationFrame(tick);\n}\n\n/* ---------- chapter navigation ---------- */\nconst rail = document.getElementById('rail');\nCHAPTERS.forEach((nm,k)=>{\n  const d=document.createElement('div');\n  d.className='dot'+(k===0?' on':'');\n  d.innerHTML='<i></i><span>'+nm+'</span>';\n  d.onclick=()=>goTo(k);\n  rail.appendChild(d);\n});\nfunction paintRail(){ [...rail.children].forEach((d,k)=>d.classList.toggle('on',k===cur)); }\n\nfunction goTo(n){\n  if(n===cur || n<0 || n>=CHAPTERS.length || busy) return;\n  busy=true;\n  const oldEl=document.getElementById('ch'+cur), newEl=document.getElementById('ch'+n);\n  oldEl.classList.add('leave'); oldEl.classList.remove('on');\n  cur=n; paintRail(); setShape(cur);\n  newEl.classList.add('enter-prep');\n  setTimeout(()=>{\n    oldEl.classList.remove('leave');\n    newEl.classList.remove('enter-prep'); newEl.classList.add('on');\n    setTimeout(()=>{ busy=false; }, 420);\n  }, 300);\n}\n\nlet wheelLock=0;\nwindow.addEventListener('wheel', e=>{\n  const now=Date.now();\n  if(now-wheelLock<900 || Math.abs(e.deltaY)<12) return;\n  wheelLock=now;\n  goTo(cur+(e.deltaY>0?1:-1));\n},{passive:true});\nwindow.addEventListener('keydown', e=>{\n  if(e.key==='ArrowDown'||e.key==='ArrowLeft'||e.key==='PageDown'||e.key===' ') goTo(cur+1);\n  if(e.key==='ArrowUp'||e.key==='ArrowRight'||e.key==='PageUp') goTo(cur-1);\n});\n\n/* ---------- boot ---------- */\nresize();\ninitParticles();\nsetShape(0);\ndocument.getElementById('ch0').classList.add('on');\ntick();\n</script>\n</body>\n</html>\n"},"caller":{"type":"direct"}}],"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":156,"cache_read_input_tokens":105898,"output_tokens":12148,"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":156,"ephemeral_5m_input_tokens":0},"inference_geo":"not_a