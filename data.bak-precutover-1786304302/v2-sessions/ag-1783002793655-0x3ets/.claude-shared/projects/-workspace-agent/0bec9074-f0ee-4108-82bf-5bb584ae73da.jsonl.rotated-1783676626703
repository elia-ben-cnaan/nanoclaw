ottom:8px}\n257\t  .name-row{display:flex;gap:10px}\n258\t  .name-row .field{flex:1 1 0;min-width:0}\n259\t  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}\n260\t  .field input{\n261\t    width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;\n262\t    color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;outline:none;\n263\t    transition:border-color .15s;\n264\t  }\n265\t  .field input:focus{border-color:var(--teal)}\n266\t  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n267\t  .field.invalid input{border-color:var(--orange)}\n268\t  .field.invalid .err{display:block}\n269\t  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n270\t  .consent input{width:16px;height:16px;accent-color:var(--teal);margin-top:1px;flex:0 0 auto}\n271\t  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n272\t  .consent.invalid{color:var(--orange)}\n273\t\n274\t  /* ---------- slide 6: done ---------- */\n275\t  .done{justify-content:center;text-align:center}\n276\t  .done-avatar{\n277\t    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n278\t    border:2px solid var(--teal-line);background:#0d1614;\n279\t  }\n280\t  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n281\t  .done h1{font-size:26px}\n282\t  .done .lead{max-width:300px;margin-inline:auto}\n283\t  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n284\t  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n285\t\n286\t  /* ---------- bottom zone ---------- */\n287\t  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n288\t  .nav-row{display:flex;align-items:center;justify-content:space-between;gap:10px}\n289\t  html[dir=\"ltr\"] .nav-row .nav-arr svg{transform:scaleX(-1)}\n290\t  .dots{display:flex;justify-content:center;gap:7px;flex:1 1 auto}\n291\t  .dots button{\n292\t    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n293\t    transition:background .2s,width .2s;\n294\t  }\n295\t  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n296\t  .cta{\n297\t    width:100%;border:none;border-radius:12px;background:var(--teal);color:#04211C;\n298\t    font-family:inherit;font-size:15.5px;font-weight:700;padding:14px;cursor:pointer;\n299\t    transition:filter .15s;\n300\t  }\n301\t  .cta:hover{filter:brightness(1.07)}\n302\t  .cta:disabled{opacity:.6;cursor:default}\n303\t  /* fixed-height sub-line keeps the bottom zone identical on every screen */\n304\t  .cta-sub{height:17px;display:flex;align-items:center;justify-content:center}\n305\t  .swipe-hint{\n306\t    display:none;justify-content:center;align-items:center;gap:6px;\n307\t    color:#8a8a8a;font-size:12.5px;\n308\t  }\n309\t  .swipe-hint svg{color:var(--teal);animation:nudge 1.6s ease-in-out infinite}\n310\t  html[dir=\"ltr\"] .swipe-hint svg{transform:scaleX(-1)}\n311\t  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n312\t  html[dir=\"ltr\"] .swipe-hint svg{animation:nudgeLtr 1.6s ease-in-out infinite}\n313\t  @keyframes nudgeLtr{0%,100%{transform:scaleX(-1) translateX(0)}50%{transform:scaleX(-1) translateX(-5px)}}\n314\t  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n315\t  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n316\t  @media (max-height:700px){\n317\t    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n318\t    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n319\t  }\n320\t</style>\n321\t</head>\n322\t<body>\n323\t\n324\t<div class=\"phone\" id=\"phone\">\n325\t  <div class=\"app-header\">\n326\t    <img class=\"logo-icon\" src=\"nanoshellano-mascot.png\" alt=\"NanoShellano\">\n327\t    <div class=\"header-side\">\n328\t      <div class=\"lang-toggle\" id=\"langToggle\" role=\"group\" aria-label=\"Language\">\n329\t        <button data-lang=\"he\" class=\"on\">HB</button><span class=\"lt-sep\">|</span><button data-lang=\"en\">EN</button>\n330\t      </div>\n331\t    </div>\n332\t  </div>\n333\t\n334\t  <div class=\"stage\" id=\"stage\">\n335\t\n336\t    <!-- 1 · hero -->\n337\t    <section class=\"slide hero active\">\n338\t      <div>\n339\t        <img class=\"mascot\" src=\"data:image/png;base64,STRIPPED\" alt=\"\">\n340\t        <h1 data-i18n-html=\"heroH1\">התקבל עובד חדש<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span></h1>\n341\t        <p class=\"lead\" data-i18n=\"heroLead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי להיות לפני כולם.</p>\n342\t        <div class=\"trust\" data-i18n-html=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n343\t      </div>\n344\t    </section>\n345\t\n346\t    <!-- 2 · telegram demo (auto simulation, no interaction) -->\n347\t    <section class=\"slide demo before\">\n348\t      <h1 class=\"demo-h1\" data-i18n-html=\"demoH1\">כך נראה יום עבודה עם <span class=\"accent\">הסוכן שלך</span></h1>\n349\t      <p class=\"lead demo-lead\" data-i18n=\"demoLead\">4 דוגמאות למשימות שגרתיות שהסוכן יודע לעשות כשהוא מחובר למערכות הארגון.</p>\n350\t      <p class=\"demo-note\" data-i18n=\"demoNote\">הדגמה להמחשה בלבד. החיבור למערכות עדיין לא פעיל.</p>\n351\t      <div class=\"chat-card\" id=\"chatCard\">\n352\t        <div class=\"tg-header\">\n353\t          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n354\t          <div class=\"tg-avatar\"><img src=\"data:image/png;base64,STRIPPED\" alt=\"\"></div>\n355\t          <div class=\"tg-title\">\n356\t            <div class=\"tg-name\" id=\"tgName\">ג'וני</div>\n357\t            <div class=\"tg-status\" id=\"tgStatus\">online</div>\n358\t          </div>\n359\t          <span class=\"tg-menu\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\"/><circle cx=\"12\" cy=\"19\" r=\"1.7\"/></svg></span>\n360\t        </div>\n361\t        <div class=\"chat-log\" id=\"chatLog\"></div>\n362\t        <div class=\"tg-input\">\n363\t          <div class=\"fake-field\">\n364\t            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n365\t            <span>Message</span>\n366\t          </div>\n367\t          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n368\t          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n369\t        </div>\n370\t      </div>\n371\t      <p class=\"manifesto-line\" data-i18n-html=\"manifesto\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n372\t    </section>\n373\t\n374\t    <!-- 3 · security -->\n375\t    <section class=\"slide list-slide before\">\n376\t      <h1 data-i18n-html=\"secH1\">הבטחה <span class=\"accent\">ופרטיות</span></h1>\n377\t      <p class=\"lead\" data-i18n=\"secLead\">הסוכן שלך סגור ומאובטח. 4 נושאים חשובים שכדאי לדעת.</p>\n378\t      <div class=\"cards\" id=\"secCards\">\n379\t        <div class=\"card\">\n380\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n381\t          <div><h3 data-i18n=\"sec1T\">שרת מבודד, משלך בלבד</h3><p data-i18n=\"sec1B\">הסוכן שלך פועל בסביבה סגורה ומבודדת שנפתחת רק עבורך, בלי שאף סוכן אחר או גורם חיצוני יכול לגעת במידע שבתוכה.</p></div>\n382\t        </div>\n383\t        <div class=\"card\">\n384\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n385\t          <div><h3 data-i18n=\"sec2T\">טלגרם, ערוץ פרטי ומוצפן</h3><p data-i18n=\"sec2B\">כל התקשורת עם הסוכן עוברת בטלגרם בלבד, בערוץ מוצפן ונפרד לחלוטין מהמייל, מהדרייב ומכל מערכת אחרת.</p></div>\n386\t        </div>\n387\t        <div class=\"card\">\n388\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n389\t          <div><h3 data-i18n=\"sec3T\">אין גישה לחשבונות הפרטיים שלך</h3><p data-i18n=\"sec3B\">המייל, הדרייב והחשבונות האישיים חסומים לסוכן ברמת ההגדרה. זו בחירה ארכיטקטונית קבועה, לא מגבלה זמנית.</p></div>\n390\t        </div>\n391\t        <div class=\"card\">\n392\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"4.5\"/><path d=\"M10.8 12.2L21 2\"/><path d=\"M15 8l3 3\"/></svg></div>\n393\t          <div><h3 data-i18n=\"sec4T\">כלי AI חיצוניים, במפתחות שלך בלבד</h3><p data-i18n=\"sec4B\">חיבור לכלי AI חיצוניים (מצגות, וידאו, תוכן) נעשה רק דרך מפתחות ה־API הפרטיים שלך. המפתחות סגורים, לא ניתנים להעברה, וניתן לנתק אותם בכל רגע.</p></div>\n394\t        </div>\n395\t      </div>\n396\t      <p class=\"soul\" data-i18n-html=\"soul\">מוח של AI, גוף של NanoClaw, ונשמה של <span class=\"accent\">אליה בן כנען</span>.</p>\n397\t    </section>\n398\t\n399\t    <!-- 4 · pilot -->\n400\t    <section class=\"slide list-slide before pilot-slide\">\n401\t      <h1 data-i18n-html=\"pilH1\">עשרה ימים <span class=\"accent\">בעולם החדש</span></h1>\n402\t      <p class=\"lead\" data-i18n=\"pilLead\">עולם העבודה משתנה מול העיניים, ואני רוצה שתרגישו את זה בעצמכם.</p>\n403\t      <div class=\"pnotes\">\n404\t        <div class=\"pnote\"><span class=\"pn-num\">1</span><div><h3 data-i18n=\"pil1T\">חינם לגמרי</h3><p data-i18n=\"pil1B\">עשרה ימים על חשבוני, מהמשאבים שלי, כדי שתוכלו פשוט להתנסות.</p></div></div>\n405\t        <div class=\"pnote\"><span class=\"pn-num\">2</span><div><h3 data-i18n=\"pil2T\">מספיק זמן להכיר</h3><p data-i18n=\"pil2B\">עשרה ימים זה בדיוק הזמן להתרגל לסוכן ולראות איך זה משנה לכם את היום.</p></div></div>\n406\t        <div class=\"pnote\"><span class=\"pn-num\">3</span><div><h3 data-i18n=\"pil3T\">ומשם, שלכם</h3><p data-i18n=\"pil3B\">כשתרגישו את ההבדל, תקימו סוכן משלכם ותמשיכו הלאה.</p></div></div>\n407\t      </div>\n408\t      <p class=\"soul\" data-i18n-html=\"pilSoul\">שלכם, <span class=\"accent\">אליה בן כנען</span>.</p>\n409\t    </section>\n410\t\n411\t    <!-- 5 · signup -->\n412\t    <section class=\"slide list-slide before\">\n413\t      <h1 data-i18n-html=\"formH1\">הסוכן <span class=\"accent\">נכנס לעבודה</span></h1>\n414\t      <p class=\"lead\" style=\"margin-top:8px\" data-i18n=\"formLead\">הסוכן שלך עובד מתוך טלגרם, ומשם תתנהל כל העבודה איתו. טלגרם זמין גם בנייד וגם במחשב, כדי שיהיה לך נוח לעבוד מכל מקום. עוד כמה פרטים, והוא כבר מתחיל.</p>\n415\t      <p class=\"dl-prompt\" data-i18n=\"dlPrompt\">צריך את טלגרם? הורד בדקה:</p>\n416\t      <div class=\"dl-row\" style=\"margin-top:8px\">\n417\t        <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlMobile\">הורדת טלגרם לנייד ←</a>\n418\t        <a href=\"https://desktop.telegram.org/\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlDesktop\">הורדת טלגרם למחשב ←</a>\n419\t      </div>\n420\t      <form id=\"signupForm\" novalidate>\n421\t        <div class=\"name-row\">\n422\t          <div class=\"field\" id=\"fFirst\">\n423\t            <label for=\"inFirst\" data-i18n=\"firstL\">שם פרטי</label>\n424\t            <input id=\"inFirst\" type=\"text\" placeholder=\"השם שלך\" autocomplete=\"given-name\" data-i18n-ph=\"firstPh\">\n425\t            <div class=\"err\" data-i18n=\"firstE\">נא להזין שם פרטי</div>\n426\t          </div>\n427\t          <div class=\"field\" id=\"fLast\">\n428\t            <label for=\"inLast\" data-i18n=\"lastL\">שם משפחה</label>\n429\t            <input id=\"inLast\" type=\"text\" placeholder=\"שם משפחה\" autocomplete=\"family-name\" data-i18n-ph=\"lastPh\">\n430\t            <div class=\"err\" data-i18n=\"lastE\">נא להזין שם משפחה</div>\n431\t          </div>\n432\t        </div>\n433\t        <div class=\"field\" id=\"fEmail\">\n434\t          <label for=\"inEmail\" data-i18n=\"emailL\">אימייל</label>\n435\t          <input id=\"inEmail\" type=\"email\" placeholder=\"name@company.com\" autocomplete=\"email\">\n436\t          <div class=\"err\" data-i18n=\"emailE\">נא להזין אימייל תקין</div>\n437\t        </div>\n438\t        <div class=\"field\" id=\"fPhone\">\n439\t          <label for=\"inPhone\" data-i18n=\"phoneL\">טלפון</label>\n440\t          <input id=\"inPhone\" type=\"tel\" placeholder=\"050-0000000\" autocomplete=\"tel\">\n441\t          <div class=\"err\" data-i18n=\"phoneE\">נא להזין מספר טלפון תקין</div>\n442\t        </div>\n443\t        <label class=\"consent\" id=\"tgConsentWrap\">\n444\t          <input type=\"checkbox\" id=\"inTgConsent\">\n445\t          <span data-i18n=\"tgConsent\">הורדתי טלגרם, אפשר להתחיל</span>\n446\t        </label>\n447\t        <label class=\"consent\" id=\"consentWrap\">\n448\t          <input type=\"checkbox\" id=\"inConsent\">\n449\t          <span data-i18n-html=\"consent\">קראתי ואישרתי את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a></span>\n450\t        </label>\n451\t      </form>\n452\t    </section>\n453\t\n454\t  </div>\n455\t\n456\t  <div class=\"cta-zone\">\n457\t    <div class=\"nav-row\">\n458\t      <button class=\"nav-arr\" id=\"arrBack\" aria-label=\"הקודם\" disabled>\n459\t        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n460\t      </button>\n461\t      <div class=\"dots\" id=\"dots\"></div>\n462\t      <button class=\"nav-arr\" id=\"arrFwd\" aria-label=\"הבא\">\n463\t        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n464\t      </button>\n465\t    </div>\n466\t    <button class=\"cta\" id=\"ctaBtn\">קדימה, הסוכן שלך מחכה</button>\n467\t    <div class=\"cta-sub\">\n468\t      <div class=\"swipe-hint\" id=\"swipeHint\">\n469\t        <span data-i18n=\"swipeHint\">החליקו לראות אותו בפעולה</span>\n470\t        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n471\t      </div>\n472\t      <div class=\"cta-foot\" id=\"ctaFoot\"></div>\n473\t    </div>\n474\t  </div>\n475\t</div>\n476\t\n477\t<div class=\"caption\">Shellano</div>\n478\t\n479\t<script>\n480\t/* ================= i18n ================= */\n481\tconst S = {\n482\t  he: {\n483\t    docTitle: 'NanoShellano · הסוכן האישי שלך',\n484\t    backAria: 'חזרה',\n485\t    heroH1: 'התקבל עובד חדש<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span>',\n486\t    heroLead: 'כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי להיות לפני כולם.',\n487\t    trust: 'חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין',\n488\t    manifesto: 'הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b>',\n489\t    demoH1: 'כך נראה יום עבודה עם <span class=\"accent\">הסוכן שלך</span>',\n490\t    demoLead: '4 דוגמאות למשימות שגרתיות שהסוכן יודע לעשות כשהוא מחובר למערכות הארגון.',\n491\t    demoNote: 'הדגמה להמחשה בלבד. החיבור למערכות עדיין לא פעיל.',\n492\t    tgName: \"ג'וני\",\n493\t    secH1: 'הבטחה <span class=\"accent\">ופרטיות</span>',\n494\t    secLead: 'הסוכן שלך סגור ומאובטח. 4 דברים שחשוב לדעת.',\n495\t    sec1T: 'סביבה מבודדת, שלך בלבד', sec1B: 'הסוכן פועל בסביבה סגורה שנפתחת רק עבורך. אף גורם מבחוץ לא נוגע במידע שבתוכה.',\n496\t    sec2T: 'טלגרם, ערוץ פרטי ומוצפן', sec2B: 'כל השיחה עוברת בטלגרם בלבד, מוצפנת ונפרדת מהמייל, מהדרייב ומכל מערכת אחרת.',\n497\t    sec3T: 'אין גישה לחשבונות שלך', sec3B: 'המייל, הדרייב והחשבונות חסומים לסוכן. בחירה ארכיטקטונית קבועה, לא מגבלה זמנית.',\n498\t    sec4T: 'כלי AI חיצוניים, במפתחות שלך', sec4B: 'חיבור לכלים חיצוניים נעשה רק דרך מפתחות ה־API שלך. סגורים, לא ניתנים להעברה, ומנותקים בלחיצה.',\n499\t    sec5T: 'מחיקה מלאה, בכל רגע', sec5B: \"אפשר למחוק את כל היסטוריית הצ'אט ולסגור את הסוכן לחלוטין בלחיצה אחת, בלי שאריות.\",\n500\t    soul: 'מוח של AI, גוף של NanoClaw, ונשמה של <span class=\"accent\">אליה בן כנען</span>.',\n501\t    pilH1: 'עשרה ימים <span class=\"accent\">בעולם החדש</span>',\n502\t    pilLead: 'עולם העבודה משתנה מול העיניים, ואני רוצה שתרגישו את זה בעצמכם.',\n503\t    pil1T: 'חינם לגמרי', pil1B: 'עשרה ימים על חשבוני, מהמשאבים שלי, כדי שתוכלו פשוט להתנסות.',\n504\t    pil2T: 'מספיק זמן להכיר', pil2B: 'עשרה ימים זה בדיוק הזמן להתרגל לסוכן ולראות איך זה משנה לכם את היום.',\n505\t    pil3T: 'ומשם, שלכם', pil3B: 'כשתרגישו את ההבדל, תקימו סוכן משלכם ותמשיכו הלאה.',\n506\t    pilSoul: 'שלכם, <span class=\"accent\">אליה בן כנען</span>.',\n507\t    installH1: 'איך זה הולך להיות',\n508\t    installLead: 'ארבעה צעדים, מהרגע שלוחצים ועד שהסוכן עובד בשבילך.',\n509\t    st1T: 'הטלגרם, הערוץ הפרטי שלך', st1B: 'זמין באפליקציה לנייד, באפליקציה למחשב, וגם בדפדפן. מהיר, מסונכרן, ונוח לעבודה. אם יש לך כבר, אפשר לדלג לשלב הבא.',\n510\t    dlMobile: 'להורדה לנייד ←', dlDesktop: 'להורדה למחשב ←',\n511\t    st2T: 'פותחים לך משתמש אישי', st2B: 'שם, טלפון ומייל. דרכם נפתח לך חשבון פרטי שלך בלבד, שאף אחד אחר לא נכנס אליו, גם לא אנחנו.',\n512\t    st3T: 'הסוכן שלך נבנה אוטומטית', st3B: 'ברגע שמאשרים, מתחילה הקמה אוטומטית של הסוכן האישי שלך. דקה-שתיים, ואנחנו מוודאים שהכל מוכן ומותאם רק לך.',\n513\t    st4T: 'השיחה הראשונה, בטלגרם', st4B: 'הסוכן נפתח אצלך בטלגרם, מציג את עצמו, ומכאן זה רק שיחה.',\n514\t    pilotH1: 'לקראת עולם העבודה החדש',\n515\t    pilotLead: 'אני מציע להתנסות בעבודה עם סוכן AI — בחינם, לעשרה ימים.',\n516\t    pl1T: \"מה בעצם הפיילוט הזה?\", pl1B: \"תוכל לעבוד עם סוכן AI לתפקיד שלך — בלי לחבר שום מערכת. ג'וני מתחיל לעבוד איתך ישירות מהשיחה.\",\n517\t    pl2T: \"למה אני עושה את זה?\", pl2B: \"כי אני מאמין שמי שיתנסה עכשיו יהיה מוכן לעולם שבא. נתתי לכם את המשאבים שלי כדי שתחוו את ההבדל בעצמכם.\",\n518\t    pl3T: \"ואחרי עשרה ימים?\", pl3B: \"הפיילוט פתוח לעשרה ימים, על חשבוני. מי שרוצה להמשיך — הכנתי מדריך להקמת NanoClaw משלך, שמתחבר לכל המערכות שלך.\",\n519\t    pilotCloser: 'אנחנו כאן בשביל להכין אותך.',\n520\t    formH1: 'הסוכן <span class=\"accent\">נכנס לעבודה</span>',\n521\t    formLead: 'הסוכן שלך עובד מתוך טלגרם, ומשם תתנהל כל העבודה איתו. טלגרם זמין גם בנייד וגם במחשב, כדי שיהיה לך נוח לעבוד מכל מקום. עוד כמה פרטים, והוא כבר מתחיל.',\n522\t    dlPrompt: 'צריך את טלגרם? הורד בדקה:',\n523\t    dlMobile: 'הורדת טלגרם לנייד ←', dlDesktop: 'הורדת טלגרם למחשב ←',\n524\t    tgConsent: 'הורדתי טלגרם, אפשר להתחיל',\n525\t    firstL: 'שם פרטי', firstPh: 'השם שלך', firstE: 'נא להזין שם פרטי',\n526\t    lastL: 'שם משפחה', lastPh: 'שם משפחה', lastE: 'נא להזין שם משפחה',\n527\t    emailL: 'אימייל', emailE: 'נא להזין אימייל תקין',\n528\t    phoneL: 'טלפון', phoneE: 'נא להזין מספר טלפון תקין',\n529\t    consent: 'קראתי ואישרתי את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a>',\n530\t    doneTitle: 'הסוכן שלך מחכה בטלגרם',\n531\t    doneTitleName: '{name}, הסוכן שלך מחכה בטלגרם',\n532\t    doneLead: 'הוא כבר כתב לך הודעה ראשונה. לחיצה אחת, ואתם מתחילים.',\n533\t    rescueQ: 'לא הגיע קישור? עדיין אין טלגרם?', rescueA: 'חזרה לשלבי ההתקנה',\n534\t    swipeHint: 'החליקו לראות אותו בפעולה',\n535\t    submitting: 'מקימים לך סוכן...',\n536\t    cta: [\n537\t      { label:'קדימה, הסוכן שלך מחכה', action:'next', hint:true },\n538\t      { label:'ורגע, כמה זה בטוח?', action:'next' },\n539\t      { label:'נשמע בטוח, אפשר להתקדם', action:'next' },\n540\t      { label:'יאללה, מתקינים', action:'next' },\n541\t      { label:'יאללה, מתחילים לעבוד', action:'submit' },\n542\t    ],\n543\t    demoGreeting: \"היי, אני ג'וני, הסוכן האישי שלך. ככה נראה יום עבודה איתי.\",\n544\t    demoClosing: 'וזה רק על קצה המזלג. בפנים נדבר כבר על העבודה שלך.'\n545\t  },\n546\t  en: {\n547\t    docTitle: 'NanoShellano · Your personal agent',\n548\t    backAria: 'Back',\n549\t    heroH1: 'A new employee just joined<br><span class=\"accent\">Your AI agent starts today</span>',\n550\t    heroLead: \"Everyone keeps saying AI will change the world of work. It is already changing it, and agents entering every role will be seismic. We are here to teach you how to manage agents, with zero technical background, so you stay ahead of everyone.\",\n551\t    trust: 'Free to try<span class=\"sep\">·</span>One tap from your phone<span class=\"sep\">·</span>Fully secured',\n552\t    manifesto: 'Agents are entering every role. <b>Those who know how to manage them will lead.</b>',\n553\t    demoH1: 'How a workday looks with <span class=\"accent\">your agent</span>',\n554\t    demoLead: \"4 examples of routine tasks your agent handles once it's connected to your org's systems.\",\n555\t    demoNote: \"Illustration only. The system connections aren't live yet.\",\n556\t    tgName: 'Joni',\n557\t    secH1: 'The Promise <span class=\"accent\">& Privacy</span>',\n558\t    secLead: \"Your agent is closed and secure. 4 things worth knowing.\",\n559\t    sec1T: 'An isolated environment, yours alone', sec1B: 'The agent runs in a closed environment that opens only for you. No outside party touches the data inside it.',\n560\t    sec2T: 'Telegram, a private encrypted channel', sec2B: 'The whole conversation runs through Telegram only, encrypted and separate from your email, drive and every other system.',\n561\t    sec3T: 'No access to your accounts', sec3B: 'Email, drive and accounts are blocked for the agent. A permanent architectural choice, not a temporary limitation.',\n562\t    sec4T: 'External AI tools, on your keys', sec4B: 'External tools connect only through your own API keys. Closed, non-transferable, and disconnected with one click.',\n563\t    sec5T: 'Full deletion, any time', sec5B: 'You can delete the entire chat history and fully shut the agent down with a single click, leaving nothing behind.',\n564\t    soul: 'The mind of AI, the body of NanoClaw, and the soul of <span class=\"accent\">Elia Ben Cnaan</span>.',\n565\t    pilH1: 'Ten days <span class=\"accent\">in the new world</span>',\n566\t    pilLead: 'The world of work is changing before our eyes, and I want you to feel it for yourselves.',\n567\t    pil1T: 'Completely free', pil1B: 'Ten days on me, from my own resources, so you can simply try it.',\n568\t    pil2T: 'Enough time to get to know it', pil2B: 'Ten days is exactly the time to get used to the agent and see how it changes your day.',\n569\t    pil3T: 'And from there, yours', pil3B: 'Once you feel the difference, you set up your own agent and carry on.',\n570\t    pilSoul: 'Yours, <span class=\"accent\">Elia Ben Cnaan</span>.',\n571\t    installH1: 'How it is going to work',\n572\t    installLead: 'Four steps, from the moment you click until your agent is working for you.',\n573\t    st1T: 'Telegram, your private channel', st1B: 'Available as a mobile app, a desktop app, and in the browser. Fast, synced, and comfortable for work. Already have it? Skip to the next step.',\n574\t    dlMobile: 'Download for mobile →', dlDesktop: 'Download for desktop →',\n575\t    st2T: 'We open your personal account', st2B: 'Name, phone and email. They open an account that is yours alone, and no one else gets in, not even us.',\n576\t    st3T: 'Your agent is built automatically', st3B: 'The moment you approve, an automatic setup of your personal agent begins. A minute or two, and we make sure everything is ready and tuned just for you.',\n577\t    st4T: 'The first conversation, on Telegram', st4B: 'The agent opens in your Telegram, introduces itself, and from there it is just a conversation.',\n578\t    pilotH1: \"Preparing for the new world of work\",\n579\t    pilotLead: \"I'm offering you a hands-on experience with an AI agent — free, for ten days.\",\n580\t    pl1T: \"What exactly is this pilot?\", pl1B: \"You'll work with an AI agent for your role — no system connections needed. Joni starts working with you right from the conversation.\",\n581\t    pl2T: \"Why am I doing this?\", pl2B: \"Because I believe that those who experience this now will be ready for what's coming. I gave you my resources so you can feel the difference for yourselves.\",\n582\t    pl3T: \"After ten days?\", pl3B: \"The pilot runs for ten days, on my account. Those who want to continue — I've prepared a guide to set up your own NanoClaw, which connects to all your systems.\",\n583\t    pilotCloser: \"We're here to get you ready.\",\n584\t    formH1: 'Your agent <span class=\"accent\">clocks in</span>',\n585\t    formLead: 'Your agent works from inside Telegram, and that is where all your work with it happens. Telegram runs on both mobile and desktop, so you can work comfortably from anywhere. A few more details, and it is ready to start.',\n586\t    dlPrompt: 'Need Telegram? Grab it in a minute:',\n587\t    dlMobile: 'Download Telegram for mobile →', dlDesktop: 'Download Telegram for desktop →',\n588\t    tgConsent: 'I have Telegram and I am ready to start',\n589\t    firstL: 'First name', firstPh: 'Your first name', firstE: 'Please enter your first name',\n590\t    lastL: 'Last name', lastPh: 'Last name', lastE: 'Please enter your last name',\n591\t    emailL: 'Email', emailE: 'Please enter a valid email',\n592\t    phoneL: 'Phone', phoneE: 'Please enter a valid phone number',\n593\t    consent: 'I have read and accepted the <a href=\"#\" onclick=\"return false\">Privacy Policy and Terms of Use</a>',\n594\t    doneTitle: 'Your agent is waiting on Telegram',\n595\t    doneTitleName: '{name}, your agent is waiting on Telegram',\n596\t    doneLead: 'It already sent you a first message. One tap, and you are off.',\n597\t    rescueQ: \"Didn't get the link? No Telegram yet?\", rescueA: 'Back to the setup steps',\n598\t    swipeHint: 'Swipe to see it in action',\n599\t    submitting: 'Setting up your agent...',\n600\t    cta: [\n601\t      { label:'Come meet your agent', action:'next', hint:true },\n602\t      { label:'Wait, how safe is this?', action:'next' },\n603\t      { label:\"Sounds safe, let's move on\", action:'next' },\n604\t      { label:\"Alright, let's install\", action:'next' },\n605\t      { label:\"Alright, let's get to work\", action:'submit' },\n606\t    ],\n607\t    demoGreeting: \"Hey, I'm Joni, your personal agent. Here is what a workday with me looks like.\",\n608\t    demoClosing: 'And that is just a taste. Keep going, inside we will talk about your own work.'\n609\t  }\n610\t};\n611\t\n612\tconst SCEN = {\n613\t  he: [\n614\t    {\n615\t      base: [9,12],\n616\t      msgs: [\n617\t        { who:'me',  text:'עדכן את הלקוח בCRM, תכין הצעת מחיר ותשלח לו במייל' },\n618\t        { who:'bot', text:'על איזה סכום ההצעה?' },\n619\t        { who:'me',  text:'45 אלף, כמו שסיכמנו בפגישה' },\n620\t        { who:'bot', text:'עדכנתי בCRM, הכנתי הצעה, וכתבתי טיוטת מייל ללקוח.' },\n621\t        { who:'bot', text:'המייל ממתין לאישורך. נשאר רק לאשר שליחה.' }\n622\t      ],\n623\t      receipt: { title:'בוצע · 3 פעולות', rows:['הלקוח עודכן ב-CRM','הצעת מחיר על 45,000 ₪ מוכנה','טיוטת מייל ממתינה לאישורך'] }\n624\t    },\n625\t    {\n626\t      base: [11,40],\n627\t      msgs: [\n628\t        { who:'me',  text:'צריך מצגת שמסבירה לצוות את הנוהל החדש, לישיבה מחר בבוקר' },\n629\t        { who:'bot', text:'על זה. משכתי את הנוהל מהמסמך ששיתפת. פנימי או ללקוחות, וכמה שקפים?' },\n630\t        { who:'me',  text:'פנימי, קצר ולעניין' },\n631\t        { who:'bot', text:'בונה: מה משתנה, למה, ומה עושים בפועל, עם דוגמה לכל שלב. 8 שקפים.', file:'מצגת_נוהל.pptx' },\n632\t        { who:'me',  text:'תוסיף גם משהו שהצוות יתרגל עליו' },\n633\t        { who:'bot', text:'הוספתי דף תרגול עם שלושה תרחישים. הכל מוכן לישיבה.', file:'דף_תרגול.pdf' }\n634\t      ],\n635\t      receipt: { title:'בוצע · 3 פעולות', rows:['הנוהל נמשך מהמסמך ששותף','מצגת של 8 שקפים נבנתה','דף תרגול עם שלושה תרחישים נוסף'] }\n636\t    },\n637\t    {\n638\t      base: [13,5],\n639\t      msgs: [\n640\t        { who:'me',  text:'התחלתי היום בתפקיד, לא מכיר את המערכות ולא את התהליכים' },\n641\t        { who:'bot', text:'אני אלווה אותך. בניתי תוכנית קליטה לשבועיים, שיבצתי פגישות היכרות ביומן עם האנשים הרלוונטיים, ורשמתי אותך למערכות. נתחיל?' },\n642\t        { who:'me',  text:'כן. ואיך פותחים בקשת רכש לציוד?' },\n643\t        { who:'bot', text:'יש טופס, אבל אני ממלא בשבילך. מה, כמה, ולמי' },\n644\t        { who:'me',  text:'3 מסכים, בערך 6000 שקל' },\n645\t        { who:'bot', text:'מילאתי, צירפתי הצדקה תקציבית, ושלחתי לאישור המנהל שלך. תגיע התראה כשיאושר. ריכזתי לך גם את כל תהליכי הקליטה במקום אחד.', file:'תוכנית_קליטה.pdf' }\n646\t      ],\n647\t      receipt: { title:'בוצע · 4 פעולות', rows:['תוכנית קליטה לשבועיים נבנתה','פגישות היכרות שובצו ביומן','נרשמת לכל המערכות','בקשת רכש נשלחה לאישור המנהל'] }\n648\t    },\n649\t    {\n650\t      base: [16,22],\n651\t      msgs: [\n652\t        { who:'me',  text:'כל שבוע יוצא כלי AI חדש, אני לא מצליח לעקוב' },\n653\t        { who:'bot', text:'אז לא צריך לעקוב. רק להגיד לי מה צריך, ואני בוחר את הכלי, מתחבר אליו, ומריץ. בלי ללמוד כלום' },\n654\t        { who:'me',  text:'צריך לנתח את הנתונים מהחודש ולהוציא תובנות' },\n655\t        { who:'bot', text:'על זה. בחרתי את הכלי המתאים, הרצתי, וזיהיתי 3 מגמות בולטות. מסדר דוח קריא עם המלצות' },\n656\t        { who:'me',  text:'תכין גם גרסה של עמוד אחד למנהלים' },\n657\t        { who:'bot', text:'הכנתי, עמוד אחד עם השורה התחתונה וההמלצה המרכזית.', file:'דוח_חודשי.pdf' }\n658\t      ],\n659\t      receipt: { title:'בוצע · 3 פעולות', rows:['הכלי המתאים נבחר והורץ','3 מגמות בולטות זוהו בנתונים','דוח מלא + עמוד מסכם למנהלים'] }\n660\t    }\n661\t  ],\n662\t  en: [\n663\t    {\n664\t      base: [9,12],\n665\t      msgs: [\n666\t        { who:'me',  text:'Update the client in the CRM, prepare a quote and send it by email' },\n667\t        { who:'bot', text:'What amount should the quote be for?' },\n668\t        { who:'me',  text:'45K, as we agreed in the meeting' },\n669\t        { who:'bot', text:'Updated the CRM, prepared the quote, and drafted an email to the client.' },\n670\t        { who:'bot', text:'The email is waiting for your approval. One click and it goes out.' }\n671\t      ],\n672\t      receipt: { title:'Done · 3 actions', rows:['Client updated in the CRM','A 45,000 quote is ready','Email draft awaiting your approval'] }\n673\t    },\n674\t    {\n675\t      base: [11,40],\n676\t      msgs: [\n677\t        { who:'me',  text:\"I need a deck that explains the new procedure to the team, for tomorrow morning's meeting\" },\n678\t        { who:'bot', text:'On it. I pulled the procedure from the doc you shared. Internal or client-facing, and how many slides?' },\n679\t        { who:'me',  text:'Internal, short and to the point' },\n680\t        { who:'bot', text:'Building: what changes, why, and what to do in practice, with an example for each step. 8 slides.', file:'Procedure_Deck.pptx' },\n681\t        { who:'me',  text:'Add something for the team to practice on' },\n682\t        { who:'bot', text:'Added a practice sheet with three scenarios. Everything is ready for the meeting.', file:'Practice_Sheet.pdf' }\n683\t      ],\n684\t      receipt: { title:'Done · 3 actions', rows:['Procedure pulled from the shared doc','An 8-slide deck was built','Practice sheet with three scenarios added'] }\n685\t    },\n686\t    {\n687\t      base: [13,5],\n688\t      msgs: [\n689\t        { who:'me',  text:'I started a new role today, I do not know the systems or the processes' },\n690\t        { who:'bot', text:'I will walk you through it. I built a two-week onboarding plan, scheduled intro meetings with the relevant people, and registered you to the systems. Shall we start?' },\n691\t        { who:'me',  text:'Yes. And how do I open a purchase request for equipment?' },\n692\t        { who:'bot', text:'There is a form, but I fill it in for you. What, how many, and for whom' },\n693\t        { who:'me',  text:'3 monitors, around 6,000' },\n694\t        { who:'bot', text:'Filled it in, attached a budget justification, and sent it to your manager for approval. A notification will arrive once it is approved. I also gathered all your onboarding into one place.', file:'Onboarding_Plan.pdf' }\n695\t      ],\n696\t      receipt: { title:'Done · 4 actions', rows:['Two-week onboarding plan built','Intro meetings scheduled in the calendar','Registered to all systems','Purchase request sent for manager approval'] }\n697\t    },\n698\t    {\n699\t      base: [16,22],\n700\t      msgs: [\n701\t        { who:'me',  text:'A new AI tool comes out every week, I cannot keep up' },\n702\t        { who:'bot', text:'Then there is no need to. Just tell me what you need, and I pick the tool, connect to it, and run it. Nothing to learn' },\n703\t        { who:'me',  text:'I need this month\\'s data analyzed, with insights' },\n704\t        { who:'bot', text:'On it. Picked the right tool, ran it, and spotted 3 clear trends. Putting together a readable report with recommendations' },\n705\t        { who:'me',  text:'Prepare a one-page version for management too' },\n706\t        { who:'bot', text:'Done, one page with the bottom line and the key recommendation.', file:'Monthly_Report.pdf' }\n707\t      ],\n708\t      receipt: { title:'Done · 3 actions', rows:['The right tool picked and run','3 clear trends identified in the data','Full report + a one-pager for management'] }\n709\t    }\n710\t  ]\n711\t};\n712\t\n713\tlet lang = 'he';\n714\tfunction T(){ return S[lang]; }\n715\tfunction SC(){ return SCEN[lang]; }\n716\t\n717\tfunction applyLang(){\n718\t  document.documentElement.lang = lang;\n719\t  document.documentElement.dir = lang === 'he' ? 'rtl' : 'ltr';\n720\t  document.title = T().docTitle;\n721\t  document.querySelectorAll('[data-i18n]').forEach(el=>{ el.textContent = T()[el.dataset.i18n]; });\n722\t  document.querySelectorAll('[data-i18n-html]').forEach(el=>{ el.innerHTML = T()[el.dataset.i18nHtml]; });\n723\t  document.querySelectorAll('[data-i18n-ph]').forEach(el=>{ el.placeholder = T()[el.dataset.i18nPh]; });\n724\t  // backBtn removed from header\n725\t  document.getElementById('tgName').textContent = T().tgName;\n726\t    document.querySelectorAll('#langToggle button').forEach(b=>b.classList.toggle('on', b.dataset.lang===lang));\n727\t  render();\n728\t}\n729\t\n730\tdocument.querySelectorAll('#langToggle button').forEach(b=>{\n731\t  b.onclick = ()=>{\n732\t    if (b.dataset.lang === lang) return;\n733\t    lang = b.dataset.lang;\n734\t    applyLang();\n735\t    restartDemo();\n736\t  };\n737\t});\n738\t\n739\t/* ================= navigation ================= */\n740\tconst slides = Array.from(document.querySelectorAll('.slide'));\n741\tconst N = slides.length;\n742\tlet current = 0;\n743\tlet userName = '';\n744\t\n745\tconst backBtn = null; // removed from header\n746\tconst ctaBtn  = document.getElementById('ctaBtn');\n747\tconst swipeHint = document.getElementById('swipeHint');\n748\tconst ctaFoot = document.getElementById('ctaFoot');\n749\tconst dotsEl  = document.getElementById('dots');\n750\t\n751\tfor (let i = 0; i < N; i++) {\n752\t  const b = document.createElement('button');\n753\t  b.setAttribute('aria-label', 'screen ' + (i + 1));\n754\t  b.onclick = () => goTo(i);\n755\t  dotsEl.appendChild(b);\n756\t}\n757\tconst dots = Array.from(dotsEl.children);\n758\t\n759\tfunction render(){\n760\t  slides.forEach((s,i)=>{\n761\t    s.classList.toggle('active', i===current);"}]},"uuid":"b93cc719-00c8-4ad3-bfd6-8fbd98af6237","timestamp":"2026-07-10T09:01:41.138Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/agent/ux-review/launch/v4-readable.html","content":"<!DOCTYPE html>\n<html lang=\"he\" dir=\"rtl\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@700&display=swap\" rel=\"stylesheet\">\n<title>Shellano · פותחים סוכן AI אישי בכמה דקות</title>\n<meta name=\"description\" content=\"פותחים סוכן AI אישי בטלגרם, לומדים איך עובדים עם סוכנים, ומתחילים להתנסות בלי רקע טכני.\">\n<meta property=\"og:locale\" content=\"he_IL\">\n<meta property=\"og:type\" content=\"website\">\n<meta property=\"og:title\" content=\"Shellano · פותחים סוכן AI אישי בכמה דקות\">\n<meta property=\"og:description\" content=\"פותחים סוכן AI אישי בטלגרם, לומדים איך עובדים עם סוכנים, ומתחילים להתנסות בלי רקע טכני.\">\n<meta property=\"og:url\" content=\"https://shellano.com/\">\n<meta property=\"og:site_name\" content=\"Shellano\">\n<meta property=\"og:image\" content=\"https://nanohubdemo.vercel.app/nanoshellano-lockup-trim.png\">\n<meta property=\"og:image:alt\" content=\"Shellano\">\n<meta name=\"twitter:card\" content=\"summary_large_image\">\n<meta name=\"twitter:title\" content=\"Shellano · פותחים סוכן AI אישי בכמה דקות\">\n<meta name=\"twitter:description\" content=\"פותחים סוכן AI אישי בטלגרם, לומדים איך עובדים עם סוכנים, ומתחילים להתנסות בלי רקע טכני.\">\n<meta name=\"twitter:image\" content=\"https://nanohubdemo.vercel.app/nanoshellano-lockup-trim.png\">\n<style>\n  :root{\n    --bg:#000000; --surface:#101010; --surface2:#181818;\n    --text:#FFFFFF; --muted:#B0B0B0; --teal:#56EDD6; --teal-dim:#1F4A43; --teal-line:#2A6B5F;\n    --orange:#E85D3A; --border:#3A3A3A;\n    /* telegram replica palette (inside chat only) */\n    --tg-bg:#1a2332; --tg-header:#212d44;\n    --tg-in:#212d3b; --tg-out-a:#4f6bE8; --tg-out-b:#3f7be8;\n    --tg-input:#161e2b;\n  }\n  *{margin:0;padding:0;box-sizing:border-box}\n  html,body{height:100%;overscroll-behavior:none;overscroll-behavior-x:contain}\n  body{\n    background:var(--bg); color:var(--text);\n    font-family:'Inter','Segoe UI',system-ui,-apple-system,sans-serif;\n    display:flex; flex-direction:column; align-items:center; justify-content:center;\n    min-height:100dvh; gap:10px; padding:8px 0;\n  }\n  .caption{color:#5a5a5a;font-size:11.5px;letter-spacing:.4px}\n\n  /* ---------- phone frame ---------- */\n  .phone{\n    position:relative; width:min(410px,100vw); height:min(860px,calc(100dvh - 56px));\n    background:var(--bg); border:1px solid #262626; border-radius:24px;\n    overflow:hidden; display:flex; flex-direction:column;\n  }\n  @media (max-width:430px){ .phone{border:none;border-radius:0;height:100dvh} body{padding:0} .caption{display:none} }\n\n  /* ---------- app header: back + logo on start side, lang toggle on end side ---------- */\n  .app-header{\n    flex:0 0 auto; display:flex; align-items:center; justify-content:space-between;\n    gap:10px; padding:14px 16px 10px;\n  }\n  .header-side{display:flex;align-items:center;gap:10px}\n  .back-btn{\n    width:34px;height:34px;border-radius:50%;border:1px solid var(--border);\n    background:var(--surface);color:var(--muted);display:flex;align-items:center;justify-content:center;\n    cursor:pointer;flex:0 0 auto;transition:opacity .2s,border-color .2s;\n  }\n  .back-btn:hover:not(:disabled){border-color:#565656;color:var(--text)}\n  .back-btn:disabled{opacity:.22;cursor:default}\n  html[dir=\"ltr\"] .back-btn svg{transform:scaleX(-1)}\n  .logo-icon{\n    height:32px;\n    width:auto;\n    display:block;\n    user-select:none;\n    -webkit-user-drag:none;\n    object-fit:contain;\n  }\n  .lang-toggle{display:flex;align-items:center;gap:0;background:none;border:none}\n  .lang-toggle button{border:none;background:none;color:var(--muted);font-family:inherit;font-size:12.5px;font-weight:500;padding:4px 8px;cursor:pointer;letter-spacing:.3px}\n  .lang-toggle .lt-sep{color:#444;font-size:11px;line-height:1;user-select:none}\n  .lang-toggle button.on{color:var(--teal);font-weight:700}\n\n  /* ---------- stage & slides ---------- */\n  .stage{position:relative;flex:1 1 auto;min-height:0}\n  .slide{\n    position:absolute;inset:0;display:flex;flex-direction:column;\n    padding:4px 20px 0;opacity:0;pointer-events:none;\n    transform:translateX(18px);transition:opacity .4s cubic-bezier(.22,.61,.36,1),transform .4s cubic-bezier(.22,.61,.36,1);\n    overflow-y:auto;scrollbar-width:none;\n  }\n  .slide::-webkit-scrollbar{display:none}\n  .slide.before{transform:translateX(-18px)}\n  html[dir=\"ltr\"] .slide{transform:translateX(-18px)}\n  html[dir=\"ltr\"] .slide.before{transform:translateX(18px)}\n  .slide.active{opacity:1;pointer-events:auto;transform:translateX(0)}\n  @media (prefers-reduced-motion:reduce){ .slide{transition:opacity .2s;transform:none!important} }\n\n  h1{font-size:27px;line-height:1.28;font-weight:700;letter-spacing:-.2px}\n  h1 .accent{color:var(--teal)}\n  .lead{color:var(--muted);font-size:14.5px;line-height:1.62;margin-top:12px}\n  .list-slide h1{margin-top:6px;text-align:center}\n  .list-slide .lead{text-align:center}\n\n\n  /* ---------- bottom nav arrows (bare icon, no circle) ---------- */\n  .nav-arr{\n    width:30px;height:30px;border:none;background:none;padding:0;\n    color:var(--muted);display:flex;align-items:center;justify-content:center;\n    cursor:pointer;flex:0 0 auto;transition:color .2s,opacity .25s;\n  }\n  .nav-arr:hover:not(:disabled){color:var(--teal)}\n  .nav-arr:disabled,.nav-arr.hidden{opacity:0;pointer-events:none}\n\n  /* ---------- slide 1: hero ---------- */\n  .hero{justify-content:center;text-align:center;gap:0}\n  .hero .mascot{width:150px;margin:0 auto 18px;display:block}\n  .hero h1{font-size:30px}\n  .hero .lead{margin-top:14px}\n  .trust{margin-top:18px;color:#8a8a8a;font-size:12.5px;letter-spacing:.2px}\n  .trust .sep{color:var(--teal-line);padding:0 7px}\n\n  /* ---------- slide 2: telegram demo ---------- */\n  .demo{padding:4px 14px 0}\n  .demo-h1{text-align:center;font-size:23px;margin-top:2px}\n  .demo-lead{text-align:center;margin-top:8px;font-size:13.5px}\n  .demo-note{text-align:center;color:#6f6f6f;font-size:11.5px;margin:6px 0 10px}\n  .chat-card{\n    flex:1 1 auto;min-height:0;display:flex;flex-direction:column;\n    border-radius:18px;overflow:hidden;border:1px solid #232d40;\n    background:var(--tg-bg) url(\"data:image/svg+xml,%3Csvg%20xmlns%3D%22