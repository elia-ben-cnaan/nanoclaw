9,.10), transparent 70%);\n  }\n\n  /* ===== מסגרת הטלפון ===== */\n  .phone{\n    position:relative; width:min(410px,100vw);\n    height:min(860px,100dvh);\n    background:linear-gradient(180deg,#0b0b0b,#070707);\n    border:1px solid var(--border-soft); border-radius:34px;\n    box-shadow:0 40px 120px rgba(0,0,0,.8), 0 0 0 1px rgba(0,0,0,.6), 0 0 80px rgba(86,237,214,.04);\n    overflow:hidden; display:flex; flex-direction:column;\n  }\n  @media (max-width:480px){\n    .phone{width:100vw;height:100dvh;border-radius:0;border:none}\n  }\n\n  /* ===== כותרת עליונה ===== */\n  header{\n    display:flex; align-items:center; justify-content:space-between;\n    padding:14px 18px 10px; flex:none;\n  }\n  .logo{font-weight:700; font-size:15px; letter-spacing:.2px}\n  .logo b{color:var(--teal); font-weight:700}\n  .header-side{display:flex; align-items:center; gap:14px}\n  .lang{display:flex; gap:6px; font-size:11.5px; color:var(--text-3); font-weight:600}\n  .lang .on{color:var(--text)}\n  .skip{\n    font-size:12px; color:var(--text-2); text-decoration:none; cursor:pointer;\n    border:1px solid var(--border); border-radius:999px; padding:4px 12px;\n    transition:color .2s,border-color .2s; background:none; font-family:var(--font);\n  }\n  .skip:hover{color:var(--teal); border-color:var(--teal)}\n\n  /* ===== נקודות התקדמות ===== */\n  .dots{display:flex; justify-content:center; gap:7px; padding:2px 0 6px; flex:none}\n  .dot{\n    width:6px;height:6px;border-radius:999px;background:#2c2c2c;border:none;cursor:pointer;\n    transition:all .35s ease; padding:0;\n  }\n  .dot.active{width:22px;background:var(--teal)}\n  .dot.seen{background:#3f6f68}\n\n  /* ===== במת המסכים ===== */\n  .stage{position:relative; flex:1; min-height:0}\n  .slide{\n    position:absolute; inset:0; display:flex; flex-direction:column;\n    padding:8px 24px 0; opacity:0; pointer-events:none;\n    transform:translateX(-18px); transition:opacity .45s ease,transform .45s ease;\n    overflow:hidden;\n  }\n  .slide.active{opacity:1; pointer-events:auto; transform:none}\n  .slide.leaving{transform:translateX(18px)}\n  .slide-body{flex:1; min-height:0; display:flex; flex-direction:column}\n\n  /* ===== טיפוגרפיה ===== */\n  .kicker{\n    font-size:11.5px; font-weight:700; letter-spacing:.14em; color:var(--teal);\n    text-transform:uppercase; margin-bottom:10px;\n  }\n  h1{font-size:40px; font-weight:800; line-height:1.12; letter-spacing:-.5px}\n  h2{font-size:26px; font-weight:800; line-height:1.18; letter-spacing:-.3px}\n  .sub{color:var(--teal); font-size:19px; font-weight:700; margin-top:8px}\n  .para{color:var(--text-2); font-size:14.5px; line-height:1.65; margin-top:14px}\n\n  /* ===== CTA תחתון ===== */\n  .cta-zone{flex:none; padding:12px 24px calc(18px + env(safe-area-inset-bottom))}\n  .cta{\n    width:100%; border:none; border-radius:14px; padding:16px;\n    background:var(--teal); color:#04211c; font-size:16px; font-weight:700;\n    font-family:var(--font); cursor:pointer; display:flex; align-items:center; justify-content:center; gap:8px;\n    transition:transform .15s ease, box-shadow .2s;\n  }\n  .cta:hover{transform:translateY(-1px); box-shadow:0 8px 30px rgba(86,237,214,.25)}\n  .cta:active{transform:translateY(0)}\n  .cta.secondary{\n    background:var(--bg-3); color:var(--text); border:1px solid var(--border);\n  }\n  .cta.secondary:hover{box-shadow:none; border-color:#565656}\n  .cta svg{flex:none}\n  .swipe-hint{\n    text-align:center; color:var(--text-3); font-size:11.5px; margin-top:10px;\n    display:flex; align-items:center; justify-content:center; gap:6px;\n  }\n\n  /* ===== מסך 1 — Hero ===== */\n  .hero{justify-content:center; text-align:center; align-items:center}\n  .mascot{\n    width:88px;height:88px;border-radius:26px; margin-bottom:26px;\n    background:radial-gradient(circle at 32% 28%, rgba(86,237,214,.28), rgba(15,117,109,.12) 60%, transparent);\n    border:1px solid rgba(86,237,214,.25);\n    display:flex;align-items:center;justify-content:center;\n    box-shadow:0 0 50px rgba(86,237,214,.12);\n  }\n  /* בפרודקשן: הקמע הקיים של Shellano נכנס כאן */\n  .chips{display:flex; gap:8px; justify-content:center; margin-top:22px; flex-wrap:wrap}\n  .chip{\n    font-size:12px; color:var(--text-2); border:1px solid var(--border);\n    border-radius:999px; padding:6px 13px; display:flex; align-items:center; gap:6px;\n  }\n  .chip svg{color:var(--teal)}\n\n  /* ===== מסכי צ'אט ===== */\n  .demo-head{flex:none; padding-bottom:12px}\n  .demo-head .para{margin-top:6px; font-size:13.5px; line-height:1.5}\n  .chat-card{\n    flex:1; min-height:0; display:flex; flex-direction:column;\n    background:var(--bg-2); border:1px solid var(--border-soft);\n    border-radius:var(--radius); overflow:hidden;\n  }\n  .chat-top{\n    flex:none; display:flex; align-items:center; gap:11px;\n    padding:12px 16px; border-bottom:1px solid var(--border-soft); background:rgba(255,255,255,.02);\n  }\n  .avatar{\n    width:38px;height:38px;border-radius:50%;\n    background:radial-gradient(circle at 35% 30%, #2ab5a0, var(--teal-action));\n    display:flex;align-items:center;justify-content:center;\n    font-weight:800; font-size:16px; color:#032420; flex:none;\n  }\n  .chat-name{font-weight:700; font-size:14.5px}\n  .chat-status{font-size:11.5px; color:var(--text-2); display:flex; align-items:center; gap:5px}\n  .chat-status .st-dot{width:6px;height:6px;border-radius:50%;background:var(--teal)}\n  .chat-status.typing{color:var(--teal)}\n  .chat-log{\n    flex:1; min-height:0; overflow-y:auto; padding:16px 14px 18px;\n    display:flex; flex-direction:column; gap:10px; scroll-behavior:smooth;\n  }\n  .chat-log::-webkit-scrollbar{width:0}\n  .msg{\n    max-width:82%; padding:10px 14px; border-radius:16px;\n    font-size:13.5px; line-height:1.55; opacity:0; transform:translateY(8px);\n    animation:msgIn .35s ease forwards;\n  }\n  @keyframes msgIn{to{opacity:1;transform:none}}\n  .msg.user{\n    align-self:flex-start; /* RTL: המשתמש בצד ימין ויזואלית = flex-start בכיוון rtl */\n    background:var(--teal-action); color:#eafffb; border-bottom-right-radius:6px;\n  }\n  .msg.agent{\n    align-self:flex-end;\n    background:var(--bg-3); border:1px solid var(--border-soft); color:var(--text);\n    border-bottom-left-radius:6px;\n  }\n  .typing-bubble{\n    align-self:flex-end; background:var(--bg-3); border:1px solid var(--border-soft);\n    border-radius:16px; border-bottom-left-radius:6px; padding:13px 16px;\n    display:flex; gap:5px; opacity:0; animation:msgIn .25s ease forwards;\n  }\n  .typing-bubble i{\n    width:6px;height:6px;border-radius:50%;background:var(--text-3);\n    animation:blink 1.1s infinite;\n  }\n  .typing-bubble i:nth-child(2){animation-delay:.18s}\n  .typing-bubble i:nth-child(3){animation-delay:.36s}\n  @keyframes blink{0%,60%,100%{opacity:.25}30%{opacity:1}}\n\n  /* קבלה — שרשרת הפעולות שבוצעו. הלב של הסיפור. */\n  .receipt{\n    align-self:flex-end; width:88%;\n    background:rgba(86,237,214,.05); border:1px solid rgba(86,237,214,.22);\n    border-radius:14px; padding:12px 14px;\n    opacity:0; transform:translateY(8px); animation:msgIn .4s ease forwards;\n  }\n  .receipt-title{font-size:11px; font-weight:700; letter-spacing:.1em; color:var(--teal); margin-bottom:8px}\n  .receipt-row{\n    display:flex; align-items:center; gap:9px; font-size:13px; color:var(--text-2);\n    padding:4px 0; opacity:0; transform:translateX(6px); animation:msgIn .3s ease forwards;\n  }\n  .receipt-row svg{color:var(--teal); flex:none}\n  .receipt-row b{color:var(--text); font-weight:600}\n\n  /* ===== מניפסט ===== */\n  .manifesto{justify-content:center}\n  .manifesto h2{font-size:30px; line-height:1.3}\n  .manifesto .accent{color:var(--orange)}\n  .principles{display:flex; gap:10px; margin-top:26px}\n  .principle{\n    flex:1; border:1px solid var(--border); border-radius:12px; padding:14px 8px;\n    text-align:center; font-weight:700; font-size:14px;\n  }\n  .principle small{display:block; margin-top:4px; font-weight:400; font-size:11.5px; color:var(--text-3)}\n\n  /* ===== יכולות ===== */\n  .caps{display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:18px}\n  .cap{\n    background:var(--bg-2); border:1px solid var(--border-soft); border-radius:14px;\n    padding:14px; display:flex; flex-direction:column; gap:8px;\n  }\n  .cap svg{color:var(--teal)}\n  .cap b{font-size:13.5px; font-weight:600}\n  .cap span{font-size:11.5px; color:var(--text-3); line-height:1.45}\n\n  /* ===== אמון / מנוע ===== */\n  .trust-list{display:flex; flex-direction:column; gap:12px; margin-top:20px}\n  .trust{\n    display:flex; gap:13px; align-items:flex-start;\n    background:var(--bg-2); border:1px solid var(--border-soft); border-radius:14px; padding:14px 15px;\n  }\n  .trust svg{color:var(--teal); flex:none; margin-top:2px}\n  .trust b{font-size:14px; font-weight:600; display:block; margin-bottom:3px}\n  .trust span{font-size:12.5px; color:var(--text-2); line-height:1.55}\n  .engine-note{\n    margin-top:18px; text-align:center; font-size:11.5px; color:var(--text-3);\n  }\n  .engine-note b{color:var(--text-2); font-weight:600}\n\n  /* ===== הרשמה ===== */\n  .signup{justify-content:center}\n  .field{margin-top:12px}\n  .field label{display:block; font-size:12px; color:var(--text-2); margin-bottom:6px; font-weight:600}\n  .field input,.field select{\n    width:100%; background:var(--bg-2); border:1px solid var(--border); border-radius:12px;\n    color:var(--text); font-family:var(--font); font-size:14.5px; padding:13px 14px; outline:none;\n    transition:border-color .2s; -webkit-appearance:none; appearance:none;\n  }\n  .field input:focus,.field select:focus{border-color:var(--teal)}\n  .field input::placeholder{color:var(--text-3)}\n  .signup-meta{\n    display:flex; justify-content:center; gap:14px; margin-top:14px;\n    font-size:11.5px; color:var(--text-3);\n  }\n  .success{\n    display:none; text-align:center; padding:30px 0;\n  }\n  .success .check{\n    width:64px;height:64px;border-radius:50%;margin:0 auto 18px;\n    border:1.5px solid var(--teal); display:flex;align-items:center;justify-content:center;\n    color:var(--teal); box-shadow:0 0 40px rgba(86,237,214,.15);\n  }\n\n  /* חיצי ניווט צד — דסקטופ */\n  .arrow{\n    position:absolute; top:50%; transform:translateY(-50%);\n    width:40px;height:40px;border-radius:50%;\n    background:rgba(24,24,24,.85); border:1px solid var(--border);\n    color:var(--text-2); cursor:pointer; display:flex;align-items:center;justify-content:center;\n    transition:all .2s; z-index:5;\n  }\n  .arrow:hover{color:var(--teal); border-color:var(--teal)}\n  .arrow.next{left:10px}\n  .arrow.prev{right:10px}\n  .arrow[hidden]{display:none}\n  @media (max-width:480px){.arrow{display:none}}\n\n  .frame-caption{\n    position:fixed; bottom:22px; left:0; right:0; text-align:center;\n    color:var(--text-3); font-size:12px; pointer-events:none;\n  }\n  @media (max-width:900px){.frame-caption{display:none}}\n\n  @media (prefers-reduced-motion:reduce){\n    *{animation-duration:.01ms !important; transition-duration:.01ms !important}\n  }\n</style>\n</head>\n<body>\n<div class=\"ambient\"></div>\n\n<div class=\"phone\" id=\"phone\">\n  <header>\n    <div class=\"logo\">Nano<b>Shellano</b></div>\n    <div class=\"header-side\">\n      <button class=\"skip\" onclick=\"goTo(7)\">הרשמה</button>\n      <div class=\"lang\"><span class=\"on\">HE</span><span>/</span><span>EN</span></div>\n    </div>\n  </header>\n\n  <nav class=\"dots\" id=\"dots\" aria-label=\"התקדמות\"></nav>\n\n  <div class=\"stage\" id=\"stage\">\n\n    <!-- ══ 1 · Hero ══ -->\n    <section class=\"slide active\" data-cta=\"בוא, הסוכן שלך מחכה\">\n      <div class=\"slide-body hero\">\n        <div class=\"mascot\" title=\"כאן נכנס הקמע הקיים\">\n          <svg width=\"40\" height=\"40\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n            <circle cx=\"12\" cy=\"12\" r=\"9\" opacity=\".5\"/><path d=\"M12 7v5l3 3\"/>\n          </svg>\n        </div>\n        <h1>התקבל עובד חדש</h1>\n        <div class=\"sub\">הסוכן האישי שלך מתחיל היום</div>\n        <p class=\"para\" style=\"max-width:300px\">\n          ה‑AI כבר משנה את עולם העבודה, והסוכנים בדרך לכל תפקיד.\n          כאן תפגשו סוכן משלכם — ותלמדו לנהל אותו. בלי ידע טכני, לפני כולם.\n        </p>\n        <div class=\"chips\">\n          <span class=\"chip\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.4\" stroke-linecap=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg>חינם להתנסות</span>\n          <span class=\"chip\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"7\" y=\"2\" width=\"10\" height=\"20\" rx=\"2.5\"/></svg>קליק אחד מהנייד</span>\n          <span class=\"chip\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 018 0v3\"/></svg>מאובטח מהיסוד</span>\n        </div>\n      </div>\n    </section>\n\n    <!-- ══ 2 · צ'אט: משימות רוחביות ══ -->\n    <section class=\"slide\" data-cta=\"לא רק משימות — גם תוצרים\" data-chat=\"0\">\n      <div class=\"slide-body\">\n        <div class=\"demo-head\">\n          <div class=\"kicker\">ככה נעבוד יחד · 1/3</div>\n          <h2>משפט אחד. שרשרת פעולות.</h2>\n          <p class=\"para\">בקשה אחת הופכת לפעולות על פני כמה מערכות — וחוזרת אליך גמורה.</p>\n        </div>\n        <div class=\"chat-card\">\n          <div class=\"chat-top\">\n            <div class=\"avatar\">ג׳</div>\n            <div>\n              <div class=\"chat-name\">ג׳וני</div>\n              <div class=\"chat-status\"><span class=\"st-dot\"></span><span class=\"st-text\">מחובר</span></div>\n            </div>\n          </div>\n          <div class=\"chat-log\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ══ 3 · צ'אט: יצירת תוצרים ══ -->\n    <section class=\"slide\" data-cta=\"והוא גם קולגה\" data-chat=\"1\">\n      <div class=\"slide-body\">\n        <div class=\"demo-head\">\n          <div class=\"kicker\">ככה נעבוד יחד · 2/3</div>\n          <h2>לא רק עונה. מייצר.</h2>\n          <p class=\"para\">דוחות, מצגות, מסמכים, ניתוחים — תוצרים מוכנים, לא רק תשובות.</p>\n        </div>\n        <div class=\"chat-card\">\n          <div class=\"chat-top\">\n            <div class=\"avatar\">ג׳</div>\n            <div>\n              <div class=\"chat-name\">ג׳וני</div>\n              <div class=\"chat-status\"><span class=\"st-dot\"></span><span class=\"st-text\">מחובר</span></div>\n            </div>\n          </div>\n          <div class=\"chat-log\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ══ 4 · צ'אט: קולגה לאונבורדינג ══ -->\n    <section class=\"slide\" data-cta=\"עכשיו, ההבטחה שלנו\" data-chat=\"2\">\n      <div class=\"slide-body\">\n        <div class=\"demo-head\">\n          <div class=\"kicker\">ככה נעבוד יחד · 3/3</div>\n          <h2>הקולגה שיודע את התשובות.</h2>\n          <p class=\"para\">מהיום הראשון בתפקיד — מישהו שמכיר את הנהלים, האנשים והלו״ז שלך.</p>\n        </div>\n        <div class=\"chat-card\">\n          <div class=\"chat-top\">\n            <div class=\"avatar\">ג׳</div>\n            <div>\n              <div class=\"chat-name\">ג׳וני</div>\n              <div class=\"chat-status\"><span class=\"st-dot\"></span><span class=\"st-text\">מחובר</span></div>\n            </div>\n          </div>\n          <div class=\"chat-log\"></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ══ 5 · מניפסט ══ -->\n    <section class=\"slide\" data-cta=\"מה מחכה לך בפנים\">\n      <div class=\"slide-body manifesto\">\n        <div class=\"kicker\">ההבטחה שלנו</div>\n        <h2>סוכנים נכנסים לעולם העבודה.<br>מי שיידע לנהל אותם — <span class=\"accent\">יוביל.</span></h2>\n        <p class=\"para\">\n          אנחנו לא מוכרים קסם. אנחנו מכינים אנשים לעולם העבודה החדש —\n          התנסות אמיתית, בטוחה ופשוטה, בניהול סוכן אישי משלך.\n        </p>\n        <div class=\"principles\">\n          <div class=\"principle\">פשוט<small>בלי ידע טכני</small></div>\n          <div class=\"principle\">בטוח<small>סביבה מבודדת</small></div>\n          <div class=\"principle\">שלך<small>לומד אותך</small></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ══ 6 · יכולות ══ -->\n    <section class=\"slide\" data-cta=\"ורגע — כמה זה בטוח?\">\n      <div class=\"slide-body\" style=\"justify-content:center\">\n        <div class=\"kicker\">טעימה ראשונה</div>\n        <h2>מה הוא כבר עושה בשבילך</h2>\n        <div class=\"caps\">\n          <div class=\"cap\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"5\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 7l9 6 9-6\"/></svg><b>טיוטות מייל</b><span>מנוסחות בטון שלך, מוכנות לשליחה</span></div>\n          <div class=\"cap\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z\"/><path d=\"M14 2v6h6\"/></svg><b>מסמכים ומצגות</b><span>תוצרים שלמים מבקשה אחת</span></div>\n          <div class=\"cap\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"M21 21l-4.3-4.3\"/></svg><b>מחקר והשוואות</b><span>סריקה, סינון ושורה תחתונה</span></div>\n          <div class=\"cap\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 7v5l3 3\"/></svg><b>תזכורות ומעקבים</b><span>שום דבר לא נופל בין הכיסאות</span></div>\n          <div class=\"cap\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z\"/></svg><b>סיכומים ותקצירים</b><span>מפגישות, מסמכים ושרשורים</span></div>\n          <div class=\"cap\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 2l2.4 7.2H22l-6 4.6 2.3 7.2-6.3-4.5-6.3 4.5L8 13.8 2 9.2h7.6z\"/></svg><b>ידע פנימי</b><span>עונה לפי הנהלים והחומרים שלך</span></div>\n        </div>\n      </div>\n    </section>\n\n    <!-- ══ 7 · אמון ══ -->\n    <section class=\"slide\" data-cta=\"אני רוצה סוכן משלי\">\n      <div class=\"slide-body\" style=\"justify-content:center\">\n        <div class=\"kicker\">מתחת למכסה המנוע</div>\n        <h2>בטוח מהיסוד.</h2>\n        <div class=\"trust-list\">\n          <div class=\"trust\">\n            <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 9h18\"/></svg>\n            <div><b>סביבה מבודדת משלך</b><span>הסוכן שלך רץ לבד, בסביבה נפרדת. לא משותפת עם אף אחד אחר.</span></div>\n          </div>\n          <div class=\"trust\">\n            <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 018 0v3\"/></svg>\n            <div><b>המפתחות בכספת</b><span>סיסמאות וחיבורים שמורים בכספת נפרדת. הסוכן אף פעם לא רואה אותם.</span></div>\n          </div>\n          <div class=\"trust\">\n            <svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7z\"/><path d=\"M9 12l2 2 4-4\"/></svg>\n            <div><b>אתה קובע מה מותר</b><span>הסוכן מבקש אישור לפני פעולות, וההרשאות מתרחבות רק כשאתה מחליט.</span></div