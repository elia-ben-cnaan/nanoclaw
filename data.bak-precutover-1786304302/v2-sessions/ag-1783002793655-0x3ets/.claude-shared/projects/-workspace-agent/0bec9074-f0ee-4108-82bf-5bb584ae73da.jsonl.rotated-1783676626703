ont-size:14px;direction:ltr;\n  }\n  .tg-mic{width:38px;height:38px;border-radius:50%;background:#3f7be8;display:flex;align-items:center;justify-content:center;flex:0 0 auto}\n  .tg-clip{color:#7a8699;display:flex}\n\n  .manifesto-line{\n    flex:0 0 auto;text-align:center;color:var(--muted);font-size:13px;line-height:1.5;\n    padding:12px 6px 2px;\n  }\n  .manifesto-line b{color:var(--teal);font-weight:600}\n\n  /* ---------- slides 3-4: security / install ---------- */\n  .cards{display:flex;flex-direction:column;gap:9px;margin-top:16px}\n  .card{\n    display:flex;gap:12px;align-items:flex-start;\n    background:var(--surface);border:1px solid #242424;border-radius:14px;padding:12px 13px;\n  }\n  .card.featured{border-color:var(--teal-line);background:#0d1614}\n  .card .ic{\n    width:34px;height:34px;border-radius:9px;background:#132320;color:var(--teal);\n    display:flex;align-items:center;justify-content:center;flex:0 0 auto;margin-top:1px;\n  }\n  .card h3{font-size:13.8px;font-weight:600;line-height:1.35}\n  .card p{color:var(--muted);font-size:12.6px;line-height:1.55;margin-top:3px}\n  .soul{color:#7d7d7d;font-size:12px;line-height:1.6;text-align:center;margin-top:14px;padding-bottom:8px}\n\n  /* staggered reveal (security) */\n  .reveal-item{opacity:0;transform:translateY(12px);transition:opacity .5s ease,transform .5s ease}\n  .reveal-item.in{opacity:1;transform:none}\n  @media (prefers-reduced-motion:reduce){ .reveal-item{opacity:1;transform:none;transition:none} }\n\n  .steps{display:flex;flex-direction:column;gap:0;margin-top:16px}\n  .step{display:flex;gap:13px;position:relative;padding-bottom:16px}\n  .step:not(:last-child)::before{\n    content:\"\";position:absolute;inset-inline-start:15px;top:34px;bottom:2px;width:1px;background:var(--teal-dim);\n  }\n  .step-num{\n    width:31px;height:31px;border-radius:50%;background:#0d1614;border:1px solid var(--teal-dim);\n    color:var(--teal);font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;\n    flex:0 0 auto;position:relative;z-index:1;\n  }\n  .step h3{font-size:14.2px;font-weight:600;line-height:1.4;padding-top:5px}\n  .step p{color:var(--muted);font-size:12.8px;line-height:1.6;margin-top:4px}\n  .dl-row{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}\n  .dl-row a{\n    text-decoration:none;color:var(--teal);font-size:12.5px;font-weight:500;\n    border:1px solid var(--teal-line);background:#0d1614;border-radius:9px;padding:7px 12px;\n    transition:border-color .15s,background .15s;\n  }\n  .dl-row a:hover{border-color:var(--teal);background:#11201c}\n  .footnote{color:#7d7d7d;font-size:12px;text-align:center;margin-top:6px;padding-bottom:8px}\n\n  /* ---------- slide 5: signup ---------- */\n  form{display:flex;flex-direction:column;gap:11px;margin-top:16px;padding-bottom:8px}\n  .name-row{display:flex;gap:10px}\n  .name-row .field{flex:1 1 0;min-width:0}\n  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}\n  .field input{\n    width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;\n    color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;outline:none;\n    transition:border-color .15s;\n  }\n  .field input:focus{border-color:var(--teal)}\n  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n  .field.invalid input{border-color:var(--orange)}\n  .field.invalid .err{display:block}\n  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n  .consent input{width:16px;height:16px;accent-color:var(--teal);margin-top:1px;flex:0 0 auto}\n  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n  .consent.invalid{color:var(--orange)}\n\n  /* ---------- slide 6: done ---------- */\n  .done{justify-content:center;text-align:center}\n  .done-avatar{\n    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n    border:2px solid var(--teal-line);background:#0d1614;\n  }\n  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n  .done h1{font-size:26px}\n  .done .lead{max-width:300px;margin-inline:auto}\n  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n\n  /* ---------- bottom zone ---------- */\n  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n  .dots{display:flex;justify-content:center;gap:7px}\n  .dots button{\n    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n    transition:background .2s,width .2s;\n  }\n  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n  .cta{\n    width:100%;border:none;border-radius:12px;background:var(--teal);color:#04211C;\n    font-family:inherit;font-size:15.5px;font-weight:700;padding:14px;cursor:pointer;\n    transition:filter .15s;\n  }\n  .cta:hover{filter:brightness(1.07)}\n  .cta:disabled{opacity:.6;cursor:default}\n  .swipe-hint{\n    display:none;justify-content:center;align-items:center;gap:6px;\n    color:#8a8a8a;font-size:12.5px;\n  }\n  .swipe-hint svg{color:var(--teal);animation:nudge 1.6s ease-in-out infinite}\n  html[dir=\"ltr\"] .swipe-hint svg{transform:scaleX(-1)}\n  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n  html[dir=\"ltr\"] .swipe-hint svg{animation:nudgeLtr 1.6s ease-in-out infinite}\n  @keyframes nudgeLtr{0%,100%{transform:scaleX(-1) translateX(0)}50%{transform:scaleX(-1) translateX(-5px)}}\n  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n  @media (max-height:700px){\n    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n  }\n</style>\n</head>\n<body>\n\n<div class=\"phone\" id=\"phone\">\n  <div class=\"app-header\">\n    <div class=\"header-side\">\n      <button class=\"back-btn\" id=\"backBtn\" aria-label=\"חזרה\" disabled>\n        <svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      </button>\n      <img class=\"logo-img\" src=\"__LOGO__\" alt=\"NanoShellano\">\n    </div>\n    <div class=\"lang-toggle\" id=\"langToggle\" role=\"group\" aria-label=\"Language\">\n      <button data-lang=\"he\" class=\"on\">עב</button><button data-lang=\"en\">EN</button>\n    </div>\n  </div>\n\n  <div class=\"stage\" id=\"stage\">\n\n    <!-- 1 · hero -->\n    <section class=\"slide hero active\">\n      <div>\n        <img class=\"mascot\" src=\"__HERO__\" alt=\"\">\n        <h1 data-i18n-html=\"heroH1\">התקבל עובד חדש<br><span class=\"accent\">הסוכן AI שלך מתחיל היום</span></h1>\n        <p class=\"lead\" data-i18n=\"heroLead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי להיות לפני כולם.</p>\n        <div class=\"trust\" data-i18n-html=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n      </div>\n    </section>\n\n    <!-- 2 · telegram demo (auto simulation, no interaction) -->\n    <section class=\"slide demo before\">\n      <div class=\"chat-card\" id=\"chatCard\">\n        <div class=\"tg-header\">\n          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n          <div class=\"tg-avatar\"><img src=\"__FACE__\" alt=\"\"></div>\n          <div class=\"tg-title\">\n            <div class=\"tg-name