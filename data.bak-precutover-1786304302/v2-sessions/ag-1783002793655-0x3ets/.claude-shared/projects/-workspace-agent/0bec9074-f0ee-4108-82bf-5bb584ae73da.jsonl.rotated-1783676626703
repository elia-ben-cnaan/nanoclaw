ap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n315\t            <span>Message</span>\n316\t          </div>\n317\t          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n318\t          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n319\t        </div>\n320\t      </div>\n321\t      <p class=\"manifesto-line\" data-i18n-html=\"manifesto\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n322\t    </section>\n323\t\n324\t    <!-- 3 · security -->\n325\t    <section class=\"slide list-slide before\">\n326\t      <h1 data-i18n-html=\"secH1\">מאובטח, <span class=\"accent\">ורק שלך</span></h1>\n327\t      <p class=\"lead\" data-i18n=\"secLead\">לפני שמכניסים סוכן לחיים שלך מגיע לך לדעת מה קורה עם המידע. הנה ההבטחה בחמש נקודות.</p>\n328\t      <div class=\"cards\" id=\"secCards\">\n329\t        <div class=\"card featured reveal-item\">\n330\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n331\t          <div><h3 data-i18n=\"sec1T\">סוכן מבודד, על שרת משלך</h3><p data-i18n=\"sec1B\">רץ על שרת NanoClaw מבודד ששייך רק לך, בלי גישה חיצונית או ערבוב מידע עם אף אחד.</p></div>\n332\t        </div>\n333\t        <div class=\"card reveal-item\">\n334\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n335\t          <div><h3 data-i18n=\"sec2T\">בטלגרם, ערוץ סגור ומוצפן</h3><p data-i18n=\"sec2B\">ערוץ התקשורת היחיד שלך והמאובטח ביותר, נפרד לגמרי מהמייל ומהדרייב.</p></div>\n336\t        </div>\n337\t        <div class=\"card reveal-item\">\n338\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n339\t          <div><h3 data-i18n=\"sec3T\">לא מתחבר למערכות אישיות</h3><p data-i18n=\"sec3B\">מייל דרייב וחשבונות פרטיים חסומים לו בהגדרות, וזאת בחירה ולא מגבלה זמנית.</p></div>\n340\t        </div>\n341\t        <div class=\"card reveal-item\">\n342\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"4.5\"/><path d=\"M10.8 12.2L21 2\"/><path d=\"M15 8l3 3\"/></svg></div>\n343\t          <div><h3 data-i18n=\"sec4T\">כלי AI חיצוניים, דרך המפתחות שלך</h3><p data-i18n=\"sec4B\">מצגות וידאו ותוכן דרך המפתחות שלך, עם ניתוק בלחיצה.</p></div>\n344\t        </div>\n345\t        <div class=\"card reveal-item\">\n346\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M3 6h18\"/><path d=\"M8 6V4a2 2 0 012-2h4a2 2 0 012 2v2\"/><path d=\"M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6\"/></svg></div>\n347\t          <div><h3 data-i18n=\"sec5T\">מחיקה מלאה בכל רגע</h3><p data-i18n=\"sec5B\">מוחקים את כל היסטוריית הצ'אט וסוגרים את הסוכן בלחיצה אחת.</p></div>\n348\t        </div>\n349\t      </div>\n350\t      <p class=\"soul reveal-item\" data-i18n=\"soul\">מוח של ה-AI המתקדם בעולם, גוף של NanoClaw, ונשמה של אליה בן כנען.</p>\n351\t    </section>\n352\t\n353\t    <!-- 4 · install -->\n354\t    <section class=\"slide list-slide before\">\n355\t      <h1 data-i18n=\"installH1\">איך זה הולך להיות</h1>\n356\t      <p class=\"lead\" data-i18n=\"installLead\">ארבעה צעדים, מהרגע שלוחצים ועד שהסוכן עובד בשבילך.</p>\n357\t      <div class=\"steps\">\n358\t        <div class=\"step\">\n359\t          <div class=\"step-num\">1</div>\n360\t          <div>\n361\t            <h3 data-i18n=\"st1T\">הטלגרם, הערוץ הפרטי שלך</h3>\n362\t            <p data-i18n=\"st1B\">זמין באפליקציה לנייד, באפליקציה למחשב, וגם בדפדפן. מהיר, מסונכרן, ונוח לעבודה. אם יש לך כבר, אפשר לדלג לשלב הבא.</p>\n363\t            <div class=\"dl-row\">\n364\t              <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlMobile\">להורדה לנייד ←</a>\n365\t              <a href=\"https://desktop.telegram.org/\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlDesktop\">להורדה למחשב ←</a>\n366\t            </div>\n367\t          </div>\n368\t        </div>\n369\t        <div class=\"step\">\n370\t          <div class=\"step-num\">2</div>\n371\t          <div>\n372\t            <h3 data-i18n=\"st2T\">פותחים לך משתמש אישי</h3>\n373\t            <p data-i18n=\"st2B\">שם, טלפון ומייל. דרכם נפתח לך חשבון פרטי שלך בלבד, שאף אחד אחר לא נכנס אליו, גם לא אנחנו.</p>\n374\t          </div>\n375\t        </div>\n376\t        <div class=\"step\">\n377\t          <div class=\"step-num\">3</div>\n378\t          <div>\n379\t            <h3 data-i18n=\"st3T\">הסוכן שלך נבנה אוטומטית</h3>\n380\t            <p data-i18n=\"st3B\">ברגע שמאשרים, מתחילה הקמה אוטומטית של הסוכן האישי שלך. דקה-שתיים, ואנחנו מוודאים שהכל מוכן ומותאם רק לך.</p>\n381\t          </div>\n382\t        </div>\n383\t        <div class=\"step\">\n384\t          <div class=\"step-num\">4</div>\n385\t          <div>\n386\t            <h3 data-i18n=\"st4T\">השיחה הראשונה, בטלגרם</h3>\n387\t            <p data-i18n=\"st4B\">הסוכן נפתח אצלך בטלגרם, מציג את עצמו, ומכאן זה רק שיחה.</p>\n388\t          </div>\n389\t        </div>\n390\t      </div>\n391\t    </section>\n392\t\n393\t    <!-- 5 · signup -->\n394\t    <section class=\"slide list-slide before\">\n395\t      <h1 data-i18n=\"formH1\">פותחים לך משתמש</h1>\n396\t      <p class=\"lead\" style=\"margin-top:8px\" data-i18n=\"formLead\">שם, מייל וטלפון. הסוכן יפתח אצלך בטלגרם תוך דקה.</p>\n397\t      <form id=\"signupForm\" novalidate>\n398\t        <div class=\"name-row\">\n399\t          <div class=\"field\" id=\"fFirst\">\n400\t            <label for=\"inFirst\" data-i18n=\"firstL\">שם פרטי</label>\n401\t            <input id=\"inFirst\" type=\"text\" placeholder=\"השם שלך\" autocomplete=\"given-name\" data-i18n-ph=\"firstPh\">\n402\t            <div class=\"err\" data-i18n=\"firstE\">נא להזין שם פרטי</div>\n403\t          </div>\n404\t          <div class=\"field\" id=\"fLast\">\n405\t            <label for=\"inLast\" data-i18n=\"lastL\">שם משפחה</label>\n406\t            <input id=\"inLast\" type=\"text\" placeholder=\"שם משפחה\" autocomplete=\"family-name\" data-i18n-ph=\"lastPh\">\n407\t            <div class=\"err\" data-i18n=\"lastE\">נא להזין שם משפחה</div>\n408\t          </div>\n409\t        </div>\n410\t        <div class=\"field\" id=\"fEmail\">\n411\t          <label for=\"inEmail\" data-i18n=\"emailL\">אימייל</label>\n412\t          <input id=\"inEmail\" type=\"email\" placeholder=\"name@company.com\" autocomplete=\"email\">\n413\t          <div class=\"err\" data-i18n=\"emailE\">נא להזין אימייל תקין</div>\n414\t        </div>\n415\t        <div class=\"field\" id=\"fPhone\">\n416\t          <label for=\"inPhone\" data-i18n=\"phoneL\">טלפון</label>\n417\t          <input id=\"inPhone\" type=\"tel\" placeholder=\"050-0000000\" autocomplete=\"tel\">\n418\t          <div class=\"err\" data-i18n=\"phoneE\">נא להזין מספר טלפון תקין</div>\n419\t        </div>\n420\t        <label class=\"consent\" id=\"consentWrap\">\n421\t          <input type=\"checkbox\" id=\"inConsent\">\n422\t          <span data-i18n-html=\"consent\">קראתי ואישרתי את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a></span>\n423\t        </label>\n424\t      </form>\n425\t    </section>\n426\t\n427\t    <!-- 6 · done -->\n428\t    <section class=\"slide done before\">\n429\t      <div>\n430\t        <div class=\"done-avatar\"><img src=\"__FACE__\" alt=\"\"></div>\n431\t        <h1 id=\"doneTitle\">הסוכן שלך מחכה בטלגרם</h1>\n432\t        <p class=\"lead\" data-i18n=\"doneLead\">הוא כבר כתב לך הודעה ראשונה. לחיצה אחת, ואתם מתחילים.</p>\n433\t        <p class=\"rescue\"><span data-i18n=\"rescueQ\">לא הגיע קישור? עדיין אין טלגרם?</span><br><a id=\"rescueLink\" data-i18n=\"rescueA\">חזרה לשלבי ההתקנה</a></p>\n434\t      </div>\n435\t    </section>\n436\t\n437\t  </div>\n438\t\n439\t  <div class=\"cta-zone\">\n440\t    <div class=\"dots\" id=\"dots\"></div>\n441\t    <button class=\"cta\" id=\"ctaBtn\">קדימה, הסוכן שלך מחכה</button>\n442\t    <div class=\"swipe-hint\" id=\"swipeHint\">\n443\t      <span data-i18n=\"swipeHint\">החליקו לראות אותו בפעולה</span>\n444\t      <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n445\t    </div>\n446\t    <div class=\"cta-foot\" id=\"ctaFoot\"></div>\n447\t  </div>\n448\t</div>\n449\t\n450\t<div class=\"caption\">Shellano · מוקאפ v4 · עב/EN · דמו אוטומטי</div>\n451\t\n452\t<script>\n453\t/* ==========