n; gap:10px; margin:4px 0 14px}\n  .cap{display:flex; gap:12px; align-items:flex-start; background:var(--panel); border:1px solid var(--line);\n    border-radius:13px; padding:11px 13px; text-align:start}\n  .cap .ci{flex:0 0 34px; width:34px; height:34px; border-radius:10px; background:var(--panel2);\n    border:1px solid var(--line); display:flex; align-items:center; justify-content:center; font-size:17px}\n  .cap .ct b{display:block; font-size:13.5px; margin-bottom:1px}\n  .cap .ct span{font-size:12px; color:var(--mut); line-height:1.45}\n\n  /* mini chat demo */\n  .demo{background:#0c1418; border:1px solid #1a2832; border-radius:16px; padding:13px 12px; margin:2px 0 6px;\n    background-image:radial-gradient(rgba(255,255,255,.025) 1px,transparent 1px); background-size:18px 18px}\n  .demo-top{display:flex; align-items:center; gap:9px; padding-bottom:11px; border-bottom:1px solid #1a2832; margin-bottom:12px}\n  .demo-av{width:30px; height:30px; border-radius:50%; background:linear-gradient(135deg,#56EDD6,#0F756D);\n    display:flex; align-items:center; justify-content:center; font-weight:800; color:#04211D; font-size:14px}\n  .demo-nm{font-size:13px; font-weight:700}\n  .demo-on{font-size:10.5px; color:#56EDD6}\n  .bub{max-width:90%; background:#17242c; border-radius:14px 14px 14px 4px; padding:9px 12px;\n    font-size:13px; line-height:1.55; color:#eaf2f4; margin-bottom:8px; animation:pop .34s ease both}\n  @keyframes pop{from{opacity:0; transform:translateY(6px) scale(.98)} to{opacity:1; transform:none}}\n  .bub:last-child{margin-bottom:0}\n  .bub.me{background:#244536; border-radius:14px 14px 4px 14px; margin-inline-start:auto; color:#dff5ea}\n  .bub b{color:#fff}\n  .bub .ok{color:#56EDD6; font-weight:800}\n\n  /* install strip */\n  .istrip{display:flex; gap:8px; margin:6px 0 18px}\n  .istep{flex:1; background:var(--panel); border:1px solid var(--line); border-radius:13px; padding:13px 7px; text-align:center}\n  .istep .in{width:27px; height:27px; border-radius:50%; background:var(--teal); color:var(--on-teal);\n    font-weight:800; font-size:13px; display:flex; align-items:center; justify-content:center; margin:0 auto 8px}\n  .istep b{display:block; font-size:11.5px; line-height:1.35; color:var(--ink)}\n\n  /* form */\n  label{display:block; font-size:13px; color:var(--mut); font-weight:700; margin:14px 2px 6px}\n  .inp{width:100%; background:var(--panel); border:1px solid var(--line); border-radius:12px;\n    padding:14px; color:var(--ink); font-size:15.5px; font-family:inherit}\n  .inp:focus{outline:none; border-color:var(--teal-deep)}\n  .seg-g{display:flex; gap:8px; margin-top:6px}\n  .seg-g button{flex:1; padding:12px; border-radius:11px; border:1px solid var(--line);\n    background:var(--panel); color:var(--mut); font-size:14.5px; font-weight:700; font-family:inherit; cursor:pointer}\n  .seg-g button.on{background:var(--teal); color:var(--on-teal); border-color:var(--teal)}\n  .check{display:flex; gap:11px; align-items:flex-start; margin-top:16px; font-size:13px; color:var(--mut); line-height:1.5; text-align:start; cursor:pointer}\n  .box{flex:0 0 24px; width:24px; height:24px; border-radius:7px; border:1px solid var(--line); background:var(--panel);\n    color:var(--on-teal); display:flex; align-items:center; justify-content:center; font-size:15px; font-weight:800; margin-top:1px; transition:.2s}\n  .check.on .box{background:var(--teal); border-color:var(--teal)}\n  .check .box span{opacity:0; transition:.2s}\n  .check.on .box span{opacity:1}\n  .check b{color:var(--teal)}\n  .tlink{color:var(--teal); text-decoration:underline; text-underline-offset:2px; cursor:pointer; font-weight:600}\n\n  .ho-ico{width:78px; height:78px; border-radius:22px;\n    background:radial-gradient(circle at 50% 40%,rgba(86,237,214,.3),transparent 70%),linear-gradient(135deg,#0F756D,#093f3a);\n    display:flex; align-items:center; justify-content:center; font-size:40px}\n  .tg-peek{display:flex; gap:10px; align-items:center; background:#0c1418; border:1px solid #1a2832; border-radius:14px; padding:11px 12px; max-width:300px}\n  .peek-av{flex:0 0 32px; width:32px; height:32px; border-radius:50%; background:linear-gradient(135deg,#56EDD6,#0F756D);\n    display:flex; align-items:center; justify-content:center; font-weight:800; color:#04211D; font-size:15px}\n  .peek-bub{font-size:13px; color:#cfe0e3; line-height:1.4; text-align:start}\n\n  .foot{flex:0 0 auto; padding:12px 22px calc(18px + env(safe-area-inset-bottom)); background:linear-gradient(transparent,#000 22%)}\n  .cta{width:100%; padding:16px; border:0; border-radius:14px; background:var(--teal); color:var(--on-teal);\n    font-size:16px; font-weight:800; font-family:inherit; cursor:pointer; transition:.15s; min-height:54px}\n  .cta:active{transform:scale(.985)}\n  .cta[disabled]{opacity:.32; pointer-events:none; background:var(--panel2); color:var(--dim); border:1px solid var(--line)}\n  .note{color:var(--dim); font-size:11.5px; text-align:center; margin-top:12px; line-height:1.55}\n\n  /* sheet overlay */\n  .sheet{position:absolute; inset:0; z-index:55; background:rgba(0,0,0,.82); backdrop-filter:blur(4px);\n    display:none; flex-direction:column; justify-content:flex-end}\n  .sheet.on{display:flex; animation:fade .25s ease both}\n  @keyframes fade{from{opacity:0} to{opacity:1}}\n  .sheet-card{background:var(--panel); border:1px solid var(--line); border-radius:22px 22px 0 0;\n    padding:22px 22px calc(22px + env(safe-area-inset-bottom)); max-height:82%; overflow-y:auto; animation:up .3s ease both}\n  @keyframes up{from{transform:translateY(40px); opacity:.5} to{transform:translateY(0); opacity:1}}\n  .sheet-card h3{font-size:18px; font-weight:800; margin-bottom:12px}\n  .sheet-card p{font-size:13.5px; color:var(--mut); line-height:1.8; margin-bottom:10px; text-align:start}\n  .sheet-card p b{color:var(--ink)}\n  .cta.ghost{background:transparent; color:var(--teal); border:1px solid var(--teal-deep); margin-top:6px}\n\n  /* magic / handoff overlay */\n  .switch{position:absolute; inset:0; z-index:50; background:rgba(0,0,0,.93); backdrop-filter:blur(5px);\n    display:none; flex-direction:column; align-items:center; justify-content:center; gap:18px; text-align:center; padding:30px}\n  .switch.on{display:flex; animation:fade .25s ease both}\n  .switch .ho-ico{animation:bob 1.4s ease-in-out infinite}\n  @keyframes bob{0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)}}\n  .switch h2{margin:0}\n  .switch p{color:var(--mut); font-size:14px; line-height:1.6}\n  .switch b{color:var(--ink)}\n</style>\n</head>\n<body>\n  <div class=\"device\">\n    <div class=\"topbar\">\n      <button class=\"back\" id=\"back\" onclick=\"go(-1)\" aria-label=\"back\">→</button>\n      <div class=\"prog\" id=\"prog\"></div>\n      <div class=\"stepn\" id=\"stepn\"></div>\n      <div class=\"lang\" id=\"lang\" onclick=\"toggleLang()\">EN</div>\n    </div>\n    <div class=\"stage\" id=\"stage\"></div>\n    <div class=\"foot\" id=\"foot\"></div>\n    <div class=\"sheet\" id=\"sheet\"></div>\n    <div class=\"switch\" id=\"switch\"></div>\n  </div>\n\n<script>\nconst N = 6;\nconst BOT_FALLBACK = 'https://t.me/Nanoco_pilot_bot';\nlet i = 0, L = 'he', agree = false, animating = false, submitting = false;\nlet deepLink = '';\nconst reg = { name:'', phone:'', email:'' };\n\nconst T = {\n  he:{\n    /* 1 NEED */\n    s1_kick:'NanoShellano',\n    s1_title:'עולם העבודה משתנה.<br>כבר עכשיו.',\n    s1_p:[\n      'בכל חודש שעובר, סוכני AI נכנסים לעוד מחלקה, לעוד תפקיד, לעוד שולחן עבודה. זה כבר לא עתיד, זה ההווה.',\n      'מי שיודע לעבוד עם סוכן ימצא את עצמו <b>צעד אחד לפני כולם</b>. ומי שלא, ימצא את עצמו עושה ביד דברים שסוכן עושה בשניות.',\n      'הצעד הכי חשוב שתעשה השנה הוא לפתוח סוכן אחד משלך, ולהתחיל לעבוד איתו. <span class=\"em\">בלי רקע טכני, בלי קוד.</span>'\n    ],\n    s1_cta:'אני רוצה להיכנס לעולם הזה →',\n    s1_note:'פיילוט בגישה מוזמנת · גרסה ראשונה',\n    s1_by:'מאת אליה בן כנען',\n\n    /* 2 FREE */\n    s2_kick:'למה בחינם',\n    s2_title:'ולמה אני נותן<br>את זה בחינם',\n    s2_p:[\n      'לפני שנה לא ידעתי לכתוב שורת קוד אחת. היום יש לי סוכנים שעושים בשבילי חצי מהעבודה, וזה שינה לי לגמרי את הדרך שבה אני עובד.',\n      'אז במקום לשמור את זה לעצמי, בניתי דרך פשוטה שתעביר גם אותך לצד השני. <b>בלי לשלם שקל.</b>',\n      'זה פיילוט שאני עושה כדי להכניס כמה שיותר אנשים לעולם הסוכנים. בלי כרטיס אשראי, בלי התחייבות, בלי קאצ\\'.'\n    ],\n    s2_cta:'יפה, ומה עם הפרטיות? →',\n    s2_note:'בלי עלות נסתרת. הפיילוט פתוח ובחינם.',\n\n    /* 3 SECURE */\n    s3_kick:'מאובטח',\n    s3_title:'מאובטח, ורק שלך',\n    s3_lead:'לפני שמכניסים סוכן לחיים שלך, מגיע לך לדעת בדיוק מה קורה עם המידע.',\n    s3_sic:'🔒',\n    s3_sec_t:'חשבון מבודד, רק שלך',\n    s3_sec:'הסוכן חי בחשבון נפרד ומבודד שמיוחד רק לך. כל חיבור נסגר מוצפן, והמידע שלך לא מתערבב עם אף אחד.',\n    s3_f:[\n      ['🔑','אתה מאשר כל חיבור בעצמך','שום שירות לא מתחבר בלי שאתה לוחץ \"אשר\", בחשבון שלך. מחברים רק מה שבא לך.'],\n      ['🚪','מנתקים ומוחקים בכל רגע','בלחיצה אחת מנתקים שירות, ובלחיצה אחת מוחקים את הסוכן ואת כל הנתונים איתו.'],\n      ['🛡️','לא מוכרים, לא משתפים','המידע שלך לא נמכר ולא עובר לאף אחד. הוא נשאר אצלך.']\n    ],\n    s3_honest:'<b>בכנות:</b> זו לא הבטחה ש\"אין לנו גישה\". זו שליטה אמיתית, אתה מחליט, אתה מאשר, ואתה מבטל מתי שתרצה.',\n    s3_nano_link:'מה זה NanoClaw בעצם?',\n    s3_cta:'הבנתי, איך זה הולך להיות? →',\n    s3_note:'אפשר לשוחח עם הסוכן בכל שפה, בעברית או באנגלית.',\n\n    /* 4 FLOW */\n    s4_kick:'הדרך',\n    s4_title:'איך זה הולך להיות',\n    s4_lead:'חמישה צעדים מהרגע שתלחץ \"מתחילים\" ועד שהסוכן עובד בשבילך.',\n    s4_flow:[\n      ['פותחים לך משתמש','שם, טלפון, מייל. לוקח דקה.'],\n      ['מוקם לך סוכן אישי','המערכת מקימה לך סוכן על שרת מנוהל, תמיד פעיל, רק שלך.'],\n      ['מקבלים קוד לטלגרם','קישור אישי שמחבר את הסוכן ישירות לטלגרם שלך.'],\n      ['נכנסים לשיחה','הסוכן מקבל את פניך בשמך, ומתחילים לדבר בשפה רגילה.'],\n      ['מחברים כלים, כשרוצים','מייל, יומן, וואטסאפ. מחברים בקצב שלך, בלחיצה.']\n    ],\n    s4_cta:'ומה הוא בעצם עושה? →',\n    s4_note:'הכל קורה תוך כמה דקות. אתה רק עוקב אחרי המסכים.',\n\n    /* 5 — ככה נעבוד יחד */\n    s5_how_t:'ככה נעבוד יחד',\n    s5_agent:'ג\\'וני',\n    s5_typing:'זמין עכשיו',\n    s5_cases:[\n      {t:'משימות רוחביות', s:'בקשה אחת הופכת לשרשרת פעולות על פני כמה מערכות, וחוזרת אליך גמורה.',\n       c:[['me','עדכן את הלקוח ב-CRM, תכין הצעת מחיר ותשלח לו במייל'],\n          ['bot','על איזה סכום ההצעה?'],\n          ['me','45 אלף, כמו שסיכמנו בפגישה'],\n          ['bot','עדכנתי ב-CRM, הכנתי הצעה, וכתבתי טיוטת מייל ללקוח.'],\n          ['bot','המייל ממתין לאישורך. תיכנס ותאשר שליחה.']]},\n      {t:'יצירת תוצרים', s:'לא רק עונה, מייצר את התוצרים עצמם. דוחות, מצגות, מסמכים וניתוחים.',\n       c:[['me','אני צריך מצגת 10 שקפים על תוצאות Q2, לישיבה ב-3'],\n          ['bot','במיתוג שלנו או של הלקוח?'],\n          ['me','שלנו, עם הלוגואים של הלקוחות החדשים'],\n          ['bot','בונה: פתיחה, 7 שקפי גרפים וסיכום עם המלצות.'],\n          ['bot','מוכנה, מצורפת.','מצגת_Q2.pptx']]},\n      {t:'קולגה לאונבורדינג', s:'חדש בתפקיד? הוא הקולגה שמלווה אותך שלב שלב.',\n       c:[['me','חדש בתפקיד. איך פותחים בקשת רכש?'],\n          ['bot','עליי. פותח לך בקשה ב-CRM ומעדכן את הפרטים לפי הנהלים. על איזה סכום?'],\n          ['me','הזמנת ציוד משרדי, תקציב 6000 שקל'],\n          ['bot','מילאתי ושלחתי לאישור המנהל. תמתין לאישור במייל.']]},\n      {t:'מתחדש בכלי AI', s:'כלי AI חדש כל שבוע, ואי אפשר להדביק. אז הוא מדביק במקומך.',\n       c:[['me','אני צריך סרטון הדרכה לנהלים החדשים במשרד'],\n          ['bot','יצא כלי חדש שמרכיב סרטונים מצילומים של המשרד והאנשים. יש לך תמונות?'],\n          ['me','מצרף תמונות של הצוות והמשרד','תמונות_הצוות.zip'],\n          ['bot','בוצע. העליתי את הסרטון לדרייב ושלחתי לאישור המנהלת.']]}\n    ],\n    s5_cta:'אז מה אנחנו מבטיחים? →',\n    s5_note:'בחר תרחיש כדי לראות איך זה נראה בשיחה אמיתית.',\n\n    /* 6 INSTALL + REGISTER */\n    s6_kick:'התקנה',\n    s6_title:'ההתקנה, ומשם הקסם',\n    s6_lead:'שלוש דקות. פותחים לך משתמש, מקבלים קוד לטלגרם, <b>ומשם הקסם מתחיל.</b>',\n    s6_steps:[['1','ממלאים פרטים'],['2','מקבלים קוד לטלגרם'],['3','הקסם מתחיל']],\n    s6_name:'שם מלא', s6_name_ph:'איך קוראים לך',\n    s6_phone:'טלפון', s6_phone_ph:'050-0000000',\n    s6_email:'מייל', s6_email_ph:'you@example.com',\n    s6_check:'קראתי ומאשר את <a class=\"tlink\" onclick=\"event.stopPropagation();openSheet(\\'priv\\')\">תנאי השימוש והפרטיות</a>. האישור הזה פותח את הסוכן.',\n    s6_cta:'פתח לי סוכן →', s6_cta_load:'פותח לך סוכן…',\n    s6_note:'הפרטים נשמרים כדי שהסוכן יקבל את פניך נכון. בלי ספאם.',\n\n    magic_t:'הסוכן שלך מוכן ✨',\n    magic_p:'פתחנו לך טלגרם. הסוכן <b>מחכה לך שם</b>, רק תגיד שלום.',\n    magic_peek:'אהלן! 👋 אני הננו שלך, מוכן להתחיל. על מה נצלול ראשון?',\n\n    sheet_nano_t:'מה זה NanoClaw?',\n    sheet_nano:[\n      '<b>NanoClaw</b> היא תשתית הסוכנים שעליה הכל רץ. סוכן אישי שחי על שרת מנוהל, תמיד פעיל, ומדבר איתך דרך טלגרם בשפה רגילה.',\n      'הסוכן הוא שלך, לא של חברה. הוא לומד מה אתה צריך, מבצע משימות, ויכול להתחבר למערכות שלך כשתרצה, תמיד בשליטה שלך.',\n      'הפיילוט הזה הוא הדרך הכי פשוטה לפתוח סוכן כזה, בלי רקע טכני ובלי הגדרות.'\n    ],\n    sheet_priv_t:'תנאי שימוש ופרטיות',\n    sheet_priv:[\n      '<b>פיילוט.</b> השירות הוא פיילוט ניסיוני שניתן בחינם, לתקופה של כחודש בשלב זה. אנחנו רשאים לשנות, להאריך, להשהות או להפסיק אותו בכל עת, ללא הודעה מוקדמת וללא התחייבות להמשך זמינות.',\n      '<b>מה אנחנו אוספים.</b> פרטים שתמסור בהרשמה (שם, טלפון, מייל), תוכן השיחות שלך עם הסוכן, ומידע משירותים שתבחר לחבר, רק אחרי שאתה מאשר כל חיבור בעצמך.',\n      '<b>למה.</b> המידע משמש כדי להקים ולהפעיל את הסוכן האישי שלך, לקבל את פניך נכון, ולתפעל את השירות. לא למטרה אחרת.',\n      '<b>איפה זה נשמר.</b> הסוכן חי בחשבון נפרד ומבודד שמיוחד רק לך. החיבורים מוצפנים, והמידע שלך לא מתערבב עם משתמשים אחרים.',\n      '<b>שיתוף.</b> אנחנו לא מוכרים ולא משתפים את המידע שלך. כדי שהשירות יעבוד הוא רץ על תשתיות צד שלישי (שרת מנוהל, טלגרם, וספקי מודל AI) שמעבדים נתונים רק לצורך הפעלת השירות.',\n      '<b>שליטה ומחיקה.</b> אתה בשליטה מלאה. כדי למחוק הכל, פשוט כותב לסוכן את פקודת המחיקה (למשל \"מחק והפסק\") והוא מוחק את כל היסטוריית השיחה שלך ומפסיק לפעול. אחר כך אפשר למחוק את איש הקשר בטלגרם, והסוכן לא יגיב יותר. תמיד אפשר גם לפנות אלינו לבקשת מחיקה.',\n      '<b>שמירת מידע.</b> המידע נשמר כל עוד הסוכן שלך פעיל, או עד שתמחק אותו. אם הפיילוט יופסק, נמחק את הנתונים בהתאם.',\n      '<b>בלי אחריות.</b> זה שירות ניסיוני שמסופק כמו שהוא (as is). אין הבטחה לזמינות רציפה, ואין להסתמך עליו לשימושים קריטיים או למידע רגיש.',\n      '<b>גיל.</b> השימוש מיועד לבני 18 ומעלה.',\n      '<b>שינויים.</b> נוכל לעדכן את התנאים מעת לעת. המשך השימוש מהווה הסכמה לגרסה המעודכנת.',\n      '<b>יצירת קשר.</b> לכל שאלה: 052-8738698 · elia@bencnaan.net'\n    ],\n    sheet_close:'הבנתי'\n  },\n\nen:{\n  s1_kick:'NanoShellano',\n  s1_title:'The world of work<br>is changing. Right now.',\n  s1_p:[\n    'Every month, AI agents move into another department, another role, another desk. This stopped being a prediction. It is already happening.',\n    'People who learn to work with an agent will be <b>a step ahead of everyone else</b>. People who don\\'t will keep doing by hand what an agent finishes in seconds.',\n    'The most important move you can make this year is to open an agent of your own and start working with it. <span class=\"em\">No technical background, no code.</span>'\n  ],\n  s1_cta:'I want in →',\n  s1_note:'Invite-only pilot · First release',\n  s1_by:'Built by Elia Ben Cnaan',\n\n  s2_kick:'Why free',\n  s2_title:'And why I give<br>it away for free',\n  s2_p:[\n    'A year ago I couldn\\'t write a single line of code. Today, agents do half my work for me, and they\\'ve changed the way I work from the ground up.',\n    'So rather than keep that to myself, I built a simple way to bring you across to the other side too. <b>Without spending a cent.</b>',\n    'This is a pilot I\\'m running to bring as many people as I can into the world of agents. No credit card, no commitment, no catch.'\n  ],\n  s2_cta:'Sounds good. What about privacy? →',\n  s2_note:'No hidden costs. The pilot is open and free.',\n\n  s3_kick:'Security',\n  s3_title:'Secure, and yours alone',\n  s3_lead:'Before you let an agent into your life, you deserve to know exactly what happens with your data.',\n  s3_sic:'🔒',\n  s3_sec_t:'An isolated account, just for you',\n  s3_sec:'Your agent lives in a separate, isolated account dedicated to you alone. Every connection is encrypted, and your data never mixes with anyone else\\'s.',\n  s3_f:[\n    ['🔑','You approve every connection','Nothing connects until you tap \"approve\", inside your own account. You connect only what you choose to.'],\n    ['🚪','Disconnect and delete anytime','One tap disconnects a service. One tap deletes the agent, along with everything it knows.'],\n    ['🛡️','Never sold, never shared','Your data isn\\'t sold and doesn\\'t get passed to anyone. It stays yours.']\n  ],\n  s3_honest:'<b>To be honest:</b> this isn\\'t a \"we have no access\" promise. It\\'s real control. You decide, you approve, and you can revoke it all whenever you want.',\n  s3_nano_link:'So what is NanoClaw, exactly?',\n  s3_cta:'Got it. How does it work? →',\n  s3_note:'You can chat with the agent in any language, Hebrew or English.',\n\n  s4_kick:'The path',\n  s4_title:'Here\\'s how it goes',\n  s4_lead:'Five steps between tapping \"start\" and having an agent that works for you.',\n  s4_flow:[\n    ['Open your account','Name, phone, email. Takes a minute.'],\n    ['Your personal agent is created','It runs on a managed server, always on, and belongs only to you.'],\n    ['Get your Telegram code','A personal link that drops the agent straight into your Telegram.'],\n    ['Step into the chat','The agent greets you by name, and you just talk, in plain language.'],\n    ['Connect tools when you\\'re ready','Email, calendar, WhatsApp. Each one is a single tap, at your own pace.']\n  ],\n  s4_cta:'So what can it actually do? →',\n  s4_note:'The whole thing takes a few minutes. Just follow the screens.',\n\n  s5_how_t:'Here\\'s how we\\'ll work',\n  s5_agent:'Joni',\n  s5_typing:'online',\n  s5_cases:[\n    {t:'Tasks across your systems', s:'One request becomes a chain of actions across several systems, and comes back to you finished.',\n     c:[['me','Update the client in the CRM, prep a quote and email it over'],\n        ['bot','What amount should the quote be for?'],\n        ['me','45K, like we agreed in the meeting'],\n        ['bot','CRM updated, quote ready, and I\\'ve drafted the email to the client.'],\n        ['bot','The email is waiting for your sign-off. Open it and approve to send.']]},\n    {t:'Creates real deliverables', s:'It produces the actual work: reports, decks, documents, analyses.',\n     c:[['me','I need a 10-slide deck on the Q2 results, for a 3pm meeting'],\n        ['bot','Our branding or the client\\'s?'],\n        ['me','Ours, with the new clients\\' logos'],\n        ['bot','On it: an intro, 7 chart slides, and a summary with recommendations.'],\n        ['bot','Done, attached.','Q2_deck.pptx']]},\n    {t:'Your onboarding buddy', s:'New on the job? It\\'s the colleague who walks you through everything, step by step.',\n     c:[['me','Just started the role. How do I open a purchase request?'],\n        ['bot','On it. I\\'ll open a request in the CRM and fill in the details according to policy. What amount?'],\n        ['me','Office equipment, budget is 6,000'],\n        ['bot','Filled in and sent to your manager for approval. Keep an eye out for the confirmation email.']]},\n    {t:'Keeps up with AI tools', s:'A new AI tool drops every week. Nobody can keep up, so it keeps up for you.',\n     c:[['me','I need a training video for the new office procedures'],\n        ['bot','A new tool just came out that builds videos from photos of the office and the team. Got any pictures?'],\n        ['me','Attaching photos of the team and the office','team_photos.zip'],\n        ['bot','Done. The video is up on Drive and sent to your manager for approval.']]}\n  ],\n  s5_cta:'So what\\'s the promise? →',\n  s5_note:'Pick a scenario to see how it plays out in a real conversation.',\n\n  s6_kick:'Install',\n  s6_title:'A short setup, then the magic',\n  s6_lead:'Three minutes. We open your account, a code lands in your Telegram, <b>and from there the magic begins.</b>',\n  s6_steps:[['1','Fill in your details'],['2','Get your Telegram code'],['3','The magic begins']],\n  s6_name:'Full name', s6_name_ph:'Your name',\n  s6_phone:'Phone', s6_phone_ph:'050-0000000',\n  s6_email:'Email', s6_email_ph:'you@example.com',\n  s6_check:'I\\'ve read and accept the <a class=\"tlink\" onclick=\"event.stopPropagation();openSheet(\\'priv\\')\">terms of use and privacy policy</a>. This confirmation is what opens your agent.',\n  s6_cta:'Open my agent →', s6_cta_load:'Opening your agent…',\n  s6_note:'We save your details so the agent can greet you properly. No spam.',\n\n  magic_t:'Your agent is ready ✨',\n  magic_p:'We\\'ve opened Telegram for you. Your agent is <b>already waiting</b>, just say hi.',\n  magic_peek:'Hey! 👋 I\\'m your Nano, ready to go. What should we dive into first?',\n\n  sheet_nano_t:'What is NanoClaw?',\n  sheet_nano:[\n    '<b>NanoClaw</b> is the infrastructure everything here runs on: a personal agent that lives on a managed server, stays on around the clock, and talks with you over Telegram in plain language.',\n    'The agent belongs to you, not to some company. It learns what you need, gets things done, and can connect to your systems when you choose, always under your control.',\n    'This pilot is the simplest way to get an agent of your own, with no technical background and nothing to configure.'\n  ],\n  sheet_priv_t:'Terms of use & privacy',\n  sheet_priv:[\n    '<b>Pilot.</b> This service is an experimental pilot, provided free of charge, for a period of roughly one month at this stage. We may change, extend, pause or discontinue it at any time, without prior notice and with no commitment to continued availability.',\n    '<b>What we collect.</b> The details you provide at signup (name, phone, email), the content of your conversations with the agent, and data from services you choose to connect, only after you approve each connection yourself.',\n    '<b>Why.</b> We use it to set up and run your personal agent, greet you by name, and operate the service. Nothing beyond that.',\n    '<b>Where it is stored.</b> Your agent runs in a separate, isolated account dedicated to you alone. Connections are encrypted, and your data never mixes with other users\\'.',\n    '<b>Sharing.</b> We do not sell or share your data. To function, the service relies on third-party infrastructure (a managed server, Telegram, and AI model providers) that processes data only to operate the service.',\n    '<b>Control and deletion.</b> You are in full control. To delete everything, send the agent a delete command (for example \"delete and exit\") and it wipes your entire chat history and stops working. You can then delete the contact in Telegram, and the agent will not respond again. You can also contact us at any time to request deletion.',\n    '<b>Retention.</b> Data is kept while your agent is active, or until you delete it. If the pilot ends, we delete the data accordingly.',\n    '<b>No warranty.</b> This is an experimental service, provided as is. Continuous availability is not guaranteed, and it should not be relied on for critical uses or sensitive data.',\n    '<b>Age.</b> The service is intended for users aged 18 and over.',\n    '<b>Changes.</b> We may update these terms from time to time. Continued use means you accept the updated version.',\n    '<b>Contact.</b> For any question: 052-8738698 · elia@bencnaan.net'\n  ],\n  sheet_close:'Got it'\n}\n};\n\nfunction esc(s){ return String(s).replace(/\"/g,'&quot;'); }\nfunction bubbles(arr){\n  return arr.map(b=>`<div class=\"bub${b[0]==='me'?' me':''}\">${b[1]}</div>`).join('');\n}\n\nfunction screenHTML(t){\n  switch(i){\n    case 0: return `\n      <div class=\"glow\"></div>\n      <img class=\"lockup\" src=\"nanoshellano-lockup-trim.png\" alt=\"NanoShellano\">\n      <div class=\"hero-mascot\"><img src=\"nanoshellano-mascot.png\" alt=\"NanoShellano\"></div>\n      <h2>${t.s1_title}</h2>\n      ${t.s1_p.map(p=>`<p class=\"prose\">${p}</p>`).join('')}\n      <div class=\"spacer\"></div>`;\n    case 1: return `\n      <div class=\"glow\"></div>\n      <div class=\"kick\">${t.s2_kick}</div>\n      <h2>${t.s2_title}</h2>\n      ${t.s2_p.map(p=>`<p class=\"prose\">${p}</p>`).join('')}\n      <div class=\"spacer\"></div>`;\n    case 2: return `\n      <div class=\"glow\"></div>\n      <div class=\"kick\">${t.s3_kick}</div>\n      <h2>${t.s3_title}</h2>\n      <p class=\"lead\">${t.s3_lead}</p>\n      <div class=\"secband\"><div class=\"sic\">${t.s3_sic}</div><div class=\"stx\"><b>${t.s3_sec_t}</b>${t.s3_sec}</div></div>\n      <div class=\"flist\">\n        ${t.s3_f.map(f=>`<div class=\"fitem\"><div class=\"fic\">${f[0]}</div><div class=\"ftx\"><b>${f[1]}</b>${f[2]}</div></div>`).join('')}\n      </div>\n      <div class=\"honest\">${t.s3_honest}</div>\n      <div class=\"linkrow\"><a onclick=\"openSheet('nano')\">${t.s3_nano_link}</a></div>\n      <div class=\"spacer\"></div>`;\n    case 3: return `\n      <div class=\"glow\"></div>\n      <div class=\"kick\">${t.s4_kick}</div>\n      <h2>${t.s4_title}</h2>\n      <p class=\"lead\">${t.s4_lead}</p>\n      <div class=\"flow\">\n        ${t.s4_flow.map((f,n)=>`<div class=\"frow\"><div class=\"fnum\">${n+1}</div><div class=\"fbody\"><b>${f[0]}</b><span>${f[1]}</span></div></div>`).join('')}\n      </div>\n      <div class=\"spacer\"></div>`;\n    case 4: return `\n      <div class=\"glow\"></div>\n      <div class=\"kick\">${t.s5_kick}</div>\n      <h2>${t.s5_title}</h2>\n      <p class=\"lead\">${t.s5_lead}</p>\n      <div class=\"caps\">\n        ${t.s5_caps.map(c=>`<div class=\"cap\"><div class=\"ci\">${c[0]}</div><div class=\"ct\"><b>${c[1]}</b><span>${c[2]}</span></div></div>`).join('')}\n      </div>\n      <div class=\"demo\">\n        <div class=\"demo-top\"><div class=\"demo-av\">N</div><div><div class=\"demo-nm\">${t.s5_demo_nm}</div><div class=\"demo-on\">online</div></div></div>\n        ${bubbles(t.s5_demo)}\n      </div>\n      <div class=\"spacer\"></div>`;\n    case 5: return `\n      <div class=\"glow\"></div>\n      <div class=\"kick\">${t.s6_kick}</div>\n      <h2>${t.s6_title}</h2>\n      <p class=\"lead\">${t.s6_lead}</p>\n      <div class=\"istrip\">\n        ${t.s6_steps.map(s=>`<div class=\"istep\"><div class=\"in\">${s[0]}</div><b>${s[1]}</b></div>`).join('')}\n      </div>\n      <label>${t.s6_name}</label>\n      <input class=\"inp\" placeholder=\"${esc(t.s6_name_ph)}\" value=\"${esc(reg.name)}\" oninput=\"reg.name=this.value;refreshCta()\">\n      <label>${t.s6_phone}</label>\n      <input class=\"inp\" type=\"tel\" placeholder=\"${esc(t.s6_phone_ph)}\" value=\"${esc(reg.phone)}\" oninput=\"reg.phone=this.value;refreshCta()\">\n      <label>${t.s6_email}</label>\n      <input class=\"inp\" type=\"email\" placeholder=\"${esc(t.s6_email_ph)}\" value=\"${esc(reg.email)}\" oninput=\"reg.email=this.value;refreshCta()\">\n      <div class=\"check ${agree?'on':''}\" onclick=\"toggleAgree()\"><div class=\"box\"><span>✓</span></div><div>${t.s6_check}</div></div>\n      <div class=\"spacer\"></div>`;\n  }\n}\n\n// Forward arrow is the opposite of back: Hebrew advances leftward (←), English advances rightward (→).\nfunction cta(label){ return label.replace(/\\s*[→←]\\s*$/,'') + ' ' + (L==='he'?'←':'→'); }\nfunction footHTML(t){\n  switch(i){\n    case 0: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s1_cta)}</button><p class=\"note\">${t.s1_note}</p><p class=\"byline\">${t.s1_by}</p>`;\n    case 1: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s2_cta)}</button><p class=\"note\">${t.s2_note}</p>`;\n    case 2: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s3_cta)}</button><p class=\"note\">${t.s3_note}</p>`;\n    case 3: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s4_cta)}</button><p class=\"note\">${t.s4_note}</p>`;\n    case 4: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s5_cta)}</button><p class=\"note\">${t.s5_note}</p>`;\n    case 5: return `<button class=\"cta\" id=\"regCta\" ${validReg()&&!submitting?'':'disabled'} onclick=\"submitReg()\">${submitting?t.s6_cta_load:cta(t.s6_cta)}</button><p class=\"note\">${t.s6_note}</p>`;\n  }\n}\n\nfunction validReg(){\n  return reg.name.trim().length>=2 &&\n    /^[\\d+][\\d\\-\\s()]{6,}$/.test(reg.phone.trim()) &&\n    /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(reg.email.trim()) &&\n    agree;\n}\nfunction refreshCta(){\n  const c=document.getElementById('regCta');\n  if(c) c.disabled = !validReg() || submitting;\n}\n\nfunction paintChrome(){\n  const t=T[L];\n  document.documentElement.lang=L;\n  document.documentElement.dir = L==='he'?'rtl':'ltr';\n  document.getElementById('back').textContent = L==='he'?'→':'←';\n  document.getElementById('lang').textContent = L==='he'?'EN':'עב';\n  let p='';\n  for(let k=0;k<N;k++) p+=`<div class=\"seg ${k<i?'done':''} ${k===i?'cur':''}\"><i></i></div>`;\n  document.getElementById('prog').innerHTML=p;\n  document.getElementById('stepn').textContent=`${i+1}/${N}`;\n  document.getElementById('back').disabled = i===0 || submitting;\n  document.getElementById('foot').innerHTML=footHTML(t);\n}\n\nfunction init(){\n  const stage=document.getElementById('stage');\n  const div=document.createElement('div');\n  div.className='screen';\n  div.innerHTML=screenHTML(T[L]);\n  stage.appendChild(div);\n  paintChrome();\n}\nfunction repaint(){\n  const stage=document.getElementById('stage');\n  stage.innerHTML='';\n  const div=document.createElement('div');\n  div.className='screen';\n  div.innerHTML=screenHTML(T[L]);\n  stage.appendChild(div);\n  paintChrome();\n}\nfunction transition(dir){\n  if(animating) return;\n  animating=true;\n  const stage=document.getElementById('stage');\n  const old=stage.querySelector('.screen');\n  const nw=document.createElement('div');\n  nw.className='screen '+(dir>0?'in-fwd':'in-back');\n  nw.innerHTML=screenHTML(T[L]);\n  if(old){ old.classList.remove('in-fwd','in-back'); old.classList.add(dir>0?'out-fwd':'out-back'); }\n  stage.appendChild(nw);\n  paintChrome();\n  setTimeout(()=>{ if(old&&old.parentNode) old.parentNode.removeChild(old); animating=false; },380);\n}\nfunction go(d){\n  const ni=i+d;\n  if(ni<0||ni>=N||animating||submitting) return;\n  i=ni; transition(d);\n}\n\nasync function submitReg(){\n  if(!validReg()||submitting||animating) return;\n  submitting=true; paintChrome();\n  const payload={ name:reg.name.trim(), phone:reg.phone.trim(), email:reg.email.trim(), lang:L };\n  try{\n    const r=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});\n    const data=await r.json().catch(()=>null);\n    deepLink=(data&&data.deepLink)?data.deepLink:BOT_FALLBACK;\n  }catch(e){ deepLink=BOT_FALLBACK; }\n  submitting=false; paintChrome();\n  handoff();\n}\nfunction handoff(){\n  const t=T[L], sw=document.getElementById('switch');\n  sw.innerHTML=`<div class=\"ho-ico\">✨</div><h2>${t.magic_t}</h2><p>${t.magic_p}</p>`+\n    `<div class=\"tg-peek\"><div class=\"peek-av\">N</div><div class=\"peek-bub\">${t.magic_peek}</div></div>`+\n    `<button class=\"cta ghost\" style=\"max-width:300px\" onclick=\"closeHandoff()\">${t.sheet_close}</button>`;\n  sw.classList.add('on');\n  window.open(deepLink||BOT_FALLBACK,'_blank','noopener');\n}\nfunction closeHandoff(){ document.getElementById('switch').classList.remove('on'); }\n\nfunction openSheet(which){\n  which = which||'nano';\n  const t=T[L], s=document.getElementById('sheet');\n  const title=t['sheet_'+which+'_t']||t.sheet_nano_t;\n  const body=t['sheet_'+which]||t.sheet_nano;\n  s.innerHTML=`<div class=\"sheet-card\"><h3>${title}</h3>${body.map(p=>`<p>${p}</p>`).join('')}<button class=\"cta ghost\" onclick=\"closeSheet()\">${t.sheet_close}</button></div>`;\n  s.classList.add('on');\n}\nfunction closeSheet(){ document.getElementById('sheet').classList.remove('on'); }\n\nfunction toggleAgree(){ agree=!agree; repaint(); }\nfunction setLang(l){ L=l; repaint(); }\nfunction toggleLang(){ L=(L==='he'?'en':'he'); repaint(); }\n\ninit();\n</script>\n</body>\n</html>\n","numLines":656,"startLine":1,"totalLines":656}},"sourceToolAssistantUUID":"5c3f5e02-e31d-4bf8-8745-92bbf2b8f8ec","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent/ux-review/desktop","sessionId":"0bec9074-f0ee-4108-82bf-5bb584ae73da","version":"2.1.197","gitBranch":"HEAD","slug":"polished-jumping-turing"}
