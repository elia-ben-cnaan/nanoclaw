tsEl  = document.getElementById('dots');\n\nfor (let i = 0; i < N; i++) {\n  const b = document.createElement('button');\n  b.setAttribute('aria-label', 'screen ' + (i + 1));\n  b.onclick = () => goTo(i);\n  dotsEl.appendChild(b);\n}\nconst dots = Array.from(dotsEl.children);\n\nfunction render(){\n  slides.forEach((s,i)=>{\n    s.classList.toggle('active', i===current);\n    s.classList.toggle('before', i>current);\n  });\n  dots.forEach((d,i)=>d.classList.toggle('on', i===current));\n  backBtn.disabled = current===0;\n  const c = T().cta[current];\n  ctaBtn.textContent = c.label;\n  swipeHint.style.display = c.hint ? 'flex' : 'none';\n  ctaFoot.style.display = c.foot ? 'block' : 'none';\n  ctaFoot.textContent = c.foot || '';\n  if (current===1) demoEnter();\n  if (current===2) securityEnter();\n}\n\nfunction goTo(i){\n  if (i<0 || i>=N || i===current) return;\n  current = i;\n  render();\n}\n\nbackBtn.onclick = ()=>goTo(current-1);\nctaBtn.onclick = ()=>{\n  const a = T().cta[current].action;\n  if (a==='next') goTo(current+1);\n  else if (a==='submit') submitForm();\n  else if (a==='telegram') window.open('https://t.me/Nanoco_pilot_bot','_blank');\n};\ndocument.getElementById('rescueLink').onclick = ()=>goTo(3);\n\ndocument.addEventListener('keydown', e=>{\n  const rtl = document.documentElement.dir === 'rtl';\n  const fwd = rtl ? 'ArrowLeft' : 'ArrowRight';\n  const bck = rtl ? 'ArrowRight' : 'ArrowLeft';\n  if (e.key===fwd) goTo(current+1);\n  if (e.key===bck) goTo(current-1);\n});\n\nlet touchX = null, touchY = null;\nconst stage = document.getElementById('stage');\nstage.addEventListener('touchstart', e=>{ touchX=e.touches[0].clientX; touchY=e.touches[0].clientY; }, {passive:true});\nstage.addEventListener('touchend', e=>{\n  if (touchX===null) return;\n  const dx = e.changedTouches[0].clientX - touchX;\n  const dy = e.changedTouches[0].clientY - touchY;\n  if (Math.abs(dx)>48 && Math.abs(dx)>Math.abs(dy)*1.4){\n    if (dx<0) goTo(current+1); else goTo(current-1); /* swipe-left = forward */\n  }\n  touchX = null;\n}, {passive:true});\n\n/* ================= security reveal ================= */\nlet secRevealed = false;\nfunction securityEnter(){\n  if (secRevealed) return;\n  secRevealed = true;\n  const items = Array.from(document.querySelectorAll('.reveal-item'));\n  items.forEach((el,i)=>{\n    setTimeout(()=>el.classList.add('in'), 260 + i*430);\n  });\n}\n\n/* ================= signup ================= */\nconst VALIDATORS = {\n  fFirst: v => v.trim().length >= 2,\n  fLast:  v => v.trim().length >= 2,\n  fEmail: v => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(v.trim()),\n  fPhone: v => /^[\\d+\\-\\s()]{9,15}$/.test(v.trim())\n};\n\nfunction validateField(wrapId){\n  const wrap = document.getElementById(wrapId);\n  const input = wrap.querySelector('input');\n  const valid = VALIDATORS[wrapId](input.value);\n  wrap.classList.toggle('invalid', !valid);\n  return valid;\n}\n\n/* errors appear only after the user touches a field (blur) or tries to submit */\nObject.keys(VALIDATORS).forEach(wrapId=>{\n  const wrap = document.getElementById(wrapId);\n  const input = wrap.querySelector('input');\n  input.addEventListener('blur', ()=>{ if (input.value.trim() !== '') validateField(wrapId); });\n  input.addEventListener('input', ()=>{ if (wrap.classList.contains('invalid')) validateField(wrapId); });\n});\ndocument.getElementById('inConsent').addEventListener('change', e=>{\n  if (e.target.checked) document.getElementById('consentWrap').classList.remove('invalid');\n});\n\nfunction updateDoneTitle(){\n  const el = document.getElementById('doneTitle');\n  el.textContent = userName ? T().doneTitleName.replace('{name}', userName) : T().doneTitle;\n}\n\nfunction submitForm(){\n  let ok = true;\n  Object.keys(VALIDATORS).forEach(wrapId=>{ if (!validateField(wrapId)) ok = false; });\n  const consent = document.getElementById('inConsent');\n  document.getElementById('consentWrap').classList.toggle('invalid', !consent.checked);\n  if (