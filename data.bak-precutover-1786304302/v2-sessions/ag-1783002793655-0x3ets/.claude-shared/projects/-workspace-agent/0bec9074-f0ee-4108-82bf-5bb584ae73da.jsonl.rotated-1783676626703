8\t  /* sheet overlay */\n179\t  .sheet{position:absolute; inset:0; z-index:55; background:rgba(0,0,0,.82); backdrop-filter:blur(4px);\n180\t    display:none; flex-direction:column; justify-content:flex-end}\n181\t  .sheet.on{display:flex; animation:fade .25s ease both}\n182\t  @keyframes fade{from{opacity:0} to{opacity:1}}\n183\t  .sheet-card{background:var(--panel); border:1px solid var(--line); border-radius:22px 22px 0 0;\n184\t    padding:22px 22px calc(22px + env(safe-area-inset-bottom)); max-height:82%; overflow-y:auto; animation:up .3s ease both}\n185\t  @keyframes up{from{transform:translateY(40px); opacity:.5} to{transform:translateY(0); opacity:1}}\n186\t  .sheet-card h3{font-size:18px; font-weight:800; margin-bottom:12px}\n187\t  .sheet-card p{font-size:13.5px; color:var(--mut); line-height:1.8; margin-bottom:10px; text-align:start}\n188\t  .sheet-card p b{color:var(--ink)}\n189\t  .cta.ghost{background:transparent; color:var(--teal); border:1px solid var(--teal-deep); margin-top:6px}\n190\t\n191\t  /* magic / handoff overlay */\n192\t  .switch{position:absolute; inset:0; z-index:50; background:rgba(0,0,0,.93); backdrop-filter:blur(5px);\n193\t    display:none; flex-direction:column; align-items:center; justify-content:center; gap:18px; text-align:center; padding:30px}\n194\t  .switch.on{display:flex; animation:fade .25s ease both}\n195\t  .switch .ho-ico{animation:bob 1.4s ease-in-out infinite}\n196\t  @keyframes bob{0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)}}\n197\t  .switch h2{margin:0}\n198\t  .switch p{color:var(--mut); font-size:14px; line-height:1.6}\n199\t  .switch b{color:var(--ink)}\n200\t</style>\n201\t</head>\n202\t<body>\n203\t  <div class=\"device\">\n204\t    <div class=\"topbar\">\n205\t      <button class=\"back\" id=\"back\" onclick=\"go(-1)\" aria-label=\"back\">→</button>\n206\t      <div class=\"prog\" id=\"prog\"></div>\n207\t      <div class=\"stepn\" id=\"stepn\"></div>\n208\t      <div class=\"lang\" id=\"lang\" onclick=\"toggleLang()\">EN</div>\n209\t    </div>\n210\t    <div class=\"stage\" id=\"stage\"></div>\n211\t    <div class=\"foot\" id=\"foot\"></div>\n212\t    <div class=\"sheet\" id=\"sheet\"></div>\n213\t    <div class=\"switch\" id=\"switch\"></div>\n214\t  </div>\n215\t\n216\t<script>\n217\tconst N = 6;\n218\tconst BOT_FALLBACK = 'https://t.me/Nanoco_pilot_bot';\n219\tlet i = 0, L = 'he', agree = false, animating = false, submitting = false;\n220\tlet deepLink = '';\n221\tconst reg = { name:'', phone:'', email:'' };\n222\t\n223\tconst T = {\n224\t  he:{\n225\t    /* 1 NEED */\n226\t    s1_kick:'NanoShellano',\n227\t    s1_title:'עולם העבודה משתנה.<br>כבר עכשיו.',\n228\t    s1_p:[\n229\t      'בכל חודש שעובר, סוכני AI נכנסים לעוד מחלקה, לעוד תפקיד, לעוד שולחן עבודה. זה כבר לא עתיד, זה ההווה.',\n230\t      'מי שיודע לעבוד עם סוכן ימצא את עצמו <b>צעד אחד לפני כולם</b>. ומי שלא, ימצא את עצמו עושה ביד דברים שסוכן עושה בשניות.',\n231\t      'הצעד הכי חשוב שתעשה השנה הוא לפתוח סוכן אחד משלך, ולהתחיל לעבוד איתו. <span class=\"em\">בלי רקע טכני, בלי קוד.</span>'\n232\t    ],\n233\t    s1_cta:'אני רוצה להיכנס לעולם הזה →',\n234\t    s1_note:'פיילוט בגישה מוזמנת · גרסה ראשונה',\n235\t    s1_by:'מאת אליה בן כנען',\n236\t\n237\t    /* 2 FREE */\n238\t    s2_kick:'למה בחינם',\n239\t    s2_title:'ולמה אני נותן<br>את זה בחינם',\n240\t    s2_p:[\n241\t      'לפני שנה לא ידעתי לכתוב שורת קוד אחת. היום יש לי סוכנים שעושים בשבילי חצי מהעבודה, וזה שינה לי לגמרי את הדרך שבה אני עובד.',\n242\t      'אז במקום לשמור את זה לעצמי, בניתי דרך פשוטה שתעביר גם אותך לצד השני. <b>בלי לשלם שקל.</b>',\n243\t      'זה פיילוט שאני עושה כדי להכניס כמה שיותר אנשים לעולם הסוכנים. בלי כרטיס אשראי, בלי התחייבות, בלי קאצ\\'.'\n244\t    ],\n245\t    s2_cta:'יפה, ומה עם הפרטיות? →',\n246\t    s2_note:'בלי עלות נסתרת. הפיילוט פתוח ובחינם.',\n247\t\n248\t    /* 3 SECURE */\n249\t    s3_kick:'מאובטח',\n250\t    s3_title:'מאובטח, ורק שלך',\n251\t    s3_lead:'לפני שמכניסים סוכן לחיים שלך, מגיע לך לדעת בדיוק מה קורה עם המידע.',\n252\t    s3_sic:'🔒',\n253\t    s3_sec_t:'חשבון מבודד, רק שלך',\n254\t    s3_sec:'הסוכן חי בחשבון נפרד ומבודד שמיוחד רק לך. כל חיבור נסגר מוצפן, והמידע שלך לא מתערבב עם אף אחד.',\n255\t    s3_f:[\n256\t      ['🔑','אתה מאשר כל חיבור בעצמך','שום שירות לא מתחבר בלי שאתה לוחץ \"אשר\", בחשבון שלך. מחברים רק מה שבא לך.'],\n257\t      ['🚪','מנתקים ומוחקים בכל רגע','בלחיצה אחת מנתקים שירות, ובלחיצה אחת מוחקים את הסוכן ואת כל הנתונים איתו.'],\n258\t      ['🛡️','לא מוכרים, לא משתפים','המידע שלך לא נמכר ולא עובר לאף אחד. הוא נשאר אצלך.']\n259\t    ],\n260\t    s3_honest:'<b>בכנות:</b> זו לא הבטחה ש\"אין לנו גישה\". זו שליטה אמיתית, אתה מחליט, אתה מאשר, ואתה מבטל מתי שתרצה.',\n261\t    s3_nano_link:'מה זה NanoClaw בעצם?',\n262\t    s3_cta:'הבנתי, איך זה הולך להיות? →',\n263\t    s3_note:'אפשר לשוחח עם הסוכן בכל שפה, בעברית או באנגלית.',\n264\t\n265\t    /* 4 FLOW */\n266\t    s4_kick:'הדרך',\n267\t    s4_title:'איך זה הולך להיות',\n268\t    s4_lead:'חמישה צעדים מהרגע שתלחץ \"מתחילים\" ועד שהסוכן עובד בשבילך.',\n269\t    s4_flow:[\n270\t      ['פותחים לך משתמש','שם, טלפון, מייל. לוקח דקה.'],\n271\t      ['מוקם לך סוכן אישי','המערכת מקימה לך סוכן על שרת מנוהל, תמיד פעיל, רק שלך.'],\n272\t      ['מקבלים קוד לטלגרם','קישור אישי שמחבר את הסוכן ישירות לטלגרם שלך.'],\n273\t      ['נכנסים לשיחה','הסוכן מקבל את פניך בשמך, ומתחילים לדבר בשפה רגילה.'],\n274\t      ['מחברים כלים, כשרוצים','מייל, יומן, וואטסאפ. מחברים בקצב שלך, בלחיצה.']\n275\t    ],\n276\t    s4_cta:'ומה הוא בעצם עושה? →',\n277\t    s4_note:'הכל קורה תוך כמה דקות. אתה רק עוקב אחרי המסכים.',\n278\t\n279\t    /* 5 — ככה נעבוד יחד */\n280\t    s5_how_t:'ככה נעבוד יחד',\n281\t    s5_agent:'ג\\'וני',\n282\t    s5_typing:'זמין עכשיו',\n283\t    s5_cases:[\n284\t      {t:'משימות רוחביות', s:'בקשה אחת הופכת לשרשרת פעולות על פני כמה מערכות, וחוזרת אליך גמורה.',\n285\t       c:[['me','עדכן את הלקוח ב-CRM, תכין הצעת מחיר ותשלח לו במייל'],\n286\t          ['bot','על איזה סכום ההצעה?'],\n287\t          ['me','45 אלף, כמו שסיכמנו בפגישה'],\n288\t          ['bot','עדכנתי ב-CRM, הכנתי הצעה, וכתבתי טיוטת מייל ללקוח.'],\n289\t          ['bot','המייל ממתין לאישורך. תיכנס ותאשר שליחה.']]},\n290\t      {t:'יצירת תוצרים', s:'לא רק עונה, מייצר את התוצרים עצמם. דוחות, מצגות, מסמכים וניתוחים.',\n291\t       c:[['me','אני צריך מצגת 10 שקפים על תוצאות Q2, לישיבה ב-3'],\n292\t          ['bot','במיתוג שלנו או של הלקוח?'],\n293\t          ['me','שלנו, עם הלוגואים של הלקוחות החדשים'],\n294\t          ['bot','בונה: פתיחה, 7 שקפי גרפים וסיכום עם המלצות.'],\n295\t          ['bot','מוכנה, מצורפת.','מצגת_Q2.pptx']]},\n296\t      {t:'קולגה לאונבורדינג', s:'חדש בתפקיד? הוא הקולגה שמלווה אותך שלב שלב.',\n297\t       c:[['me','חדש בתפקיד. איך פותחים בקשת רכש?'],\n298\t          ['bot','עליי. פותח לך בקשה ב-CRM ומעדכן את הפרטים לפי הנהלים. על איזה סכום?'],\n299\t          ['me','הזמנת ציוד משרדי, תקציב 6000 שקל'],\n300\t          ['bot','מילאתי ושלחתי לאישור המנהל. תמתין לאישור במייל.']]},\n301\t      {t:'מתחדש בכלי AI', s:'כלי AI חדש כל שבוע, ואי אפשר להדביק. אז הוא מדביק במקומך.',\n302\t       c:[['me','אני צריך סרטון הדרכה לנהלים החדשים במשרד'],\n303\t          ['bot','יצא כלי חדש שמרכיב סרטונים מצילומים של המשרד והאנשים. יש לך תמונות?'],\n304\t          ['me','מצרף תמונות של הצוות והמשרד','תמונות_הצוות.zip'],\n305\t          ['bot','בוצע. העליתי את הסרטון לדרייב ושלחתי לאישור המנהלת.']]}\n306\t    ],\n307\t    s5_cta:'אז מה אנחנו מבטיחים? →',\n308\t    s5_note:'בחר תרחיש כדי לראות איך זה נראה בשיחה אמיתית.',\n309\t\n310\t    /* 6 INSTALL + REGISTER */\n311\t    s6_kick:'התקנה',\n312\t    s6_title:'ההתקנה, ומשם הקסם',\n313\t    s6_lead:'שלוש דקות. פותחים לך משתמש, מקבלים קוד לטלגרם, <b>ומשם הקסם מתחיל.</b>',\n314\t    s6_steps:[['1','ממלאים פרטים'],['2','מקבלים קוד לטלגרם'],['3','הקסם מתחיל']],\n315\t    s6_name:'שם מלא', s6_name_ph:'איך קוראים לך',\n316\t    s6_phone:'טלפון', s6_phone_ph:'050-0000000',\n317\t    s6_email:'מייל', s6_email_ph:'you@example.com',\n318\t    s6_check:'קראתי ומאשר את <a class=\"tlink\" onclick=\"event.stopPropagation();openSheet(\\'priv\\')\">תנאי השימוש והפרטיות</a>. האישור הזה פותח את הסוכן.',\n319\t    s6_cta:'פתח לי סוכן →', s6_cta_load:'פותח לך סוכן…',\n320\t    s6_note:'הפרטים נשמרים כדי שהסוכן יקבל את פניך נכון. בלי ספאם.',\n321\t\n322\t    magic_t:'הסוכן שלך מוכן ✨',\n323\t    magic_p:'פתחנו לך טלגרם. הסוכן <b>מחכה לך שם</b>, רק תגיד שלום.',\n324\t    magic_peek:'אהלן! 👋 אני הננו שלך, מוכן להתחיל. על מה נצלול ראשון?',\n325\t\n326\t    sheet_nano_t:'מה זה NanoClaw?',\n327\t    sheet_nano:[\n328\t      '<b>NanoClaw</b> היא תשתית הסוכנים שעליה הכל רץ. סוכן אישי שחי על שרת מנוהל, תמיד פעיל, ומדבר איתך דרך טלגרם בשפה רגילה.',\n329\t      'הסוכן הוא שלך, לא של חברה. הוא לומד מה אתה צריך, מבצע משימות, ויכול להתחבר למערכות שלך כשתרצה, תמיד בשליטה שלך.',\n330\t      'הפיילוט הזה הוא הדרך הכי פשוטה לפתוח סוכן כזה, בלי רקע טכני ובלי הגדרות.'\n331\t    ],\n332\t    sheet_priv_t:'תנאי שימוש ופרטיות',\n333\t    sheet_priv:[\n334\t      '<b>פיילוט.</b> השירות הוא פיילוט ניסיוני שניתן בחינם, לתקופה של כחודש בשלב זה. אנחנו רשאים לשנות, להאריך, להשהות או להפסיק אותו בכל עת, ללא הודעה מוקדמת וללא התחייבות להמשך זמינות.',\n335\t      '<b>מה אנחנו אוספים.</b> פרטים שתמסור בהרשמה (שם, טלפון, מייל), תוכן השיחות שלך עם הסוכן, ומידע משירותים שתבחר לחבר, רק אחרי שאתה מאשר כל חיבור בעצמך.',\n336\t      '<b>למה.</b> המידע משמש כדי להקים ולהפעיל את הסוכן האישי שלך, לקבל את פניך נכון, ולתפעל את השירות. לא למטרה אחרת.',\n337\t      '<b>איפה זה נשמר.</b> הסוכן חי בחשבון נפרד ומבודד שמיוחד רק לך. החיבורים מוצפנים, והמידע שלך לא מתערבב עם משתמשים אחרים.',\n338\t      '<b>שיתוף.</b> אנחנו לא מוכרים ולא משתפים את המידע שלך. כדי שהשירות יעבוד הוא רץ על תשתיות צד שלישי (שרת מנוהל, טלגרם, וספקי מודל AI) שמעבדים נתונים רק לצורך הפעלת השירות.',\n339\t      '<b>שליטה ומחיקה.</b> אתה בשליטה מלאה. כדי למחוק הכל, פשוט כותב לסוכן את פקודת המחיקה (למשל \"מחק והפסק\") והוא מוחק את כל היסטוריית השיחה שלך ומפסיק לפעול. אחר כך אפשר למחוק את איש הקשר בטלגרם, והסוכן לא יגיב יותר. תמיד אפשר גם לפנות אלינו לבקשת מחיקה.',\n340\t      '<b>שמירת מידע.</b> המידע נשמר כל עוד הסוכן שלך פעיל, או עד שתמחק אותו. אם הפיילוט יופסק, נמחק את הנתונים בהתאם.',\n341\t      '<b>בלי אחריות.</b> זה שירות ניסיוני שמסופק כמו שהוא (as is). אין הבטחה לזמינות רציפה, ואין להסתמך עליו לשימושים קריטיים או למידע רגיש.',\n342\t      '<b>גיל.</b> השימוש מיועד לבני 18 ומעלה.',\n343\t      '<b>שינויים.</b> נוכל לעדכן את התנאים מעת לעת. המשך השימוש מהווה הסכמה לגרסה המעודכנת.',\n344\t      '<b>יצירת קשר.</b> לכל שאלה: 052-8738698 · elia@bencnaan.net'\n345\t    ],\n346\t    sheet_close:'הבנתי'\n347\t  },\n348\t\n349\ten:{\n350\t  s1_kick:'NanoShellano',\n351\t  s1_title:'The world of work<br>is changing. Right now.',\n352\t  s1_p:[\n353\t    'Every month, AI agents move into another department, another role, another desk. This stopped being a prediction. It is already happening.',\n354\t    'People who learn to work with an agent will be <b>a step ahead of everyone else</b>. People who don\\'t will keep doing by hand what an agent finishes in seconds.',\n355\t    'The most important move you can make this year is to open an agent of your own and start working with it. <span class=\"em\">No technical background, no code.</span>'\n356\t  ],\n357\t  s1_cta:'I want in →',\n358\t  s1_note:'Invite-only pilot · First release',\n359\t  s1_by:'Built by Elia Ben Cnaan',\n360\t\n361\t  s2_kick:'Why free',\n362\t  s2_title:'And why I give<br>it away for free',\n363\t  s2_p:[\n364\t    'A year ago I couldn\\'t write a single line of code. Today, agents do half my work for me, and they\\'ve changed the way I work from the ground up.',\n365\t    'So rather than keep that to myself, I built a simple way to bring you across to the other side too. <b>Without spending a cent.</b>',\n366\t    'This is a pilot I\\'m running to bring as many people as I can into the world of agents. No credit card, no commitment, no catch.'\n367\t  ],\n368\t  s2_cta:'Sounds good. What about privacy? →',\n369\t  s2_note:'No hidden costs. The pilot is open and free.',\n370\t\n371\t  s3_kick:'Security',\n372\t  s3_title:'Secure, and yours alone',\n373\t  s3_lead:'Before you let an agent into your life, you deserve to know exactly what happens with your data.',\n374\t  s3_sic:'🔒',\n375\t  s3_sec_t:'An isolated account, just for you',\n376\t  s3_sec:'Your agent lives in a separate, isolated account dedicated to you alone. Every connection is encrypted, and your data never mixes with anyone else\\'s.',\n377\t  s3_f:[\n378\t    ['🔑','You approve every connection','Nothing connects until you tap \"approve\", inside your own account. You connect only what you choose to.'],\n379\t    ['🚪','Disconnect and delete anytime','One tap disconnects a service. One tap deletes the agent, along with everything it knows.'],\n380\t    ['🛡️','Never sold, never shared','Your data isn\\'t sold and doesn\\'t get passed to anyone. It stays yours.']\n381\t  ],\n382\t  s3_honest:'<b>To be honest:</b> this isn\\'t a \"we have no access\" promise. It\\'s real control. You decide, you approve, and you can revoke it all whenever you want.',\n383\t  s3_nano_link:'So what is NanoClaw, exactly?',\n384\t  s3_cta:'Got it. How does it work? →',\n385\t  s3_note:'You can chat with the agent in any language, Hebrew or English.',\n386\t\n387\t  s4_kick:'The path',\n388\t  s4_title:'Here\\'s how it goes',\n389\t  s4_lead:'Five steps between tapping \"start\" and having an agent that works for you.',\n390\t  s4_flow:[\n391\t    ['Open your account','Name, phone, email. Takes a minute.'],\n392\t    ['Your personal agent is created','It runs on a managed server, always on, and belongs only to you.'],\n393\t    ['Get your Telegram code','A personal link that drops the agent straight into your Telegram.'],\n394\t    ['Step into the chat','The agent greets you by name, and you just talk, in plain language.'],\n395\t    ['Connect tools when you\\'re ready','Email, calendar, WhatsApp. Each one is a single tap, at your own pace.']\n396\t  ],\n397\t  s4_cta:'So what can it actually do? →',\n398\t  s4_note:'The whole thing takes a few minutes. Just follow the screens.',\n399\t\n400\t  s5_how_t:'Here\\'s how we\\'ll work',\n401\t  s5_agent:'Joni',\n402\t  s5_typing:'online',\n403\t  s5_cases:[\n404\t    {t:'Tasks across your systems', s:'One request becomes a chain of actions across several systems, and comes back to you finished.',\n405\t     c:[['me','Update the client in the CRM, prep a quote and email it over'],\n406\t        ['bot','What amount should the quote be for?'],\n407\t        ['me','45K, like we agreed in the meeting'],\n408\t        ['bot','CRM updated, quote ready, and I\\'ve drafted the email to the client.'],\n409\t        ['bot','The email is waiting for your sign-off. Open it and approve to send.']]},\n410\t    {t:'Creates real deliverables', s:'It produces the actual work: reports, decks, documents, analyses.',\n411\t     c:[['me','I need a 10-slide deck on the Q2 results, for a 3pm meeting'],\n412\t        ['bot','Our branding or the client\\'s?'],\n413\t        ['me','Ours, with the new clients\\' logos'],\n414\t        ['bot','On it: an intro, 7 chart slides, and a summary with recommendations.'],\n415\t        ['bot','Done, attached.','Q2_deck.pptx']]},\n416\t    {t:'Your onboarding buddy', s:'New on the job? It\\'s the colleague who walks you through everything, step by step.',\n417\t     c:[['me','Just started the role. How do I open a purchase request?'],\n418\t        ['bot','On it. I\\'ll open a request in the CRM and fill in the details according to policy. What amount?'],\n419\t        ['me','Office equipment, budget is 6,000'],\n420\t        ['bot','Filled in and sent to your manager for approval. Keep an eye out for the confirmation email.']]},\n421\t    {t:'Keeps up with AI tools', s:'A new AI tool drops every week. Nobody can keep up, so it keeps up for you.',\n422\t     c:[['me','I need a training video for the new office procedures'],\n423\t        ['bot','A new tool just came out that builds videos from photos of the office and the team. Got any pictures?'],\n424\t        ['me','Attaching photos of the team and the office','team_photos.zip'],\n425\t        ['bot','Done. The video is up on Drive and sent to your manager for approval.']]}\n426\t  ],\n427\t  s5_cta:'So what\\'s the promise? →',\n428\t  s5_note:'Pick a scenario to see how it plays out in a real conversation.',\n429\t\n430\t  s6_kick:'Install',\n431\t  s6_title:'A short setup, then the magic',\n432\t  s6_lead:'Three minutes. We open your account, a code lands in your Telegram, <b>and from there the magic begins.</b>',\n433\t  s6_steps:[['1','Fill in your details'],['2','Get your Telegram code'],['3','The magic begins']],\n434\t  s6_name:'Full name', s6_name_ph:'Your name',\n435\t  s6_phone:'Phone', s6_phone_ph:'050-0000000',\n436\t  s6_email:'Email', s6_email_ph:'you@example.com',\n437\t  s6_check:'I\\'ve read and accept the <a class=\"tlink\" onclick=\"event.stopPropagation();openSheet(\\'priv\\')\">terms of use and privacy policy</a>. This confirmation is what opens your agent.',\n438\t  s6_cta:'Open my agent →', s6_cta_load:'Opening your agent…',\n439\t  s6_note:'We save your details so the agent can greet you properly. No spam.',\n440\t\n441\t  magic_t:'Your agent is ready ✨',\n442\t  magic_p:'We\\'ve opened Telegram for you. Your agent is <b>already waiting</b>, just say hi.',\n443\t  magic_peek:'Hey! 👋 I\\'m your Nano, ready to go. What should we dive into first?',\n444\t\n445\t  sheet_nano_t:'What is NanoClaw?',\n446\t  sheet_nano:[\n447\t    '<b>NanoClaw</b> is the infrastructure everything here runs on: a personal agent that lives on a managed server, stays on around the clock, and talks with you over Telegram in plain language.',\n448\t    'The agent belongs to you, not to some company. It learns what you need, gets things done, and can connect to your systems when you choose, always under your control.',\n449\t    'This pilot is the simplest way to get an agent of your own, with no technical background and nothing to configure.'\n450\t  ],\n451\t  sheet_priv_t:'Terms of use & privacy',\n452\t  sheet_priv:[\n453\t    '<b>Pilot.</b> This service is an experimental pilot, provided free of charge, for a period of roughly one month at this stage. We may change, extend, pause or discontinue it at any time, without prior notice and with no commitment to continued availability.',\n454\t    '<b>What we collect.</b> The details you provide at signup (name, phone, email), the content of your conversations with the agent, and data from services you choose to connect, only after you approve each connection yourself.',\n455\t    '<b>Why.</b> We use it to set up and run your personal agent, greet you by name, and operate the service. Nothing beyond that.',\n456\t    '<b>Where it is stored.</b> Your agent runs in a separate, isolated account dedicated to you alone. Connections are encrypted, and your data never mixes with other users\\'.',\n457\t    '<b>Sharing.</b> We do not sell or share your data. To function, the service relies on third-party infrastructure (a managed server, Telegram, and AI model providers) that processes data only to operate the service.',\n458\t    '<b>Control and deletion.</b> You are in full control. To delete everything, send the agent a delete command (for example \"delete and exit\") and it wipes your entire chat history and stops working. You can then delete the contact in Telegram, and the agent will not respond again. You can also contact us at any time to request deletion.',\n459\t    '<b>Retention.</b> Data is kept while your agent is active, or until you delete it. If the pilot ends, we delete the data accordingly.',\n460\t    '<b>No warranty.</b> This is an experimental service, provided as is. Continuous availability is not guaranteed, and it should not be relied on for critical uses or sensitive data.',\n461\t    '<b>Age.</b> The service is intended for users aged 18 and over.',\n462\t    '<b>Changes.</b> We may update these terms from time to time. Continued use means you accept the updated version.',\n463\t    '<b>Contact.</b> For any question: 052-8738698 · elia@bencnaan.net'\n464\t  ],\n465\t  sheet_close:'Got it'\n466\t}\n467\t};\n468\t\n469\tfunction esc(s){ return String(s).replace(/\"/g,'&quot;'); }\n470\tfunction bubbles(arr){\n471\t  return arr.map(b=>`<div class=\"bub${b[0]==='me'?' me':''}\">${b[1]}</div>`).join('');\n472\t}\n473\t\n474\tfunction screenHTML(t){\n475\t  switch(i){\n476\t    case 0: return `\n477\t      <div class=\"glow\"></div>\n478\t      <img class=\"lockup\" src=\"nanoshellano-lockup-trim.png\" alt=\"NanoShellano\">\n479\t      <div class=\"hero-mascot\"><img src=\"nanoshellano-mascot.png\" alt=\"NanoShellano\"></div>\n480\t      <h2>${t.s1_title}</h2>\n481\t      ${t.s1_p.map(p=>`<p class=\"prose\">${p}</p>`).join('')}\n482\t      <div class=\"spacer\"></div>`;\n483\t    case 1: return `\n484\t      <div class=\"glow\"></div>\n485\t      <div class=\"kick\">${t.s2_kick}</div>\n486\t      <h2>${t.s2_title}</h2>\n487\t      ${t.s2_p.map(p=>`<p class=\"prose\">${p}</p>`).join('')}\n488\t      <div class=\"spacer\"></div>`;\n489\t    case 2: return `\n490\t      <div class=\"glow\"></div>\n491\t      <div class=\"kick\">${t.s3_kick}</div>\n492\t      <h2>${t.s3_title}</h2>\n493\t      <p class=\"lead\">${t.s3_lead}</p>\n494\t      <div class=\"secband\"><div class=\"sic\">${t.s3_sic}</div><div class=\"stx\"><b>${t.s3_sec_t}</b>${t.s3_sec}</div></div>\n495\t      <div class=\"flist\">\n496\t        ${t.s3_f.map(f=>`<div class=\"fitem\"><div class=\"fic\">${f[0]}</div><div class=\"ftx\"><b>${f[1]}</b>${f[2]}</div></div>`).join('')}\n497\t      </div>\n498\t      <div class=\"honest\">${t.s3_honest}</div>\n499\t      <div class=\"linkrow\"><a onclick=\"openSheet('nano')\">${t.s3_nano_link}</a></div>\n500\t      <div class=\"spacer\"></div>`;\n501\t    case 3: return `\n502\t      <div class=\"glow\"></div>\n503\t      <div class=\"kick\">${t.s4_kick}</div>\n504\t      <h2>${t.s4_title}</h2>\n505\t      <p class=\"lead\">${t.s4_lead}</p>\n506\t      <div class=\"flow\">\n507\t        ${t.s4_flow.map((f,n)=>`<div class=\"frow\"><div class=\"fnum\">${n+1}</div><div class=\"fbody\"><b>${f[0]}</b><span>${f[1]}</span></div></div>`).join('')}\n508\t      </div>\n509\t      <div class=\"spacer\"></div>`;\n510\t    case 4: return `\n511\t      <div class=\"glow\"></div>\n512\t      <div class=\"kick\">${t.s5_kick}</div>\n513\t      <h2>${t.s5_title}</h2>\n514\t      <p class=\"lead\">${t.s5_lead}</p>\n515\t      <div class=\"caps\">\n516\t        ${t.s5_caps.map(c=>`<div class=\"cap\"><div class=\"ci\">${c[0]}</div><div class=\"ct\"><b>${c[1]}</b><span>${c[2]}</span></div></div>`).join('')}\n517\t      </div>\n518\t      <div class=\"demo\">\n519\t        <div class=\"demo-top\"><div class=\"demo-av\">N</div><div><div class=\"demo-nm\">${t.s5_demo_nm}</div><div class=\"demo-on\">online</div></div></div>\n520\t        ${bubbles(t.s5_demo)}\n521\t      </div>\n522\t      <div class=\"spacer\"></div>`;\n523\t    case 5: return `\n524\t      <div class=\"glow\"></div>\n525\t      <div class=\"kick\">${t.s6_kick}</div>\n526\t      <h2>${t.s6_title}</h2>\n527\t      <p class=\"lead\">${t.s6_lead}</p>\n528\t      <div class=\"istrip\">\n529\t        ${t.s6_steps.map(s=>`<div class=\"istep\"><div class=\"in\">${s[0]}</div><b>${s[1]}</b></div>`).join('')}\n530\t      </div>\n531\t      <label>${t.s6_name}</label>\n532\t      <input class=\"inp\" placeholder=\"${esc(t.s6_name_ph)}\" value=\"${esc(reg.name)}\" oninput=\"reg.name=this.value;refreshCta()\">\n533\t      <label>${t.s6_phone}</label>\n534\t      <input class=\"inp\" type=\"tel\" placeholder=\"${esc(t.s6_phone_ph)}\" value=\"${esc(reg.phone)}\" oninput=\"reg.phone=this.value;refreshCta()\">\n535\t      <label>${t.s6_email}</label>\n536\t      <input class=\"inp\" type=\"email\" placeholder=\"${esc(t.s6_email_ph)}\" value=\"${esc(reg.email)}\" oninput=\"reg.email=this.value;refreshCta()\">\n537\t      <div class=\"check ${agree?'on':''}\" onclick=\"toggleAgree()\"><div class=\"box\"><span>✓</span></div><div>${t.s6_check}</div></div>\n538\t      <div class=\"spacer\"></div>`;\n539\t  }\n540\t}\n541\t\n542\t// Forward arrow is the opposite of back: Hebrew advances leftward (←), English advances rightward (→).\n543\tfunction cta(label){ return label.replace(/\\s*[→←]\\s*$/,'') + ' ' + (L==='he'?'←':'→'); }\n544\tfunction footHTML(t){\n545\t  switch(i){\n546\t    case 0: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s1_cta)}</button><p class=\"note\">${t.s1_note}</p><p class=\"byline\">${t.s1_by}</p>`;\n547\t    case 1: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s2_cta)}</button><p class=\"note\">${t.s2_note}</p>`;\n548\t    case 2: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s3_cta)}</button><p class=\"note\">${t.s3_note}</p>`;\n549\t    case 3: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s4_cta)}</button><p class=\"note\">${t.s4_note}</p>`;\n550\t    case 4: return `<button class=\"cta\" onclick=\"go(1)\">${cta(t.s5_cta)}</button><p class=\"note\">${t.s5_note}</p>`;\n551\t    case 5: return `<button class=\"cta\" id=\"regCta\" ${validReg()&&!submitting?'':'disabled'} onclick=\"submitReg()\">${submitting?t.s6_cta_load:cta(t.s6_cta)}</button><p class=\"note\">${t.s6_note}</p>`;\n552\t  }\n553\t}\n554\t\n555\tfunction validReg(){\n556\t  return reg.name.trim().length>=2 &&\n557\t    /^[\\d+][\\d\\-\\s()]{6,}$/.test(reg.phone.trim()) &&\n558\t    /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(reg.email.trim()) &&\n559\t    agree;\n560\t}\n561\tfunction refreshCta(){\n562\t  const c=document.getElementById('regCta');\n563\t  if(c) c.disabled = !validReg() || submitting;\n564\t}\n565\t\n566\tfunction paintChrome(){\n567\t  const t=T[L];\n568\t  document.documentElement.lang=L;\n569\t  document.documentElement.dir = L==='he'?'rtl':'ltr';\n570\t  document.getElementById('back').textContent = L==='he'?'→':'←';\n571\t  document.getElementById('lang').textContent = L==='he'?'EN':'עב';\n572\t  let p='';\n573\t  for(let k=0;k<N;k++) p+=`<div class=\"seg ${k<i?'done':''} ${k===i?'cur':''}\"><i></i></div>`;\n574\t  document.getElementById('prog').innerHTML=p;\n575\t  document.getElementById('stepn').textContent=`${i+1}/${N}`;\n576\t  document.getElementById('back').disabled = i===0 || submitting;\n577\t  document.getElementById('foot').innerHTML=footHTML(t);\n578\t}\n579\t\n580\tfunction init(){\n581\t  const stage=document.getElementById('stage');\n582\t  const div=document.createElement('div');\n583\t  div.className='screen';\n584\t  div.innerHTML=screenHTML(T[L]);\n585\t  stage.appendChild(div);\n586\t  paintChrome();\n587\t}\n588\tfunction repaint(){\n589\t  const stage=document.getElementById('stage');\n590\t  stage.innerHTML='';\n591\t  const div=document.createElement('div');\n592\t  div.className='screen';\n593\t  div.innerHTML=screenHTML(T[L]);\n594\t  stage.appendChild(div);\n595\t  paintChrome();\n596\t}\n597\tfunction transition(dir){\n598\t  if(animating) return;\n599\t  animating=true;\n600\t  const stage=document.getElementById('stage');\n601\t  const old=stage.querySelector('.screen');\n602\t  const nw=document.createElement('div');\n603\t  nw.className='screen '+(dir>0?'in-fwd':'in-back');\n604\t  nw.innerHTML=screenHTML(T[L]);\n605\t  if(old){ old.classList.remove('in-fwd','in-back'); old.classList.add(dir>0?'out-fwd':'out-back'); }\n606\t  stage.appendChild(nw);\n607\t  paintChrome();\n608\t  setTimeout(()=>{ if(old&&old.parentNode) old.parentNode.removeChild(old); animating=false; },380);\n609\t}\n610\tfunction go(d){\n611\t  const ni=i+d;\n612\t  if(ni<0||ni>=N||animating||submitting) return;\n613\t  i=ni; transition(d);\n614\t}\n615\t\n616\tasync function submitReg(){\n617\t  if(!validReg()||submitting||animating) return;\n618\t  submitting=true; paintChrome();\n619\t  const payload={ name:reg.name.trim(), phone:reg.phone.trim(), email:reg.email.trim(), lang:L };\n620\t  try{\n621\t    const r=await fetch('/api/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});\n622\t    const data=await r.json().catch(()=>null);\n623\t    deepLink=(data&&data.deepLink)?data.deepLink:BOT_FALLBACK;\n624\t  }catch(e){ deepLink=BOT_FALLBACK; }\n625\t  submitting=false; paintChrome();\n626\t  handoff();\n627\t}\n628\tfunction handoff(){\n629\t  const t=T[L], sw=document.getElementById('switch');\n630\t  sw.innerHTML=`<div class=\"ho-ico\">✨</div><h2>${t.magic_t}</h2><p>${t.magic_p}</p>`+\n631\t    `<div class=\"tg-peek\"><div class=\"peek-av\">N</div><div class=\"peek-bub\">${t.magic_peek}</div></div>`+\n632\t    `<button class=\"cta ghost\" style=\"max-width:300px\" onclick=\"closeHandoff()\">${t.sheet_close}</button>`;\n633\t  sw.classList.add('on');\n634\t  window.open(deepLink||BOT_FALLBACK,'_blank','noopener');\n635\t}\n636\tfunction closeHandoff(){ document.getElementById('switch').classList.remove('on'); }\n637\t\n638\tfunction openSheet(which){\n639\t  which = which||'nano';\n640\t  const t=T[L], s=document.getElementById('sheet');\n641\t  const title=t['sheet_'+which+'_t']||t.sheet_nano_t;\n642\t  const body=t['sheet_'+which]||t.sheet_nano;\n643\t  s.innerHTML=`<div class=\"sheet-card\"><h3>${title}</h3>${body.map(p=>`<p>${p}</p>`).join('')}<button class=\"cta ghost\" onclick=\"closeSheet()\">${t.sheet_close}</button></div>`;\n644\t  s.classList.add('on');\n645\t}\n646\tfunction closeSheet(){ document.getElementById('sheet').classList.remove('on'); }\n647\t\n648\tfunction toggleAgree(){ agree=!agree; repaint(); }\n649\tfunction setLang(l){ L=l; repaint(); }\n650\tfunction toggleLang(){ L=(L==='he'?'en':'he'); repaint(); }\n651\t\n652\tinit();\n653\t</script>\n654\t</body>\n655\t</html>\n656\t"}]},"uuid":"3caf8ec6-411b-4301-ad39-2915bc5f39e0","timestamp":"2026-07-06T13:55:39.862Z","toolUseResult":{"type":"text","file":{"filePath":"/w