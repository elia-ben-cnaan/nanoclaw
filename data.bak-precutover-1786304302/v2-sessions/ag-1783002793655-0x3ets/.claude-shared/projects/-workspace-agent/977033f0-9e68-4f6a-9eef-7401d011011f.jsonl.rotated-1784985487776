px}\n  .step:not(:last-child)::before{\n    content:\"\";position:absolute;inset-inline-start:15px;top:34px;bottom:2px;width:1px;background:var(--teal-dim);\n  }\n  .step-num{\n    width:31px;height:31px;border-radius:50%;background:#0d1614;border:1px solid var(--teal-dim);\n    color:var(--teal);font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center;\n    flex:0 0 auto;position:relative;z-index:1;\n  }\n  .step h3{font-size:14.2px;font-weight:600;line-height:1.4;padding-top:5px}\n  .step p{color:var(--muted);font-size:12.8px;line-height:1.6;margin-top:4px}\n  .dl-prompt{color:var(--muted);font-size:12.5px;margin-top:14px}\n  .dl-row{display:flex;gap:8px;margin-top:9px;flex-wrap:wrap}\n  .dl-row a{\n    text-decoration:none;color:var(--teal);font-size:12.5px;font-weight:500;\n    border:1px solid var(--teal-line);background:#0d1614;border-radius:9px;padding:7px 12px;\n    transition:border-color .15s,background .15s;\n  }\n  .dl-row a:hover{border-color:var(--teal);background:#11201c}\n  .footnote{color:#7d7d7d;font-size:12px;text-align:center;margin-top:6px;padding-bottom:8px}\n\n  /* ---------- slide 5: signup ---------- */\n  form{display:flex;flex-direction:column;gap:11px;margin-top:16px;padding-bottom:8px}\n  .name-row{display:flex;gap:10px}\n  .name-row .field{flex:1 1 0;min-width:0}\n  .field label{display:block;font-size:12.5px;color:var(--muted);margin-bottom:5px}\n  .field input{\n    width:100%;background:var(--surface);border:1px solid var(--border);border-radius:10px;\n    color:var(--text);font-family:inherit;font-size:14.5px;padding:11px 13px;outline:none;\n    transition:border-color .15s;\n  }\n  .field input:focus{border-color:var(--teal)}\n  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n  .field.invalid input{border-color:var(--orange)}\n  .field.invalid .err{display:block}\n  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n  .consent input{width:16px;height:16px;accent-color:var(--teal);margin-top:1px;flex:0 0 auto}\n  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n  .consent.invalid{color:var(--orange)}\n\n  /* ---------- slide 6: done ---------- */\n  .done{justify-content:center;text-align:center}\n  .done-avatar{\n    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n    border:2px solid var(--teal-line);background:#0d1614;\n  }\n  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n  .done h1{font-size:26px}\n  .done .lead{max-width:300px;margin-inline:auto}\n  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n\n  /* ---------- bottom zone ---------- */\n  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n  .nav-row{display:flex;align-items:center;justify-content:space-between;gap:10px}\n  html[dir=\"ltr\"] .nav-row .nav-arr svg{transform:scaleX(-1)}\n  .dots{display:flex;justify-content:center;gap:7px;flex:1 1 auto}\n  .dots button{\n    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n    transition:background .2s,width .2s;\n  }\n  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n  .cta{\n    width:100%;border:none;border-radius:12px;background:var(--teal);color:#04211C;\n    font-family:inherit;font-size:15.5px;font-weight:700;padding:14px;cursor:pointer;\n    transition:filter .15s,transform .12s;\n  }\n  .cta:active{transform:scale(.985)}\n  .cta:hover{filter:brightness(1.07);box-shadow:0 6px 22px rgba(86,237,214,.25)}\n  .cta:disabled{opacity:.6;cursor:default}\n  /* fixed-height sub-line keeps the bottom zone identical on every screen */\n  .cta-sub{height:17px;display:flex;align-items:center;justify-content:center}\n  .swipe-hint{\n    display:none;justify-content:center;align-items:center;gap:6px;\n    color:#8a8a8a;font-size:12.5px;\n  }\n  .swipe-hint svg{color:var(--teal);animation:nudge 1.6s ease-in-out infinite}\n  html[dir=\"ltr\"] .swipe-hint svg{transform:scaleX(-1)}\n  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n  html[dir=\"ltr\"] .swipe-hint svg{animation:nudgeLtr 1.6s ease-in-out infinite}\n  @keyframes nudgeLtr{0%,100%{transform:scaleX(-1) translateX(0)}50%{transform:scaleX(-1) translateX(-5px)}}\n  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n  @media (max-height:700px){\n    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n  }\n</style>\n</head>\n<body>\n\n<div class=\"phone\" id=\"phone\">\n  <div class=\"app-header\">\n    <img class=\"logo-icon\" src=\"@@ASSET0@@\" alt=\"NanoShellano\">\n    <div class=\"header-side\">\n      <div class=\"lang-toggle\" id=\"langToggle\" role=\"group\" aria-label=\"Language\">\n        <button data-lang=\"he\" class=\"on\">HE</button><span class=\"lt-sep\">|</span><button data-lang=\"en\">EN</button>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"stage\" id=\"stage\">\n\n    <!-- 1 · hero -->\n    <section class=\"slide hero active\">\n      <div>\n        <img class=\"mascot\" src=\"@@ASSET1@@\" alt=\"\">\n        <h1 data-i18n-html=\"heroH1\">התקבל עובד חדש<br><span class=\"accent\">סוכן ה-AI שלך מתחיל היום</span></h1>\n        <p class=\"lead\" data-i18n=\"heroLead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי להיות לפני כולם.</p>\n        </div>\n      <div class=\"trust\" data-i18n-html=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n    </section>\n\n    <!-- 2 · telegram demo (auto simulation, no interaction) -->\n    <section class=\"slide demo before\">\n      <h1 class=\"demo-h1\" data-i18n-html=\"demoH1\">כך נראה יום עבודה עם <span class=\"accent\">הסוכן שלך</span></h1>\n      <p class=\"lead demo-lead\" data-i18n=\"demoLead\">4 דוגמאות למשימות שגרתיות שהסוכן יודע לעשות.</p>\n      <p class=\"demo-note\" data-i18n=\"demoNote\">הדגמה להמחשה בלבד. החיבור למערכות עדיין לא פעיל.</p>\n      <div class=\"chat-card\" id=\"chatCard\">\n        <div class=\"tg-header\">\n          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n          <div class=\"tg-avatar\"><img src=\"@@ASSET2@@\" alt=\"\"></div>\n          <div class=\"tg-title\">\n            <div class=\"tg-name\" id=\"tgName\">ג'וני</div>\n            <div class=\"tg-status\" id=\"tgStatus\">online</div>\n          </div>\n          <span class=\"tg-menu\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\"/><circle cx=\"12\" cy=\"19\" r=\"1.7\"/></svg></span>\n        </div>\n        <div class=\"chat-log\" id=\"chatLog\"></div>\n        <div class=\"tg-input\">\n          <div class=\"fake-field\">\n            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n            <span>Message</span>\n          </div>\n          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n        </div>\n      </div>\n      <p class=\"manifesto-line\" data-i18n-html=\"manifesto\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n    </section>\n\n    <!-- 3 · security -->\n    <section class=\"slide list-slide before\">\n      <h1 data-i18n-html=\"secH1\">הבטחה <span class=\"accent\">ופרטיות</span></h1>\n      <p class=\"lead\" data-i18n=\"secLead\">הסוכן שלך סגור ומאובטח. 4 דברים שחשוב לדעת.</p>\n      <div class=\"cards\" id=\"secCards\">\n        <div class=\"card reveal-item\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n          <div><h3 data-i18n=\"sec1T\">סביבה מבודדת, שלך בלבד</h3><p data-i18n=\"sec1B\">הסוכן פועל בסביבה סגורה שנפתחת רק עבורך. אף גורם מבחוץ לא נוגע במידע שבתוכה.</p></div>\n        </div>\n        <div class=\"card reveal-item\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n          <div><h3 data-i18n=\"sec2T\">טלגרם, ערוץ פרטי ומוצפן</h3><p data-i18n=\"sec2B\">כל השיחה עוברת בטלגרם בלבד, מוצפנת ונפרדת מהמייל, מהדרייב ומכל מערכת אחרת.</p></div>\n        </div>\n        <div class=\"card reveal-item\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n          <div><h3 data-i18n=\"sec3T\">אין גישה לחשבונות שלך</h3><p data-i18n=\"sec3B\">המייל, הדרייב והחשבונות חסומים לסוכן. בחירה ארכיטקטונית קבועה, לא מגבלה זמנית.</p></div>\n        </div>\n        <div class=\"card reveal-item\">\n          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"4.5\"/><path d=\"M10.8 12.2L21 2\"/><path d=\"M15 8l3 3\"/></svg></div>\n          <div><h3 data-i18n=\"sec4T\">כלי AI חיצוניים, במפתחות שלך</h3><p data-i18n=\"sec4B\">חיבור לכלים חיצוניים נעשה רק דרך מפתחות ה־API שלך. סגורים, לא ניתנים להעברה, ומנותקים בלחיצה.</p></div>\n        </div>\n      </div>\n      <p class=\"soul\" data-i18n-html=\"soul\">מוח של AI, גוף של NanoClaw, ונשמה של <span class=\"accent\">אליה בן כנען</span>.</p>\n    </section>\n\n    <!-- 4 · pilot -->\n    <section class=\"slide list-slide before pilot-slide\">\n      <h1 data-i18n-html=\"pilH1\">עשרה ימים <span class=\"accent\">בעולם החדש</span></h1>\n      <p class=\"lead\" data-i18n=\"pilLead\">סוכני AI נכנסים לכל תפקיד, והעבודה שהכרנו משתנה. אני רוצה שתרגישו את זה בעצמכם. עשרה ימים על העבודה האמיתית שלכם.</p>\n      <div class=\"pnotes\">\n        <div class=\"pnote reveal-item\"><span class=\"pn-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"20 12 20 22 4 22 4 12\"/><rect x=\"2\" y=\"7\" width=\"20\" height=\"5\"/><line x1=\"12\" y1=\"22\" x2=\"12\" y2=\"7\"/><path d=\"M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z\"/><path d=\"M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z\"/></svg></span><div><h3 data-i18n=\"pil1T\">חינם באמת</h3><p data-i18n=\"pil1B\">בלי כרטיס אשראי, בלי לבטל כלום, בלי אותיות קטנות. פשוט מתחילים.</p></div></div>\n        <div class=\"pnote reveal-item\"><span class=\"pn-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg></span><div><h3 data-i18n=\"pil2T\">זה אמיתי, וגדל איתכם</h3><p data-i18n=\"pil2B\">לא הדגמה. סוכן שעובד על המשימות האמיתיות שלכם, ולומד את הקצב והסגנון שלכם ככל שתשתמשו.</p></div></div>\n        <div class=\"pnote reveal-item\"><span class=\"pn-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4\"/></svg></span><div><h3 data-i18n=\"pil3T\">בסוף, אתם מחליטים</h3><p data-i18n=\"pil3B\">רוצים להמשיך? מקימים סוכן משלכם. לא רוצים? פשוט נגמר. בלי חיוב ובלי מלכוד.</p></div></div>\n      </div>\n      <p class=\"soul\" data-i18n-html=\"pilSoul\"><span class=\"accent\">שלכם, אליה בן כנען</span>.</p>\n    </section>\n\n    <!-- 5 · signup -->\n    <section class=\"slide list-slide before\">\n      <h1 data-i18n-html=\"formH1\">הסוכן <span class=\"accent\">נכנס לעבודה</span></h1>\n      <p class=\"lead\" style=\"margin-top:8px\" data-i18n=\"formLead\">הסוכן שלך עובד מתוך טלגרם, ומשם תתנהל כל העבודה איתו. טלגרם זמין גם בנייד וגם במחשב, כדי שיהיה לך נוח לעבוד מכל מקום. עוד כמה פרטים, והוא כבר מתחיל.</p>\n      <p class=\"dl-prompt\" data-i18n=\"dlPrompt\">אין לך טלגרם? מורידים בדקה:</p>\n      <div class=\"dl-row\" style=\"margin-top:8px\">\n        <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlMobile\">הורדת טלגרם לנייד ←</a>\n        <a href=\"https://desktop.telegram.org/\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlDesktop\">הורדת טלגרם למחשב ←</a>\n      </div>\n      <form id=\"signupForm\" novalidate>\n        <div class=\"name-row\">\n          <div class=\"field\" id=\"fFirst\">\n            <label for=\"inFirst\" data-i18n=\"firstL\">שם פרטי</label>\n            <input id=\"inFirst\" type=\"text\" placeholder=\"השם שלך\" autocomplete=\"given-name\" data-i18n-ph=\"firstPh\">\n            <div class=\"err\" data-i18n=\"firstE\">נא להזין שם פרטי</div>\n          </div>\n          <div class=\"field\" id=\"fLast\">\n            <label for=\"inLast\" data-i18n=\"lastL\">שם משפחה</label>\n            <input id=\"inLast\" type=\"text\" placeholder=\"שם משפחה\" autocomplete=\"family-name\" data-i18n-ph=\"lastPh\">\n            <div class=\"err\" data-i18n=\"lastE\">נא להזין שם משפחה</div>\n          </div>\n        </div>\n        <div class=\"field\" id=\"fEmail\">\n          <label for=\"inEmail\" data-i18n=\"emailL\">אימייל</label>\n          <input id=\"inEmail\" type=\"email\" placeholder=\"name@company.com\" autocomplete=\"email\">\n          <div class=\"err\" data-i18n=\"emailE\">נא להזין אימייל תקין</div>\n        </div>\n        <div class=\"field\" id=\"fPhone\">\n          <label for=\"inPhone\" data-i18n=\"phoneL\">טלפון</label>\n          <input id=\"inPhone\" type=\"tel\" placeholder=\"050-0000000\" autocomplete=\"tel\">\n          <div class=\"err\" data-i18n=\"phoneE\">נא להזין מספר טלפון תקין</div>\n        </div>\n        <label class=\"consent\" id=\"tgConsentWrap\">\n          <input type=\"checkbox\" id=\"inTgConsent\">\n          <span data-i18n=\"tgConsent\">הורדתי טלגרם, אפשר להתחיל</span>\n        </label>\n        <label class=\"consent\" id=\"consentWrap\">\n          <input type=\"checkbox\" id=\"inConsent\">\n          <span data-i18n-html=\"consent\">קראתי ואישרתי את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a></span>\n        </label>\n      </form>\n      <p class=\"soul\" data-i18n-html=\"formSoul\">עוד דקה של פרטים, והסוכן שלך שולח לך <span class=\"accent\">הודעה ראשונה</span>.</p>\n    </section>\n\n  </div>\n\n  <div class=\"cta-zone\">\n    <div class=\"nav-row\">\n      <button class=\"nav-arr\" id=\"arrBack\" aria-label=\"הקודם\" disabled>\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n      </button>\n      <div class=\"dots\" id=\"dots\"></div>\n      <button class=\"nav-arr\" id=\"arrFwd\" aria-label=\"הבא\">\n        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n      </button>\n    </div>\n    <button class=\"cta\" id=\"ctaBtn\">קדימה, הסוכן שלך מחכה</button>\n    <div class=\"cta-sub\">\n      <div class=\"swipe-hint\" id=\"swipeHint\">\n        <span data-i18n=\"swipeHint\">החליקו לראות אותו בפעולה</span>\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg>\n      </div>\n      <div class=\"cta-foot\" id=\"ctaFoot\"></div>\n    </div>\n  </div>\n</div>\n\n<div class=\"caption\">Shellano</div>\n\n<script>\n/* ================= i18n ================= */\nconst S = {\n  he: {\n    docTitle: 'Shellano · פותחים סוכן AI אישי בכמה דקות',\n    heroH1: 'התקבל עובד חדש<br><span class=\"accent\">סוכן ה-AI שלך מתחיל היום</span>',\n    heroLead: 'כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום יד