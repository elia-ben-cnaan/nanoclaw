fx-example { padding: 16px 18px; }\n  .fx-ex-calc { font-size: 15px; }\n}\n</style>\n</head>\n<body>\n\n<nav id=\"navbar\">\n  <div class=\"nav-logo\"><img src=\"payme-logo.jpg\" alt=\"PayMe\"></div>\n  <div class=\"nav-left\">\n    <div class=\"nav-count\"><b id=\"cur\">01</b>&thinsp;/&thinsp;<span id=\"tot\">16</span></div>\n    <a class=\"lang-toggle\" href=\"/en.html\">EN</a>\n  </div>\n</nav>\n\n<div id=\"deck\"></div>\n\n<div id=\"bottombar\">\n  <div id=\"slide-lbl\"></div>\n  <div id=\"progress\"></div>\n  <div id=\"arrows\">\n    <button class=\"arr-btn\" id=\"arr-fwd\">&#8592;</button>\n    <button class=\"arr-btn\" id=\"arr-back\">&#8594;</button>\n  </div>\n</div>\n\n<script>\nconst STAGES = [\n  { n: 'חודש 1', t: 'תכנון\\nוהכנת תשתית', mrr: '5,000 ₪', bullets: [\n    'בניית התוכנית ונכסי ה-Go-to-Market, מיפוי השוק וההזדמנויות האמיתיות',\n    'מחקר ודגימה בלבד, עדיין בלי תהליך מכירה אקטיבי',\n    'נגיעות חמות במעגל הקרוב ובאנשי ה-Inbound המוכרים, לא Sales Cycle',\n    'פתיחת ערוצי ההפצה: LinkedIn, מייל, רשת אישית, נוכחות ראשונה בסושיאל'\n  ]},\n  { n: 'חודש 2', t: 'מגע ראשון\\nו-Pilots', mrr: '13,600 ₪', bullets: [\n    'מגע אמיתי ראשון עם השוק: פניות יזומות, ניוזלטרים ו-WhatsApp על השירות המתאים',\n    'קובעים ומקיימים פגישות, שולחים חומרים תומכים',\n    'דגימה ברמת הטלפון כדי ללמוד מאיפה מגיע הפידבק',\n    'אחרי כל פגישה יוצאת הצעת מחיר'\n  ]},\n  { n: 'חודש 3', t: 'הבשלה', mrr: '47,000 ₪', bullets: [\n    'הצעות מותאמות אישית ו-Follow-ups רצים, מתחיל משא ומתן מורכב לסגירה',\n    'עסקאות על השולחן, ותהליכים מבשילים שכבר רואים אותם נסגרים בחודש הבא',\n    'מחממים את החשבונות המדויקים, אלה עם כוונת הקנייה הגבוהה',\n    'הרחבת ה-Inbound ממשיכה במקביל'\n  ]},\n  { n: 'חודש 4', t: 'סגירות\\nואופטימיזציה', mrr: '102,100 ₪', bullets: [\n    'מתחילים לסגור עסקאות',\n    'אופטימיזציה: מכפילים השקעה בחשבונות הרציניים, משחררים את אלה שלא מתקדמים',\n    'בודקים פרוספקטים מקבילים באותם סגמנטים, לפי הפידבק מהשטח',\n    'חוצים את היעד: מעל 100K ₪ MRR נטו'\n  ]}\n];\n\nconst SLIDES = [\n  { label: 'שער', type: 'cover' },\n  { label: 'מי מאחורי הדק', type: 'profile',\n    kicker: 'מי מאחורי הדק',\n    photo: 'elia.png',\n    name: 'אליה בן כנען',\n    role: 'פיתוח עסקי · אסטרטגיה שיווקית · 15 שנה',\n    pts: [\n      '<b>15 שנה בפיתוח עסקי ואסטרטגיה שיווקית</b>, מהמפגש הראשון ועד סגירת העסקה.',\n      'עבודת שטח מול שותפים: לפתוח דלתות, לבנות ערך משותף ולהניע תהליך מסחרי עד הסוף.',\n      'את השיטה הזו כבר הרצתי בשטח: מיפוי שוק, פתיחת הדלת הנכונה וסגירת שותפויות מסחריות מקצה לקצה. בדיוק מה שהתפקיד דורש.'\n    ]\n  },\n  { label: 'איך בניתי את האסטרטגיה', type: 'process', dir: true,\n    kicker: 'המתודולוגיה',\n    hl: 'איך בניתי\\n<em>את האסטרטגיה</em>',\n    bd: 'לא ניחוש. תהליך של ארבעה שלבים, מרוחב של השוק אל תוכנית שאפשר להריץ. התוכנית ממוקדת בשוק הישראלי כנקודת הפתיחה, שם אני יכול להניע תוצאה מהיום הראשון.',\n    steps: [\n      { num: '1', h: 'מחקר שוק', p: '5 סגמנטים, 40+ שותפים פוטנציאליים' },\n      { num: '2', h: 'סינון ופוקוס', p: 'הסגמנטים עם הפוטנציאל הגבוה ביותר' },\n      { num: '3', h: 'חלוקה', p: 'Inbound (מינוף קיימים) + Outbound (שותפים חדשים)' },\n      { num: '4', h: 'תוכנית אופרטיבית', p: 'למי פונים, מה אומרים, מתי סוגרים, כמה מכניס' }\n    ],\n    band: [\n      { b: 'Inbound', s: '4 שותפים קיימים · הרחבת מוצרים · ~90,000 עסקים' },\n      { b: 'Outbound', s: '6 שותפים חדשים · 5 סגמנטים · ~20,000 עסקים' }\n    ]\n  },\n  { label: 'שני מנועים', type: 'split', cycle: true,\n    hl: 'שני מנועים.\\n<em>יעד אחד.</em>',\n    bd: 'לא הימרתי הכל על עסקאות חדשות. חצי מהתוכנית מגדל שותפים שכבר בפנים, מהיר ובסיכון נמוך. החצי השני פותח קרקע חדשה. אם אחד מתעכב, השני מפצה.',\n    cards: [\n      { step: 'מנוע 01', hl: 'Inbound', bd: 'ארבעה שותפים שכבר עובדים עם PayMe. מרחיבים את מה שהם מוכרים, מתשלומים אל הנהלת חשבונות ושיווק. המעגל הקרוב קודם, בלי להתחיל מאפס.' },\n      { step: 'מנוע 02', hl: 'Outbound', bd: 'שש שותפויות חדשות שבהן PayMe עדיין לא נמצאת, שנבחרו כי ההתאמה ברורה וה-Sales Cycle קצר.' }\n    ]\n  },\n  { label: 'Inbound · מוצרים משלימים', type: 'table',\n    kicker: 'מנוע 01 · Inbound',\n    hl: 'מוצרים משלימים <em>לשותפים קיימים</em>',\n    sub: 'כל שותף כבר משתמש במוצר אחד של PayMe. אלה ההזדמנויות להוסיף מוצר שני. פער אחד מאומת. השאר השערות שדורשות שיחת גילוי לפני שמקצים משאבים.',\n    cols: ['שותף', 'משתמש היום', 'מוצר להוספה', 'למה', 'סטטוס', 'MRR משוער'],\n    rows: [\n      ['Wix', 'Payments בלבד', 'Accounting (חשבוניות ישראליות)', 'ל-Wix אין חשבוניות מאושרות רשות המסים לסוחרים ישראלים. חובה חוקית עם אפס כיסוי היום.', '<span class=\"st-ok\">מאומת</span>', '<span class=\"num\">7,500 ₪</span>'],\n      ['Wolt Merchants', 'Accounting + Payments (שליחים)', 'Promoter למסעדות', 'מסעדות רוצות יותר הזמנות ונראות. עלול לחפוף ל-Promoted Listings שבתוך האפליקציה.', '<span class=\"st-chk\">דורש בדיקה</span>', 'לא ידוע'],\n      ['Isracard / Cal', 'Payments (White Label)', 'Accounting + Promoter כחבילה', 'כל המתחרים מציעים סליקה. הוספת Accounting + Promoter היא הדיפרנציאציה. תהליך של 6+ חודשים.', '<span class=\"st-chk\">דורש בדיקה</span>', 'לא ידוע'],\n      ['Zester', 'Payments B2B (ספקים)', 'Accounting למסעדות', 'מסעדות משלמות ספקים דרך PayMe אבל מנהלות חשבוניות בנפרד. ייתכן שכבר יש להן הנהלת חשבונות.', '<span class=\"st-chk\">דורש בדיקה</span>', 'לא ידוע']\n    ],\n    foot: 'רק Wix היא פער מאומת היום (7,500 ₪). השאר השערות לשיחות גילוי. ברמפה שמרנית מנוע ה-Inbound מוסיף ~30,000 ₪ MRR, החצי השני של יעד ה-102,100.',\n    src: 'מקור: אתר PayMe, Wix Developer Docs, Isracard.co.il'\n  },\n  { label: 'Outbound · מיפוי סגמנטים', type: 'table',\n    kicker: 'מנוע 02 · Outbound',\n    hl: 'חמישה סגמנטים, לפי עדיפות',\n    cols: ['סגמנט', 'גודל שוק (IL)', 'שותפים אסטרטגיים', 'מוצר PayMe', 'עדיפות'],\n    rows: [\n      ['Gig Economy', '25,000-35,000', '<span class=\"tag-hunger\">10bis · יאנגו דלי · Gett</span>', 'Accounting', '<span class=\"stars\">★★★★★</span>'],\n      ['מרכזים רפואיים', '1,500-2,000', '<span class=\"tag-hunger\">אסותא · HMC · מדיקה</span>', 'Accounting + Payments', '<span class=\"stars\">★★★★★</span>'],\n      ['כושר / סטודיואים', '10,000-20,000', '<span class=\"tag-hunger\">Arbox · BoostApp · Fizikal</span>', 'Accounting + Promoter', '<span class=\"stars\">★★★★</span>'],\n      ['יופי / קוסמטיקה', '10,000-20,000', '<span class=\"tag-hunger\">Plannie · Arbox · Fresha</span>', 'Payments + Accounting', '<span class=\"stars\">★★★★</span>'],\n      ['בעלי מקצוע', 'עשרות אלפים', '<span class=\"tag-hunger\">מידרג · המקצוענים</span>', 'Accounting + Payments', '<span class=\"stars\">★★★★</span>']\n    ],\n    foot: 'סה\"כ Addressable Market: ~50,000-80,000 עסקים קטנים ועצמאיים בישראל',\n    src: 'מקורות מפורטים בגיליון \"בסיס החישוב\" + מסמכי המחקר המצורפים'\n  },\n  { label: 'Outbound · שותפים נבחרים', type: 'table',\n    kicker: 'מנוע 02 · Outbound',\n    hl: 'שישה נבחרו מתוך 40+',\n    sub: 'קריטריונים: Sales Cycle, PoC קיים, Volume, התאמה למוצר. החשיפה נעה מתרחיש שמרני לעליון, והיא שקובעת את ה-MRR של חודש 4.',\n    cols: ['שותף', 'אקוסיסטם', 'מוצר', 'למה נבחר', 'חשיפה', 'MRR חודש 4'],\n    rows: [\n      ['תן ביס (10bis)', '~6,000 שליחים', 'Accounting', 'PoC של Wolt מוכח. עברה ל-100% עצמאיים ב-2025. מחליפה Keycost.', 'שמרני: 900 · 15%\\nעליון: 1,800 · 30%', '<span class=\"num\">33,750 ₪</span>'],\n      ['Arbox', '~7,000 עסקים', 'Accounting + Promoter', 'פלטפורמה #1 בכושר. חסר Accounting. Volume ענק.', 'שמרני: 350 · 5%\\nעליון: 700 · 10%', '<span class=\"num\">17,600 ₪</span>'],\n      ['Plannie', '~3,000 עסקים', 'Payments + Accounting', 'תורים ללא סליקה. התאמה טבעית.', 'שמרני: 300 · 10%\\nעליון: 600 · 20%', '<span class=\"num\">12,000 ₪</span>'],\n      ['יאנגו דלי', '~2,000 שליחים', 'Accounting', 'אותו מודל Wolt. מבית Yandex.', 'שמרני: 200 · 10%\\nעליון: 400 · 20%', '<span class=\"num\">7,500 ₪</span>'],\n      ['אסותא', '~400 רופאים', 'Accounting + Payments', 'Credibility. עסקה אחת = מאות רופאים.', 'שמרני: 20 · 5%\\nעליון: 50 · 12%', '<span class=\"num\">1,250 ₪</span>'],\n      ['HMC · הרצליה מדיקל', '~500 רופאים', 'Accounting + Payments', 'בי\"ח פרטי פרימיום. אות איכות למגזר הרפואי.', 'תרחיש עליון', '<span class=\"tag-pain\">עליון</span>']\n    ],\n    foot: 'סה\"כ Outbound (שמרני): ~72,000 ₪ MRR בחודש 4 · המודל המלא: 102,100 ₪ שמרני · 141,000 ₪ עליון',\n    src: 'מקור: גיליונות \"בחירת שותפים\" + \"תרחיש שמרני / עליון\", PayMe_תוכנית_סופית.xlsx'\n  },\n  { label: 'הצעת ערך', type: 'split', cycle: true,\n    hl: 'הצעת ערך,\\n<em>לא עמלה.</em>',\n    bd: 'בשני המנועים הפיץ׳ זהה, והוא אינו העמלה: מה שהשותף מרוויח ולא יכול לבנות לבד. שלוש דוגמאות Outbound ואחת Inbound.',\n    cards: [\n      { step: 'OUTBOUND · תן ביס', hl: 'שימור שליחים', bd: 'שליח שלא מסתדר עם ניירת עוזב. PayMe מחליפה את Keycost בשירות טוב יותר, והשליח נשאר.' },\n      { step: 'OUTBOUND · Arbox', hl: 'הפיצ׳ר החסר', bd: 'הלקוחות שואלים \"למה אין חשבוניות?\". PayMe נותנת את זה בלי שורת קוד אחת מצדם.' },\n      { step: 'OUTBOUND · Plannie', hl: 'הכפלת ARPU', bd: 'מ-50 ₪ (יומן) ל-200 ₪ (יומן + סליקה + חשבוניות). PayMe מכפילה את ה-ARPU של Plannie.' },\n      { step: 'INBOUND · Wix', hl: 'חווית משתמש שלמה', bd: 'סוחר ישראלי מנהל 3 מערכות בנפרד. עם Accounting הכל במקום אחד, Lock-in ו-Revenue Stream חדש.' }\n    ]\n  },\n  { label: 'איך זה נראה בפועל', type: 'insight',\n    hl: 'איך זה נראה\\n<em>בפועל.</em>',\n    bd: 'דוגמה אחת, מפורקת עד הסוף: סגמנט הרופאים. זו לא עוד שורה בתוכנית, זו הדגמה של השיטה: לזהות את הכאב, לבנות את המודל המסחרי, למצוא את נקודת הכניסה. אותו פירוק בדיוק רץ על כל סגמנט שנחליט להיכנס אליו.'\n  },\n  { label: 'Use Case · הדגמת מתודולוגיה', type: 'split', cycle: true, tag: 'הדגמת מתודולוגיה',\n    hl: 'Use Case · הרופא\\n<em>בקליניקה הגדולה</em>',\n    bd: 'לא רופא שפותח קליניקה. היעד הוא רופאים שעובדים בתוך קליניקות פרטיות גדולות ומרכזים רפואיים שמעסיקים מטפלים רבים, ולצידם הרופאים הצעירים בתחילת הדרך. לא כולם מנהלים ספרים מסודרים, וגם מי שכן מריץ סליקה וחשבוניות במערכות נפרדות. PayMe לא פותחת להם עסק, היא הופכת את ניהול הכסף היומיומי לזרימה אחת.',\n    foot: 'מטפל שמריץ 4 מערכות תמורת ~1,200 ₪ בחודש 