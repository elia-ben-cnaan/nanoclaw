{"parentUuid":"b6886b68-a3e8-4f81-8231-0e94b51622e7","isSidechain":false,"promptId":"ac94058b-3b00-4f82-9b33-8d04137ab0be","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MUDZ9wFUFHAqXJPZoyHyw4","type":"tool_result","content":"340\t  },\n341\t  { label: 'How I built the strategy', type: 'process', dir: true,\n342\t    kicker: 'THE METHODOLOGY',\n343\t    hl: 'How I built\\n<em>the strategy</em>',\n344\t    bd: 'Not guesswork. A four-step process, from the breadth of the market down to a plan you can run.',\n345\t    steps: [\n346\t      { num: '1', h: 'Market research', p: '5 segments, 40+ potential partners' },\n347\t      { num: '2', h: 'Filter & focus', p: 'The segments with the highest potential' },\n348\t      { num: '3', h: 'Split', p: 'Inbound (leverage existing) + Outbound (new partners)' },\n349\t      { num: '4', h: 'Operating plan', p: 'Who to approach, what to say, when to close, how much it brings' }\n350\t    ],\n351\t    band: [\n352\t      { b: 'Inbound', s: '4 existing partners · product expansion · ~90,000 businesses' },\n353\t      { b: 'Outbound', s: '6 new partners · 5 segments · ~20,000 businesses' }\n354\t    ]\n355\t  },\n356\t  { label: 'Two engines', type: 'split', cycle: true,\n357\t    hl: 'Two engines.\\n<em>One target.</em>',\n358\t    bd: 'I did not bet everything on new deals. Half the plan grows partners already inside, fast and low-risk. The other half opens new ground. If one is delayed, the other compensates.',\n359\t    cards: [\n360\t      { step: 'ENGINE 01', hl: 'Inbound', bd: 'Four partners already working with PayMe. Expand what they sell, from payments to accounting and marketing. The closest circle first, no starting from zero.' },\n361\t      { step: 'ENGINE 02', hl: 'Outbound', bd: 'Six new partnerships where PayMe is not yet present, chosen because the fit is clear and the sales cycle is short.' }\n362\t    ]\n363\t  },\n364\t  { label: 'Inbound · complementary products', type: 'table',\n365\t    kicker: 'ENGINE 01 · INBOUND',\n366\t    hl: 'Complementary products for <em>existing partners</em>',\n367\t    sub: 'Each partner already uses one PayMe product. These are the openings to add a second. One gap is validated. The rest are hypotheses that need a discovery call before we commit resources.',\n368\t    cols: ['Partner', 'Uses today', 'Product to add', 'Why', 'Status', 'Est. MRR'],\n369\t    rows: [\n370\t      ['Wix', 'Payments only', 'Accounting (IL invoicing)', 'No tax-authority-approved invoicing for Israeli merchants. A legal requirement with zero coverage today.', '<span class=\"st-ok\">Validated</span>', '<span class=\"num\">₪7,500</span>'],\n371\t      ['Wolt Merchants', 'Accounting + Payments (couriers)', 'Promoter for restaurants', 'Restaurants want more orders and visibility. May overlap Wolt\\'s in-app Promoted Listings.', '<span class=\"st-chk\">To validate</span>', 'TBD'],\n372\t      ['Isracard / Cal', 'Payments (White Label)', 'Accounting + Promoter bundle', 'Every competitor offers payments. Adding Accounting + Promoter is the differentiation. 6+ month cycle.', '<span class=\"st-chk\">To validate</span>', 'TBD'],\n373\t      ['Zester', 'Payments B2B (suppliers)', 'Accounting for restaurants', 'Restaurants pay suppliers through PayMe but manage invoices separately. May already have bookkeeping.', '<span class=\"st-chk\">To validate</span>', 'TBD']\n374\t    ],\n375\t    foot: 'Only Wix is a validated gap today (₪7,500). The rest are hypotheses for discovery. At a conservative ramp the Inbound engine adds ~₪30,000 MRR, the other half of the ₪102,100 target.',\n376\t    src: 'Source: PayMe website, Wix Developer Docs, Isracard.co.il'\n377\t  },\n378\t  { label: 'Outbound · segment mapping', type: 'table',\n379\t    kicker: 'ENGINE 02 · OUTBOUND',\n380\t    hl: 'Five segments, by priority',\n381\t    cols: ['Segment', 'Market size (IL)', 'Strategic partners', 'PayMe product', 'Priority'],\n382\t    rows: [\n383\t      ['Gig Economy', '25,000-35,000', '<span class=\"tag-hunger\">10bis · Yango Deli · Gett</span>', 'Accounting', '<span class=\"stars\">★★★★★</span>'],\n384\t      ['Medical centers', '1,500-2,000', '<span class=\"tag-hunger\">Assuta · HMC · Medica</span>', 'Accounting + Payments', '<span class=\"stars\">★★★★★</span>'],\n385\t      ['Fitness / studios', '10,000-20,000', '<span class=\"tag-hunger\">Arbox · BoostApp · Fizikal</span>', 'Accounting + Promoter', '<span class=\"stars\">★★★★</span>'],\n386\t      ['Beauty / cosmetics', '10,000-20,000', '<span class=\"tag-hunger\">Plannie · Arbox · Fresha</span>', 'Payments + Accounting', '<span class=\"stars\">★★★★</span>'],\n387\t      ['Professionals', 'tens of thousands', '<span class=\"tag-hunger\">Midrag · HaMiktzoanim</span>', 'Accounting + Payments', '<span class=\"stars\">★★★★</span>']\n388\t    ],\n389\t    foot: 'Total Addressable Market: ~50,000-80,000 small and independent businesses in Israel',\n390\t    src: 'Detailed sources in the \"Calculation Basis\" sheet + the attached research documents'\n391\t  },\n392\t  { label: 'Outbound · selected partners', type: 'table',\n393\t    kicker: 'ENGINE 02 · OUTBOUND',\n394\t    hl: 'Six chosen out of 40+',\n395\t    sub: 'Criteria: sales cycle, existing PoC, volume, product fit. Exposure runs from a conservative to an upside scenario, and drives the Month 4 MRR.',\n396\t    cols: ['Partner', 'Ecosystem', 'Product', 'Why chosen', 'Exposure (cons → upside)', 'MRR M4'],\n397\t    rows: [\n398\t      ['10bis', '~6,000 couriers', 'Accounting', 'Wolt PoC proven. 100% independents in 2025. Replaces Keycost.', '900 · 15% → 1,800 · 30%', '<span class=\"num\">₪33,750</span>'],\n399\t      ['Arbox', '~7,000 businesses', 'Accounting + Promoter', '#1 fitness platform. Missing Accounting. Huge volume.', '350 · 5% → 700 · 10%', '<span class=\"num\">₪17,600</span>'],\n400\t      ['Plannie', '~3,000 businesses', 'Payments + Accounting', 'Scheduling without payment processing. A natural fit.', '300 · 10% → 600 · 20%', '<span class=\"num\">₪12,000</span>'],\n401\t      ['Yango Deli', '~2,000 couriers', 'Accounting', 'Same model as Wolt. From Yandex.', '200 · 10% → 400 · 20%', '<span class=\"num\">₪7,500</span>'],\n402\t      ['Assuta', '~400 physicians', 'Accounting + Payments', 'Credibility. One deal = hundreds of physicians.', '20 · 5% → 50 · 12%', '<span class=\"num\">₪1,250</span>'],\n403\t      ['HMC · Herzliya Medical', '~500 physicians', 'Accounting + Payments', 'Premium private hospital. A quality signal for the sector.', 'upside scenario', '<span class=\"tag-pain\">upside</span>']\n404\t    ],\n405\t    foot: 'Total Outbound (conservative): ~₪72,000 MRR in Month 4 · full model: ₪102,100 conservative · ₪141,000 upside',\n406\t    src: 'Source: \"Partner Selection\" + \"Conservative / Upside Scenario\" sheets, PayMe_Final_Plan.xlsx'\n407\t  },\n408\t  { label: 'Value proposition', type: 'split', cycle: true,\n409\t    hl: 'A value prop,\\n<em>not a fee.</em>',\n410\t    bd: 'On both engines the pitch is the same. Not the fee, but what the partner gains and cannot build alone. Three Outbound examples and one Inbound.',\n411\t    cards: [\n412\t      { step: 'OUTBOUND · 10bis', hl: 'Courier retention', bd: 'A courier who cannot handle the paperwork leaves. PayMe replaces Keycost with a better service, and the courier stays.' },\n413\t      { step: 'OUTBOUND · Arbox', hl: 'The missing feature', bd: 'Customers ask \"why is there no invoicing?\". PayMe delivers it without a single line of code on their side.' },\n414\t      { step: 'OUTBOUND · Plannie', hl: 'Double the ARPU', bd: 'From ₪50 (calendar) to ₪200 (calendar + payments + invoices). PayMe doubles Plannie\\'s ARPU.' },\n415\t      { step: 'INBOUND · Wix', hl: 'A complete UX', bd: 'An Israeli merchant runs 3 separate systems. With Accounting it is all in one place, Lock-in and a new revenue stream.' }\n416\t    ]\n417\t  },\n418\t  { label: 'How it works in practice', type: 'insight',\n419\t    hl: 'How it looks\\n<em>in practice.</em>',\n420\t    bd: 'One example, taken all the way down: the physicians segment. This is not an extra line in the plan, it is a demonstration of the method. Spot the pain, build the commercial model, find the entry point. The exact same breakdown runs on every segment we choose to enter.'\n421\t  },\n422\t  { label: 'Use Case · methodology demo', type: 'split', cycle: true, tag: 'METHODOLOGY DEMO',\n423\t    hl: 'Use case · the physician\\n<em>inside the large clinic</em>',\n424\t    bd: 'Not a physician opening a clinic. The target is physicians working inside large private clinics and medical centers that employ many practitioners, and the young physicians early in their path. Not all keep organized books, and even those who do run their processing and invoicing across separate systems. PayMe does not open a business for them, it makes the day-to-day money management one flow.',\n425\t    foot: 'A practitioner running 4 systems for ~₪1,200/mo runs everything through PayMe for ~₪250, in one place.',\n426\t    cards: [\n427\t      { step: 'Payments', hl: 'One-click processing', bd: 'The patient pays by card, Bit or transfer. No separate terminal, no extra provider, no double processing fees.' },\n428\t      { step: 'Accounting', hl: 'Automatic invoice + tax report', bd: 'An invoice is issued the moment payment is made and the tax report is ready, flowing to the accountant with no manual work.' },\n429\t      { step: 'One interface', hl: 'Connected to the clinic software', bd: 'Instead of separate systems that do not talk, one flow that plugs into the clinic management software already in use.' }\n430\t    ]\n431\t  },\n432\t  { label: 'Use Case · the commercial model', type: 'table',\n433\t    kicker: 'THE COMMERCIAL MODEL · VIA CLINIC MANAGEMENT SOFTWARE',\n434\t    hl: 'Who <em>gains</em> what',\n435\t    sub: 'The recommended path: enter through an existing platform like Tipulog, and approach the large medical centers (Assuta, HMC, Medica) in parallel. One deal reaches many practitioners at once, and every side comes out ahead.',\n436\t    cols: ['Side', 'What they get', 'How much'],\n437\t    rows: [\n438\t      ['Physician / practitioner', 'Payments + Accounting built into software they already use', 'Pays <span class=\"num\">~₪250</span> instead of ~1,200. Saves ~₪950/mo'],\n439\t      ['The platform (Tipulog)', 'Revenue share + customer retention + higher ARPU', '<span class=\"num\">₪40-60</span>/practitioner/mo'],\n440\t      ['PayMe', 'Access to many practitioners with no long individual sales cycle', '<span class=\"num\">₪100-150K</span> MRR (1,000 practitioners × ₪100-150 ARPU after revenue share)']\n441\t    ],\n442\t    foot: 'When we choose to enter this segment, the recommended entry is a platform like Tipulog, thousands of practitioners with no processing. One deal reaches many, and the exact same thinking runs on every vertical we go after.',\n443\t    src: 'The model repeats for every vertical, fitness · beauty · construction. Physicians are the proof of concept.'\n444\t  },\n445\t  { label: 'Calculation basis', type: 'formula',\n446\t    kicker: 'BEHIND THE NUMBERS',\n447\t    hl: 'Every shekel here is <em>calculated.</em>',\n448\t    terms: [\n449\t      { t: 'Businesses in ecosystem', ex: '6,000' },\n450\t      { t: '% exposure', ex: '15%' },\n451\t      { t: 'Activation rate', ex: '25%' },\n452\t      { t: 'Monthly ARPU', ex: '₪150' }\n453\t    ],\n454\t    result: '₪33,750',\n455\t    exLabel: 'One worked example · 10bis · Month 4',\n456\t    note: 'This is the 10bis line, spelled out. The identical formula runs on every one of the partners, the full per-partner table sits in the attached workbook. Exposure builds gradually over the quarter and reaches its full level (15%) by Month 4.',\n457\t    src: 'Source: \"Calculation Basis\" sheet, PayMe_Final_Plan.xlsx'\n458\t  },\n459\t  { label: '4-month plan', type: 'cmdcenter', meta: 'Work plan · month by month' },\n460\t  { label: 'Forecast', type: 'insight',\n461\t    hl: 'Two scenarios.\\n<em>Both clear the target.</em>',\n462\t    bd: 'The conservative scenario assumes 60% close rate and a slow rollout, and still clears the 100K target. In that scenario it is roughly 800 active users by Month 4, right inside the 700-1,000 we set out to reach at the start. The upside assumes a fast rollout, a working Promoter, and Isracard landing on time. The plan does not depend on any single win.',\n463\t    stats: [\n464\t      { num: '₪102,100', lbl: 'Conservative\\n60% close · 15% exposure' },\n465\t      { num: '₪141,000', lbl: 'Upside\\n80% close · 30% exposure · Promoter active', muted: true }\n466\t    ]\n467\t  },\n468\t  { label: 'Sources', type: 'closing',\n469\t    kicker: 'THE WORK BEHIND THE DECK',\n470\t    banner: 'Researched. Modeled.\\n<em>Ready to run.</em>',\n471\t    close: 'The supporting materials, ready to open straight in your browser. This is what I bring to the role: not just spotting an opportunity, but translating it into a numbers-backed plan you can open your first day of work with.',\n472\t    next: [\n473\t      { t: 'Workbook · final plan (Excel)', d: '6 sheets, 200+ live formulas: calculation basis, partner selection, 12-week activity, two scenarios and a comparison.', href: 'https://view.officeapps.live.com/op/view.aspx?src=https%3A%2F%2Fpayme-partners.vercel.app%2Fmaterials%2Fplan.xlsx' },\n474\t      { t: 'Companion document (Word)', d: 'The dual-engine model, Inbound methodology, segment selection, value propositions and forecast logic.', href: 'https://view.officeapps.live.com/op/view.aspx?src=https%3A%2F%2Fpayme-partners.vercel.app%2Fmaterials%2Fcompanion.docx' }\n475\t    ]\n476\t  },\n477\t  { label: 'Ready to start', type: 'finale',\n478\t    hl: 'Ready to start.\\n<em>From day one.</em>',\n479\t    line: 'I did not just analyze a market. I built a plan you can open your first day of work with, and reach ₪100,000 MRR in four months. I would love to go deep with the team and get started.',\n480\t    sign: 'Elia Ben Cnaan · Strategic Partner Sales',\n481\t    contact: 'elia@bencnaan.net · 052-8738698'\n482\t  }\n483\t];\n484\t\n485\tconst N = SLIDES.length;\n486\tlet cur = 0;\n487\tconst cycleIntervals = {}, cycleState = {};\n488\tconst BULLET_DURATION = 1875;\n489\tlet cmdActiveIdx = -1, cmdBulletTimer = null, cmdBulletIdx = -1, cmdAutoTimer = null;\n490\t\n491\tfunction pad2(n){ return String(n+1).padStart(2,'0'); }\n492\t\n493\tfunction buildSlideHTML(s, i) {\n494\t  const ov = `<div class=\"s-ov\"></div>`;\n495\t\n496\t  if (s.type === 'cover') {\n497\t    return ov + `<div class=\"s-wrap centered\">\n498\t      <img class=\"cover-logo\" src=\"payme-logo.jpg\" alt=\"PayMe\">\n499\t      <div class=\"cover-tag\">Strategic Partner Sales</div>\n500\t      <h1 class=\"cover-h\">₪100,000 net MRR.<br><em>In four months.</em></h1>\n501\t      <div class=\"cover-line\">Not just a market analysis. A partnerships plan you can open on day one.</div>\n502\t      <div class=\"cover-meta\"><span>Submitted by</span><span class=\"cover-dot\"></span><b>Elia Ben Cnaan</b></div>\n503\t    </div>`;\n504\t  }\n505\t\n506\t  if (s.type === 'process') {\n507\t    const cards = s.steps.map((c,ci)=>`\n508\t      <div class=\"proc-card\" id=\"proc-card-${i}-${ci}\"><div class=\"proc-num\">${c.num}</div><h3>${c.h}</h3><p>${c.p}</p></div>`).join('');\n509\t    const band = s.band.map(e=>`<div class=\"proc-eng\"><b>${e.b}</b><span>${e.s}</span></div>`).join('');\n510\t    const dir = s.dir ? `<div class=\"proc-dir\"><span class=\"pd-tag\">The direction</span>\n511\t      <div class=\"pd-eq\"><b>₪100,000</b><span>net per month</span></div><i class=\"pd-op\">÷</i>\n512\t      <div class=\"pd-eq\"><b>₪100-150</b><span>net ARPU per user</span></div><i class=\"pd-op\">=</i>\n513\t      <div class=\"pd-eq pd-res\"><b>~700-1,000</b><span>users to acquire</span></div></div>` : '';\n514\t    return ov + `<div class=\"s-wrap\">\n515\t      <div class=\"label-sm\">${s.kicker}</div><div class=\"rule\"></div>\n516\t      <h1 class=\"h-lg\" id=\"hl-${i}\"></h1><p class=\"body-t\" id=\"bd-${i}\"></p>\n517\t      <div class=\"proc-grid\">${cards}</div><div class=\"proc-band\">${band}</div>${dir}\n518\t    </div>`;\n519\t  }\n520\t\n521\t  if (s.type === 'split') {\n522\t    const cards = s.cards.map((c,ci)=>`\n523\t      <div class=\"fcard\">\n524\t        <div class=\"fcard-step\" id=\"cstep-${i}-${ci}\"></div>\n525\t        <h3 id=\"ctitle-${i}-${ci}\"></h3><p id=\"cdesc-${i}-${ci}\"></p>\n526\t        ${c.mrr ? `<span class=\"mrr\">${c.mrr}</span>` : ''}<div class=\"fcard-dot\"></div>\n527\t      </div>`).join('');\n528\t    return ov + `<div class=\"s-wrap\"><div class=\"split\">\n529\t        <div class=\"split-l\">${s.tag ? `<div class=\"label-sm\">${s.tag}</div>` : ''}<div class=\"rule\"></div>\n530\t          <h1 class=\"h-lg\" id=\"hl-${i}\"></h1><p class=\"body-t\" id=\"bd-${i}\"></p>\n531\t          ${s.foot ? `<div style=\"margin-top:22px;font-size:14px;font-weight:800;color:var(--accent)\">${s.foot}</div>` : ''}\n532\t        </div>\n533\t        <div class=\"split-r${s.cards.length > 3 ? ' grid2' : ''}\">${cards}</div>\n534\t      </div></div>`;\n535\t  }\n536\t\n537\t  if (s.type === 'table') {\n538\t    const head = s.cols.map(c=>`<th>${c}</th>`).join('');\n539\t    const body = s.rows.map(r=>`<tr>${r.map(c=>`<td>${String(c).replace(/\\n/g,'<br>')}</td>`).join('')}</tr>`).join('');\n540\t    return ov + `<div class=\"s-wrap centered\">\n541\t      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n542\t      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(34px,4.6vw,66px);margin-bottom:${s.sub?'8px':'0'}\"></h1>\n543\t      ${s.sub ? `<p class=\"body-t\" style=\"max-width:720px\">${s.sub}</p>` : ''}\n544\t      <div class=\"tbl-wrap\"><table class=\"ptable\"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>\n545\t      ${s.foot ? `<div class=\"tbl-foot\">${s.foot.replace(/(~?[\\d,]+(?:-[\\d,]+)?\\s*₪?)/,'<b>$1</b>')}</div>` : ''}\n546\t      ${s.src ? `<div class=\"tbl-src\">${s.src}</div>` : ''}\n547\t    </div>`;\n548\t  }\n549\t\n550\t  if (s.type === 'formula') {\n551\t    const terms = s.terms.map((t,ti)=>`\n552\t      <div class=\"fx-term\"><div class=\"fx-term-t\">${t.t}</div><div class=\"fx-term-ex\">${t.ex}</div></div>\n553\t      ${ti < s.terms.length-1 ? '<div class=\"fx-op\">×</div>' : ''}`).join('');\n554\t    const calc = s.terms.map(t=>t.ex).join(' × ') + ' = <b>' + s.result + '</b>';\n555\t    return ov + `<div class=\"s-wrap centered\">\n556\t      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n557\t      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(34px,4.6vw,64px);margin-bottom:6px\"></h1>\n558\t      <div class=\"fx-eq\"><div class=\"fx-res-lead\">MRR</div><div class=\"fx-op fx-eq-sign\">=</div>${terms}</div>\n559\t      <div class=\"fx-example\"><span class=\"fx-ex-label\">${s.exLabel}</span><span class=\"fx-ex-calc\">${calc}</span></div>\n560\t      <div class=\"tbl-src\" style=\"margin-top:22px;max-width:660px;line-height:1.6\">${s.note}</div>\n561\t      ${s.src ? `<div class=\"tbl-src\">${s.src}</div>` : ''}\n562\t    </div>`;\n563\t  }\n564\t\n565\t  if (s.type === 'insight') {\n566\t    const stats = s.stats ? `<div class=\"stat-row\">${s.stats.map((st,si)=>\n567\t      `<div class=\"stat-box\"><div class=\"stat-num ${st.muted?'muted':''}\">${st.num}</div><div class=\"stat-lbl\" id=\"stat-lbl-${i}-${si}\"></div></div>`).join('')}</div>` : '';\n568\t    return ov + `<div class=\"insight-wrap\"><h1 class=\"h-insight\" id=\"hl-${i}\"></h1><p class=\"insight-body\" id=\"bd-${i}\"></p>${stats}</div>`;\n569\t  }\n570\t\n571\t  if (s.type === 'statement') {\n572\t    const pts = s.pts.map((p,pi)=>`<div class=\"pt-item\" id=\"pt-${i}-${pi}\"><h4>${p.h}</h4><p>${p.p}</p></div>`).join('');\n573\t    return ov + `<div class=\"s-wrap centered\">\n574\t      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n575\t      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(38px,5vw,72px);margin-bottom:30px\"></h1>\n576\t      <div class=\"pts\">${pts}</div></div>`;\n577\t  }\n578\t\n579\t  if (s.type === 'cmdcenter') {\n580\t    const nodes = STAGES.map((st,si)=>`\n581\t      <div class=\"cmd-node\" id=\"cmd-node-${si}\" onclick=\"cmdSelectStage(${si})\">\n582\t        <div class=\"cmd-node-num\">${st.n}</div><div class=\"cmd-node-name\" id=\"cmd-nname-${si}\"></div>\n583\t        <div class=\"cmd-prog\" id=\"cmd-prog-${si}\"></div>\n584\t      </div>`).join('');\n585\t    return ov + `\n586\t      <div class=\"cmd-scan\" id=\"cmd-scan\"></div>\n587\t      <div class=\"cmd-center\">\n588\t        <div class=\"cmd-bg-num\" id=\"cmd-bg-num\">Month 1</div>\n589\t        <div class=\"cmd-header\"><div class=\"cmd-meta\" id=\"meta-${i}\"></div></div>\n590\t        <div class=\"cmd-selector\">${nodes}</div>\n591\t        <div class=\"cmd-main\" id=\"cmd-content\">\n592\t          <div class=\"cmd-stage-label\" id=\"cmd-active-num\"></div>\n593\t          <div class=\"cmd-stage-title\" id=\"cmd-active-name\"></div>\n594\t          <div class=\"cmd-bullets\" id=\"cmd-bullets\"></div>\n595\t          <div class=\"cmd-mrr-tag\" id=\"cmd-mrr\"></div>\n596\t        </div>\n597\t      </div>`;\n598\t  }\n599\t\n600\t  if (s.type === 'closing') {\n601\t    const kinds = ['XLSX','DOCX','PDF','PDF'];\n602\t    const cells = s.next.map((c,ci)=>{\n603\t      const inner = `<div class=\"next-kind\">${kinds[ci]||'DOC'}</div><h4 id=\"next-t-${i}-${ci}\"></h4><p id=\"next-d-${i}-${ci}\"></p>${c.href?`<span class=\"next-open\">Open in browser ↗</span>`:''}`;\n604\t      return c.href\n605\t        ? `<a class=\"next-cell\" href=\"${c.href}\" target=\"_blank\" rel=\"noopener\">${inner}</a>`\n606\t        : `<div class=\"next-cell\">${inner}</div>`;\n607\t    }).join('');\n608\t    return ov + `<div class=\"s-wrap centered\">\n609\t      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n610\t      <h1 class=\"banner\" id=\"banner-${i}\"></h1>\n611\t      ${s.close ? `<div class=\"close-line\">${s.close}</div>` : ''}\n612\t      <div class=\"next-grid\">${cells}</div></div>`;\n613\t  }\n614\t\n615\t  if (s.type === 'profile') {\n616\t    const photo = s.photo\n617\t      ? `<img src=\"${s.photo}\" alt=\"${s.name}\">`\n618\t      : `<div class=\"prof-mono\">EB</div>`;\n619\t    const pts = s.pts.map(p=>`<div class=\"prof-pt\"><span class=\"prof-dot\"></span>${p}</div>`).join('');\n620\t    return ov + `<div class=\"s-wrap profile-wrap\">\n621\t      <div class=\"prof-photo\">${photo}</div>\n622\t      <div class=\"prof-text\">\n623\t        <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule\"></div>\n624\t        <h1 class=\"prof-name\">${s.name}</h1>\n625\t        <div class=\"prof-role\">${s.role}</div>\n626\t        <div class=\"prof-pts\">${pts}</div>\n627\t      </div>\n628\t    </div>`;\n629\t  }\n630\t\n631\t  if (s.type === 'finale') {\n632\t    return ov + `<div class=\"s-wrap centered finale-wrap\">\n633\t      <img class=\"finale-logo\" src=\"payme-logo.jpg\" alt=\"PayMe\">\n634\t      <h1 class=\"finale-h\">${s.hl.replace(/\\n/g,'<br>')}</h1>\n635\t      <div class=\"finale-line\">${s.line}</div>\n636\t      <div class=\"finale-sign\">${s.sign}</div>\n637\t      <div class=\"finale-contact\">${s.contact}</div>\n638\t    </div>`;\n639\t  }\n640\t  return ov;\n641\t}\n642\t\n643\tfunction buildDeck() {\n644\t  const deck = document.getElementById('deck');\n645\t  const prog = document.getElementById('progress');\n646\t  document.getElementById('tot').textContent = N;\n647\t  SLIDES.forEach((s,i)=>{\n648\t    const el = document.createElement('div');\n649\t    el.className = 'slide' + (i===0?' active':'');\n650\t    el.id = 'slide-'+i;\n651\t    el.innerHTML = buildSlideHTML(s,i);\n652\t    deck.appendChild(el);\n653\t    const dot = document.createElement('div');\n654\t    dot.className = 'pdot' + (i===0?' on':'');\n655\t    dot.onclick = ()=>goTo(i);\n656\t    prog.appendChild(dot);\n657\t  });\n658\t  renderContent();\n659\t}\n660\t\n661\tfunction renderContent() {\n662\t  SLIDES.forEach((s,i)=>{\n663\t    const hl = document.getElementById('hl-'+i);\n664\t    const bd = document.getElementById('bd-'+i);\n665\t    const meta = document.getElementById('meta-'+i);\n666\t    if (hl && s.hl) hl.innerHTML = s.hl.replace(/\\n/g,'<br>');\n667\t    if (bd && s.bd) bd.innerHTML = s.bd.replace(/\\n/g,'<br>');\n668\t    if (meta && s.meta) meta.textContent = s.meta;\n669\t    if (s.stats) s.stats.forEach((st,si)=>{ const l = document.getElementById(`stat-lbl-${i}-${si}`); if (l) l.innerHTML = st.lbl.replace(/\\n/g,'<br>'); });"}]},"uuid":"77beda88-0425-4aa8-b004-1a642e92d6a9","timestamp":"2026-07-22T12:40:57.474Z","toolUseResult":{"type":"text","file":{"filePath":"/workspace/agent/payme_deck/en.html","content":"  },\n  { label: 'How I built the strategy', type: 'process', dir: true,\n    kicker: 'THE METHODOLOGY',\n    hl: 'How I built\\n<em>the strategy</em>',\n    bd: 'Not guesswork. A four-step process, from the breadth of the market down to a plan you can run.',\n    steps: [\n      { num: '1', h: 'Market research', p: '5 segments, 40+ potential partners' },\n      { num: '2', h: 'Filter & focus', p: 'The segments with the highest potential' },\n      { num: '3', h: 'Split', p: 'Inbound (leverage existing) + Outbound (new partners)' },\n      { num: '4', h: 'Operating plan', p: 'Who to approach, what to say, when to close, how much it brings' }\n    ],\n    band: [\n      { b: 'Inbound', s: '4 existing partners · product expansion · ~90,000 businesses' },\n      { b: 'Outbound', s: '6 new partners · 5 segments · ~20,000 businesses' }\n    ]\n  },\n  { label: 'Two engines', type: 'split', cycle: true,\n    hl: 'Two engines.\\n<em>One target.</em>',\n    bd: 'I did not bet everything on new deals. Half the plan grows partners already inside, fast and low-risk. The other half opens new ground. If one is delayed, the other compensates.',\n    cards: [\n      { step: 'ENGINE 01', hl: 'Inbound', bd: 'Four partners already working with PayMe. Expand what they sell, from payments to accounting and marketing. The closest circle first, no starting from zero.' },\n      { step: 'ENGINE 02', hl: 'Outbound', bd: 'Six new partnerships where PayMe is not yet present, chosen because the fit is clear and the sales cycle is short.' }\n    ]\n  },\n  { label: 'Inbound · complementary products', type: 'table',\n    kicker: 'ENGINE 01 · INBOUND',\n    hl: 'Complementary products for <em>existing partners</em>',\n    sub: 'Each partner already uses one PayMe product. These are the openings to add a second. One gap is validated. The rest are hypotheses that need a discovery call before we commit resources.',\n    cols: ['Partner', 'Uses today', 'Product to add', 'Why', 'Status', 'Est. MRR'],\n    rows: [\n      ['Wix', 'Payments only', 'Accounting (IL invoicing)', 'No tax-authority-approved invoicing for Israeli merchants. A legal requirement with zero coverage today.', '<span class=\"st-ok\">Validated</span>', '<span class=\"num\">₪7,500</span>'],\n      ['Wolt Merchants', 'Accounting + Payments (couriers)', 'Promoter for restaurants', 'Restaurants want more orders and visibility. May overlap Wolt\\'s in-app Promoted Listings.', '<span class=\"st-chk\">To validate</span>', 'TBD'],\n      ['Isracard / Cal', 'Payments (White Label)', 'Accounting + Promoter bundle', 'Every competitor offers payments. Adding Accounting + Promoter is the differentiation. 6+ month cycle.', '<span class=\"st-chk\">To validate</span>', 'TBD'],\n      ['Zester', 'Payments B2B (suppliers)', 'Accounting for restaurants', 'Restaurants pay suppliers through PayMe but manage invoices separately. May already have bookkeeping.', '<span class=\"st-chk\">To validate</span>', 'TBD']\n    ],\n    foot: 'Only Wix is a validated gap today (₪7,500). The rest are hypotheses for discovery. At a conservative ramp the Inbound engine adds ~₪30,000 MRR, the other half of the ₪102,100 target.',\n    src: 'Source: PayMe website, Wix Developer Docs, Isracard.co.il'\n  },\n  { label: 'Outbound · segment mapping', type: 'table',\n    kicker: 'ENGINE 02 · OUTBOUND',\n    hl: 'Five segments, by priority',\n    cols: ['Segment', 'Market size (IL)', 'Strategic partners', 'PayMe product', 'Priority'],\n    rows: [\n      ['Gig Economy', '25,000-35,000', '<span class=\"tag-hunger\">10bis · Yango Deli · Gett</span>', 'Accounting', '<span class=\"stars\">★★★★★</span>'],\n      ['Medical centers', '1,500-2,000', '<span class=\"tag-hunger\">Assuta · HMC · Medica</span>', 'Accounting + Payments', '<span class=\"stars\">★★★★★</span>'],\n      ['Fitness / studios', '10,000-20,000', '<span class=\"tag-hunger\">Arbox · BoostApp · Fizikal</span>', 'Accounting + Promoter', '<span class=\"stars\">★★★★</span>'],\n      ['Beauty / cosmetics', '10,000-20,000', '<span class=\"tag-hunger\">Plannie · Arbox · Fresha</span>', 'Payments + Accounting', '<span class=\"stars\">★★★★</span>'],\n      ['Professionals', 'tens of thousands', '<span class=\"tag-hunger\">Midrag · HaMiktzoanim</span>', 'Accounting + Payments', '<span class=\"stars\">★★★★</span>']\n    ],\n    foot: 'Total Addressable Market: ~50,000-80,000 small and independent businesses in Israel',\n    src: 'Detailed sources in the \"Calculation Basis\" sheet + the attached research documents'\n  },\n  { label: 'Outbound · selected partners', type: 'table',\n    kicker: 'ENGINE 02 · OUTBOUND',\n    hl: 'Six chosen out of 40+',\n    sub: 'Criteria: sales cycle, existing PoC, volume, product fit. Exposure runs from a conservative to an upside scenario, and drives the Month 4 MRR.',\n    cols: ['Partner', 'Ecosystem', 'Product', 'Why chosen', 'Exposure (cons → upside)', 'MRR M4'],\n    rows: [\n      ['10bis', '~6,000 couriers', 'Accounting', 'Wolt PoC proven. 100% independents in 2025. Replaces Keycost.', '900 · 15% → 1,800 · 30%', '<span class=\"num\">₪33,750</span>'],\n      ['Arbox', '~7,000 businesses', 'Accounting + Promoter', '#1 fitness platform. Missing Accounting. Huge volume.', '350 · 5% → 700 · 10%', '<span class=\"num\">₪17,600</span>'],\n      ['Plannie', '~3,000 businesses', 'Payments + Accounting', 'Scheduling without payment processing. A natural fit.', '300 · 10% → 600 · 20%', '<span class=\"num\">₪12,000</span>'],\n      ['Yango Deli', '~2,000 couriers', 'Accounting', 'Same model as Wolt. From Yandex.', '200 · 10% → 400 · 20%', '<span class=\"num\">₪7,500</span>'],\n      ['Assuta', '~400 physicians', 'Accounting + Payments', 'Credibility. One deal = hundreds of physicians.', '20 · 5% → 50 · 12%', '<span class=\"num\">₪1,250</span>'],\n      ['HMC · Herzliya Medical', '~500 physicians', 'Accounting + Payments', 'Premium private hospital. A quality signal for the sector.', 'upside scenario', '<span class=\"tag-pain\">upside</span>']\n    ],\n    foot: 'Total Outbound (conservative): ~₪72,000 MRR in Month 4 · full model: ₪102,100 conservative · ₪141,000 upside',\n    src: 'Source: \"Partner Selection\" + \"Conservative / Upside Scenario\" sheets, PayMe_Final_Plan.xlsx'\n  },\n  { label: 'Value proposition', type: 'split', cycle: true,\n    hl: 'A value prop,\\n<em>not a fee.</em>',\n    bd: 'On both engines the pitch is the same. Not the fee, but what the partner gains and cannot build alone. Three Outbound examples and one Inbound.',\n    cards: [\n      { step: 'OUTBOUND · 10bis', hl: 'Courier retention', bd: 'A courier who cannot handle the paperwork leaves. PayMe replaces Keycost with a better service, and the courier stays.' },\n      { step: 'OUTBOUND · Arbox', hl: 'The missing feature', bd: 'Customers ask \"why is there no invoicing?\". PayMe delivers it without a single line of code on their side.' },\n      { step: 'OUTBOUND · Plannie', hl: 'Double the ARPU', bd: 'From ₪50 (calendar) to ₪200 (calendar + payments + invoices). PayMe doubles Plannie\\'s ARPU.' },\n      { step: 'INBOUND · Wix', hl: 'A complete UX', bd: 'An Israeli merchant runs 3 separate systems. With Accounting it is all in one place, Lock-in and a new revenue stream.' }\n    ]\n  },\n  { label: 'How it works in practice', type: 'insight',\n    hl: 'How it looks\\n<em>in practice.</em>',\n    bd: 'One example, taken all the way down: the physicians segment. This is not an extra line in the plan, it is a demonstration of the method. Spot the pain, build the commercial model, find the entry point. The exact same breakdown runs on every segment we choose to enter.'\n  },\n  { label: 'Use Case · methodology demo', type: 'split', cycle: true, tag: 'METHODOLOGY DEMO',\n    hl: 'Use case · the physician\\n<em>inside the large clinic</em>',\n    bd: 'Not a physician opening a clinic. The target is physicians working inside large private clinics and medical centers that employ many practitioners, and the young physicians early in their path. Not all keep organized books, and even those who do run their processing and invoicing across separate systems. PayMe does not open a business for them, it makes the day-to-day money management one flow.',\n    foot: 'A practitioner running 4 systems for ~₪1,200/mo runs everything through PayMe for ~₪250, in one place.',\n    cards: [\n      { step: 'Payments', hl: 'One-click processing', bd: 'The patient pays by card, Bit or transfer. No separate terminal, no extra provider, no double processing fees.' },\n      { step: 'Accounting', hl: 'Automatic invoice + tax report', bd: 'An invoice is issued the moment payment is made and the tax report is ready, flowing to the accountant with no manual work.' },\n      { step: 'One interface', hl: 'Connected to the clinic software', bd: 'Instead of separate systems that do not talk, one flow that plugs into the clinic management software already in use.' }\n    ]\n  },\n  { label: 'Use Case · the commercial model', type: 'table',\n    kicker: 'THE COMMERCIAL MODEL · VIA CLINIC MANAGEMENT SOFTWARE',\n    hl: 'Who <em>gains</em> what',\n    sub: 'The recommended path: enter through an existing platform like Tipulog, and approach the large medical centers (Assuta, HMC, Medica) in parallel. One deal reaches many practitioners at once, and every side comes out ahead.',\n    cols: ['Side', 'What they get', 'How much'],\n    rows: [\n      ['Physician / practitioner', 'Payments + Accounting built into software they already use', 'Pays <span class=\"num\">~₪250</span> instead of ~1,200. Saves ~₪950/mo'],\n      ['The platform (Tipulog)', 'Revenue share + customer retention + higher ARPU', '<span class=\"num\">₪40-60</span>/practitioner/mo'],\n      ['PayMe', 'Access to many practitioners with no long individual sales cycle', '<span class=\"num\">₪100-150K</span> MRR (1,000 practitioners × ₪100-150 ARPU after revenue share)']\n    ],\n    foot: 'When we choose to enter this segment, the recommended entry is a platform like Tipulog, thousands of practitioners with no processing. One deal reaches many, and the exact same thinking runs on every vertical we go after.',\n    src: 'The model repeats for every vertical, fitness · beauty · construction. Physicians are the proof of concept.'\n  },\n  { label: 'Calculation basis', type: 'formula',\n    kicker: 'BEHIND THE NUMBERS',\n    hl: 'Every shekel here is <em>calculated.</em>',\n    terms: [\n      { t: 'Businesses in ecosystem', ex: '6,000' },\n      { t: '% exposure', ex: '15%' },\n      { t: 'Activation rate', ex: '25%' },\n      { t: 'Monthly ARPU', ex: '₪150' }\n    ],\n    result: '₪33,750',\n    exLabel: 'One worked example · 10bis · Month 4',\n    note: 'This is the 10bis line, spelled out. The identical formula runs on every one of the partners, the full per-partner table sits in the attached workbook. Exposure builds gradually over the quarter and reaches its full level (15%) by Month 4.',\n    src: 'Source: \"Calculation Basis\" sheet, PayMe_Final_Plan.xlsx'\n  },\n  { label: '4-month plan', type: 'cmdcenter', meta: 'Work plan · month by month' },\n  { label: 'Forecast', type: 'insight',\n    hl: 'Two scenarios.\\n<em>Both clear the target.</em>',\n    bd: 'The conservative scenario assumes 60% close rate and a slow rollout, and still clears the 100K target. In that scenario it is roughly 800 active users by Month 4, right inside the 700-1,000 we set out to reach at the start. The upside assumes a fast rollout, a working Promoter, and Isracard landing on time. The plan does not depend on any single win.',\n    stats: [\n      { num: '₪102,100', lbl: 'Conservative\\n60% close · 15% exposure' },\n      { num: '₪141,000', lbl: 'Upside\\n80% close · 30% exposure · Promoter active', muted: true }\n    ]\n  },\n  { label: 'Sources', type: 'closing',\n    kicker: 'THE WORK BEHIND THE DECK',\n    banner: 'Researched. Modeled.\\n<em>Ready to run.</em>',\n    close: 'The supporting materials, ready to open straight in your browser. This is what I bring to the role: not just spotting an opportunity, but translating it into a numbers-backed plan you can open your first day of work with.',\n    next: [\n      { t: 'Workbook · final plan (Excel)', d: '6 sheets, 200+ live formulas: calculation basis, partner selection, 12-week activity, two scenarios and a comparison.', href: 'https://view.officeapps.live.com/op/view.aspx?src=https%3A%2F%2Fpayme-partners.vercel.app%2Fmaterials%2Fplan.xlsx' },\n      { t: 'Companion document (Word)', d: 'The dual-engine model, Inbound methodology, segment selection, value propositions and forecast logic.', href: 'https://view.officeapps.live.com/op/view.aspx?src=https%3A%2F%2Fpayme-partners.vercel.app%2Fmaterials%2Fcompanion.docx' }\n    ]\n  },\n  { label: 'Ready to start', type: 'finale',\n    hl: 'Ready to start.\\n<em>From day one.</em>',\n    line: 'I did not just analyze a market. I built a plan you can open your first day of work with, and reach ₪100,000 MRR in four months. I would love to go deep with the team and get started.',\n    sign: 'Elia Ben Cnaan · Strategic Partner Sales',\n    contact: 'elia@bencnaan.net · 052-8738698'\n  }\n];\n\nconst N = SLIDES.length;\nlet cur = 0;\nconst cycleIntervals = {}, cycleState = {};\nconst BULLET_DURATION = 1875;\nlet cmdActiveIdx = -1, cmdBulletTimer = null, cmdBulletIdx = -1, cmdAutoTimer = null;\n\nfunction pad2(n){ return String(n+1).padStart(2,'0'); }\n\nfunction buildSlideHTML(s, i) {\n  const ov = `<div class=\"s-ov\"></div>`;\n\n  if (s.type === 'cover') {\n    return ov + `<div class=\"s-wrap centered\">\n      <img class=\"cover-logo\" src=\"payme-logo.jpg\" alt=\"PayMe\">\n      <div class=\"cover-tag\">Strategic Partner Sales</div>\n      <h1 class=\"cover-h\">₪100,000 net MRR.<br><em>In four months.</em></h1>\n      <div class=\"cover-line\">Not just a market analysis. A partnerships plan you can open on day one.</div>\n      <div class=\"cover-meta\"><span>Submitted by</span><span class=\"cover-dot\"></span><b>Elia Ben Cnaan</b></div>\n    </div>`;\n  }\n\n  if (s.type === 'process') {\n    const cards = s.steps.map((c,ci)=>`\n      <div class=\"proc-card\" id=\"proc-card-${i}-${ci}\"><div class=\"proc-num\">${c.num}</div><h3>${c.h}</h3><p>${c.p}</p></div>`).join('');\n    const band = s.band.map(e=>`<div class=\"proc-eng\"><b>${e.b}</b><span>${e.s}</span></div>`).join('');\n    const dir = s.dir ? `<div class=\"proc-dir\"><span class=\"pd-tag\">The direction</span>\n      <div class=\"pd-eq\"><b>₪100,000</b><span>net per month</span></div><i class=\"pd-op\">÷</i>\n      <div class=\"pd-eq\"><b>₪100-150</b><span>net ARPU per user</span></div><i class=\"pd-op\">=</i>\n      <div class=\"pd-eq pd-res\"><b>~700-1,000</b><span>users to acquire</span></div></div>` : '';\n    return ov + `<div class=\"s-wrap\">\n      <div class=\"label-sm\">${s.kicker}</div><div class=\"rule\"></div>\n      <h1 class=\"h-lg\" id=\"hl-${i}\"></h1><p class=\"body-t\" id=\"bd-${i}\"></p>\n      <div class=\"proc-grid\">${cards}</div><div class=\"proc-band\">${band}</div>${dir}\n    </div>`;\n  }\n\n  if (s.type === 'split') {\n    const cards = s.cards.map((c,ci)=>`\n      <div class=\"fcard\">\n        <div class=\"fcard-step\" id=\"cstep-${i}-${ci}\"></div>\n        <h3 id=\"ctitle-${i}-${ci}\"></h3><p id=\"cdesc-${i}-${ci}\"></p>\n        ${c.mrr ? `<span class=\"mrr\">${c.mrr}</span>` : ''}<div class=\"fcard-dot\"></div>\n      </div>`).join('');\n    return ov + `<div class=\"s-wrap\"><div class=\"split\">\n        <div class=\"split-l\">${s.tag ? `<div class=\"label-sm\">${s.tag}</div>` : ''}<div class=\"rule\"></div>\n          <h1 class=\"h-lg\" id=\"hl-${i}\"></h1><p class=\"body-t\" id=\"bd-${i}\"></p>\n          ${s.foot ? `<div style=\"margin-top:22px;font-size:14px;font-weight:800;color:var(--accent)\">${s.foot}</div>` : ''}\n        </div>\n        <div class=\"split-r${s.cards.length > 3 ? ' grid2' : ''}\">${cards}</div>\n      </div></div>`;\n  }\n\n  if (s.type === 'table') {\n    const head = s.cols.map(c=>`<th>${c}</th>`).join('');\n    const body = s.rows.map(r=>`<tr>${r.map(c=>`<td>${String(c).replace(/\\n/g,'<br>')}</td>`).join('')}</tr>`).join('');\n    return ov + `<div class=\"s-wrap centered\">\n      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(34px,4.6vw,66px);margin-bottom:${s.sub?'8px':'0'}\"></h1>\n      ${s.sub ? `<p class=\"body-t\" style=\"max-width:720px\">${s.sub}</p>` : ''}\n      <div class=\"tbl-wrap\"><table class=\"ptable\"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>\n      ${s.foot ? `<div class=\"tbl-foot\">${s.foot.replace(/(~?[\\d,]+(?:-[\\d,]+)?\\s*₪?)/,'<b>$1</b>')}</div>` : ''}\n      ${s.src ? `<div class=\"tbl-src\">${s.src}</div>` : ''}\n    </div>`;\n  }\n\n  if (s.type === 'formula') {\n    const terms = s.terms.map((t,ti)=>`\n      <div class=\"fx-term\"><div class=\"fx-term-t\">${t.t}</div><div class=\"fx-term-ex\">${t.ex}</div></div>\n      ${ti < s.terms.length-1 ? '<div class=\"fx-op\">×</div>' : ''}`).join('');\n    const calc = s.terms.map(t=>t.ex).join(' × ') + ' = <b>' + s.result + '</b>';\n    return ov + `<div class=\"s-wrap centered\">\n      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(34px,4.6vw,64px);margin-bottom:6px\"></h1>\n      <div class=\"fx-eq\"><div class=\"fx-res-lead\">MRR</div><div class=\"fx-op fx-eq-sign\">=</div>${terms}</div>\n      <div class=\"fx-example\"><span class=\"fx-ex-label\">${s.exLabel}</span><span class=\"fx-ex-calc\">${calc}</span></div>\n      <div class=\"tbl-src\" style=\"margin-top:22px;max-width:660px;line-height:1.6\">${s.note}</div>\n      ${s.src ? `<div class=\"tbl-src\">${s.src}</div>` : ''}\n    </div>`;\n  }\n\n  if (s.type === 'insight') {\n    const stats = s.stats ? `<div class=\"stat-row\">${s.stats.map((st,si)=>\n      `<div class=\"stat-box\"><div class=\"stat-num ${st.muted?'muted':''}\">${st.num}</div><div class=\"stat-lbl\" id=\"stat-lbl-${i}-${si}\"></div></div>`).join('')}</div>` : '';\n    return ov + `<div class=\"insight-wrap\"><h1 class=\"h-insight\" id=\"hl-${i}\"></h1><p class=\"insight-body\" id=\"bd-${i}\"></p>${stats}</div>`;\n  }\n\n  if (s.type === 'statement') {\n    const pts = s.pts.map((p,pi)=>`<div class=\"pt-item\" id=\"pt-${i}-${pi}\"><h4>${p.h}</h4><p>${p.p}</p></div>`).join('');\n    return ov + `<div class=\"s-wrap centered\">\n      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(38px,5vw,72px);margin-bottom:30px\"></h1>\n      <div class=\"pts\">${pts}</div></div>`;\n  }\n\n  if (s.type === 'cmdcenter') {\n    const nodes = STAGES.map((st,si)=>`\n      <div class=\"cmd-node\" id=\"cmd-node-${si}\" onclick=\"cmdSelectStage(${si})\">\n        <div class=\"cmd-node-num\">${st.n}</div><div class=\"cmd-