Partner Sales</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=Heebo:wght@300;400;500;600;700;800;900&display=swap\" rel=\"stylesheet\">\n<style>\n:root {\n  --bg: #171B3A;\n  --card: #242B54;\n  --card-hi: #2E3667;\n  --brand: #2A315D;\n  --accent: #2FC2BC;\n  --accent-d: #22A9A3;\n  --border: rgba(255,255,255,0.09);\n  --border-acc: rgba(47,194,188,0.36);\n  --text: #F4F5FB;\n  --gray: #A7ADCC;\n  --dim: rgba(255,255,255,0.3);\n}\n*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\nhtml, body { width: 100%; height: 100%; overflow: hidden; background: var(--bg); font-family: 'Heebo', sans-serif; -webkit-font-smoothing: antialiased; }\n\n#deck { position: fixed; inset: 0; z-index: 1; }\n\n.slide { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity 0.55s ease; display: flex; align-items: center; justify-content: center; }\n.slide.active { opacity: 1; pointer-events: auto; }\n.s-ov { position: absolute; inset: 0; pointer-events: none; z-index: 0; background: radial-gradient(120% 90% at 50% 0%, rgba(42,49,93,0.6) 0%, transparent 55%); }\n\n.s-wrap { position: relative; z-index: 2; width: 100%; max-width: 1280px; padding: 0 72px; display: flex; flex-direction: column; }\n.s-wrap.centered { align-items: center; text-align: center; }\n\n.label-sm { font-size: 11px; font-weight: 800; letter-spacing: 0.16em; color: var(--accent); margin-bottom: 20px; }\n.rule { width: 40px; height: 2px; background: var(--accent); margin-bottom: 26px; opacity: 0.75; border-radius: 2px; }\n.rule.c { margin-right: auto; margin-left: auto; }\n\n.h-xl { font-size: clamp(44px, 6.4vw, 98px); font-weight: 900; line-height: 1.02; letter-spacing: -0.02em; color: var(--text); margin-bottom: 30px; }\n.h-xl em { font-style: normal; color: var(--accent); }\n.h-lg { font-size: clamp(34px, 4.4vw, 64px); font-weight: 900; line-height: 1.05; letter-spacing: -0.015em; color: var(--text); margin-bottom: 22px; }\n.h-lg em { font-style: normal; color: var(--accent); }\n.body-t { font-size: clamp(15px, 1.35vw, 18px); font-weight: 400; line-height: 1.8; color: var(--gray); max-width: 560px; }\n.s-wrap.centered .body-t { max-width: 640px; }\n\n/* COVER */\n.cover-logo { width: 156px; height: auto; border-radius: 16px; margin-bottom: 30px; box-shadow: 0 20px 60px rgba(0,0,0,0.45); }\n.cover-tag { font-size: clamp(18px, 2.2vw, 30px); font-weight: 800; color: var(--text); margin-bottom: 10px; letter-spacing: -0.01em; }\n.cover-sub-line { font-size: clamp(13px, 1.5vw, 19px); font-weight: 600; color: var(--accent); margin-bottom: 18px; }\n.cover-line { font-size: clamp(13px, 1.35vw, 17px); font-weight: 500; color: var(--gray); max-width: 560px; line-height: 1.6; margin-bottom: 30px; }\n.cover-meta { display: flex; gap: 13px; align-items: center; flex-wrap: wrap; justify-content: center; font-size: clamp(11px, 1.1vw, 14px); font-weight: 500; color: var(--dim); }\n.cover-meta b { color: var(--text); font-weight: 700; }\n.cover-dot { width: 4px; height: 4px; border-radius: 50%; background: var(--border-acc); }\n\n/* PROCESS */\n.proc-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; width: 100%; margin-top: 40px; }\n.proc-card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 26px 22px; text-align: right; position: relative; overflow: hidden; transition: border-color .45s, background .45s; }\n.proc-card.on { border-color: var(--border-acc); background: var(--card-hi); }\n.proc-num { font-size: 30px; font-weight: 900; color: var(--dim); line-height: 1; margin-bottom: 14px; transition: color .45s; }\n.proc-card.on .proc-num { color: var(--accent); }\n.proc-card h3 { font-size: 17px; font-weight: 800; color: var(--text); margin-bottom: 7px; }\n.proc-card p { font-size: 13px; line-height: 1.6; color: var(--gray); }\n.proc-band { margin-top: 16px; display: flex; gap: 14px; width: 100%; }\n.proc-eng { flex: 1; background: rgba(47,194,188,0.08); border: 1px solid var(--border-acc); border-radius: 12px; padding: 16px 20px; text-align: right; }\n.proc-eng b { color: var(--accent); font-weight: 800; font-size: 15px; }\n.proc-eng span { display: block; color: var(--gray); font-size: 12.5px; margin-top: 3px; }\n\n/* SPLIT / CARDS */\n.split { display: flex; align-items: flex-start; gap: 64px; width: 100%; }\n.split-l { flex: 0 0 340px; }\n.split-r { flex: 1; display: flex; flex-direction: column; gap: 12px; padding-top: 4px; }\n.split-r.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-content: start; }\n.split-r.grid2 .fcard { padding: 15px 17px 14px; }\n.split-r.grid2 .fcard h3 { font-size: 15.5px; margin-bottom: 4px; }\n.split-r.grid2 .fcard p { font-size: 12.5px; line-height: 1.55; }\n.split-r.grid2 .fcard .mrr { margin-top: 7px; font-size: 11.5px; }\n.fcard { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 22px 22px 20px; position: relative; overflow: hidden; transition: border-color .45s, background .45s; }\n.fcard.on { border-color: var(--border-acc); background: var(--card-hi); }\n.fcard-step { font-size: 11px; font-weight: 800; letter-spacing: 0.05em; color: var(--dim); margin-bottom: 8px; transition: color .45s; }\n.fcard.on .fcard-step { color: var(--accent); }\n.fcard h3 { font-size: 17px; font-weight: 800; color: var(--text); margin-bottom: 6px; }\n.fcard p { font-size: 13.5px; line-height: 1.68; color: var(--gray); }\n.fcard .mrr { display: inline-block; margin-top: 9px; font-size: 12.5px; font-weight: 800; color: var(--accent); background: rgba(47,194,188,0.12); padding: 3px 11px; border-radius: 20px; }\n.fcard-dot { position: absolute; top: 20px; left: 20px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 9px var(--accent); opacity: 0; animation: dpulse 2.2s ease-in-out infinite; transition: opacity .45s; }\n.fcard.on .fcard-dot { opacity: 1; }\n@keyframes dpulse { 0%,100% { transform: scale(0.8);} 50% { transform: scale(1.25);} }\n\n/* TABLE */\n.tbl-wrap { width: 100%; max-width: 1180px; margin-top: 30px; overflow-x: auto; }\n.ptable { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 13.5px; min-width: 720px; }\n.ptable thead th { background: var(--brand); color: var(--text); font-weight: 800; font-size: 12.5px; padding: 13px 15px; text-align: right; border-bottom: 2px solid var(--accent); white-space: nowrap; }\n.ptable thead th:first-child { border-top-right-radius: 10px; }\n.ptable thead th:last-child { border-top-left-radius: 10px; }\n.ptable tbody td { padding: 12px 15px; text-align: right; color: var(--gray); border-bottom: 1px solid var(--border); line-height: 1.45; vertical-align: top; }\n.ptable tbody tr:nth-child(even) td { background: rgba(255,255,255,0.018); }\n.ptable tbody tr:hover td { background: rgba(47,194,188,0.07); }\n.ptable td:first-child { color: var(--text); font-weight: 700; white-space: nowrap; }\n.ptable .num { color: var(--accent); font-weight: 800; white-space: nowrap; }\n.ptable .stars { color: var(--accent); letter-spacing: 1px; white-space: nowrap; }\n.ptable .tag-pain { color: var(--text); font-weight: 700; }\n.ptable .tag-hunger { color: var(--accent); font-weight: 700; }\n.tbl-foot { margin-top: 16px; font-size: 14px; font-weight: 700; color: var(--text); text-align: center; }\n.tbl-foot b { color: var(--accent); }\n.tbl-src { margin-top: 8px; font-size: 11px; color: var(--dim); text-align: center; }\n\n/* FORMULA */\n.fx-eq { display: flex; align-items: stretch; justify-content: center; gap: 9px; flex-wrap: wrap; margin: 30px 0 30px; direction: rtl; }\n.fx-res-lead { display: flex; align-items: center; font-size: clamp(24px, 3.4vw, 44px); font-weight: 900; color: var(--accent); }\n.fx-op { display: flex; align-items: center; font-size: clamp(17px, 2vw, 26px); font-weight: 800; color: var(--gray); }\n.fx-eq-sign { color: var(--accent); }\n.fx-term { background: var(--card); border: 1px solid var(--border-acc); border-radius: 12px; padding: 15px 18px; min-width: 116px; text-align: center; display: flex; flex-direction: column; justify-content: center; }\n.fx-term-t { font-size: 12px; font-weight: 700; color: var(--gray); margin-bottom: 7px; line-height: 1.3; }\n.fx-term-ex { font-size: clamp(17px, 1.9vw, 23px); font-weight: 900; color: var(--text); }\n.fx-example { display: flex; flex-direction: column; gap: 9px; align-items: center; background: rgba(47,194,188,0.08); border: 1px solid var(--border-acc); border-radius: 14px; padding: 20px 30px; }\n.fx-ex-label { font-size: 12px; font-weight: 800; letter-spacing: 0.06em; color: var(--accent); }\n.fx-ex-calc { font-size: clamp(16px, 2vw, 26px); font-weight: 600; color: var(--text); direction: ltr; }\n.fx-ex-calc b { color: var(--accent); font-weight: 900; }\n\n/* INSIGHT */\n.insight-wrap { position: relative; z-index: 2; width: 100%; padding: 0 64px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px; }\n.h-insight { font-size: clamp(40px, 6vw, 90px); font-weight: 900; line-height: 1.02; letter-spacing: -0.02em; color: var(--text); text-align: center; }\n.h-insight em { font-style: normal; color: var(--accent); }\n.insight-body { font-size: clamp(14px, 1.25vw, 17px); line-height: 1.8; color: var(--gray); text-align: center; max-width: 660px; }\n.stat-row { display: flex; gap: 44px; align-items: stretch; justify-content: center; flex-wrap: wrap; margin-top: 4px; }\n.stat-box { text-align: center; min-width: 150px; }\n.stat-num { font-size: clamp(46px, 5.6vw, 84px); font-weight: 900; letter-spacing: -0.03em; line-height: 1; color: var(--accent); }\n.stat-num.muted { color: var(--gray); }\n.stat-lbl { font-size: clamp(12px, 1.1vw, 14px); font-weight: 600; color: var(--gray); margin-top: 10px; line-height: 1.5; }\n\n/* STATEMENT */\n.pts { display: flex; flex-direction: column; gap: 16px; width: 100%; max-width: 760px; margin-top: 8px; }\n.pt-item { background: var(--card); border: 1px solid var(--border); border-right: 3px solid var(--border-acc); border-radius: 12px; padding: 18px 22px; text-align: right; transition: border-color .4s, background .4s; }\n.pt-item.on { background: var(--card-hi); border-right-color: var(--accent); }\n.pt-item h4 { font-size: 17px; font-weight: 800; color: var(--text); margin-bottom: 5px; }\n.pt-item p { font-size: 13.5px; line-height: 1.6; color: var(--gray); }\n\n/* COMMAND CENTER */\n.cmd-scan { position: absolute; inset: 0; z-index: 3; pointer-events: none; background: linear-gradient(180deg, transparent 0%, rgba(47,194,188,0.05) 50%, transparent 100%); opacity: 0; }\n@keyframes scan { 0% { transform: translateY(-100%); opacity: 0;} 8% {opacity:1;} 92% {opacity:1;} 100% { transform: translateY(110%); opacity: 0;} }\n.cmd-center { position: absolute; top: 78px; bottom: 70px; right: 0; left: 0; padding: 18px 72px 14px; display: flex; flex-direction: column; gap: 14px; z-index: 2; }\n.cmd-bg-num { position: absolute; left: 56px; top: 20%; font-size: clamp(110px,18vw,280px); font-weight: 900; letter-spacing: -0.05em; color: rgba(47,194,188,0.07); line-height: 1; pointer-events: none; user-select: none; transition: opacity .3s; }\n.cmd-header { display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; }\n.cmd-meta { font-size: 11px; font-weight: 800; letter-spacing: 0.1em; color: var(--accent); }\n.cmd-selector { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(255,255,255,0.05); border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.07); flex-shrink: 0; }\n.cmd-node { background: var(--bg); padding: 17px 16px 15px; cursor: pointer; position: relative; overflow: hidden; transition: background .35s; }\n.cmd-node.active { background: var(--card-hi); }\n.cmd-node:hover:not(.active) { background: rgba(255,25