;\n  msgClock.m += 1;\n  if (msgClock.m>59){ msgClock.m=0; msgClock.h=(msgClock.h+1)%24; }\n  return t;\n}\n\nfunction scrollLog(){ chatLog.scrollTop = chatLog.scrollHeight; }\n\nfunction dayPill(){\n  const row = document.createElement('div');\n  row.className = 'day-row';\n  row.innerHTML = '<span class=\"day-pill\">' + T().dayPill + '</span>';\n  chatLog.appendChild(row);\n}\n\nfunction bubble(who, html, withStamp){\n  const row = document.createElement('div');\n  row.className = 'msg-row ' + who;\n  const b = document.createElement('div');\n  b.className = 'bubble';\n  b.innerHTML = html;\n  if (withStamp){\n    const st = document.createElement('div');\n    st.className = 'stamp';\n    st.innerHTML = (who==='me' ? DBL_CHECK : '') + '<span>' + fmtTime() + '</span>';\n    b.appendChild(st);\n  }\n  row.appendChild(b);\n  chatLog.appendChild(row);\n  scrollLog();\n  return row;\n}\n\nfunction docHtml(name){\n  const kind = name.split('.').pop().toUpperCase();\n  return '<div class=\"doc\"><div class=\"doc-ic\">' + DOC_ICON + '</div><div><div class=\"doc-name\">' + name + '</div><div class=\"doc-kind\">' + kind + '</div></div></div>';\n}\n\nfunction typingOn(){\n  tgStatus.textContent = 'typing…';\n  tgStatus.classList.add('typing');\n  const row = document.createElement('div');\n  row.className = 'msg-row bot typing-row';\n  row.innerHTML = '<div class=\"bubble typing-bubble\"><i></i><i></i><i></i></div>';\n  chatLog.appendChild(row);\n  scrollLog();\n  return row;\n}\nfunction typingOff(row){\n  tgStatus.textContent = 'online';\n  tgStatus.classList.remove('typing');\n  if (row && row.parentNode) row.remove();\n}\n\nasync function botSays(gen, html, quick){\n  await waitVisible(gen);\n  const t = typingOn();\n  await wait(quick ? 650 : 1050);\n  step(gen);\n  typingOff(t);\n  return bubble('bot', html, true);\n}\n\nasync function playScenario(gen, idx){\n  const sc = SC()[idx];\n  msgClock = { h: sc.base[0], m: sc.base[1] };\n  for (const m of sc.msgs){\n    await waitVisible(gen);\n    if (m.who==='me'){\n      await wait(650); step(gen);\n      bubble('me', m.text + (m.file ? docHtml(m.file) : ''), true);\n    } else {\n      const t = typingOn();\n      await wait(1000); step(gen);\n      typingOff(t);\n      bubble('bot', (m.file ? docHtml(m.file) : '') + m.text, true);\n    }\n    /* reading pause: let the reader read the message, but keep the rhythm brisk */\n    const readMs = Math.min(2500, 700 + m.text.length * 30);\n    await wait(readMs); step(gen);\n  }\n  /* receipt as a telegram-style bot message */\n  await wait(500); step(gen);\n  const t = typingOn();\n  await wait(800); step(gen);\n  typingOff(t);\n  let html = '<div class=\"receipt-head\">' + CHECK_TEAL + '<span>' + sc.receipt.title + '</span></div>';\n  sc.receipt.rows.forEach(r=>{ html += '<div class=\"receipt-row\">' + CHECK_TEAL + '<span>' + r + '</span></div>'; });\n  bubble('bot', html, true);\n}\n\nasync function fadeClear(gen){\n  chatLog.style.transition = 'opacity .45s ease';\n  chatLog.style.opacity = '0';\n  await wait(480); step(gen);\n  chatLog.innerHTML = '';\n  dayPill();\n  chatLog.style.opacity = '1';\n}\n\nasync function runLoop(gen){\n  try {\n    await wait(500);\n    while (true){\n      await waitVisible(gen);\n      dayPill();\n      await botSays(gen, T().demoGreeting);\n      await wait(1600);\n      for (let i = 0; i < SC().length; i++){\n        await playScenario(gen, i);\n        await wait(2600); step(gen);\n        if (i < SC().length - 1){ await fadeClear(gen); }\n      }\n      await botSays(gen, T().demoClosing, true);\n      await wait(5200); step(gen);\n      await fadeClear(gen);\n    }\n  } catch(e){ /* stale generation: a newer run owns the stage */ }\n}\n\nfunction restartDemo(){\n  demoGen++;\n  chatLog.innerHTML = '';\n  chatLog.style.opacity = '1';\n  tgStatus.textContent = 'online';\n  tgStatus.classList.remove('typing');\n  if (demoStarted) runLoop(demoGen);\n}\n\nfunction demoEnter(){\n  if (demoStarted) return;\n  demoStarted = true;\n  runLoop(++demoGen);\n}\n\napplyLang();\n</script>\n</body>\n</html>\n","numLines":396,"startLine":678,"totalLines":1073}},"sourceToolAssistantUUID":"4763b420-d113-4710-b33c-bd4baf657f10","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"977033f0-9e68-4f6a-9eef-7401d011011f","version":"2.1.197","gitBranch":"HEAD","slug":"cuddly-forging-river"}
