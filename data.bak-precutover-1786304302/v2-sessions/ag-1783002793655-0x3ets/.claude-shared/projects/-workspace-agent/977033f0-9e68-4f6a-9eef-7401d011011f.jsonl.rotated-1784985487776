.15s;\n286\t  }\n287\t  .field input:focus{border-color:var(--teal)}\n288\t  .field .err{display:none;color:var(--orange);font-size:11.5px;margin-top:4px}\n289\t  .field.invalid input{border-color:var(--orange)}\n290\t  .field.invalid .err{display:block}\n291\t  .consent{display:flex;gap:9px;align-items:flex-start;font-size:12.3px;color:var(--muted);line-height:1.5}\n292\t  .consent input{width:16px;height:16px;accent-color:var(--teal);margin-top:1px;flex:0 0 auto}\n293\t  .consent a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60}\n294\t  .consent.invalid{color:var(--orange)}\n295\t\n296\t  /* ---------- slide 6: done ---------- */\n297\t  .done{justify-content:center;text-align:center}\n298\t  .done-avatar{\n299\t    width:86px;height:86px;border-radius:50%;overflow:hidden;margin:0 auto 18px;\n300\t    border:2px solid var(--teal-line);background:#0d1614;\n301\t  }\n302\t  .done-avatar img{width:100%;height:100%;object-fit:cover;display:block}\n303\t  .done h1{font-size:26px}\n304\t  .done .lead{max-width:300px;margin-inline:auto}\n305\t  .rescue{margin-top:22px;font-size:12.5px;color:#8a8a8a;line-height:1.7}\n306\t  .rescue a{color:var(--teal);text-decoration:none;border-bottom:1px solid #2b6a60;cursor:pointer}\n307\t\n308\t  /* ---------- bottom zone ---------- */\n309\t  .cta-zone{flex:0 0 auto;padding:10px 20px 16px;display:flex;flex-direction:column;gap:11px}\n310\t  .nav-row{display:flex;align-items:center;justify-content:space-between;gap:10px}\n311\t  html[dir=\"ltr\"] .nav-row .nav-arr svg{transform:scaleX(-1)}\n312\t  .dots{display:flex;justify-content:center;gap:7px;flex:1 1 auto}\n313\t  .dots button{\n314\t    width:7px;height:7px;border-radius:50%;border:none;background:#333;cursor:pointer;padding:0;\n315\t    transition:background .2s,width .2s;\n316\t  }\n317\t  .dots button.on{background:var(--teal);width:19px;border-radius:4px}\n318\t  .cta{\n319\t    width:100%;border:none;border-radius:12px;background:var(--teal);color:#04211C;\n320\t    font-family:inherit;font-size:15.5px;font-weight:700;padding:14px;cursor:pointer;\n321\t    transition:filter .15s,transform .12s;\n322\t  }\n323\t  .cta:active{transform:scale(.985)}\n324\t  .cta:hover{filter:brightness(1.07);box-shadow:0 6px 22px rgba(86,237,214,.25)}\n325\t  .cta:disabled{opacity:.6;cursor:default}\n326\t  /* fixed-height sub-line keeps the bottom zone identical on every screen */\n327\t  .cta-sub{height:17px;display:flex;align-items:center;justify-content:center}\n328\t  .swipe-hint{\n329\t    display:none;justify-content:center;align-items:center;gap:6px;\n330\t    color:#8a8a8a;font-size:12.5px;\n331\t  }\n332\t  .swipe-hint svg{color:var(--teal);animation:nudge 1.6s ease-in-out infinite}\n333\t  html[dir=\"ltr\"] .swipe-hint svg{transform:scaleX(-1)}\n334\t  @keyframes nudge{0%,100%{transform:translateX(0)}50%{transform:translateX(-5px)}}\n335\t  html[dir=\"ltr\"] .swipe-hint svg{animation:nudgeLtr 1.6s ease-in-out infinite}\n336\t  @keyframes nudgeLtr{0%,100%{transform:scaleX(-1) translateX(0)}50%{transform:scaleX(-1) translateX(-5px)}}\n337\t  @media (prefers-reduced-motion:reduce){ .swipe-hint svg{animation:none} }\n338\t  .cta-foot{display:none;color:#7d7d7d;font-size:11.8px;text-align:center}\n339\t  @media (max-height:700px){\n340\t    h1{font-size:23px} .hero h1{font-size:25px} .hero .mascot{width:112px}\n341\t    .lead{font-size:13.5px;margin-top:9px} .cta{padding:12px}\n342\t  }\n343\t</style>\n344\t</head>\n345\t<body>\n346\t\n347\t<div class=\"phone\" id=\"phone\">\n348\t  <div class=\"app-header\">\n349\t    <img class=\"logo-icon\" src=\"@@ASSET0@@\" alt=\"NanoShellano\">\n350\t    <div class=\"header-side\">\n351\t      <div class=\"lang-toggle\" id=\"langToggle\" role=\"group\" aria-label=\"Language\">\n352\t        <button data-lang=\"he\" class=\"on\">HE</button><span class=\"lt-sep\">|</span><button data-lang=\"en\">EN</button>\n353\t      </div>\n354\t    </div>\n355\t  </div>\n356\t\n357\t  <div class=\"stage\" id=\"stage\">\n358\t\n359\t    <!-- 1 · hero -->\n360\t    <section class=\"slide hero active\">\n361\t      <div>\n362\t        <img class=\"mascot\" src=\"@@ASSET1@@\" alt=\"\">\n363\t        <h1 data-i18n-html=\"heroH1\">התקבל עובד חדש<br><span class=\"accent\">סוכן ה-AI שלך מתחיל היום</span></h1>\n364\t        <p class=\"lead\" data-i18n=\"heroLead\">כל הזמן אומרים שה-AI ישנה את עולם העבודה. אבל הוא כבר משנה אותו, וכניסת הסוכנים לכל תפקיד תהיה מטלטלת. אנחנו כאן כדי ללמד אותך איך לנהל סוכנים, ללא שום ידע טכני, כדי להיות לפני כולם.</p>\n365\t        </div>\n366\t      <div class=\"trust\" data-i18n-html=\"trust\">חינם להתנסות<span class=\"sep\">·</span>קליק אחד מהנייד<span class=\"sep\">·</span>מאובטח לחלוטין</div>\n367\t    </section>\n368\t\n369\t    <!-- 2 · telegram demo (auto simulation, no interaction) -->\n370\t    <section class=\"slide demo before\">\n371\t      <h1 class=\"demo-h1\" data-i18n-html=\"demoH1\">כך נראה יום עבודה עם <span class=\"accent\">הסוכן שלך</span></h1>\n372\t      <p class=\"lead demo-lead\" data-i18n=\"demoLead\">4 דוגמאות למשימות שגרתיות שהסוכן יודע לעשות.</p>\n373\t      <p class=\"demo-note\" data-i18n=\"demoNote\">הדגמה להמחשה בלבד. החיבור למערכות עדיין לא פעיל.</p>\n374\t      <div class=\"chat-card\" id=\"chatCard\">\n375\t        <div class=\"tg-header\">\n376\t          <span class=\"tg-back\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M15 18l-6-6 6-6\"/></svg></span>\n377\t          <div class=\"tg-avatar\"><img src=\"@@ASSET2@@\" alt=\"\"></div>\n378\t          <div class=\"tg-title\">\n379\t            <div class=\"tg-name\" id=\"tgName\">ג'וני</div>\n380\t            <div class=\"tg-status\" id=\"tgStatus\">online</div>\n381\t          </div>\n382\t          <span class=\"tg-menu\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><circle cx=\"12\" cy=\"5\" r=\"1.7\"/><circle cx=\"12\" cy=\"12\" r=\"1.7\"/><circle cx=\"12\" cy=\"19\" r=\"1.7\"/></svg></span>\n383\t        </div>\n384\t        <div class=\"chat-log\" id=\"chatLog\"></div>\n385\t        <div class=\"tg-input\">\n386\t          <div class=\"fake-field\">\n387\t            <svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 14.2c.9 1.1 2.1 1.8 3.5 1.8s2.6-.7 3.5-1.8\"/><circle cx=\"9\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/><circle cx=\"15\" cy=\"9.7\" r=\".6\" fill=\"currentColor\"/></svg>\n388\t            <span>Message</span>\n389\t          </div>\n390\t          <span class=\"tg-clip\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M21.4 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48\"/></svg></span>\n391\t          <span class=\"tg-mic\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5 11a7 7 0 0014 0\"/><path d=\"M12 18v3\"/></svg></span>\n392\t        </div>\n393\t      </div>\n394\t      <p class=\"manifesto-line\" data-i18n-html=\"manifesto\">הסוכנים נכנסים לכל תפקיד. <b>מי שיידע לנהל אותם, יוביל.</b></p>\n395\t    </section>\n396\t\n397\t    <!-- 3 · security -->\n398\t    <section class=\"slide list-slide before\">\n399\t      <h1 data-i18n-html=\"secH1\">הבטחה <span class=\"accent\">ופרטיות</span></h1>\n400\t      <p class=\"lead\" data-i18n=\"secLead\">הסוכן שלך סגור ומאובטח. 4 דברים שחשוב לדעת.</p>\n401\t      <div class=\"cards\" id=\"secCards\">\n402\t        <div class=\"card reveal-item\">\n403\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"7\" rx=\"2\"/><rect x=\"3\" y=\"13\" width=\"18\" height=\"7\" rx=\"2\"/><path d=\"M7 7.5h.01M7 16.5h.01\"/></svg></div>\n404\t          <div><h3 data-i18n=\"sec1T\">סביבה מבודדת, שלך בלבד</h3><p data-i18n=\"sec1B\">הסוכן פועל בסביבה סגורה שנפתחת רק עבורך. אף גורם מבחוץ לא נוגע במידע שבתוכה.</p></div>\n405\t        </div>\n406\t        <div class=\"card reveal-item\">\n407\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M22 2L11 13\"/><path d=\"M22 2l-7 20-4-9-9-4 20-7z\"/></svg></div>\n408\t          <div><h3 data-i18n=\"sec2T\">טלגרם, ערוץ פרטי ומוצפן</h3><p data-i18n=\"sec2B\">כל השיחה עוברת בטלגרם בלבד, מוצפנת ונפרדת מהמייל, מהדרייב ומכל מערכת אחרת.</p></div>\n409\t        </div>\n410\t        <div class=\"card reveal-item\">\n411\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M5.5 5.5l13 13\"/></svg></div>\n412\t          <div><h3 data-i18n=\"sec3T\">אין גישה לחשבונות שלך</h3><p data-i18n=\"sec3B\">המייל, הדרייב והחשבונות חסומים לסוכן. בחירה ארכיטקטונית קבועה, לא מגבלה זמנית.</p></div>\n413\t        </div>\n414\t        <div class=\"card reveal-item\">\n415\t          <div class=\"ic\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"7.5\" cy=\"15.5\" r=\"4.5\"/><path d=\"M10.8 12.2L21 2\"/><path d=\"M15 8l3 3\"/></svg></div>\n416\t          <div><h3 data-i18n=\"sec4T\">כלי AI חיצוניים, במפתחות שלך</h3><p data-i18n=\"sec4B\">חיבור לכלים חיצוניים נעשה רק דרך מפתחות ה־API שלך. סגורים, לא ניתנים להעברה, ומנותקים בלחיצה.</p></div>\n417\t        </div>\n418\t      </div>\n419\t      <p class=\"soul\" data-i18n-html=\"soul\">מוח של AI, גוף של NanoClaw, ונשמה של <span class=\"accent\">אליה בן כנען</span>.</p>\n420\t    </section>\n421\t\n422\t    <!-- 4 · pilot -->\n423\t    <section class=\"slide list-slide before pilot-slide\">\n424\t      <h1 data-i18n-html=\"pilH1\">עשרה ימים <span class=\"accent\">בעולם החדש</span></h1>\n425\t      <p class=\"lead\" data-i18n=\"pilLead\">סוכני AI נכנסים לכל תפקיד, והעבודה שהכרנו משתנה. אני רוצה שתרגישו את זה בעצמכם. עשרה ימים על העבודה האמיתית שלכם.</p>\n426\t      <div class=\"pnotes\">\n427\t        <div class=\"pnote reveal-item\"><span class=\"pn-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"20 12 20 22 4 22 4 12\"/><rect x=\"2\" y=\"7\" width=\"20\" height=\"5\"/><line x1=\"12\" y1=\"22\" x2=\"12\" y2=\"7\"/><path d=\"M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z\"/><path d=\"M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z\"/></svg></span><div><h3 data-i18n=\"pil1T\">חינם באמת</h3><p data-i18n=\"pil1B\">בלי כרטיס אשראי, בלי לבטל כלום, בלי אותיות קטנות. פשוט מתחילים.</p></div></div>\n428\t        <div class=\"pnote reveal-item\"><span class=\"pn-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg></span><div><h3 data-i18n=\"pil2T\">זה אמיתי, וגדל איתכם</h3><p data-i18n=\"pil2B\">לא הדגמה. סוכן שעובד על המשימות האמיתיות שלכם, ולומד את הקצב והסגנון שלכם ככל שתשתמשו.</p></div></div>\n429\t        <div class=\"pnote reveal-item\"><span class=\"pn-ico\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4\"/></svg></span><div><h3 data-i18n=\"pil3T\">בסוף, אתם מחליטים</h3><p data-i18n=\"pil3B\">רוצים להמשיך? מקימים סוכן משלכם. לא רוצים? פשוט נגמר. בלי חיוב ובלי מלכוד.</p></div></div>\n430\t      </div>\n431\t      <p class=\"soul\" data-i18n-html=\"pilSoul\"><span class=\"accent\">שלכם, אליה בן כנען</span>.</p>\n432\t    </section>\n433\t\n434\t    <!-- 5 · signup -->\n435\t    <section class=\"slide list-slide before\">\n436\t      <h1 data-i18n-html=\"formH1\">הסוכן <span class=\"accent\">נכנס לעבודה</span></h1>\n437\t      <p class=\"lead\" style=\"margin-top:8px\" data-i18n=\"formLead\">הסוכן שלך עובד מתוך טלגרם, ומשם תתנהל כל העבודה איתו. טלגרם זמין גם בנייד וגם במחשב, כדי שיהיה לך נוח לעבוד מכל מקום. עוד כמה פרטים, והוא כבר מתחיל.</p>\n438\t      <p class=\"dl-prompt\" data-i18n=\"dlPrompt\">אין לך טלגרם? מורידים בדקה:</p>\n439\t      <div class=\"dl-row\" style=\"margin-top:8px\">\n440\t        <a href=\"https://telegram.org/dl\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlMobile\">הורדת טלגרם לנייד ←</a>\n441\t        <a href=\"https://desktop.telegram.org/\" target=\"_blank\" rel=\"noopener\" data-i18n=\"dlDesktop\">הורדת טלגרם למחשב ←</a>\n442\t      </div>\n443\t      <form id=\"signupForm\" novalidate>\n444\t        <div class=\"name-row\">\n445\t          <div class=\"field\" id=\"fFirst\">\n446\t            <label for=\"inFirst\" data-i18n=\"firstL\">שם פרטי</label>\n447\t            <input id=\"inFirst\" type=\"text\" placeholder=\"השם שלך\" autocomplete=\"given-name\" data-i18n-ph=\"firstPh\">\n448\t            <div class=\"err\" data-i18n=\"firstE\">נא להזין שם פרטי</div>\n449\t          </div>\n450\t          <div class=\"field\" id=\"fLast\">\n451\t            <label for=\"inLast\" data-i18n=\"lastL\">שם משפחה</label>\n452\t            <input id=\"inLast\" type=\"text\" placeholder=\"שם משפחה\" autocomplete=\"family-name\" data-i18n-ph=\"lastPh\">\n453\t            <div class=\"err\" data-i18n=\"lastE\">נא להזין שם משפחה</div>\n454\t          </div>\n455\t        </div>\n456\t        <div class=\"field\" id=\"fEmail\">\n457\t          <label for=\"inEmail\" data-i18n=\"emailL\">אימייל</label>\n458\t          <input id=\"inEmail\" type=\"email\" placeholder=\"name@company.com\" autocomplete=\"email\">\n459\t          <div class=\"err\" data-i18n=\"emailE\">נא להזין אימייל תקין</div>\n460\t        </div>\n461\t        <div class=\"field\" id=\"fPhone\">\n462\t          <label for=\"inPhone\" data-i18n=\"phoneL\">טלפון</label>\n463\t          <input id=\"inPhone\" type=\"tel\" placeholder=\"050-0000000\" autocomplete=\"tel\">\n464\t          <div class=\"err\" data-i18n=\"phoneE\">נא להזין מספר טלפון תקין</div>\n465\t        </div>\n466\t        <label class=\"consent\" id=\"tgConsentWrap\">\n467\t          <input type=\"checkbox\" id=\"inTgConsent\">\n468\t          <span data-i18n=\"tgConsent\">הורדתי טלגרם, אפשר להתחיל</span>\n469\t        </label>\n470\t        <label class=\"consent\" id=\"consentWrap\">\n471\t          <input type=\"checkbox\" id=\"inConsent\">\n472\t          <span data-i18n-html=\"consent\">קראתי ואישרתי את <a href=\"#\" onclick=\"return false\">מדיניות הפרטיות ותנאי השימוש</a></span>\n473\t        </label>\n474\t      </form>\n475\t      <p class=\"soul\" data-i18n-html=\"formSoul\">עוד דקה של פרטים, והסוכן שלך שולח לך <span class=\"accent\">הודעה ראשונה</span>.</p>\n476\t    </section>\n477\t\n478\t  </div>\n479\t\n480\t  <div class=\"cta-zone\">\n481\t    <div class=\"nav-row\">\n482\t      <button class=\"nav-arr\" id=\"arrBack\" aria-label=\"הקודם\" disabled>\n483\t        <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 18l6-6-6-6\"/></svg>\n484\t 