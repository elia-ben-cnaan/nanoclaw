ulletIdx = -1, cmdAutoTimer = null;\n516\t\n517\tfunction pad2(n){ return String(n+1).padStart(2,'0'); }\n518\t\n519\tfunction buildSlideHTML(s, i) {\n520\t  const ov = `<div class=\"s-ov\"></div>`;\n521\t\n522\t  if (s.type === 'cover') {\n523\t    return ov + `<div class=\"s-wrap centered\">\n524\t      <img class=\"cover-logo\" src=\"payme-logo.jpg\" alt=\"PayMe\">\n525\t      <div class=\"cover-tag\">Strategic Partner Sales</div>\n526\t      <div class=\"cover-sub-line\">100,000 ₪ MRR ב-4 חודשים · אסטרטגיית שותפויות</div>\n527\t      <div class=\"cover-line\">לא ניתחתי שוק. בניתי תוכנית שאפשר להריץ ביום הראשון.</div>\n528\t      <div class=\"cover-meta\"><span>הוגש על ידי</span><span class=\"cover-dot\"></span><b>אליה בן כנען</b></div>\n529\t    </div>`;\n530\t  }\n531\t\n532\t  if (s.type === 'process') {\n533\t    const cards = s.steps.map((c,ci)=>`\n534\t      <div class=\"proc-card\" id=\"proc-card-${i}-${ci}\"><div class=\"proc-num\">${c.num}</div><h3>${c.h}</h3><p>${c.p}</p></div>`).join('');\n535\t    const band = s.band.map(e=>`<div class=\"proc-eng\"><b>${e.b}</b><span>${e.s}</span></div>`).join('');\n536\t    return ov + `<div class=\"s-wrap\">\n537\t      <div class=\"label-sm\">${s.kicker}</div><div class=\"rule\"></div>\n538\t      <h1 class=\"h-lg\" id=\"hl-${i}\"></h1><p class=\"body-t\" id=\"bd-${i}\"></p>\n539\t      <div class=\"proc-grid\">${cards}</div><div class=\"proc-band\">${band}</div>\n540\t    </div>`;\n541\t  }\n542\t\n543\t  if (s.type === 'split') {\n544\t    const cards = s.cards.map((c,ci)=>`\n545\t      <div class=\"fcard\">\n546\t        <div class=\"fcard-step\" id=\"cstep-${i}-${ci}\"></div>\n547\t        <h3 id=\"ctitle-${i}-${ci}\"></h3><p id=\"cdesc-${i}-${ci}\"></p>\n548\t        ${c.mrr ? `<span class=\"mrr\">${c.mrr}</span>` : ''}<div class=\"fcard-dot\"></div>\n549\t      </div>`).join('');\n550\t    return ov + `<div class=\"s-wrap\"><div class=\"split\">\n551\t        <div class=\"split-l\"><div class=\"rule\"></div>\n552\t          <h1 class=\"h-lg\" id=\"hl-${i}\"></h1><p class=\"body-t\" id=\"bd-${i}\"></p>\n553\t          ${s.foot ? `<div style=\"margin-top:22px;font-size:14px;font-weight:800;color:var(--accent)\">${s.foot}</div>` : ''}\n554\t        </div>\n555\t        <div class=\"split-r${s.cards.length > 3 ? ' grid2' : ''}\">${cards}</div>\n556\t      </div></div>`;\n557\t  }\n558\t\n559\t  if (s.type === 'table') {\n560\t    const head = s.cols.map(c=>`<th>${c}</th>`).join('');\n561\t    const body = s.rows.map(r=>`<tr>${r.map(c=>`<td>${String(c).replace(/\\n/g,'<br>')}</td>`).join('')}</tr>`).join('');\n562\t    return ov + `<div class=\"s-wrap centered\">\n563\t      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n564\t      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(34px,4.6vw,66px);margin-bottom:${s.sub?'8px':'0'}\"></h1>\n565\t      ${s.sub ? `<p class=\"body-t\" style=\"max-width:720px\">${s.sub}</p>` : ''}\n566\t      <div class=\"tbl-wrap\"><table class=\"ptable\"><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>\n567\t      ${s.foot ? `<div class=\"tbl-foot\">${s.foot.replace(/(~?[\\d,]+(?:-[\\d,]+)?\\s*₪?)/,'<b>$1</b>')}</div>` : ''}\n568\t      ${s.src ? `<div class=\"tbl-src\">${s.src}</div>` : ''}\n569\t    </div>`;\n570\t  }\n571\t\n572\t  if (s.type === 'formula') {\n573\t    const terms = s.terms.map((t,ti)=>`\n574\t      <div class=\"fx-term\"><div class=\"fx-term-t\">${t.t}</div><div class=\"fx-term-ex\">${t.ex}</div></div>\n575\t      ${ti < s.terms.length-1 ? '<div class=\"fx-op\">×</div>' : ''}`).join('');\n576\t    const calc = s.terms.map(t=>t.ex).join(' × ') + ' = <b>' + s.result + '</b>';\n577\t    return ov + `<div class=\"s-wrap centered\">\n578\t      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n579\t      <h1 class=\"h-xl\" id=\"hl-${i}\" style=\"font-size:clamp(34px,4.6vw,64px);margin-bottom:6px\"></h1>\n580\t      <div class=\"fx-eq\"><div class=\"fx