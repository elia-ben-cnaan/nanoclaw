"next-open\">Open in browser ↗</span>`:''}`;\n      return c.href\n        ? `<a class=\"next-cell\" href=\"${c.href}\" target=\"_blank\" rel=\"noopener\">${inner}</a>`\n        : `<div class=\"next-cell\">${inner}</div>`;\n    }).join('');\n    return ov + `<div class=\"s-wrap centered\">\n      <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule c\"></div>\n      <h1 class=\"banner\" id=\"banner-${i}\"></h1>\n      ${s.close ? `<div class=\"close-line\">${s.close}</div>` : ''}\n      <div class=\"next-grid\">${cells}</div></div>`;\n  }\n\n  if (s.type === 'profile') {\n    const photo = s.photo\n      ? `<img src=\"${s.photo}\" alt=\"${s.name}\">`\n      : `<div class=\"prof-mono\">EB</div>`;\n    const pts = s.pts.map(p=>`<div class=\"prof-pt\"><span class=\"prof-dot\"></span>${p}</div>`).join('');\n    return ov + `<div class=\"s-wrap profile-wrap\">\n      <div class=\"prof-photo\">${photo}</div>\n      <div class=\"prof-text\">\n        <div class=\"label-sm\">${s.kicker||''}</div><div class=\"rule\"></div>\n        <h1 class=\"prof-name\">${s.name}</h1>\n        <div class=\"prof-role\">${s.role}</div>\n        <div class=\"prof-pts\">${pts}</div>\n      </div>\n    </div>`;\n  }\n\n  if (s.type === 'finale') {\n    return ov + `<div class=\"s-wrap centered finale-wrap\">\n      <img class=\"finale-logo\" src=\"payme-logo.jpg\" alt=\"PayMe\">\n      <h1 class=\"finale-h\">${s.hl.replace(/\\n/g,'<br>')}</h1>\n      <div class=\"finale-line\">${s.line}</div>\n      <div class=\"finale-sign\">${s.sign}</div>\n      <div class=\"finale-contact\">${s.contact}</div>\n    </div>`;\n  }\n  return ov;\n}\n\nfunction buildDeck() {\n  const deck = document.getElementById('deck');\n  const prog = document.getElementById('progress');\n  document.getElementById('tot').textContent = N;\n  SLIDES.forEach((s,i)=>{\n    const el = document.createElement('div');\n    el.className = 'slide' + (i===0?' active':'');\n    el.id = 'slide-'+i;\n    el.innerHTML = buildSlid