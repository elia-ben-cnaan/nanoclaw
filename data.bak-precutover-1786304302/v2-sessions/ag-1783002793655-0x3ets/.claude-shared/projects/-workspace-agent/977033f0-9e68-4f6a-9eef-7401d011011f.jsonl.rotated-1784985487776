d of leaving the page,\n   and never exits the app even on the first slide. */\nhistory.replaceState({ app: true }, '');\nhistory.pushState({ app: true }, '');\nwindow.addEventListener('popstate', ()=>{\n  if (current > 0) goTo(current - 1);\n  /* always re-arm a buffer entry so a further back press stays in the app */\n  history.pushState({ app: true }, '');\n});\n\n/* ============ reading highlight: glides card to card at reading pace ============ */\nlet readGen = 0;\nfunction readingCycle(idx){\n  const gen = ++readGen;\n  const cards = Array.from(slides[idx].querySelectorAll('.card'));\n  if (!cards.length) return;\n  let i = 0;\n  const tick = ()=>{\n    if (gen !== readGen || current !== idx){ cards.forEach(c=>c.classList.remove('reading')); return; }\n    cards.forEach(c=>c.classList.remove('reading'));\n    cards[i].classList.add('reading');\n    i = (i + 1) % cards.length;\n    setTimeout(tick, 2000);\n  };\n  tick();\n}\n\n/* ================= staggered reveal (signup) ================= */\nconst revealedSlides = new Set();\nfunction revealEnter(idx){\n  if (revealedSlides.has(idx)) return;\n  revealedSlides.add(idx);\n  const items = Array.from(slides[idx].querySelectorAll('.reveal-item'));\n  items.forEach((el,i)=>{\n    setTimeout(()=>el.classList.add('in'), 260 + i*430);\n  });\n}\n\n/* ================= signup ================= */\nconst VALIDATORS = {\n  fFirst: v => v.trim().length >= 2,\n  fLast:  v => v.trim().length >= 2,\n  fEmail: v => /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(v.trim()),\n  fPhone: v => /^[\\d+\\-\\s()]{9,15}$/.test(v.trim())\n};\n\nfunction validateField(wrapId){\n  const wrap = document.getElementById(wrapId);\n  const input = wrap.querySelector('input');\n  const valid = VALIDATORS[wrapId](input.value);\n  wrap.classList.toggle('invalid', !valid);\n  return valid;\n}\n\n/* errors appear only after the user touches a field (blur) or tries to submit */\nObject.keys(VALIDATORS).forEach(wrapId=>{\n  const wrap = document.getElementById(wrapId);\n  const input = wrap.querySelector('input');\n  input.addEventListener('blur', ()=>{ if (input.value.trim() !== '') validateField(wrapId); });\n  input.addEventListener('input', ()=>{ if (wrap.classList.contains('invalid')) validateField(wrapId); });\n});\ndocument.getElementById('inTgConsent').addEventListener('change', e=>{\n  if (e.target.checked) document.getElementById('tgConsentWrap').classList.remove('invalid');\n});\ndocument.getElementById('inConsent').addEventListener('change', e=>{\n  if (e.target.checked) document.getElementById('consentWrap').classList.remove('invalid');\n});\n\nfunction submitForm(){\n  let ok = true;\n  Object.keys(VALIDATORS).forEach(wrapId=>{ if (!validateField(wrapId)) ok = false; });\n  const tgConsent = document.getElementById('inTgConsent');\n  document.getElementById('tgConsentWrap').classList.toggle('invalid', !tgConsent.checked);\n  if (!tgConsent.checked) ok = false;\n  const consent = document.getElementById('inConsent');\n  document.getElementById('consentWrap').classList.toggle('invalid', !consent.checked);\n  if (!consent.checked) ok = false;\n  if (!ok){\n    const firstInvalid = document.querySelector('.field.invalid input');\n    if (firstInvalid) firstInvalid.focus();\n    return;\n  }\n  userName = document.getElementById('inFirst').value.trim();\n  ctaBtn.disabled = true;\n  ctaBtn.textContent = T().submitting;\n  setTimeout(()=>{\n    ctaBtn.disabled = false;\n    window.open('https://t.me/joni_agent_bot','_blank');\n  }, 1400);\n}\n\n/* ================= telegram demo: auto simulation, watch-it-happen ================= */\nconst chatLog = document.getElementById('chatLog');\nconst tgStatus = document.getElementById('tgStatus');\n\nconst CHECK_TEAL = '<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#56EDD6\" stroke-width=\"2.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M20 6L9 17l-5-5\"/></svg>';\nconst DBL_CHECK = '<svg width=\"15\" height=\"11\" viewBox=\"0 0 20 12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M1 6.5L4.5 10 11 2.5\"/><path d=\"M8 6.5L11.5 10 18 2.5\"/></svg>';\nconst DOC_ICON = '<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#fff\" stroke-width=\"1.9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M14 2H7a2 2 0 00-2 2v16a2 2 0 002 2h10a2 2 0 002-2V7z\"/><path d=\"M14 2v5h5\"/></svg>';\n\nlet demoStarted = false;\nlet demoGen = 0;\nlet msgClock = null;\n\nfunction wait(ms){ return new Promise(res=>setTimeout(res, ms)); }\nfunction step(gen){ if (gen !== demoGen) throw new Error('stale'); }\nasync function waitVisible(gen){\n  step(gen);\n  while (current !== 1){ await wait(400); step(gen); }\n}\n\nfunction fmtTime(){\n  if (!msgClock) return '';\n  const t = msgClock.h.toString() + ':' + (msgClock.m<10?'0':'') + msgClock.m;\n  msgClock.m += 1;\n  if (msgClock.m>59){ msgClock.m=0; msgClock.h=(msgClock.h+1)%24; }\n  return t;\n}\n\nfunction scrollLog(){ chatLog.scrollTop = chatLog.scrollHeight; }\n\nfunction dayPill(){\n  const row = document.createElement('div');\n  row.className = 'day-row';\n  row.innerHTML = '<span class=\"day-pill\">' + T().dayPill + '</span>';\n  chatLog.appendChild(row);\n}\n\nfunction bubble(who, html, withStamp){\n  const row = document.createElement('div');\n  row.className = 'msg-row ' + who;\n  const b = document.createElement('div');\n  b.className = 'bubble';\n  b.innerHTML = html;\n  if (withStamp){\n    const st = document.createElement('div');\n    st.className = 'stamp';\n    st.innerHTML = (who==='me' ? DBL_CHECK : '') + '<span>' + fmtTime() + '</span>';\n    b.appendChild(st);\n  }\n  row.appendChild(b);\n  chatLog.appendChild(row);\n  scrollLog();\n  return row;\n}\n\nfunction docHtml(name){\n  const kind = name.split('.').pop().toUpperCase();\n  return '<div class=\"doc\"><div class=\"doc-ic\">' + DOC_ICON + '</div><div><div class=\"doc-name\">' + name + '</div><div class=\"doc-kind\">' + kind + '</div></div></div>';\n}\n\nfunction typingOn(){\n  tgStatus.textContent = 'typing…';\n  tgStatus.classList.add('typing');\n  const row = document.createElement('div');\n  row.className = 'msg-row bot typing-row';\n  row.innerHTML = '<div class=\"bubble typing-bubble\"><i></i><i></i><i></i></div>';\n  chatLog.appendChild(row);\n  scrollLog();\n  return row;\n}\nfunction typingOff(row){\n  tgStatus.textContent = 'online';\n  tgStatus.classList.remove('typing');\n  if (row && row.parentNode) row.remove();\n}\n\nasync function botSays(gen, html, quick){\n  await waitVisible(gen);\n  const t = typingOn();\n  await wait(quick ? 650 : 1050);\n  step(gen);\n  typingOff(t);\n  return bubble('bot', html, true);\n}\n\nasync function playScenario(gen, idx){\n  const sc = SC()[idx];\n  msgClock = { h: sc.base[0], m: sc.base[1] };\n  for (const m of sc.msgs){\n    await waitVisible(gen);\n    if (m.who==='me'){\n      await wait(650); step(gen);\n      bubble('me', m.text + (m.file ? docHtml(m.file) : ''), true);\n    } else {\n      const t = typingOn();\n      await wait(1000); step(gen);\n      typingOff(t);\n      bubble('bot', (m.file ? docHtml(m.file) : '') + m.text, true);\n    }\n    /* reading pause: let the reader read the message, but keep the rhythm brisk */\n    const readMs = Math.min(2500, 700 + m.text.length * 30);\n    await wait(readMs); step(gen);\n  }\n  /* receipt as a telegram-style bot message */\n  await wait(500); step(gen);\n  const t = typingOn();\n  await wait(800); step(gen);\n  typingOff(t);\n  let html = '<div class=\"receipt-head\">' + CHECK_TEAL + '<span>' + sc.receipt.title + '</span></div>';\n  sc.receipt.rows.forEach(r=>{ html += '<div class=\"receipt-row\">' + CHECK_TEAL + '<span>' + r + '</span></div>'; });\n  bubble('bot', html, true);\n}\n\nasync function fadeClear(gen){\n  chatLog.style.transition = 'opacity .45s ease';\n  chatLog.style.opacity = '0';\n  await wait(480); step(gen);\n  chatLog.innerHTML = '';\n  dayPill();\n  chatLog.style.opacity = '1';\n}\n\nasync function runLoop(gen){\n  try {\n    await wait(500);\n    while (true){\n      await waitVisible(gen);\n      dayPill();\n      await botSays(gen, T().demoGreeting);\n      await wait(1600);\n      for (let i = 0; i < SC().length; i++){\n        await playScenario(gen, i);\n        await wait(2600); step(gen);\n        if (i < SC().length - 1){ await fadeClear(gen); }\n      }\n      await botSays(gen, T().demoClosing, true);\n      await wait(5200); step(gen);\n      await fadeClear(gen);\n    }\n  } catch(e){ /* stale generation: a newer run owns the stage */ }\n}\n\nfunction restartDemo(){\n  demoGen++;\n  chatLog.innerHTML = '';\n  chatLog.style.opacity = '1';\n  tgStatus.textContent = 'online';\n  tgStatus.classList.remove('typing');\n  if (demoStarted) runLoop(demoGen);\n}\n\nfunction demoEnter(){\n  if (demoStarted) return;\n  demoStarted = true;\n  runLoop(++demoGen);\n}\n\napplyLang();\n</script>\n</body>\n</html>\n","numLines":294,"startLine":769,"totalLines":1062}},"sourceToolAssistantUUID":"bf106a11-56b9-4d32-b69d-49e473be9e19","userType":"external","entrypoint":"sdk-ts","cwd":"/workspace/agent","sessionId":"977033f0-9e68-4f6a-9eef-7401d011011f","version":"2.1.197","gitBranch":"HEAD"}
